{
  "schema": "unmatched.t53-tags-damage/2",
  "status": "измерено",
  "method": {
    "tags": {
      "rev": 2,
      "frames": "три доски × K1 хоста, K1 присоединившегося, K3, кадры урона; цвет, серый, deuteranopia",
      "textVsBackground": {
        "method": "ядро текста = пиксели painted-bbox строки (SHOT widget id=board.tag.name / board.tag.hp) с ΔE76 ≤ 10 к байтам tag.text (242,236,222) — сглаженные края букв сюда не входят; подложка = пиксели painted-bbox тега с ΔE76 ≤ 6 к tag.background (22,26,40); WCAG медиан",
        "minWcag": 4.5,
        "pass": "100 % строк 100 % тегов",
        "predicted": 14.7
      },
      "backgroundIntegrity": {
        "rule": "≥ 98 % пикселей painted-bbox тега вне bbox текста, HP-бара (board.tag.bar) и чипа (board.tag.chip) — цвет подложки (ΔE76 ≤ 6)",
        "min": 0.98
      },
      "overlaps": {
        "rule": "tag∩tag, tag∩icon, tag∩plate, tag∩damage, tag∩HUD-панель (SHOT panel) = 0 px² (ε 0,5) по painted-bbox; tag∩FigureScreenRect другого бойца — записывается, не гейт",
        "epsilonPx2": 0.5
      },
      "textHeight": {
        "rule": "кегль строки (поле font= строки SHOT widget) ≥ 11 su при 1920×1080",
        "minSu": 11
      },
      "mode": {
        "rule": "режим тега совпадает с правилом: блок-аут (без арт-фигуры) → full, арт-фигура (Medusa) → compact, владелец плашки → hidden, K2 → compact; -ArtPreviewTagNames=all → full",
        "pass": "100 %"
      },
      "geom": "bbox только из geom=painted"
    },
    "damage": {
      "rev": 2,
      "textVsCapsule": {
        "method": "ядро текста ΔE76 ≤ 10 к damage.text (255,224,175), капсула ΔE76 ≤ 6 к (22,26,40), WCAG медиан",
        "minWcag": 4.5,
        "predicted": 13.6,
        "variants": [
          "color",
          "gray",
          "deuteranopia"
        ]
      },
      "overlaps": {
        "rule": "пересечение bbox числа с любым тегом, иконкой, плашкой = 0 px² (было 25–27 %)",
        "epsilonPx2": 0.5
      },
      "binding": {
        "rule": "центр числа ближе к FigureScreenRect цели (строка SHOT figure), чем к FigureScreenRect любого другого бойца",
        "pass": "100 % кадров"
      },
      "geom": "geom=painted; счёт CUE = ARTPREVIEW damage-number ровно по одному на обеих сторонах сохраняется (validation.json)",
      "twoFrames": "в акте два кадра урона: способность (помечено) и бой"
    }
  },
