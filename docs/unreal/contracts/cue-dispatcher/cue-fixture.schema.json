{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unmatched.local/schemas/unmatched.cue-fixture-1.json",
  "title": "unmatched.cue-fixture/1 — фикстура FS08CueDispatcher без мира",
  "description": "scenario: входные события -> точная трасса `CUE fx …` (эталонная модель и будущие C++-тесты GD-044 обязаны дать её побайтно, без префиксов лога). negative-trace: трасса, которую гейт обязан отклонить с перечисленными кодами.",
  "type": "object",
  "required": ["schema", "id", "kind", "description", "covers"],
  "properties": {
    "schema": {"const": "unmatched.cue-fixture/1"},
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "kind": {"enum": ["scenario", "negative-trace"]},
    "description": {"type": "string", "minLength": 1},
    "covers": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "assets_present": {
      "type": "object",
      "patternProperties": {"^CUE-[0-9]{3}$": {"type": "object", "additionalProperties": false,
        "properties": {"vfx": {"type": "string"}, "sfx": {"type": "string"}, "clip": {"type": "string"}}}},
      "additionalProperties": false
    },
    "assets_unloadable": {"type": "array", "items": {"type": "string"}},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["t", "kind"],
        "properties": {
          "t": {"type": "integer", "minimum": 0},
          "kind": {"enum": ["cue", "reconnect", "settings", "advance", "combat"]},
          "id": {"type": "string", "pattern": "^CUE-[0-9]{3}$"},
          "subject": {"type": "string", "pattern": "^[A-Za-z0-9_:-]+$"},
          "seq": {"type": ["integer", "null"], "minimum": 0},
          "channel": {"enum": ["http", "ws", "local"]},
          "steps": {"type": "integer", "minimum": 1},
          "move_kind": {"enum": ["move", "place"], "description": "CUE-007: вид перемещения (place — один шаг place_ms)"},
          "order": {"type": "integer", "minimum": 0, "description": "CUE-007: индекс этого перемещения в seq_moves"},
          "seq_moves": {"type": "array", "minItems": 1, "description": "CUE-007: все перемещения seq по порядку — длительность считает расписание 04 §6.3",
            "items": {"type": "object", "required": ["steps"], "additionalProperties": false,
              "properties": {"steps": {"type": "integer", "minimum": 1}, "kind": {"enum": ["move", "place"]}}}},
          "recovered_seq": {"type": "integer", "minimum": 0},
          "reduced_motion": {"type": "boolean"},
          "hold_ms": {"type": "integer", "minimum": 0, "description": "DE-018: пропускаемое удержание внутри показа (CUE-010: чтение и строки эффекта); done пишет hold=, G5 меряет ms − hold"},
          "staged": {"type": "boolean", "description": "CUE постановки (CUE-011 из кадра контакта, CUE-013 из падения боя) с seq своего боя: D3 не применяется, D2 и D4 применяются"},
          "duration_ms": {"type": "integer", "minimum": 0, "description": "DE-018: длина показа вместо duration_ms строки (скорость анимации постановки боя)"},
          "stage": {"enum": ["start", "read", "effect", "slam", "face", "pause", "lunge", "contact", "hit", "minus", "hp", "fall", "end", "skip"], "description": "DE-018: этап строки `CUE combat` (kind combat); AN-24 (BP-06): face — доворот атакующего к цели за 120 мс до выпада"},
          "fields": {"type": "object", "additionalProperties": {"type": ["string", "integer"]}, "description": "DE-018: поля строки `CUE combat` после t, в этом порядке"}
        },
        "allOf": [
          {"if": {"properties": {"kind": {"const": "cue"}}}, "then": {"required": ["id"]}},
          {"if": {"properties": {"kind": {"const": "reconnect"}}}, "then": {"required": ["recovered_seq"]}},
          {"if": {"properties": {"kind": {"const": "settings"}}}, "then": {"required": ["reduced_motion"]}},
          {"if": {"properties": {"kind": {"const": "combat"}}}, "then": {"required": ["seq", "stage"]}}
        ]
      }
    },
    "expect_trace": {"type": "array", "items": {"type": "string", "pattern": "^CUE "}},
    "expect_summary": {"type": "object"},
    "staging": {
      "type": "object",
      "description": "DE-018: вход постановки боя для C++-порта (Unmatched.S09.CombatStage.Fixtures): тот же сценарий, что events, но события строит FS09CombatStage. Эталонная модель его не читает.",
      "required": ["start_t", "end_t", "input"],
      "properties": {
        "declare": {"type": "object", "required": ["t", "subject", "seq"]},
        "start_t": {"type": "integer", "minimum": 0},
        "end_t": {"type": "integer", "minimum": 0},
        "input": {"type": "object", "required": ["seq", "attacker", "target"]},
        "skips": {"type": "array", "items": {"type": "object", "required": ["t", "src"]}}
      }
    },
    "trace": {"type": "array", "items": {"type": "string"}},
    "expect_error_codes": {"type": "array", "items": {"pattern": "^[GMC][1-9]$"}, "minItems": 1}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "scenario"}}}, "then": {"required": ["events", "expect_trace"]}},
    {"if": {"properties": {"kind": {"const": "negative-trace"}}}, "then": {"required": ["trace", "expect_error_codes"]}}
  ]
}
