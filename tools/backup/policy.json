{
  "exclude_names": [
    ".git", "node_modules", ".venv", "venv", "__pycache__",
    "DerivedDataCache", "Intermediate", ".vs", ".pytest_cache",
    ".ruff_cache", ".hypothesis", "nul", "con", "prn", "aux"
  ],
  "exclude_relative_paths": [
    ".claude", ".codex", ".zcode", ".zcode-tmp", ".tmp-docker-config",
    ".idea", ".vscode", ".playwright-mcp", ".mcp.json", "login_test.json",
    ".audio-upload/suno_raw.cjs", "tmp/hud-verify", "test-results", "playwright-report",
    "dist", "backend/dist", "admin/dist",
    "unreal/Unmatched/Binaries", "unreal/Unmatched/Artifacts",
    "unreal/Unmatched/Saved/Cooked", "unreal/Unmatched/Saved/StagedBuilds",
    "unreal/Unmatched/Saved/Logs", "unreal/Unmatched/Saved/Crashes",
    "unreal/Unmatched/Saved/Temp", "unreal/Unmatched/Saved/Shaders",
    "unreal/Unmatched/Saved/ShaderDebugInfo", "unreal/Unmatched/Saved/MaterialStats",
    "unreal/Unmatched/Saved/UnrealBuildTool"
  ],
  "exclude_file_patterns": [".env", ".env.*", "*.env.bak", "*.pem", "*.key", "*.pfx", "*.p12"],
  "retention": {"last": 24, "daily": 14, "weekly": 8, "monthly": 12}
}
