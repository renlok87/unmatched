{
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "enum": [
        "unmatched.anim-acceptance/1"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "anim"
      ]
    },
    "asset_id": {
      "type": "string",
      "pattern": "^ASSET-[A-Z0-9]+(-[A-Z0-9]+)*-[0-9]{3}$"
    },
    "clip": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]+$",
      "description": "только kind=anim: имя клипа D-11 (Idle, LungeAttack, HitReact, DeathSettle)"
    },
    "cycle": {
      "type": "string",
      "enum": [
        "r1",
        "r2",
        "r3"
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "previous_card": {
      "type": [
        "string",
        "null"
      ],
      "description": "card.json предыдущего цикла (путь от корня репо); null у r1"
    },
    "accepted_object": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "frames": {
      "type": "object",
      "properties": {
        "dir": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+\\.(jpg|png|json)$"
          }
        }
      },
      "required": [
        "dir",
        "files"
      ],
      "additionalProperties": false
    },
    "reports": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gates": {
      "type": "object",
      "properties": {
        "G-VALIDATE": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "PASS",
                "FAIL",
                "n/a"
              ]
            },
            "source": {
              "type": "string",
              "description": "отчёт (путь от корня) или команда, давшая статус"
            },
            "note": {
              "type": [
                "string",
                "null"
              ],
              "description": "файл#ключ = значение; null — без заметки"
            },
            "source_defect": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "только FAIL у модели: true — дефект исходника Tripo; иначе null"
            }
          },
          "required": [
            "status",
            "source",
            "note",
            "source_defect"
          ],
          "additionalProperties": false
        },
        "G-CONTACT": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "PASS",
                "FAIL",
                "n/a"
              ]
            },
            "source": {
              "type": "string",
              "description": "отчёт (путь от корня) или команда, давшая статус"
            },
            "note": {
              "type": [
                "string",
                "null"
              ],
              "description": "файл#ключ = значение; null — без заметки"
            },
            "source_defect": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "только FAIL у модели: true — дефект исходника Tripo; иначе null"
            }
          },
          "required": [
            "status",
            "source",
            "note",
            "source_defect"
          ],
          "additionalProperties": false
        },
        "G-MANIFEST": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "PASS",
                "FAIL",
                "n/a"
              ]
            },
            "source": {
              "type": "string",
              "description": "отчёт (путь от корня) или команда, давшая статус"
            },
            "note": {
              "type": [
                "string",
                "null"
              ],
              "description": "файл#ключ = значение; null — без заметки"
            },
            "source_defect": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "только FAIL у модели: true — дефект исходника Tripo; иначе null"
            }
          },
          "required": [
            "status",
            "source",
            "note",
            "source_defect"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "G-VALIDATE",
        "G-CONTACT",
        "G-MANIFEST"
      ],
      "additionalProperties": false
