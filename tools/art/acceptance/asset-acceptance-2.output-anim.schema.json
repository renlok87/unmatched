            "frames"
          ],
          "additionalProperties": false
        },
        "D": {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "description": "0 | 0.5 | 1 | 1.5 | 2"
            },
            "rationale": {
              "type": "string"
            },
            "frames": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "value",
