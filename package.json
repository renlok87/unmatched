    "docker:stop": "bash scripts/stop-wsl.sh",
    "docker:restart": "bash scripts/restart-wsl.sh",
    "docker:logs": "wsl -d Ubuntu -e bash -c \"cd /mnt/c/Users/ren/WebstormProjects/unmached/unmached && docker compose logs -f\"",
    "docker:ps": "wsl -d Ubuntu -e bash -c \"cd /mnt/c/Users/ren/WebstormProjects/unmached/unmached && docker compose ps\""
  },
  "dependencies": {
    "@apollo/client": "^3.14.0",
    "@types/react-router-dom": "^5.3.3",
