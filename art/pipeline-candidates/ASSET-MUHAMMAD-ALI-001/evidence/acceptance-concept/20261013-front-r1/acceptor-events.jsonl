\\u0434\\u0440\\u043e\\u0432 **\\u043e\\u0442 \\u043a\\u043e\\u0440\\u043d\\u044f \\u0440\\u0435\\u043f\\u043e\\u0437\\u0438\\u0442\\u043e\\u0440\\u0438\\u044f** (`art/pipeline-candidates/<ASSET_ID>/evidence/acceptance/<YYYYMMDD>-r<N>/frames`; \\u043a\\u0430\\u043b\\u0438\\u0431\\u0440\\u043e\\u0432\\u043a\\u0430 \\u2014 `docs/art-pipeline/evidence/acceptance-calibration-<YYYYMMDD>/<\\u043f\\u0440\\u043e\\u0433\\u043e\\u043d>/frames`, \\u00a712); \\u043a\\u0430\\u0434\\u0440\\u044b \\u0432\\u043e \\u0432\\u0440\\u0435\\u043c\\u0435\\u043d\\u043d\\u043e\\u043c \\u043a\\u0430\\u0442\\u0430\\u043b\\u043e\\u0433\\u0435 \\u0432\\u043d\\u0435 \\u0440\\u0435\\u043f\\u043e\\u0437\\u0438\\u0442\\u043e\\u0440\\u0438\\u044f \\u0432 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0443 \\u043d\\u0435 \\u043f\\u043e\\u043f\\u0430\\u0434\\u0430\\u044e\\u0442 \\u2014 \\u0438\\u0445 \\u0441\\u043d\\u0430\\u0447\\u0430\\u043b\\u0430 \\u0441\\u043d\\u0438\\u043c\\u0430\\u044e\\u0442 \\u0438\\u043b\\u0438 \\u043a\\u043e\\u043f\\u0438\\u0440\\u0443\\u044e\\u0442 \\u0432 `dir`; `files` = `frames.json#files` (\\u043a\\u0430\\u0434\\u0440\\u044b \\u00a73, `frames.json`, `sheet.png`, `tone.json`, \\u0435\\u0441\\u043b\\u0438 \\u0435\\u0441\\u0442\\u044c) |\\n| `reports` | \\u043f\\u0443\\u0442\\u0438 \\u043e\\u0442 \\u043a\\u043e\\u0440\\u043d\\u044f \\u0440\\u0435\\u043f\\u043e\\u0437\\u0438\\u0442\\u043e\\u0440\\u0438\\u044f \\u043a\\u043e \\u0432\\u0441\\u0435\\u043c \\u043e\\u0442\\u0447\\u0451\\u0442\\u0430\\u043c, \\u043d\\u0430 \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0435 \\u0441\\u0441\\u044b\\u043b\\u0430\\u044e\\u0442\\u0441\\u044f \\u0433\\u0435\\u0439\\u0442\\u044b |\\n| `gates` | `{\\\"G-TOPO\\\"\\\\|\\\"G-UV\\\"\\\\|\\\"G-TEX\\\"\\\\|\\\"G-RIG\\\"\\\\|\\\"G-NAMES\\\": {status: PASS\\\\|FAIL\\\\|n/a, source, note, source_defect?}}` \\u2014 \\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u0430 \\u0437\\u0430\\u043f\\u0438\\u0441\\u0438 \\u00a74; \\u0434\\u0440\\u0443\\u0433\\u0438\\u0445 \\u043a\\u043b\\u044e\\u0447\\u0435\\u0439 \\u043d\\u0435\\u0442 |\\n| `scores` | `{\\\"S\\\"\\\\|\\\"F\\\"\\\\|\\\"T\\\"\\\\|\\\"D\\\": {value: 0\\u20262 (\\u0448\\u0430\\u0433 0,5) \\\\| null, rationale: \\\"\\u2026\\\", frames: [\\\"turn-045.jpg\\\", \\u2026]}}`; \\u0438\\u043c\\u0435\\u043d\\u0430 \\u0432 `frames` \\u2014 \\u0438\\u0437 `frames.files` |\\n| `score` | \\u0447\\u0438\\u0441\\u043b\\u043e \\u043f\\u043e \\u0444\\u043e\\u0440\\u043c\\u0443\\u043b\\u0435 \\u00a76, \\u043e\\u043a\\u0440\\u0443\\u0433\\u043b\\u0435\\u043d\\u0438\\u0435 half-up |\\n| `verdict` | `pass` \\\\| `rework_blender` \\\\| `return_to_stage_1` \\\\| `return_to_stage_2` \\\\| `escalate_user` |\\n| `verdict_reason` | \\u043e\\u0431\\u044f\\u0437\\u0430\\u0442\\u0435\\u043b\\u0435\\u043d \\u043f\\u0440\\u0438 \\u043b\\u044e\\u0431\\u043e\\u043c `verdict`, \\u043a\\u0440\\u043e\\u043c\\u0435 `pass` (\\u00a76); \\u0443 `pass` \\u043f\\u043e\\u043b\\u0435 \\u043d\\u0435 \\u043f\\u0438\\u0448\\u0435\\u0442\\u0441\\u044f |\\n| `rework_fix_list` | \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e F, T, D \\u043d\\u0438\\u0436\\u0435 2 \\u0438 FAIL-\\u0433\\u0435\\u0439\\u0442\\u044b (S \\u043d\\u0438\\u043a\\u043e\\u0433\\u0434\\u0430: \\u0432 Blender \\u043d\\u0435 \\u043f\\u0440\\u0430\\u0432\\u0438\\u0442\\u0441\\u044f, \\u0432\\u0430\\u043b\\u0438\\u0434\\u0430\\u0442\\u043e\\u0440 \\u043e\\u0442\\u0432\\u0435\\u0440\\u0433\\u0430\\u0435\\u0442); \\u043f\\u0443\\u043d\\u043a\\u0442 = `{item, frame, fix, tool}`, \\u0434\\u0440\\u0443\\u0433\\u0438\\u0445 \\u043a\\u043b\\u044e\\u0447\\u0435\\u0439 \\u043d\\u0435\\u0442; `item` \\u2014 `F`, `T`, `D` \\u0438\\u043b\\u0438 id \\u0433\\u0435\\u0439\\u0442\\u0430 (`G-UV`). \\u041f\\u0440\\u0438 `rework_blender` \\u2014 \\u043d\\u0435 \\u043f\\u0443\\u0441\\u0442\\u043e\\u0439 \\u0438 \\u043f\\u043e\\u043a\\u0440\\u044b\\u0432\\u0430\\u0435\\u0442 \\u043a\\u0430\\u0436\\u0434\\u044b\\u0439 FAIL-\\u0433\\u0435\\u0439\\u0442, \\u043a\\u