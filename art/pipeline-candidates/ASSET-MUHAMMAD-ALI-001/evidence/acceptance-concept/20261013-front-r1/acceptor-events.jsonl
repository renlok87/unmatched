e\\u0440\\u0430\\u0431\\u043e\\u0442\\u043a\\u0438 \\u0438 \\u044d\\u0442\\u0430\\u043f\\u0430 7 \\u2014 \\u043c\\u0435\\u043b\\u043e\\u0447\\u0438 \\u043d\\u0430 \\u043a\\u0440\\u0443\\u043f\\u043d\\u044b\\u0445 \\u043f\\u043b\\u0430\\u043d\\u0430\\u0445 \\u043f\\u0440\\u0438 pass, \\u043a\\u043b\\u0430\\u0441\\u0441\\u044b `floor` \\u0438\\u0437 `tone.json`, \\u0441\\u043f\\u0440\\u0430\\u0432\\u043e\\u0447\\u043d\\u044b\\u0435 \\u0447\\u0438\\u0441\\u043b\\u0430 \\u0433\\u0435\\u0439\\u0442\\u043e\\u0432 (\\u043f\\u043e\\u0447\\u0442\\u0438 \\u0432\\u044b\\u0440\\u043e\\u0436\\u0434\\u0435\\u043d\\u043d\\u044b\\u0435 \\u0442\\u0440\\u0435\\u0443\\u0433\\u043e\\u043b\\u044c\\u043d\\u0438\\u043a\\u0438), \\u043a\\u0430\\u0441\\u0430\\u043d\\u0438\\u0435 \\u043e\\u0440\\u0443\\u0436\\u0438\\u044f \\u0432 \\u043f\\u043e\\u0437\\u0430\\u0445 \\u043f\\u0440\\u043e\\u0431 (`pose_checks.*_contact`), \\u0442\\u043e\\u043d \\u0431\\u0435\\u0437 `tone.json`, \\u0430 \\u043f\\u0440\\u0438 \\u0432\\u043e\\u0437\\u0432\\u0440\\u0430\\u0442\\u0435 \\u043f\\u043e S \\u2014 \\u0437\\u0430\\u043c\\u0435\\u0447\\u0430\\u043d\\u0438\\u044f F, T, D \\u043d\\u0438\\u0436\\u0435 2,0; `item` \\u2014 \\u0438\\u0437\\u043c\\u0435\\u0440\\u0435\\u043d\\u0438\\u0435 \\u0438\\u043b\\u0438 \\u0433\\u0435\\u0439\\u0442, `frame` \\u2014 \\u0438\\u0437 `frames.files` |\\n| `acceptor` | `{profile: \\\"Opus xhigh\\\" \\\\| \\\"Sol 6.1 xhigh\\\", session_id}`; \\u0441\\u043e\\u043e\\u0442\\u0432\\u0435\\u0442\\u0441\\u0442\\u0432\\u0438\\u0435 \\u043f\\u043e\\u043b\\u044f \\u0437\\u0430\\u044f\\u0432\\u043a\\u0438 `ACCEPTOR_PROFILE` (SKILL.md \\u00a77.2): `opus-xhigh` \\u2192 `\\\"Opus xhigh\\\"`, `sol-6.1-xhigh` \\u2192 `\\\"Sol 6.1 xhigh\\\"`. \\u0423 `card-2.json` \\u0432\\u0442\\u043e\\u0440\\u043e\\u0433\\u043e \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a\\u0430 \\u2014 \\u0434\\u0440\\u0443\\u0433\\u043e\\u0439 \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u044c (\\u00a78.5) |\\n| `