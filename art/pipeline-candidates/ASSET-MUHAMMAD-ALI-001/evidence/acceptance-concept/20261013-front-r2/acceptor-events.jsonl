b\\u043e 1\\u0431 \\u0440\\u0435\\u0448\\u0430\\u0435\\u0442\\u0441\\u044f\\n\\u043e\\u0434\\u043d\\u0438\\u043c \\u0432\\u043e\\u043f\\u0440\\u043e\\u0441\\u043e\\u043c \\u043a \\u043b\\u0438\\u0441\\u0442\\u0443: \\u00ab\\u044d\\u0442\\u043e\\u0442 \\u0434\\u0435\\u0444\\u0435\\u043a\\u0442 (\\u043a\\u043e\\u043d\\u0442\\u0443\\u0440, \\u043f\\u0440\\u043e\\u043f\\u043e\\u0440\\u0446\\u0438\\u044f, \\u044f\\u043a\\u043e\\u0440\\u044c, \\u043f\\u044f\\u0442\\u043d\\u043e \\u0446\\u0432\\u0435\\u0442\\u0430) \\u0435\\u0441\\u0442\\u044c \\u043d\\u0430 \\u043b\\u0438\\u0441\\u0442\\u0435 \\u0432 \\u0442\\u043e\\u043c \\u0436\\u0435 \\u043c\\u0435\\u0441\\u0442\\u0435?\\u00bb \\u0414\\u0430 \\u2014 \\u044d\\u0442\\u0430\\u043f 1;\\n\\u043d\\u0435\\u0442 \\u2014 \\u044d\\u0442\\u0430\\u043f 2. \\u041e\\u0442\\u0432\\u0435\\u0442 \\u0438 \\u0432\\u0438\\u0434 \\u043b\\u0438\\u0441\\u0442\\u0430 \\u043f\\u0438\\u0448\\u0443\\u0442\\u0441\\u044f \\u0432 `verdict_reason`.\\n\\n**`rework_fix_list` \\u043f\\u0440\\u0438 \\u0432\\u043e\\u0437\\u0432\\u0440\\u0430\\u0442\\u0435 \\u043f\\u043e S \\u2014 \\u043f\\u0443\\u0441\\u0442\\u043e\\u0439** (`[]`, \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u044f\\u0435\\u0442 `validate_card.py`): \\u043c\\u043e\\u0434\\u0435\\u043b\\u044c \\u043f\\u0435\\u0440\\u0435\\u0433\\u0435\\u043d\\u0435\\u0440\\u0438\\u0440\\u0443\\u044e\\u0442, \\u043f\\u0443\\u043d\\u043a\\u0442\\u044b\\n\\u0434\\u043e\\u0440\\u0430\\u0431\\u043e\\u0442\\u043a\\u0438 \\u0431\\u0435\\u0441\\u0441\\u043c\\u044b\\u0441\\u043b\\u0435\\u043d\\u043d\\u044b. \\u0417\\u0430\\u043c\\u0435\\u0447\\u0430\\u043d\\u0438\\u044f F, T, D \\u043d\\u0438\\u0436\\u0435 2,0 \\u0437\\u0430\\u043f\\u0438\\u0441\\u044b\\u0432\\u0430\\u044e\\u0442\\u0441\\u044f \\u0432 `known_issues` (\\u043e\\u043d\\u0438 \\u043d\\u0443\\u0436\\u043d\\u044b \\u0441\\u043b\\u0435\\u0434\\u0443\\u044e\\u0449\\u0435\\u043c\\u0443 \\u0446\\u0438\\u043a\\u043b\\u0443 \\u043a\\u0430\\u043a\\n\\u0441\\u043f\\u0438\\u0441\\u043e\\u043a \\u0442\\u043e\\u0433\\u043e, \\u0447\\u0442\\u043e \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u0438\\u0442\\u044c). \\u041f\\u0440\\u0438 \\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u0435 2 (`source_defect`) \\u0441\\u043f\\u0438\\u0441\\u043e\\u043a \\u0442\\u043e\\u0436\\u0435 \\u043c\\u043e\\u0436\\u0435\\u0442 \\u0431\\u044b\\u0442\\u044c \\u043f\\u0443\\u0441\\u0442\\u044b\\u043c.\\n\\n\\u041f\\u0440\\u0430\\u0432\\u0438\\u043b\\u043e 2 \\u0432\\u0430\\u043b\\u0438\\u0434\\u0430\\u0442\\u043e\\u0440 \\u0440\\u0430\\u0437\\u043b\\u0438\\u0447\\u0430\\u0435\\u0442 \\u0441 \\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u043e\\u043c 3 **\\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043f\\u043e \\u0444\\u043b\\u0430\\u0433\\u0443** `gates.<G>.source_defect: true`. \\u0421\\u043b\\u043e\\u0432\\u0435\\u0441\\u043d\\u043e\\u0435 \\u043e\\u043f\\u0438\\u0441\\u0430\\u043d\\u0438\\u0435\\n\\u0434\\u0435\\u0444\\u0435\\u043a\\u0442\\u0430 \\u0431\\u0435\\u0437 \\u0444\\u043b\\u0430\\u0433\\u0430 \\u0434\\u0430\\u0451\\u0442 `rework_blender`, \\u0438 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0430 \\u0441 `return_to_stage_2` \\u043f\\u043e\\u043b\\u0443\\u0447\\u0438\\u0442 \\u043a\\u043e\\u0434 1. \\u0421\\u0430\\u043c \\u0434\\u0435\\u0444\\u0435\\u043a\\u0442 \\u043e\\u043f\\u0438\\u0441\\u044b\\u0432\\u0430\\u0435\\u0442\\u0441\\u044f \\u0432\\n`gates.<G>.note` \\u0438 \\u0432 `verdict_reason`.\\n\\n`verdict_reason` (\\u0441\\u0442\\u0440\\u043e\\u043a\\u0430 \\u2265 10 \\u0441\\u0438\\u043c\\u0432\\u043e\\u043b\\u043e\\u0432) \\u043e\\u0431\\u044f\\u0437\\u0430\\u0442\\u0435\\u043b\\u0435\\u043d \\u043f\\u0440\\u0438 **\\u043b\\u044e\\u0431\\u043e\\u043c** \\u0432\\u0435\\u0440\\u0434\\u0438\\u043a\\u0442\\u0435, \\u043a\\u0440\\u043e\\u043c\\u0435 `pass` (\\u0441\\u0445\\u0435\\u043c\\u0430, `allOf` if/then):\\n\\n- `return_to_stage_1` / `return_to_stage_2` \\u043f\\u043e \\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u0443 1 \\u20