 \\u043f\\u0435\\u0440\\u0435\\u0441\\u043d\\u0438\\u043c\\u0430\\u044e\\u0442\\u0441\\u044f \\u0441\n  \\u0432\\u0435\\u0440\\u043d\\u044b\\u043c \\u0432\\u0445\\u043e\\u0434\\u043e\\u043c, \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a \\u0432\\u044b\\u0437\\u044b\\u0432\\u0430\\u0435\\u0442\\u0441\\u044f \\u0437\\u0430\\u043d\\u043e\\u0432\\u043e. \\u041e\\u0431\\u044b\\u0447\\u043d\\u043e \\u043e\\u0448\\u0438\\u0431\\u043a\\u0443 \\u043b\\u043e\\u0432\\u0438\\u0442 \\u00ab\\u0421\\u0432\\u0435\\u0440\\u043a\\u0430 \\u0432\\u0445\\u043e\\u0434\\u0430\\u00bb \\u0435\\u0449\\u0451 \\u0434\\u043e \\u0432\\u044b\\u0437\\u043e\\u0432\\u0430 \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a\\u0430;\n- **\\u043d\\u0435\\u0433\\u0430\\u0442\\u0438\\u0432\\u043d\\u044b\\u0439 \\u043a\\u043e\\u043d\\u0442\\u0440\\u043e\\u043b\\u044c \\u043a\\u0430\\u043b\\u0438\\u0431\\u0440\\u043e\\u0432\\u043a\\u0438** (\\u00a712) \\u2014 \\u0432\\u0445\\u043e\\u0434 \\u043d\\u0435\\u0432\\u0435\\u0440\\u0435\\u043d \\u043d\\u0430\\u043c\\u0435\\u0440\\u0435\\u043d\\u043d\\u043e: \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0430 \\u0441 `return_to_stage_1` \\u0438\n  `verdict_reason` \\u00ab\\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u043e 1\\u0430: \\u0434\\u0440\\u0443\\u0433\\u043e\\u0439 \\u043f\\u0435\\u0440\\u0441\\u043e\\u043d\\u0430\\u0436 \\u2026 ; \\u0432\\u0445\\u043e\\u0434: \\u043b\\u0438\\u0441\\u0442 \\u043d\\u0430\\u043c\\u0435\\u0440\\u0435\\u043d\\u043d\\u043e \\u0447\\u0443\\u0436\\u043e\\u0439 (\\u043d\\u0435\\u0433\\u0430\\u0442\\u0438\\u0432\\u043d\\u044b\\u0439 \\u043a\\u043e\\u043d\\u0442\\u0440\\u043e\\u043b\\u044c)\\u00bb \\u0437\\u0430\\u043f\\u0438\\u0441\\u044b\\u0432\\u0430\\u0435\\u0442\\u0441\\u044f \\u043a\\u0430\\u043a\n  \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442 \\u043a\\u0430\\u043b\\u0438\\u0431\\u0440\\u043e\\u0432\\u043a\\u0438, \\u043c\\u0430\\u0440\\u0448\\u0440\\u0443\\u0442\\u0430 \\u043d\\u0435\\u0