n**\\u0420\\u0430\\u0437\\u0432\\u0438\\u043b\\u043a\\u0430 \\u0432\\u043e\\u0437\\u0432\\u0440\\u0430\\u0442\\u0430 \\u043f\\u043e S** (\\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u043e\\u0440\\u043a\\u0435\\u0441\\u0442\\u0440\\u0430\\u0442\\u043e\\u0440\\u0430 \\u043f\\u043e \\u043a\\u0430\\u043b\\u0438\\u0431\\u0440\\u043e\\u0432\\u043a\\u0435 2026-10-09, \\u0440\\u0430\\u0443\\u043d\\u0434\\u044b 3\\u20134). \\u041f\\u0440\\u0430\\u0432\\u0438\\u043b\\u043e 1\\u0430: \\u043d\\u0430 \\u043a\\u0430\\u0434\\u0440\\u0430\\u0445 \\u0434\\u0440\\u0443\\u0433\\u043e\\u0439\n\\u043f\\u0435\\u0440\\u0441\\u043e\\u043d\\u0430\\u0436 \\u2014 \\u043e\\u0442\\u0441\\u0443\\u0442\\u0441\\u0442\\u0432\\u0443\\u044e\\u0449\\u0438\\u0445 \\u0438 \\u0434\\u0440\\u0443\\u0433\\u043e\\u0439 \\u0444\\u043e\\u0440\\u043c\\u044b \\u043f\\u043e\\u043b\\u043e\\u0432\\u0438\\u043d\\u0430 `ANCHORS` \\u043b\\u0438\\u0441\\u0442\\u0430 \\u0438 \\u0431\\u043e\\u043b\\u044c\\u0448\\u0435 (\\u00a75.1, \\u0442\\u0435\\u0440\\u043c\\u0438\\u043d\\u044b; \\u0438\\u043b\\u0438 \\u0444\\u0438\\u0433\\u0443\\u0440\\u0430 \\u043d\\u0430 3/4 \\u0438 \\u0441\\u0437\\u0430\\u0434\\u0438 \\u043d\\u0435\n\\u043e\\u043f\\u043e\\u0437\\u043d\\u0430\\u0451\\u0442\\u0441\\u044f). \\u041a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0430 \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a\\u0430 \\u043f\\u0440\\u0438 S = 0 **\\u0432\\u0441\\u0435\\u0433\\u0434\\u0430** \\u043d\\u0435\\u0441\\u0451\\u0442 `return_to_stage_1` (\\u0432\\u0430\\u043b\\u0438\\u0434\\u0430\\u0442\\u043e\\u0440 \\u0434\\u0440\\u0443\\u0433\\u043e\\u0433\\u043e \\u043d\\u0435 \\u043f\\u0440\\u0438\\u043c\\u0435\\u0442) \\u2014 \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a\n\\u0432\\u0445\\u043e\\u0434 \\u043d\\u0435 \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u044f\\u0435\\u0442. \\u0412\\u0445\\u043e\\u0434 \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u044f\\u0435\\u0442 \\u0437\\u0430\\u043f\\u0443\\u0441\\u04