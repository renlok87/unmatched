\u043e\\u0442\\u043e\\u043c\\u0443 \\u0447\\u0442\\u043e \\u0434\\u043e\\u0440\\u0430\\u0431\\u043e\\u0442\\u043a\\u0430 \\u043c\\u043e\\u0434\\u0435\\u043b\\u0438, \\u043a\\u043e\\u0442\\u043e\\u0440\\u0443\\u044e \\u0432\\u0441\\u0451 \\u0440\\u0430\\u0432\\u043d\\u043e\\n\\u043f\\u0435\\u0440\\u0435\\u0433\\u0435\\u043d\\u0435\\u0440\\u0438\\u0440\\u0443\\u044e\\u0442, \\u2014 \\u043f\\u0443\\u0441\\u0442\\u0430\\u044f \\u0442\\u0440\\u0430\\u0442\\u0430 \\u0446\\u0438\\u043a\\u043b\\u0430. \\u0413\\u0440\\u0430\\u043d\\u0438\\u0446\\u0430 5,0 \\u0438 \\u043e\\u0442\\u0434\\u0435\\u043b\\u044c\\u043d\\u044b\\u0439 \\u043f\\u043e\\u0440\\u043e\\u0433 \\u0434\\u043b\\u044f \\u0430\\u0441\\u0441\\u0435\\u0442\\u043e\\u0432 \\u0431\\u0435\\u0437 \\u0440\\u0438\\u0433\\u0430 \\u0443\\u043f\\u0440\\u0430\\u0437\\u0434\\u043d\\u0435\\u043d\\u044b. \\u041f\\u0440\\u0430\\u0432\\u0438\\u043b\\u0430 \\u0438 \\u043f\\u043e\\u0440\\u044f\\u0434\\u043e\\u043a\\n\\u0441\\u043e\\u0432\\u043f\\u0430\\u0434\\u0430\\u044e\\u0442 \\u0441 `compute_verdict` \\u0432 `validate_card.py` \\u0438 \\u0441 `tools/art/acceptance/README.md` \\u00a72.\\n\\n**\\u0423\\u0441\\u0442\\u043e\\u0439\\u0447\\u0438\\u0432\\u044b\\u0439 pass** (\\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u0441\\u043a\\u0438\\u043b\\u043b\\u0430 \\u043f\\u043e \\u043a\\u0430\\u043b\\u0438\\u0431\\u0440\\u043e\\u0432\\u043a\\u0435 2026-10-09; \\u043f\\u043e\\u0440\\u043e\\u0433 8,0 \\u043d\\u0435 \\u043c\\u0435\\u043d\\u044f\\u0435\\u0442\\u0441\\u044f). Medusa, \\u043f\\u0440\\u0438\\u043d\\u044f\\u0442\\u0430\\u044f \\u0432 \\u043f\\u0440\\u043e\\u0435\\u043a\\u0442\\u0435,\\n\\u043d\\u0430\\u0431\\u0440\\u0430\\u043b\\u0430 8,1: \\u0443 \\u0433\\u0435\\u0440\\u043e\\u044f \\u044d\\u0442\\u043e \\u0440\\u043e\\u0432\\u043d\\u043e \\u0442\\u0440\\u0438 \\u043f\\u043e\\u0442\\u0435\\u0440\\u044f\\u043d\\u043d\\u044b\\u0445 \\u043f\\u043e\\u043b\\u0443\\u0448\\u0430\\u0433\\u0430, \\u0438 \\u043e\\u0434\\u0438\\u043d \\u043f\\u043e\\u043b\\u0443\\u0448\\u0430\\u0433 \\u0434\\u0440\\u0443\\u0433\\u043e\\u0433\\u043e \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a\\u0430 (S 1,5 \\u0438\\u043b\\u0438 T 1,0) \\u0434\\u0430\\u0451\\u0442 7,5 \\u0438\\n`rework_blender`. \\u0417\\u0430\\u0449\\u0438\\u0442\\u0430 \\u043e\\u0442 \\u0440\\u0430\\u0437\\u0431\\u0440\\u043e\\u0441\\u0430 \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a\\u043e\\u0432 \\u00b10,5:\\n\\n- `pass` \\u0441\\u043e `score` \\u2265 8,0 \\u0438 < 8,5 (\\u0443 \\u0433\\u0435\\u0440\\u043e\\u044f 8,1, \\u0443 \\u043f\\u0440\\u043e\\u043f\\u0430 8,3, \\u0443 \\u043b\\u0438\\u0441\\u0442\\u0430 \\u043a\\u043e\\u043d\\u0446\\u0435\\u043f\\u0442\\u0430 \\u0438 \\u043a\\u043b\\u0438\\u043f\\u0430 8,1) \\u043e\\u0434\\u043d\\u043e\\u0439 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u043e\\u0439 \\u043d\\u0435\\n  \\u043e\\u043a\\u043e\\u043d\\u0447\\u0430\\u0442\\u0435\\u043b\\u0435\\u043d: `validate_card.py` \\u0434\\u0430\\u0451\\u0442 \\u043a\\u043e\\u0434 **3** \\u0438 \\u043f\\u0435\\u0447\\u0430\\u0442\\u0430\\u0435\\u0442 `needs_second_acceptor`;\\n- \\u0432\\u0442\\u043e\\u0440\\u043e\\u0439 \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a \\u2014 **\\u0434\\u0440\\u0443\\u0433\\u043e\\u0439 \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u044c** (\\u00a71), \\u0442\\u0435 \\u0436\\u0435 \\u043a\\u0430\\u0434\\u0440\\u044b, \\u0442\\u043e\\u0442 \\u0436\\u0435 \\u043f\\u0440\\u043e\\u043c\\u043f\\u0442, \\u043d\\u043e\\u0432\\u044b\\u0439 \\u043a\\u043e\\u043d\\u0442\\u0435\\u043a\\u0441\\u0442; \\u043e\\u043d \\u043d\\u0435 \\u0432\\u0438\\u0434\\u0438\\u0442 \\u043f\\u0435\\u0440\\u0432\\u0443\\u044e \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0443\\n  (\\u00a78.5) \\u0438 \\u043f\\u0438\\u0448\\u0435\\u0442 `card-2.json`;\\n- \\u0438\\u0442\\u043e\\u0433 \\u043f\\u0430\\u0440\\u044b (`validate_card.py card.json --second card-2.json`): `score` \\u2014 \\u043c\\u0438\\u043d\\u0438\\u043c\\u0443\\u043c \\u0434\\u0432\\u0443\\u0445; \\u0432\\u0435\\u0440\\u0434\\u0438\\u043a\\u0442 \\u2014 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0438 \\u0441 \\u043c\\u0435\\u043d\\u044c\\u0448\\u0438\\u043c\\n  `score` (\\u043f\\u0440\\u0438 \\u0440\\u0430\\u0432\\u0435\\u043d\\u0441\\u0442\\u0432\\u0435 \\u2014 \\u0431\\u043e\\u043b\\u0435\\u0435 \\u0441\\u0442\\u0440\\u043e\\u0433\\u0438\\u0439), \\u043d\\u043e \\u0435\\u0441\\u043b\\u0438 \\u0443 \\u0434\\u0440\\u0443\\u0433\\u043e\\u0439 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0438 \\u043c\\u0430\\u0440\\u0448\\u0440\\u0443\\u0442 \\u0441\\u0442\\u0440\\u043e\\u0436\\u0435 (\\u0432\\u043e\\u0437\\u0432\\u0440\\u0430\\u0442, FAIL-\\u0433\\u0435\\u0439\\u0442, \\u0432\\u0435\\u0442\\u043e), \\u043f\\u043e\\u0431\\u0435\\u0436\\u0434\\u0430\\u0435\\u0442\\n  \\u043e\\u043d. \\u041c\\u0430\\u0440\\u0448\\u0440\\u0443\\u0442 \\u0438 `rework_fix_list` \\u0431\\u0435\\u0440\\u0443\\u0442\\u0441\\u044f \\u0438\\u0437 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0438, \\u0434\\u0430\\u0432\\u0448\\u0435\\u0439 \\u0438\\u0442\\u043e\\u0433 (`source_card` \\u0432 `final.json`);\\n- \\u0432\\u0442\\u043e\\u0440\\u043e\\u0439 `pass` \\u0432 \\u0442\\u043e\\u0439 \\u0436\\u0435 \\u043f\\u043e\\u043b\\u043e\\u0441\\u0435 8,0\\u20138,4 \\u2014 \\u0438\\u0442\\u043e\\u0433 `pass` (\\u043c\\u0438\\u043d\\u0438\\u043c\\u0443\\u043c \\u2265 8,0), \\u0442\\u0440\\u0435\\u0442\\u0438\\u0439 \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a \\u043d\\u0435 \\u043d\\u0443\\u0436\\u0435\\u043d;\\n- \\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u043e \\u0434\\u0435\\u0439\\u0441\\u0442\\u0432\\u0443\\u0435\\u0442 \\u0434\\u043b\\u044f **\\u0432\\u0441\\u0435\\u0445** \\u0432\\u0438\\u0434\\u043e\\u0432 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u0435\\u043a \\u2014 `model`, `concept`, `anim` (\\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u043e\\u0440\\u043a\\u0435\\u0441\\u0442\\u0440\\u0430\\u0442\\u043e\\u0440\\u0430 \\u043f\\u043e \\u043a\\u0430\\u043b\\u0438\\u0431\\u0440\\u043e\\u0432\\u043a\\u0435\\n  2026-10-09, \\u0440\\u0430\\u0443\\u043d\\u0434 3: \\u0443 \\u043b\\u0438\\u0441\\u0442\\u0430 \\u0438 \\u043a\\u043b\\u0438\\u043f\\u0430 \\u0442\\u0430 \\u0436\\u0435 \\u0448\\u043a\\u0430\\u043b\\u0430 0\\u20132 \\u0441 \\u0448\\u0430\\u0433\\u043e\\u043c 0,5 \\u0438 \\u0442\\u043e\\u0442 \\u0436\\u0435 \\u0440\\u0430\\u0437\\u0431\\u0440\\u043e\\u0441 \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a\\u043e\\u0432). \\u0412\\u044b\\u0437\\u043e\\u0432 \\u0432\\u0442\\u043e\\u0440\\u043e\\u0433\\u043e\\n  \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a\\u0430 \\u2014 \\u00a78.5; \\u0443 \\u043a\\u043e\\u043d\\u0446\\u0435\\u043f\\u0442\\u0430 \\u0438 \\u043a\\u043b\\u0438\\u043f\\u0430 \\u043c\\u0435\\u043d\\u044f\\u044e\\u0442\\u0441\\u044f \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u0444\\u0430\\u0439\\u043b\\u044b (`references/concept-sheet.md` \\u00a711,\\n  `references/animation-vfx-sfx.md` \\u00a710.5).\\n\\n\\u041d\\u0443\\u043c\\u0435\\u0440\\u0430\\u0446\\u0438\\u044f `r<N>` \\u0441\\u043a\\u0432\\u043e\\u0437\\u043d\\u0430\\u044f \\u0434\\u043b\\u044f \\u043c\\u043e\\u0434\\u0435\\u043b\\u0438 \\u0430\\u0441\\u0441\\u0435\\u0442\\u0430 \\u0438 \\u043d\\u0435 \\u043e\\u0431\\u043d\\u0443\\u043b\\u044f\\u0435\\u0442\\u0441\\u044f \\u043f\\u043e\\u0441\\u043b\\u0435 \\u0432\\u043e\\u0437\\u0432\\u0440\\u0430\\u0442\\u0430 \\u043d\\u0430 \\u044d\\u0442\\u0430\\u043f 1 \\u0438\\u043b\\u0438 2 (\\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u0441\\u043a\\u0438\\u043b\\u043b\\u0430). \\u0412\\u043e\\u0437\\u0432\\u0440\\u0430\\u0442 \\u0442\\u043e\\u0436\\u0435\\n\\u0442\\u0440\\u0430\\u0442\\u0438\\u0442 \\u0446\\u0438\\u043a\\u043b. \\u041f\\u043e\\u044d\\u0442\\u043e\\u043c\\u0443 \\u043f\\u0440\\u0438\\u0451\\u043c\\u043e\\u043a \\u043c\\u043e\\u0434\\u0435\\u043b\\u0438 \\u043d\\u0435 \\u0431\\u043e\\u043b\\u044