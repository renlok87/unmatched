\u0439 \\u0435\\u0441\\u0442\\u044c); \\u043d\\u0430 \\u044d\\u0442\\u0430\\u043f\\u0435 0 \\u2014 \\u0442\\u043e\\u0442 \\u0436\\u0435 \\u0432\\u044b\\u0437\\u043e\\u0432 \\u0431\\u0435\\u0437 `--balance` (\\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043e\\u0441\\u0442\\u0430\\u0442\\u043e\\u043a \\u0412\\u0420-04 \\u043d\\u0430 \\u0432\\u0435\\u0441\\u044c \\u043f\\u043b\\u0430\\u043d). \\u041e\\u0436\\u0438\\u0434\\u0430\\u0435\\u043c\\u043e \\u043d\\u0430 \\u0433\\u0435\\u0440\\u043e\\u044f: \\u0447\\u0435\\u0440\\u043d\\u043e\\u0432\\u0438\\u043a \\u2248 30 (\\u0437\\u0430\\u043c\\u0435\\u0440 \\u0444\\u043e\\u0440\\u043c\\u044b Studio 2026-10-09: \\u0440\\u0435\\u0436\\u0438\\u043c \\u043f\\u043e \\u0443\\u043c\\u043e\\u043b\\u0447\\u0430\\u043d\\u0438\\u044e H3.1 \\u0431\\u0435\\u0437 8K, \\u043d\\u0435 \\u0441\\u043f\\u0438\\u0441\\u044b\\u0432\\u0430\\u043b\\u043e\\u0441\\u044c; \\u0442\\u043e\\u0447\\u043d\\u0430\\u044f \\u0446\\u0435\\u043d\\u0430 \\u2014 \\u0441 \\u043a\\u043d\\u043e\\u043f\\u043a\\u0438 \\u0434\\u043e \\u043a\\u043b\\u0438\\u043a\\u0430) + H2 95 (60 + 30 + 5; 65 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043f\\u0440\\u0438 \\u043d\\u0435\\u0438\\u0437\\u0440\\u0430\\u0441\\u0445\\u043e\\u0434\\u043e\\u0432\\u0430\\u043d\\u043d\\u043e\\u0439 \\u043f\\u0440\\u043e\\u0431\\u0435 8K) | \\u0412\\u0420-\\u0440\\u0435\\u0435\\u0441\\u0442\\u0440 \\u0412\\u0420-04; `references/tripo3d-stages.md` \\u00a73 |\\n| \\u041e\\u043f\\u0438\\u0441\\u0430\\u043d\\u0438\\u0435 \\u0438 \\u0438\\u043c\\u044f \\u0431\\u043e\\u0439\\u0446\\u0430 | `DESCRIPTION`, `ANCHORS`, `FIGHTER_NAME` \\u2014 \\u0438\\u0437 `scraped-data/api/heroes/<slug>.json` \\u0438 \\u044d\\u0442\\u0430\\u043b\\u043e\\u043d\\u043d\\u043e\\u0439 \\u0411\\u0414 (\\u0438\\u043c\\u044f, \\u043e\\u0440\\u0443\\u0436\\u0438\\u0435, \\u043f\\u043e\\u043c\\u043e\\u0449\\u043d\\u0438\\u043a\\u0438) \\u0442\\u0435\\u043a\\u0441\\u0442\\u043e\\u043c; \\u0430\\u0432\\u0430\\u0442\\u0430\\u0440