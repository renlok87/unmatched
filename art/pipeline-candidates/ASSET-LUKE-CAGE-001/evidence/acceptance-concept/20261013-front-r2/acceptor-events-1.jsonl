\u043e \\u043d\\u0430 \\u043a\\u043e\\u043f\\u0438\\u0438 \\u0440\\u0435\\u0435\\u0441\\u0442\\u0440\\u0430 2026-10-09 \\u2014 \\u043d\\u0438 \\u043e\\u0434\\u043d\\u043e\\u0433\\u043e ERROR), \\u00a72 \\u2014\n\\u043f\\u043e\\u0441\\u0442\\u0430\\u043d\\u043e\\u0432\\u043a\\u0430 `<ASSET_DIR>/STOP-RIG-CONTRACT-3.md` \\u0434\\u043b\\u044f \\u0432\\u0435\\u0442\\u043a\\u0438 `non-humanoid` (\\u0433\\u0435\\u0439\\u0442 \\u00a75 \\u043f.1), \\u00a73 \\u2014 `.gitignore` \\u0430\\u0441\\u0441\\u0435\\u0442\\u0430.\n\n## 8. \\u041f\\u0440\\u0430\\u0432\\u0438\\u043b\\u0430 \\u043f\\u0440\\u043e\\u0435\\u043a\\u0442\\u0430\n\n- **\\u041a\\u043e\\u043c\\u043c\\u0438\\u0442** \\u2014 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e `git commit --no-verify` (AGENTS.md \\u00abCommits without hooks\\u00bb), \\u0444\\u0430\\u0439\\u043b\\u044b \\u0434\\u043e\\u0431\\u0430\\u0432\\u043b\\u044f\\u044e\\u0442\\u0441\\u044f \\u0441\\u043f\\u0438\\u0441\\u043a\\u043e\\u043c \\u043f\\u0443\\u0442\\u0435\\u0439\n  (HANDBOOK \\u00a78). \\u0411\\u0435\\u0437 `git add -A`, `stash`, `reset`, `clean`, push. \\u0427\\u0443\\u0436\\u0438\\u0435 \\u043d\\u0435\\u0437\\u0430\\u043a\\u043e\\u043c\\u043c\\u0438\\u0447\\u0435\\u043d\\u043d\\u044b\\u0435 \\u0444\\u0430\\u0439\\u043b\\u044b \\u043d\\u0435 \\u0442\\u0440\\u043e\\u0433\\u0430\\u0442\\u044c. \\u041f\\u0435\\u0440\\u0435\\u0434\n  \\u043a\\u043e\\u043c\\u043c\\u0438\\u0442\\u043e\\u043c \\u0441\\u0432\\u0435\\u0440\\u0438\\u0442\\u044c `git diff` \\u0441 \\u043e\\u0431\\u044a\\u0451\\u043c\\u043e\\u043c \\u0437\\u0430\\u0434\\u0430\\u0447\\u0438: \\u0430\\u0433\\u0435\\u043d\\u0442\\u044b-\\u0438\\u0441\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u0438 \\u0432\\u044b\\u0445\\u043e\\u0434\\u044f\\u0442 \\u0437\\u0430 \\u0440\\u0430\\u043c\\u043a\\u0438.\n- **\\u0418\\u043d\\u0442\\u0435\\u0433\\u0440\\u0430\\u0446\\u0438\\u044f \\u0438\\u0437 worktree** \\u2014 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e `tools/git/safe-integrate.sh <branch>`: \\u0441\\u043d\\u0430\\u0447\\u0430\\u043b\\u0430 \\u0441\\u0443\\u0445\\u043e\\u0439 \\u043f\\u0440\\u043e\\u0433\\u043e\\u043d, \\u043f\\u043e\\u0442\\u043e\\u043c `--apply`.\n  \\u0421\\u043a\\u0440\\u0438\\u043f\\u0442 \\u0442\\u0440\\u0435\\u0431\\u0443\\u0435\\u0442: \\u0432\\u0435\\u0442\\u043a\\u0430 \\u0441\\u043e\\u0434\\u0435\\u0440\\u0436\\u0438\\u0442 \\u0441\\u0432\\u0435\\u0436\\u0438\\u0439 `fix/admin-panel`; \\u0432 \\u043e\\u0441\\u043d\\u043e\\u0432\\u043d\\u043e\\u043c \\u0447\\u0435\\u043a\\u0430\\u0443\\u0442\\u0435 \\u043d\\u0435\\u0442 git-\\u043e\\u043f\\u0435\\u0440\\u0430\\u0446\\u0438\\u0438 \\u0438 staged-\\u0444\\u0430\\u0439\\u043b\\u043e\\u0432;\n  \\u0432\\u0445\\u043e\\u0434\\u044f\\u0449\\u0438\\u0435 \\u0444\\u0430\\u0439\\u043b\\u044b \\u0442\\u0430\\u043c \\u0431\\u0435\\u0437 \\u043d\\u0435\\u0437\\u0430\\u043a\\u043e\\u043c\\u043c\\u0438\\u0447\\u0435\\u043d\\u043d\\u044b\\u0445 \\u043f\\u0440\\u0430\\u0432\\u043e\\u043a; \\u043f\\u0440\\u0438 \\u0438\\u0437\\u043c\\u0435\\u043d\\u0435\\u043d\\u0438\\u044f\\u0445 \\u0432 `unreal/` \\u043d\\u0435 \\u0437\\u0430\\u043f\\u0443\\u0449\\u0435\\u043d\\u044b UnrealEditor, UBT \\u0438 \\u043a\\u043b\\u0438\\u0435\\u043d\\u0442\n  \\u043e\\u0441\\u043d\\u043e\\u0432\\u043d\\u043e\\u0433\\u043e \\u0447\\u0435\\u043a\\u0430\\u0443\\u0442\\u0430 (`safe-integrate.sh:53-57`) \\u2014 \\u0442\\u043e \\u0435\\u0441\\u0442\\u044c \\u0440\\u0435\\u0434\\u0430\\u043a\\u0442\\u043e\\u0440 \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044f \\u0437\\u0430\\u043a\\u0440\\u044b\\u0442 (\\u0433\\u0435\\u0439\\u0442 \\u00a75 \\u043f.7). \\u0417\\u0430\\u0442\\u0435\\u043c \\u0432 \\u043e\\u0441\\u043d\\u043e\\u0432\\u043d\\u043e\\u043c\n  \\u0447\\u0435\\u043a\\u0430\\u0443\\u0442\\u0435 \\u043f\\u0435\\u0440\\u0435\\u0441\\u043e\\u0431\\u0440\\u0430\\u0442\\u044c UnmatchedEditor (\\u043a\\u043e\\u043c\\u0430\\u043d\\u0434\\u0443 \\u043f\\u0435\\u0447\\u0430\\u0442\\u0430\\u0435\\u0442 \\u0441\\u043a\\u0440\\u0438\\u043f\\u0442) \\u0438 \\u0432\\u044b\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u044c\n  `tools/s08/sync-staged-build.ps1 -From <worktree>` \\u0431\\u0435\\u0437 \\u043f\\u043e\\u0432\\u0442\\u043e\\u0440\\u043d\\u043e\\u0439 \\u0443\\u043f\\u0430\\u043a\\u043e\\u0432\\u043a\\u0438.\n- **\\u041e\\u0434\\u043d\\u0430 \\u0443\\u043f\\u0430\\u043a\\u043e\\u0432\\u043a\\u0430 \\u043d\\u0430 \\u0438\\u0437\\u043c\\u0435\\u043d\\u0435\\u043d\\u0438\\u0435** (AGENTS.md \\u00abIteration speed\\u00bb, \\u043b\\u043e\\u0432\\u0443\\u0448\\u043a\\u0430 \\u043d\\u043e\\u0432\\u043e\\u0433\\u043e `Config/**.json` \\u2014 \\u044d\\u0442\\u0430\\u043f 7b \\u043f.3).\n- **\\u0420\\u0435\\u0436\\u0438\\u043c.** \\u041d\\u043e\\u0432\\u044b\\u0439 \\u0430\\u0441\\u0441\\u0435\\u0442 \\u2014 \\u043f\\u043e\\u043b\\u043d\\u044b\\u0439 \\u0440\\u0435\\u0436\\u0438\\u043c; \\u0440\\u0435\\u0432\\u044c\\u044e = \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a \\u044d\\u0442\\u0430\\u043f\\u043e\\u0432 1/4/6. \\u041d\\u043e\\u0432\\u044b\\u0435 \\u043c\\u0435\\u0448\\u0438 \\u0438 \\u043c\\u0430\\u0442\\u0435\\u0440\\u0438\\u0430\\u043b\\u044b \\u0442\\u0440\\u0435\\u0431\\u0443\\u044e\\u0442 \\u0437\\u0430\\u043c\\u0435\\u0440\\u0430 \\u0446\\u0435\\u043d\\u044b\n  (AGENTS.md \\u00abIteration speed\\u00bb): \\u0440\\u043e\\u0432\\u043d\\u043e \\u043e\\u0434\\u0438\\u043d \\u043f\\u0440\\u043e\\u0433\\u043e\\u043d `render_bench.py` \\u043d\\u0430 \\u0448\\u0430\\u0433\\u0435 7b \\u043f\\u043e\\u0441\\u043b\\u0435 \\u0443\\u043f\\u0430\\u043a\\u043e\\u0432\\u043a\\u0438, \\u043d\\u0430 \\u0432\\u0430\\u0440\\u0438\\u0430\\u043d\\u0442\\u0435 \\u0444\\u0438\\u043a\\u0441\\u0442\\u0443\\u0440\\u044b \\u0441\n  \\u043d\\u043e\\u0432\\u044b\\u043c \\u0431\\u043e\\u0439\\u0446\\u043e\\u043c (\\u043a\\u043e\\u043c\\u0430\\u043d\\u0434\\u0430 \\u2014 `references/ue-import-package.md` \\u00a76.5). \\u0427\\u0438\\u0441\\u043b\\u043e \\u0437\\u0430\\u043f\\u0438\\u0441\\u0430\\u0442\\u044c \\u0432 evidence; \\u043f\\u0440\\u0430\\u0432\\u0438\\u0442\\u044c \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e\n  \\u043f\\u0440\\u0435\\u0432\\u044b\\u0448\\u0435\\u043d\\u0438\\u0435 \\u043f\\u043e\\u0440\\u043e\\u0433\\u0430 (ACC-022 60 FPS) \\u0438\\u043b\\u0438 \\u043f\\u043e\\u043b\\u043e\\u043c\\u043a\\u0443, \\u043e\\u043f\\u0442\\u0438\\u043c\\u0438\\u0437\\u0430\\u0446\\u0438\\u0438 \\u0432 \\u043f\\u0440\\u0435\\u0434\\u0435\\u043b\\u0430\\u0445 \\u0431\\u044e\\u0434\\u0436\\u0435\\u0442\\u0430 \\u0437\\u0430\\u043f\\u0440\\u0435\\u0449\\u0435\\u043d\\u044b, \\u043f\\u043e\\u0432\\u0442\\u043e\\u0440\\u043d\\u044b\\u0445 \\u0431\\u0435\\u043d\\u0447\\u0435\\u0439 \\u043d\\u0435\\u0442.\n  \\u041f\\u0440\\u0430\\u0432\\u043a\\u0430 \\u043e\\u0434\\u043d\\u043e\\u0433\\u043e \\u043f\\u0430\\u0440\\u0430\\u043c\\u0435\\u0442\\u0440\\u0430 \\u043f\\u043e\\u0441\\u043b\\u0435 \\u043f\\u0440\\u0438\\u0451\\u043c\\u043a\\u0438 \\u2014 \\u043b\\u0451\\u0433\\u043a\\u0438\\u0439 \\u0440\\u0435\\u0436\\u0438\\u043c, \\u0431\\u0435\\u0437 \\u0431\\u0435\\u043d\\u0447\\u0430.\n- **\\u0421\\u043c\\u043e\\u0442\\u0440\\u0435\\u0442\\u044c \\u043a\\u0430\\u0434\\u0440 \\u043f\\u0435\\u0440\\u0435\\u0434 \\u043e\\u0442\\u0447\\u0451\\u0442\\u043e\\u043c:** \\u043e\\u0442\\u043a\\u0440\\u044b\\u0442\\u044c PNG \\u0438 \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u0438\\u0442\\u044c \\u0440\\u0435\\u0430\\u043b\\u044c\\u043d\\u0443\\u044e \\u0434\\u043e\\u0441\\u043a\\u0443, \\u0432\\u0435\\u0440\\u043d\\u044b\\u0439 \\u0437\\u0430\\u0434\\u043d\\u0438\\u043a \\u0438 v2-\\u0444\\u0438\\u0433\\u0443\\u0440\\u044b (AGENTS.md\n  \\u00abLook before you report\\u00bb).\n- **\\u041f\\u0440\\u043e\\u0446\\u0435\\u0441\\u0441\\u044b:** \\u0441\\u0432\\u043e\\u0438 Blender headless, \\u0441\\u043a\\u0440\\u0438\\u043f\\u0442\\u044b \\u0438 \\u043a\\u043b\\u0438\\u0435\\u043d\\u0442\\u044b \\u043e\\u0441\\u0442\\u0430\\u043d\\u0430\\u0432\\u043b\\u0438\\u0432\\u0430\\u0442\\u044c \\u043f\\u043e PID \\u043f\\u043e\\u0441\\u043b\\u0435 \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043a\\u0438 \\u043a\\u043e\\u043c\\u0430\\u043d\\u0434\\u043d\\u043e\\u0439 \\u0441\\u0442\\u0440\\u043e\\u043a\\u0438.\n  \\u0420\\u0435\\u0434\\u0430\\u043a\\u0442\\u043e\\u0440 UE \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044f \\u043d\\u0435 \\u0437\\u0430\\u043a\\u0440\\u044b\\u0432\\u0430\\u0442\\u044c \\u0431\\u0435\\u0437 \\u0435\\u0433\\u043e \\u0441\\u043b\\u043e\\u0432\\u0430 (\\u00a75 \\u043f.7), \\u0436\\u0438\\u0432\\u043e\\u0439 Blender \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044f \\u043d\\u0435 \\u0437\\u0430\\u043a\\u0440\\u044b\\u0432\\u0430\\u0442\\u044c.\n- **\\u0421\\u0442\\u0430\\u0442\\u0443\\u0441\\u044b:** \\u0438\\u0441\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u044c \\u0441\\u0442\\u0430\\u0432\\u0438\\u0442 \\u043c\\u0430\\u043a\\u0441\\u0438\\u043c\\u0443\\u043c \\u00ab\\u0442\\u0435\\u0445\\u043d\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438 \\u0438\\u043c\\u043f\\u043e\\u0440\\u0442\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u043e\\u00bb (HANDBOOK \\u00a70 \\u043f.3). Pass \\u043f\\u0440\\u0438\\u0451\\u043c\\u043a\\u0438 \\u043f\\u0438\\u0448\\u0435\\u0442\\u0441\\u044f \\u0432\n  \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0443 \\u043a\\u0430\\u043a \\u00ab\\u0445\\u0443\\u0434\\u043e\\u0436\\u0435\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u043e \\u043f\\u0440\\u0438\\u043d\\u044f\\u0442\\u043e, \\u043f\\u043e \\u0434\\u0435\\u043b\\u0435\\u0433\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044e\\u00bb. \\u0421\\u0442\\u0430\\u0442\\u0443\\u0441 \\u0440\\u0435\\u0435\\u0441\\u0442\\u0440\\u0430 \\u00ab\\u0445\\u0443\\u0434\\u043e\\u0436\\u0435\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u043e \\u043f\\u0440\\u0438\\u043d\\u044f\\u0442\\u043e\\u00bb \\u0442\\u0440\\u0435\\u0431\\u0443\\u0435\\u0442 \\u0430\\u043a\\u0442\\u0430\n  `docs/game-design/evidence/(ART|GD)-NNN/\\u2026` (\\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u043e `validate_registry.py`).\n\n## 9. Evidence \\u0438 \\u0440\\u0435\\u0435\\u0441\\u0442\\u0440\\u044b\n\n```\nart/pipeline-candidates/<ASSET_ID>/\n  .gitignore                     # \\u044d\\u0442\\u0430\\u043f 0 (references/intake-and-evidence.md \\u00a73)\n  asset-card.yaml\n  source-specs/tripo-<task8>-h2.json   # \\u044d\\u0442\\u0430\\u043f 2 \\u0433\\u0435\\u0440\\u043e\\u044f; \\u0447\\u0435\\u0440\\u043d\\u043e\\u0432\\u0438\\u043a \\u2014 tripo-<task8>-draft.json, \\u043f\\u0440\\u043e\\u043f \\u2014 tripo-<task8>.json\n  build-profiles/<key>-h2-bake-h2.json, <key>-h2-lookdev.json, <key>-h2-lookdev-teamaccent.json,\n                 <key>-h2anim.json, <key>-h2ld-lookdev-ue-import.json      # \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043d\\u043e\\u0432\\u044b\\u0435 \\u0444\\u0430\\u0439\\u043b\\u044b; \\u0434\\u043e\\u0440\\u0430\\u0431\\u043e\\u0442\\u043a\\u0430 \\u2014 \\u2026-r<N>.json\n  <YYYYMMDD>-draft-tripo/{generation-request,source,orthos,reports}/   # \\u0448\\u0430\\u0433 1b (\\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u0441\\u043a\\u0438\\u043b\\u043b\\u0430)\n  <YYYYMMDD>-h2-tripo/  <YYYYMMDD>-prop-tripo/                         # \\u044d\\u0442\\u0430\\u043f 2 (references/tripo3d-stages.md \\u00a77)\n  <YYYYMMDD>-h2-bake[-r<N>]/  <YYYYMMDD>-h2-lookdev[-r<N>]/  <YYYYMMDD>-h2anim/          # \\u044d\\u0442\\u0430\\u043f\\u044b 3, 5, 6\n  <YYYYMMDD>-prop-build[-r<N>]/{reports,export,preview}/   # \\u044d\\u0442\\u0430\\u043f 3 \\u043f\\u0440\\u043e\\u043f\\u0430 (HANDBOOK \\u00a75, \\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u0441\\u043a\\u0438\\u043b\\u043b\\u0430 \\u043f\\u043e \\u0438\\u043c\\u0435\\u043d\\u0438)\n  <YYYYMMDD>-h2ld-ue-import/  <YYYYMMDD>-h2ld-ldc-ue/{review-config.json, review/}       # \\u044d\\u0442\\u0430\\u043f 7\n  evidence/acceptance-concept/<YYYYMMDD>-<front|sheet>-r<N>/card.json   # \\u044d\\u0442\\u0430\\u043f 1 (\\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u0441\\u043a\\u0438\\u043b\\u043b\\u0430)\n  evidence/acceptance/<YYYYMMDD>-r<N>/{card.json, card-2.json?, final.json?, acceptor-prompt.md, frames/}   # \\u044d\\u0442\\u0430\\u043f 4\n  evidence/acceptance-anim/<YYYYMMDD>-r<N>/<Clip>/{card.json, frames/}          # \\u044d\\u0442\\u0430\\u043f 6\nart/imagegen/concept-<key>-codex/                     # \\u043f\\u0430\\u043a\\u0435\\u0442 Codex (07 \\u00a71.1)\ndocs/game-design/visual/06-tasks/prompts/<ASSET_ID>-concept.codex.md, <ASSET_ID>-concept-views.codex.md\ndocs/art-pipeline/evidence/<key>-<YYYYMMDD>/          # evidence \\u044d\\u0442\\u0430\\u043f\\u0430 7 (references/ue-import-package.md \\u00a76.4)\n```\n\n`.gitignore` \\u0430\\u0441\\u0441\\u0435\\u0442\\u0430 \\u2014 \\u0448\\u0430\\u0431\\u043b\\u043e\\u043d `references/intake-and-evidence.md` \\u00a73 (\\u0433\\u0435\\u043d\\u0435\\u0440\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438\\u0439 `h2_bake` \\u043a\\u043b\\u0430\\u0434\\u0451\\u0442 4K-\\u043c\\u0430\\u0441\\u0442\\u0435\\u0440\\u0430 \\u043f\\u0440\\u044f\\u043c\\u043e \\u0432\n`textures/` \\u0431\\u0435\\u0437 \\u0441\\u0443\\u0444\\u0444\\u0438\\u043a\\u0441\\u0430, \\u0440\\u043e\\u0434\\u0438\\u0442\\u0435\\u043b\\u044c\\u0441\\u043a\\u0438\\u0439 `art/pipeline-candidates/.gitignore` \\u0438\\u0445 \\u043d\\u0435 \\u043b\\u043e\\u0432\\u0438\\u0442). \\u0412 git \\u0438\\u0434\\u0443\\u0442 2K-\\u043d\\u0430\\u0431\\u043e\\u0440, MatID 4K\n\\u0438 LUT, \\u043a\\u0430\\u043a \\u0443 Medusa; \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043a\\u0430 \\u043f\\u043e\\u0441\\u043b\\u0435 \\u043f\\u0435\\u0440\\u0432\\u043e\\u0433\\u043e \\u043f\\u0440\\u043e\\u0433\\u043e\\u043d\\u0430 \\u044d\\u0442\\u0430\\u043f\\u0430 3 \\u2014 `git check-ignore -v` \\u0434\\u043b\\u044f 4K-\\u043c\\u0430\\u0441\\u0442\\u0435\\u0440\\u0430 \\u0438 2K-\\u043a\\u0430\\u0440\\u0442\\u044b.\n\n\\u0421\\u044b\\u0440\\u044b\\u0435 GLB \\u0438 4K-\\u043c\\u0430\\u0441\\u0442\\u0435\\u0440\\u0430 \\u2014 \\u043b\\u043e\\u043a\\u0430\\u043b\\u044c\\u043d\\u043e, sha256 \\u0432 source-spec \\u0438 \\u043e\\u0442\\u0447\\u0451\\u0442\\u0430\\u0445; \\u043a\\u0430\\u0434\\u0440\\u044b \\u2014 JPEG 1200 px q92 (HANDBOOK \\u00a78).\n\\u0420\\u0435\\u0435\\u0441\\u0442\\u0440\\u043e\\u0432 \\u0434\\u0432\\u0430, \\u0438 \\u043e\\u043d\\u0438 \\u0440\\u0430\\u0437\\u0432\\u0435\\u0434\\u0435\\u043d\\u044b. `docs/art-pipeline/asset-registry.json` \\u0432\\u0435\\u0434\\u0451\\u0442\\u0441\\u044f \\u0441 \\u044d\\u0442\\u0430\\u043f\\u0430 0 \\u0438 \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u044f\\u0435\\u0442\\u0441\\u044f\n`validate_registry.py`. `docs/game-design/visual/03-asset-registry.csv` \\u043f\\u043e\\u043b\\u0443\\u0447\\u0430\\u0435\\u0442 \\u0441\\u0442\\u0440\\u043e\\u043a\\u0443 \\u043d\\u0430 \\u044d\\u0442\\u0430\\u043f\\u0435 7. \\u0416\\u0443\\u0440\\u043d\\u0430\\u043b \\u0442\\u0440\\u0430\\u0442 \\u2014\n`docs/game-design/visual/credits-ledger.json` (\\u0441\\u0442\\u0430\\u0440\\u044b\\u0435 \\u0436\\u0443\\u0440\\u043d\\u0430\\u043b\\u044b \\u043d\\u0435 \\u043f\\u043e\\u043f\\u043e\\u043b\\u043d\\u044f\\u0442\\u044c, `07-prompt-templates.md` \\u00a74.1).\n\n## 10. \\u0421\\u043f\\u0440\\u0430\\u0432\\u043e\\u0447\\u043d\\u0438\\u043a\\u0438\n\n| \\u0424\\u0430\\u0439\\u043b | \\u042d\\u0442\\u0430\\u043f\\u044b | \\u0427\\u0442\\u043e \\u0432\\u043d\\u0443\\u0442\\u0440\\u0438 |\n|---|---|---|\n| `references/concept-sheet.md` | 1 | \\u043f\\u0440\\u043e\\u043c\\u043f\\u0442-\\u043f\\u0430\\u043a 1a/1c, \\u0441\\u0435\\u0442\\u043a\\u0430 \\u0438 \\u0434\\u043e\\u043f\\u0443\\u0441\\u043a\\u0438, \\u0441\\u043b\\u043e\\u0442\\u044b \\u0432\\u0438\\u0434\\u043e\\u0432, \\u0440\\u0435\\u0442\\u0440\\u0430\\u0438, `prompts.md` |\n| `references/tripo3d-stages.md` | 1b, 2 | 12 \\u0438\\u043d\\u0441\\u0442\\u0440\\u0443\\u043c\\u0435\\u043d\\u0442\\u043e\\u