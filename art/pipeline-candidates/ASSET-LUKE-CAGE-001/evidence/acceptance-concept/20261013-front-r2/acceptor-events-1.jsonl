44b\\u0439 \\u0433\\u0435\\u0440\\u043e\\u0439 / \\u043f\\u043e\\u043c\\u043e\\u0449\\u043d\\u0438\\u043a / \\u0441\\u0443\\u0449\\u0435\\u0441\\u0442\\u0432\\u043e / \\u043f\\u0440\\u043e\\u043f\\u00bb, \\u00ab\\u043d\\u043e\\u0432\\u0430\\u044f \\u0444\\u0438\\u0433\\u0443\\u0440\\u0430\\u00bb, \\u00ab3D model pipeline\\u00bb, \\u00ab\\u043c\\u043e\\u0434\\u0435\\u043b\\u044c \\u0447\\u0435\\u0440\\u0435\\u0437 Tripo\\u00bb, \\u00ab\\u043a\\u043e\\u043d\\u0446\\u0435\\u043f\\u0442-\\u043b\\u0438\\u0441\\u0442 \\u0433\\u0435\\u0440\\u043e\\u044f\\u00bb. \\u0421\\u0442\\u0430\\u0442\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438\\u0439 \\u043f\\u0440\\u043e\\u043f (\\u0431\\u043e\\u0447\\u043a\\u0430, \\u0444\\u043e\\u043d\\u0430\\u0440\\u044c, \\u044f\\u0449\\u0438\\u043a) \\u2014 \\u0434\\u0430, \\u0434\\u043e \\u0438\\u043c\\u043f\\u043e\\u0440\\u0442\\u0430 \\u0432 UE; \\u0435\\u0433\\u043e \\u0440\\u0430\\u0437\\u043c\\u0435\\u0449\\u0435\\u043d\\u0438\\u0435 \\u0432 \\u0440\\u0430\\u0441\\u043a\\u043b\\u0430\\u0434\\u043a\\u0435 \\u0434\\u043e\\u0441\\u043a\\u0438 \\u2014 \\u043d\\u0435\\u0442. \\u041d\\u0415 \\u0434\\u043b\\u044f \\u043e\\u043a\\u0440\\u0443\\u0436\\u0435\\u043d\\u0438\\u044f, \\u0437\\u0430\\u0434\\u043d\\u0438\\u043a\\u043e\\u0432 \\u0438 \\u0441\\u0446\\u0435\\u043d \\u0434\\u043e\\u0441\\u043e\\u043a \\u0438 \\u0440\\u0430\\u0437\\u043c\\u0435\\u0449\\u0435\\u043d\\u0438\\u044f \\u043f\\u0440\\u043e\\u043f\\u043e\\u0432 \\u0432 EnvLayouts (Marmoreal/Sarpedon \\u2014 \\u0442\\u0440\\u0435\\u043a ENV-MAPS) \\u0438 \\u041d\\u0415 \\u0434\\u043b\\u044f \\u0440\\u0430\\u0437\\u043e\\u0432\\u044b\\u0445 \\u043f\\u0440\\u0430\\u0432\\u043e\\u043a \\u0441\\u0443\\u0449\\u0435\\u0441\\u0442\\u0432\\u0443\\u044e\\u0449\\u0438\\u0445 \\u0430\\u0441\\u0441\\u0435\\u0442\\u043e\\u0432.\n---\n\n# 3d-model-pipeline\n\n\\u042d\\u0442\\u043e\\u0442 \\u0444\\u0430\\u0439\\u043b \\u2014 \\u043d\\u0430\\u0432\\u0438\\u0433\\u0430\\u0446\\u0438\\u044f \\u0438 \\u043e\\u0440\\u043a\\u0435\\u0441\\u0442\\u0440\\u0430\\u0446\\u0438\\u044f. \\u0414\\u0435\\u0442\\u0430\\u043b\\u0438 \\u043b\\u0435\\u0436\\u0430\\u0442 \\u0432 `references/` \\u0438 \\u043e\\u0442\\u043a\\u0440\\u044b\\u0432\\u0430\\u044e\\u0442\\u0441\\u044f \\u043d\\u0430 \\u0441\\u0432\\u043e\\u0451\\u043c \\u044d\\u0442\\u0430\\u043f\\u0435. \\u041d\\u043e\\u0440\\u043c\\u0430 \\u043f\\u0440\\u043e\\u0438\\u0437\\u0432\\u043e\\u0434\\u0441\\u0442\\u0432\\u0430\n\\u0433\\u0435\\u0440\\u043e\\u044f \\u0438 \\u043f\\u0440\\u043e\\u043f\\u0430 \\u2014 `docs/art-pipeline/BLENDER-MODEL-HANDBOOK.md` (\\u0434\\u0430\\u043b\\u0435\\u0435 HANDBOOK). \\u041e\\u043d \\u0433\\u043b\\u0430\\u0432\\u043d\\u0435\\u0435 \\u0441\\u043a\\u0438\\u043b\\u043b\\u0430, \\u0430 \\u0441\\u043a\\u0438\\u043b\\u043b \\u0435\\u0433\\u043e \\u0447\\u0438\\u0441\\u043b\\u0430\n\\u043d\\u0435 \\u043a\\u043e\\u043f\\u0438\\u0440\\u0443\\u0435\\u0442. \\u041f\\u043e\\u043c\\u0435\\u0442\\u043a\\u0430 \\u00ab\\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u0441\\u043a\\u0438\\u043b\\u043b\\u0430\\u00bb \\u043e\\u0437\\u043d\\u0430\\u0447\\u0430\\u0435\\u0442, \\u0447\\u0442\\u043e \\u0438\\u0441\\u0442\\u043e\\u0447\\u043d\\u0438\\u043a\\u0430 \\u0432 \\u0440\\u0435\\u043f\\u043e \\u043d\\u0435\\u0442 \\u0438 \\u0437\\u043d\\u0430\\u0447\\u0435\\u043d\\u0438\\u0435 \\u0432\\u044b\\u0431\\u0440\\u0430\\u043d\\u043e \\u0437\\u0434\\u0435\\u0441\\u044c \\u043f\\u043e \\u0434\\u0435\\u043b\\u0435\\u0433\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044e\n(`docs/game-design/decisions/2026-10-06-visual-delegated-decisions.md`, \\u0434\\u0430\\u043b\\u0435\\u0435 \\u00ab\\u0412\\u0420-\\u0440\\u0435\\u0435\\u0441\\u0442\\u0440\\u00bb).\n\n## 1. \\u041a\\u043e\\u0433\\u0434\\u0430 \\u0438\\u0441\\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u044c\n\n- **\\u0414\\u0430:** \\u043d\\u043e\\u0432\\u0430\\u044f \\u0444\\u0438\\u0433\\u0443\\u0440\\u0430 \\u0434\\u043b\\u044f \\u0438\\u0433\\u0440\\u044b, \\u043e\\u0442 \\u0437\\u0430\\u044f\\u0432\\u043a\\u0438 \\u0434\\u043e `/Game/PipelineCandidates/<Key>/` \\u0438 \\u043a\\u0430\\u0434\\u0440\\u043e\\u0432 \\u0432 packaged-\\u043a\\u043b\\u0438\\u0435\\u043d\\u0442\\u0435. \\u041d\\u043e\\u0432\\u044b\\u0439\n  \\u0441\\u0442\\u0430\\u0442\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438\\u0439 \\u043f\\u0440\\u043e\\u043f (\\u0431\\u043e\\u0447\\u043a\\u0430, \\u0444\\u043e\\u043d\\u0430\\u0440\\u044c, \\u044f\\u0449\\u0438\\u043a, \\u0434\\u0435\\u043a\\u043e\\u0440 \\u2014 HANDBOOK \\u00a71, \\u0441\\u0442\\u0440\\u043e\\u043a\\u0430 \\u00ab\\u0421\\u0442\\u0430\\u0442\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438\\u0439 \\u043f\\u0440\\u043e\\u043f\\u0441\\u00bb) \\u2014 \\u044d\\u0442\\u0438\\u043c \\u0441\\u043a\\u0438\\u043b\\u043b\\u043e\\u043c \\u0434\\u043e \\u0438\\u043c\\u043f\\u043e\\u0440\\u0442\\u0430 \\u0432\n  UE (\\u0432\\u0435\\u0442\\u043a\\u0430 `prop`, \\u00a73; `references/ue-import-package.md` \\u00a78).\n  \\u0417\\u0430\\u043f\\u0443\\u0441\\u043a \\u0441\\u043a\\u0438\\u043b\\u043b\\u0430 \\u0437\\u0430\\u044f\\u0432\\u043a\\u043e\\u0439 \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044f \\u0441\\u0447\\u0438\\u0442\\u0430\\u0435\\u0442\\u0441\\u044f \\u0441\\u043e\\u0433\\u043b\\u0430\\u0441\\u0438\\u0435\\u043c \\u043d\\u0430 Workflow-\\u0430\\u0433\\u0435\\u043d\\u0442\\u043e\\u0432 \\u043f\\u0440\\u0438\\u0451\\u043c\\u043a\\u0438 \\u0438 \\u0434\\u043e\\u0440\\u0430\\u0431\\u043e\\u0442\\u043a\\u0438 (\\u00a74) \\u0438 \\u0440\\u0430\\u0437\\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435\\u043c\n  \\u0442\\u0440\\u0430\\u0442\\u0438\\u0442\\u044c \\u043a\\u0440\\u0435\\u0434\\u0438\\u0442\\u044b Tripo \\u0438 SYNTX \\u0432 \\u043b\\u0438\\u043c\\u0438\\u0442\\u0435 \\u0412\\u0420-04 \\u0441 \\u0437\\u0430\\u043f\\u0438\\u0441\\u044c\\u044e \\u0432 \\u0436\\u0443\\u0440\\u043d\\u0430\\u043b (\\u00a77.1, \\u0441\\u0442\\u0440\\u043e\\u043a\\u0430 \\u00ab\\u041a\\u0440\\u0435\\u0434\\u0438\\u0442\\u044b\\u00bb). \\u041e\\u0442\\u0434\\u0435\\u043b\\u044c\\u043d\\u043e \\u043e \\u0442\\u0440\\u0430\\u0442\\u0430\\u0445 \\u043d\\u0435\n  \\u0441\\u043f\\u0440\\u0430\\u0448\\u0438\\u0432\\u0430\\u0442\\u044c: \\u0442\\u0430\\u043a\\u043e\\u0433\\u043e \\u0433\\u0435\\u0439\\u0442\\u0430 \\u0432 \\u00a75 \\u043d\\u0435\\u0442.\n- **\\u041d\\u0435\\u0442:** \\u043e\\u043a\\u0440\\u0443\\u0436\\u0435\\u043d\\u0438\\u0435, \\u0437\\u0430\\u0434\\u043d\\u0438\\u043a, \\u0441\\u0446\\u0435\\u043d\\u044b \\u0434\\u043e\\u0441\\u043e\\u043a \\u0438 \\u0440\\u0430\\u0437\\u043c\\u0435\\u0449\\u0435\\u043d\\u0438\\u0435 \\u043f\\u0440\\u043e\\u043f\\u043e\\u0432 \\u0432 `EnvLayouts` \\u2014 \\u043e\\u0442\\u0434\\u0435\\u043b\\u044c\\u043d\\u044b\\u0439 \\u0442\\u0440\\u0435\\u043a ENV-MAPS (AGENTS.md\n  \\u00abBoard scenes and heroes\\u00bb, HANDBOOK \\u00a71 \\u00ab\\u041e\\u043a\\u0440\\u0443\\u0436\\u0435\\u043d\\u0438\\u0435/\\u043a\\u0430\\u0440\\u0442\\u044b\\u00bb). \\u041d\\u0435 \\u0434\\u043b\\u044f \\u0440\\u0430\\u0437\\u043e\\u0432\\u044b\\u0445 \\u043f\\u0440\\u0430\\u0432\\u043e\\u043a \\u0433\\u043e\\u0442\\u043e\\u0432\\u043e\\u0433\\u043e \\u0430\\u0441\\u0441\\u0435\\u0442\\u0430: \\u043f\\u0435\\u0440\\u0435\\u043a\\u0440\\u0430\\u0441\\u043a\\u0430 MI, \\u0437\\u0430\\u043c\\u0435\\u043d\\u0430 \\u0442\\u0435\\u043a\\u0441\\u0442\\u0443\\u0440\\u044b,\n  \\u043f\\u0440\\u0430\\u0432\\u043a\\u0430 \\u043e\\u0434\\u043d\\u043e\\u0433\\u043e \\u043a\\u043b\\u0438\\u043f\\u0430. \\u041e\\u043d\\u0438 \\u0438\\u0434\\u0443\\u0442 \\u043e\\u0431\\u044b\\u0447\\u043d\\u043e\\u0439 \\u0437\\u0430\\u0434\\u0430\\u0447\\u0435\\u0439. \\u041d\\u043e\\u0432\\u0430\\u044f \\u0441\\u043c\\u044b\\u0441\\u043b\\u043e\\u0432\\u0430\\u044f \\u0434\\u0435\\u0442\\u0430\\u043b\\u044c \\u0441\\u0443\\u0449\\u0435\\u0441\\u0442\\u0432\\u0443\\u044e\\u0449\\u0435\\u0439 \\u0444\\u0438\\u0433\\u0443\\u0440\\u044b \\u2014 \\u044d\\u0442\\u043e \\u043d\\u043e\\u0432\\u0430\\u044f \\u0437\\u0430\\u044f\\u0432\\u043a\\u0430.\n- \\u0420\\u043e\\u0441\\u0442\\u0435\\u0440 \\u043f\\u043e\\u0441\\u043b\\u0435 MVP \\u0432\\u043d\\u0435 \\u043e\\u0431\\u044a\\u0451\\u043c\\u0430 \\u0412\\u0420-18 (`docs/game-design/visual/02-visual-design.md` \\u00a78.6). \\u0421\\u043a\\u0438\\u043b\\u043b \\u043f\\u0438\\u0448\\u0435\\u0442 \\u043e\\u0431 \\u044d\\u0442\\u043e\\u043c\n  \\u043f\\u0440\\u0435\\u0434\\u0443\\u043f\\u0440\\u0435\\u0436\\u0434\\u0435\\u043d\\u0438\\u0435 \\u0432 \\u043f\\u043e\\u043b\\u0435 `NOTES` \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0438, \\u043d\\u043e \\u0440\\u0430\\u0431\\u043e\\u0442\\u0443 \\u043d\\u0435 \\u043e\\u0441\\u0442\\u0430\\u043d\\u0430\\u0432\\u043b\\u0438\\u0432\\u0430\\u0435\\u0442: \\u0437\\u0430\\u043f\\u0440\\u043e\\u0441 \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044f \\u0438 \\u0435\\u0441\\u0442\\u044c \\u043e\\u0441\\u043d\\u043e\\u0432\\u0430\\u043d\\u0438\\u0435 \\u0434\\u043b\\u044f \\u0437\\u0430\\u043f\\u0443\\u0441\\u043a\\u0430.\n\n## 2. \\u041a\\u0430\\u0440\\u0442\\u0430 \\u044d\\u0442\\u0430\\u043f\\u043e\\u0432 0\\u20137\n\n| \\u042d\\u0442\\u0430\\u043f | \\u0427\\u0442\\u043e | \\u0418\\u0441\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u044c | \\u0412\\u044b\\u0445\\u043e\\u0434 | \\u041a\\u0440\\u0438\\u0442\\u0435\\u0440\\u0438\\u0439 \\u0432\\u044b\\u0445\\u043e\\u0434\\u0430 |\n|---|---|---|---|---|\n| 0 | \\u0417\\u0430\\u044f\\u0432\\u043a\\u0430, \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043a\\u0430 \\u0438\\u0441\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u0435\\u0439, \\u0440\\u0435\\u0435\\u0441\\u0442\\u0440 | \\u0437\\u0430\\u043f\\u0443\\u0441\\u043a\\u0430\\u044e\\u0449\\u0438\\u0439 \\u0430\\u0433\\u0435\\u043d\\u0442 | `ASSET_DIR/asset-card.yaml`, `.gitignore` \\u0430\\u0441\\u0441\\u0435\\u0442\\u0430, \\u0437\\u0430\\u043f\\u0438\\u0441\\u044c \\u0432 `docs/art-pipeline/asset-registry.json`, \\u0441\\u0442\\u0440\\u043e\\u043a\\u0430 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0438 \\u0432 `06-tasks/anim.csv` | \\u0432\\u0441\\u0435 \\u043f\\u043e\\u043b\\u044f \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0438 \\u0437\\u0430\\u043f\\u043e\\u043b\\u043d\\u0435\\u043d\\u044b (\\u0434\\u0435\\u0444\\u043e\\u043b\\u0442\\u044b \\u00a77 \\u0440\\u0430\\u0437\\u0440\\u0435\\u0448\\u0435\\u043d\\u044b); `validate_registry.py` \\u0431\\u0435\\u0437 ERROR \\u043f\\u043e `ASSET_ID` (\\u043f\\u043e \\u0441\\u0442\\u0440\\u043e\\u043a\\u0430\\u043c ERROR, \\u043d\\u0435 \\u043f\\u043e \\u043a\\u043e\\u0434\\u0443 \\u0432\\u044b\\u0445\\u043e\\u0434\\u0430); \\u043f\\u0440\\u043e\\u0431\\u044b \\u0438\\u0441\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u0435\\u0439 \\u043f\\u0440\\u043e\\u0448\\u043b\\u0438; \\u0433\\u0435\\u0439\\u0442\\u044b \\u00a75 \\u043d\\u0435 \\u0441\\u0440\\u0430\\u0431\\u043e\\u0442\\u0430\\u043b\\u0438 |\n| 1 | \\u041a\\u043e\\u043d\\u0446\\u0435\\u043f\\u0442-\\u043b\\u0438\\u0441\\u0442: 1a \\u0434\\u0438\\u0437\\u0430\\u0439\\u043d-front \\u2192 1b \\u0447\\u0435\\u0440\\u043d\\u043e\\u0432\\u0430\\u044f \\u043c\\u043e\\u0434\\u0435\\u043b\\u044c Tripo \\u2192 1c \\u0432\\u0438\\u0434\\u044b \\u043f\\u043e\\u0432\\u0435\\u0440\\u0445 \\u043e\\u0440\\u0442\\u043e | Codex, \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a | `art/imagegen/concept-<key>-codex/` | `check_concept_views.py` 0 FAIL \\u0438 \\u043a\\u043e\\u044d\\u0444\\u0444\\u0438\\u0446\\u0438\\u0435\\u043d\\u0442 \\u043b\\u0438\\u0441\\u0442\\u0430 \\u2265 8,0 |\n| 2 | \\u0413\\u0435\\u043d\\u0435\\u0440\\u0430\\u0446\\u0438\\u044f Tripo H2 | \\u0437\\u0430\\u043f\\u0443\\u0441\\u043a\\u0430\\u044e\\u0449\\u0438\\u0439 \\u0430\\u0433\\u0435\\u043d\\u0442 (Studio \\u0432 \\u0431\\u0440\\u0430\\u0443\\u0437\\u0435\\u0440\\u0435) \\u0438\\u043b\\u0438 \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044c \\u043f\\u043e \\u0447\\u0435\\u043a-\\u043b\\u0438\\u0441\\u0442\\u0443 | `<ASSET_ID>/<YYYYMMDD>-h2-tripo/` + `source-specs/tripo-<task8>-h2.json` (\\u043f\\u0440\\u043e\\u043f \\u2014 `<YYYYMMDD>-prop-tripo/`, `tripo-<task8>.json`) | \\u0447\\u0435\\u043a-\\u043b\\u0438\\u0441\\u0442 \\u0432\\u044b\\u0445\\u043e\\u0434\\u0430 \\u044d\\u0442\\u0430\\u043f\\u0430 2 \\u0432 `references/tripo3d-stages.md` \\u00a79 |\n| 3 | \\u0420\\u0435\\u0433\\u0438\\u0441\\u0442\\u0440\\u0430\\u0446\\u0438\\u044f \\u043f\\u0435\\u0440\\u0441\\u043e\\u043d\\u0430\\u0436\\u0430 \\u2192 H2 bake \\u2192 look-dev \\u2192 TeamAccent (\\u043f\\u0440\\u043e\\u043f \\u2014 \\u0441\\u0431\\u043e\\u0440\\u043a\\u0430 \\u0441\\u0442\\u0430\\u0442\\u0438\\u0447\\u0435\\u0441\\u043a\\u043e\\u0433\\u043e \\u043f\\u0440\\u043e\\u043f\\u0430) | \\u0437\\u0430\\u043f\\u0443\\u0441\\u043a\\u0430\\u044e\\u0449\\u0438\\u0439 \\u0430\\u0433\\u0435\\u043d\\u0442, headless | `SK_<Key>_H2.fbx`, `SK_<Key>_H2LD.fbx`, \\u0442\\u0435\\u043a\\u0441\\u0442\\u0443\\u0440\\u044b (\\u043f\\u0440\\u043e\\u043f \\u2014 `<YYYYMMDD>-prop-build/export/SM_<Name>.fbx` + `T_<Name>_{BC,N,ORM}`) | \\u0432\\u0441\\u0435 \\u0441\\u0442\\u0430\\u0434\\u0438\\u0438 `run_h2_bake.py` OK, probes 7/7, \\u0434\\u0435\\u0442\\u0435\\u0440\\u043c\\u0438\\u043d\\u0438\\u0437\\u043c (HANDBOOK \\u00a74.3\\u20134.4); \\u043f\\u0440\\u043e\\u043f \\u2014 `reports/candidate-report.json` \\u0441 `checks_passed: true` \\u0438 `reports/fbx-readback.json` (HANDBOOK \\u00a75) |\n| 4 | \\u041f\\u0440\\u0438\\u0451\\u043c\\u043a\\u0430 \\u043c\\u043e\\u0434\\u0435\\u043b\\u0438 (\\u043a\\u043e\\u044d\\u0444\\u0444\\u0438\\u0446\\u0438\\u0435\\u043d\\u0442) | \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a (\\u043f\\u0440\\u0438 \\u043d\\u0435\\u0443\\u0441\\u0442\\u043e\\u0439\\u0447\\u0438\\u0432\\u043e\\u043c pass \\u2014 \\u0432\\u0442\\u043e\\u0440\\u043e\\u0439, \\u0434\\u0440\\u0443\\u0433\\u0438\\u043c \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u0435\\u043c) | `evidence/acceptance/<YYYYMMDD>-r<N>/card.json` (+ `card-2.json`, `final.json`) + `frames/` (`capture_acceptance_set.py --sheet`) | \\u0432\\u0435\\u0440\\u0434\\u0438\\u043a\\u0442 `validate_card.py`: \\u043a\\u043e\\u0434 0 \\u2014 \\u043f\\u043e \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0435; \\u043a\\u043e\\u0434 3 \\u2014 \\u043f\\u043e `final.json` \\u043f\\u0430\\u0440\\u044b |\n| 5 | \\u0414\\u043e\\u0440\\u0430\\u0431\\u043e\\u0442\\u043a\\u0430 \\u0432 Blender | \\u043b\\u0438\\u0447\\u043d\\u043e \\u00abOpus xhigh\\u00bb | \\u043d\\u043e\\u0432\\u044b\\u0439 run `\\u2026-r<N+1>` | \\u043f\\u043e\\u0432\\u0442\\u043e\\u0440\\u043d\\u044b\\u0439 \\u044d\\u0442\\u0430\\u043f 4; \\u043d\\u0435 \\u0431\\u043e\\u043b\\u044c\\u0448\\u0435 2 \\u0446\\u0438\\u043a\\u043b\\u043e\\u0432 (r1\\u2192r2\\u2192r3) |\n| 6 | \\u0410\\u043d\\u0438\\u043c\\u0430\\u0446\\u0438\\u044f, VFX, SFX | \\u0437\\u0430\\u043f\\u0443\\u0441\\u043a\\u0430\\u044e\\u0449\\u0438\\u0439 \\u0430\\u0433\\u0435\\u043d\\u0442; \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a; \\u0434\\u043e\\u0440\\u0430\\u0431\\u043e\\u0442\\u043a\\u0430 \\u2014 \\u00abOpus xhigh\\u00bb | `<ASSET_ID>/<YYYYMMDD>-h2anim/`, \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0438 `evidence/acceptance-anim/<YYYYMMDD>-r<N>/<Clip>/card.json`, \\u0437\\u0432\\u0443\\u043a\\u0438 \\u0438 FX \\u043f\\u043e \\u0441\\u043b\\u043e\\u0442\\u0430\\u043c | \\u0432\\u0430\\u043b\\u0438\\u0434\\u0430\\u0442\\u043e\\u0440\\u044b PASS \\u0438 \\u043a\\u043e\\u044d\\u0444\\u0444\\u0438\\u0446\\u0438\\u0435\\u043d\\u0442 \\u043a\\u0430\\u0436\\u0434\\u043e\\u0433\\u043e \\u043a\\u043b\\u0438\\u043f\\u0430 \\u2265 8,0 |\n| 7 | 7a \\u0438\\u043c\\u043f\\u043e\\u0440\\u0442 \\u0438 look-dev \\u0432 \\u043e\\u0442\\u043a\\u0440\\u044b\\u0442\\u043e\\u043c \\u0440\\u0435\\u0434\\u0430\\u043a\\u0442\\u043e\\u0440\\u0435 (MCP); 7b C++, \\u0441\\u0431\\u043e\\u0440\\u043a\\u0430, \\u0430\\u0432\\u0442\\u043e\\u0442\\u0435\\u0441\\u0442\\u044b, \\u0443\\u043f\\u0430\\u043a\\u043e\\u0432\\u043a\\u0430, \\u043a\\u0430\\u0434\\u0440\\u044b \\u0432 \\u0438\\u0433\\u0440\\u0435 \\u2014 \\u0431\\u0435\\u0437 \\u0440\\u0435\\u0434\\u0430\\u043a\\u0442\\u043e\\u0440\\u0430 (\\u0433\\u0435\\u0439\\u0442 \\u00a75 \\u043f.7) | \\u0437\\u0430\\u043f\\u0443\\u0441\\u043a\\u0430\\u044e\\u0449\\u0438\\u0439 \\u0430\\u0433\\u0435\\u043d\\u0442 | `/Game/PipelineCandidates/<Key>/\\u2026`, \\u043f\\u0440\\u0430\\u0432\\u043a\\u0438 C++ \\u0438 \\u043a\\u043e\\u043d\\u0444\\u0438\\u0433\\u043e\\u0432 | `ue-import-report.json` passed, \\u0430\\u0432\\u0442\\u043e\\u0442\\u0435\\u0441\\u0442\\u044b S08 PASS, \\u043a\\u0430\\u0434\\u0440\\u044b `-Bench` \\u043e\\u0431\\u0435\\u0438\\u0445 \\u0434\\u043e\\u0441\\u043e\\u043a \\u043e\\u0441\\u043c\\u043e\\u0442\\u0440\\u0435\\u043d\\u044b, \\u043e\\u0431\\u0430 \\u0440\\u0435\\u0435\\u0441\\u0442\\u0440\\u0430 \\u043e\\u0431\\u043d\\u043e\\u0432\\u043b\\u0435\\u043d\\u044b |\n\n\\u0427\\u0435\\u0440\\u043d\\u043e\\u0432\\u0430\\u044f \\u043c\\u043e\\u0434\\u0435\\u043b\\u044c \\u0448\\u0430\\u0433\\u0430 1b \\u2014 \\u043f\\u043b\\u0430\\u0442\\u043d\\u0430\\u044f \\u043e\\u043f\\u0435\\u0440\\u0430\\u0446\\u0438\\u044f Tripo \\u0432\\u043d\\u0443\\u0442\\u0440\\u0438 \\u044d\\u0442\\u0430\\u043f\\u0430 1 (\\u043c\\u0430\\u0440\\u0448\\u0440\\u0443\\u0442 \\u00ab\\u0427\\u0435\\u0440\\u043d\\u043e\\u0432\\u0438\\u043a\\u00bb \\u0432 `references/tripo3d-stages.md`).\n\\u0421\\u0442\\u0430\\u0440\\u044b\\u0435 \\u00ab\\u043f\\u0440\\u0438\\u0451\\u043c\\u043a\\u0430 \\u043a\\u0430\\u043d\\u0434\\u0438\\u0434\\u0430\\u0442\\u0430 h31\\u00bb \\u0438 \\u00ab\\u044d\\u0442\\u0430\\u043f 4.5\\u00bb \\u0443\\u043f\\u0440\\u0430\\u0437\\u0434\\u043d\\u0435\\u043d\\u044b. \\u041c\\u0430\\u0440\\u0448\\u0440\\u0443\\u0442 h31 \\u0438 \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u044c `skeletal-candidate` \\u043e\\u0441\\u0442\\u0430\\u043b\\u0438\\u0441\\u044c\n\\u0438\\u0441\\u0442\\u043e\\u0440\\u0438\\u0435\\u0439, \\u0430 \\u043d\\u0435 \\u043e\\u0431\\u0440\\u0430\\u0437\\u0446\\u043e\\u043c (HANDBOOK \\u00a71 \\u00ab\\u041d\\u0435 \\u0438\\u0441\\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u044c \\u043a\\u0430\\u043a \\u043e\\u0431\\u0440\\u0430\\u0437\\u0435\\u0446\\u00bb).\n\n## 3. \\u0412\\u0435\\u0442\\u043a\\u0438 \\u043f\\u043e \\u0430\\u043d\\u0430\\u0442\\u043e\\u043c\\u0438\\u0438 (\\u043f\\u043e\\u043b\\u0435 `ANATOMY`)\n\n| \\u0412\\u0435\\u0442\\u043a\\u0430 | \\u042d\\u0442\\u0430\\u043f\\u044b | \\u041e\\u0441\\u043e\\u0431\\u0435\\u043d\\u043d\\u043e\\u0441\\u0442\\u0438 |\n|---|---|---|\n| `humanoid` (\\u0433\\u0435\\u0440\\u043e\\u0439 \\u0438\\u043b\\u0438 \\u043f\\u043e\\u043c\\u043e\\u0449\\u043d\\u0438\\u043a) | 0\\u20137 | \\u0440\\u0438\\u0433 `UM_HUMANOID_17_v2`, 17 \\u043a\\u043e\\u0441\\u0442\\u0435\\u0439; \\u043d\\u043e\\u0432\\u044b\\u0439 \\u043f\\u0435\\u0440\\u0441\\u043e\\u043d\\u0430\\u0436 \\u2014 \\u044d\\u0442\\u043e \\u0440\\u0443\\u0442\\u0438\\u043d\\u043d\\u0430\\u044f \\u0440\\u0435\\u0433\\u0438\\u0441\\u0442\\u0440\\u0430\\u0446\\u0438\\u044f (`references/new-character-registration.md`), \\u0430 \\u043d\\u0435 \\u044d\\u0441\\u043a\\u0430\\u043b\\u0430\\u0446\\u0438\\u044f |\n| `winged-biped` (\\u043e\\u0431\\u0440\\u0430\\u0437\\u0435\\u0446 \\u2014 Harpy) | 0\\u20137 | \\u043a\\u0440\\u044b\\u043b\\u044c\\u044f = \\u0446\\u0435\\u043f\\u043e\\u0447\\u043a\\u0438 `arm_upper \\u2192 arm_lower \\u2192 hand` \\u0431\\u0430\\u0437\\u043e\\u0432\\u043e\\u0433\\u043e \\u0441\\u043a\\u0435\\u043b\\u0435\\u0442\\u0430, \\u043a\\u0430\\u043a \\u0443 Harpy; \\u043e\\u0440\\u0443\\u0436\\u0438\\u044f \\u043d\\u0435\\u0442 (`WEAPON_BONE: null`), 16 \\u043a\\u043e\\u0441\\u0442\\u0435\\u0439 (HANDBOOK \\u00a72.6, \\u00a70.3 \\u043f.4); `wing_tip.L/R` \\u2014 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043f\\u043e \\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u044e (\\u0441\\u0442\\u043e\\u043f \\u00a75 \\u043f.5); \\u0448\\u0438\\u0440\\u043e\\u043a\\u0438\\u0439 \\u043a\\u0430\\u0434\\u0440 \\u043a\\u043e\\u043d\\u0446\\u0435\\u043f\\u0442\\u0430 (HANDBOOK \\u00a73.1) |\n| `prop` | 0, 1, 2, 3, 4, 6?, 7 | Tripo \\u2014 multi-view: front+side \\u0443 \\u043e\\u0441\\u0435\\u0441\\u0438\\u043c\\u043c\\u0435\\u0442\\u0440\\u0438\\u0447\\u043d\\u043e\\u0433\\u043e, front+back \\u0443 \\u0430\\u0441\\u0438\\u043c\\u043c\\u0435\\u0442\\u0440\\u0438\\u0447\\u043d\\u043e\\u0433\\u043e; \\u044d\\u0442\\u0430\\u043f 3 \\u2014 \\u043f\\u0443\\u0442\\u044c \\u0441\\u0442\\u0430\\u0442\\u0438\\u0447\\u0435\\u0441\\u043a\\u043e\\u0433\\u043e \\u043f\\u0440\\u043e\\u043f\\u0441\\u0430 (HANDBOOK \\u00a75, \\u00a76 \\u00ab\\u042d\\u0442\\u0430\\u043f 3 \\u2014 \\u043f\\u0440\\u043e\\u043f\\u00bb), \\u0440\\u0435\\u0433\\u0438\\u0441\\u0442\\u0440\\u0430\\u0446\\u0438\\u0438 \\u043f\\u0435\\u0440\\u0441\\u043e\\u043d\\u0430\\u0436\\u0430 \\u043d\\u0435\\u0442; \\u043d\\u0430 \\u044d\\u0442\\u0430\\u043f\\u0435 4 `D = null` \\u0438 `G-RIG = n/a`, \\u0441\\u044a\\u0451\\u043c\\u043a\\u0430 `capture_acceptance_set.py --no-base` \\u0440\\u0430\\u0431\\u043e\\u0442\\u0430\\u0435\\u0442 \\u0438 \\u043d\\u0430 \\u0448\\u0438\\u0440\\u043e\\u043a\\u043e\\u043c \\u043f\\u0440\\u043e\\u043f\\u0435 (`references/acceptance-and-blender.md` \\u00a714); \\u044d\\u0442\\u0430\\u043f 6 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043f\\u0440\\u0438 CUE \\u0438\\u043b\\u0438 \\u0437\\u0432\\u0443\\u043a\\u0435, \\u0438\\u043d\\u0430\\u0447\\u0435 \\u043f\\u0440\\u043e\\u043f\\u0443\\u0441\\u043a \\u0441 \\u0437\\u0430\\u043f\\u0438\\u0441\\u044c\\u044e \\u00ab\\u043d\\u0435\\u0442 \\u0441\\u043b\\u043e\\u0442\\u043e\\u0432\\u00bb \\u0432 `STAGE6_SLOTS`; \\u044d\\u0442\\u0430\\u043f 7 \\u2014 \\u0441\\u0442\\u0430\\u0442\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438\\u0439 \\u0438\\u043c\\u043f\\u043e\\u0440\\u0442 (HANDBOOK \\u00a75 \\u043f.7); \\u043f\\u0440\\u043e\\u043f \\u0441 \\u043e\\u0441\\u0435\\u0432\\u043e\\u0439 \\u0441\\u0438\\u043c\\u043c\\u0435\\u0442\\u0440\\u0438\\u0435\\u0439 \\u043c\\u043e\\u0436\\u0435\\u0442 \\u043f\\u0440\\u043e\\u043f\\u0443\\u0441\\u0442\\u0438\\u0442\\u044c \\u0448\\u0430\\u0433 1b |\n| `non-humanoid` (\\u0447\\u0435\\u0442\\u0432\\u0435\\u0440\\u043e\\u043d\\u043e\\u0433\\u043e\\u0435, \\u043c\\u043d\\u043e\\u0433\\u043e\\u0433\\u043e\\u043b\\u043e\\u0432\\u043e\\u0435, \\u0437\\u043c\\u0435\\u0435\\u0432\\u0438\\u0434\\u043d\\u043e\\u0435) | **\\u0441\\u0442\\u043e\\u043f \\u043d\\u0430 \\u044d\\u0442\\u0430\\u043f\\u0435 0** | \\u0433\\u0435\\u0439\\u0442 \\u00a75 \\u043f.1: \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044e \\u0443\\u0445\\u043e\\u0434\\u0438\\u0442 \\u0433\\u043e\\u0442\\u043e\\u0432\\u0430\\u044f \\u043f\\u043e\\u0441\\u0442\\u0430\\u043d\\u043e\\u0432\\u043a\\u0430 `<ASSET_DIR>/STOP-RIG-CONTRACT-3.md` \\u043f\\u043e \\u0448\\u0430\\u0431\\u043b\\u043e\\u043d\\u0443 `references/intake-and-evidence.md` \\u00a72. \\u0414\\u043e \\u0441\\u0442\\u043e\\u043f\\u0430 \\u043f\\u0438\\u0448\\u0435\\u0442\\u0441\\u044f \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e `asset-card.yaml` (`ANATOMY: non-humanoid`, \\u0430\\u043d\\u0430\\u0442\\u043e\\u043c\\u0438\\u044f \\u0432 `NOTES`); \\u0437\\u0430\\u043f\\u0438\\u0441\\u044c \\u0440\\u0435\\u0435\\u0441\\u0442\\u0440\\u0430, \\u0441\\u0442\\u0440\\u043e\\u043a\\u0430 `anim.csv` \\u0438 \\u0442\\u0440\\u0430\\u0442\\u044b \\u2014 \\u043d\\u0435\\u0442. \\u041f\\u0440\\u0430\\u0432\\u0438\\u043b\\u0430 \\u043f\\u043e\\u0437 \\u0447\\u0435\\u0442\\u0432\\u0435\\u0440\\u043e\\u043d\\u043e\\u0433\\u0438\\u0445 \\u0432 \\u0441\\u043f\\u0440\\u0430\\u0432\\u043e\\u0447\\u043d\\u0438\\u043a\\u0430\\u0445 \\u0434\\u0435\\u0439\\u0441\\u0442\\u0432\\u0443\\u044e\\u0442 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043f\\u043e\\u0441\\u043b\\u0435 \\u043f\\u0440\\u0438\\u043d\\u044f\\u0442\\u0438\\u044f rig-contract/3 |\n\n\\u0411\\u043b\\u043e\\u043a `optional_extensions` \\u0432 `docs/art-pipeline/rig/rig-contract.json:169-184` (`crown_snakes`, `cloak`, `harpy_wings`)\n\\u0438\\u043c\\u0435\\u0435\\u0442 \\u0441\\u0442\\u0430\\u0442\\u0443\\u0441 \\u00ab\\u043f\\u0440\\u0435\\u0434\\u043b\\u043e\\u0436\\u0435\\u043d\\u043e, \\u043d\\u0435 \\u0440\\u0435\\u0430\\u043b\\u0438\\u0437\\u043e\\u0432\\u0430\\u043d\\u043e\\u00bb: h2_bake \\u0438 \\u0432\\u0430\\u043b\\u0438\\u0434\\u0430\\u0442\\u043e\\u0440\\u044b \\u044d\\u0442\\u0438\\u0445 \\u043a\\u043e\\u0441\\u0442\\u0435\\u0439 \\u043d\\u0435 \\u0441\\u043e\\u0437\\u0434\\u0430\\u044e\\u0442 (HANDBOOK \\u00a72.6 \\u00ab\\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043f\\u043e\n\\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u044e\\u00bb). \\u0418\\u0441\\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u044c \\u0440\\u0430\\u0441\\u0448\\u0438\\u0440\\u0435\\u043d\\u0438\\u0435 \\u2014 \\u0441\\u0442\\u043e\\u043f \\u00a75 \\u043f.5. \\u0411\\u0435\\u0437 \\u043d\\u043e\\u0432\\u044b\\u0445 \\u043a\\u043e\\u0441\\u0442\\u0435\\u0439 \\u0440\\u0430\\u0431\\u043e\\u0442\\u0430\\u0435\\u0442 \\u0431\\u0430\\u0437\\u0430: \\u0437\\u043c\\u0435\\u0438 100 % \\u043d\\u0430 `head`, \\u043f\\u043b\\u0430\\u0449, \\u043a\\u0430\\u043f\\u044e\\u0448\\u043e\\u043d\n\\u0438 \\u044e\\u0431\\u043a\\u0430 \\u2014 \\u043f\\u043b\\u0430\\u0432\\u043d\\u044b\\u0435 \\u0432\\u0435\\u0441\\u0430 `hips`/`leg_upper.L/R`. \\u041d\\u043e\\u0432\\u044b\\u0439 MatID-\\u043a\\u043b\\u0430\\u0441\\u0441 \\u2014 \\u0442\\u043e\\u0436\\u0435 \\u0441\\u0442\\u043e\\u043f \\u00a75 \\u043f.5.\n\n## 4. \\u0418\\u0441\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u0438 \\u0438 \\u043a\\u0430\\u043a \\u0438\\u0445 \\u0432\\u044b\\u0437\\u044b\\u0432\\u0430\\u0442\\u044c\n\n| \\u0420\\u043e\\u043b\\u044c | \\u041a\\u0430\\u043a \\u0432\\u044b\\u0437\\u0432\\u0430\\u0442\\u044c | \\u041f\\u0440\\u0430\\u0432\\u0438\\u043b\\u0430 |\n|---|---|---|\n| Codex (\\u044d\\u0442\\u0430\\u043f 1) | \\u041e\\u0441\\u043d\\u043e\\u0432\\u043d\\u043e\\u0439 \\u043f\\u0443\\u0442\\u044c \\u2014 `codex.exe exec` \\u043f\\u043e\\u0441\\u043b\\u0435 \\u043f\\u0440\\u043e\\u0431\\u044b exec (`references/concept-sheet.md` \\u00a75.2): exe \\u0438\\u0437 `%LOCALAPPDATA%/OpenAI/Codex/bin/<hash>/` (\\u0435\\u0433\\u043e \\u0437\\u0430\\u043f\\u0443\\u0441\\u043a\\u0430\\u0435\\u0442 \\u0441\\u0430\\u043c\\u043e \\u043f\\u0440\\u0438\\u043b\\u043e\\u0436\\u0435\\u043d\\u0438\\u0435), \\u043f\\u0440\\u0438 \\u00abused by another process\\u00bb \\u2014 \\u043a\\u043e\\u043f\\u0438\\u044f \\u0432 `C:/tmp/codex-bin/`; \\u043f\\u0440\\u0438 \\u0437\\u0430\\u043a\\u0440\\u044b\\u0442\\u043e\\u043c \\u043f\\u0440\\u0438\\u043b\\u043e\\u0436\\u0435\\u043d\\u0438\\u0438 \\u0433\\u043e\\u0434\\u0438\\u0442\\u0441\\u044f \\u0438 exe \\u043f\\u0430\\u043a\\u0435\\u0442\\u0430 `C:/Program Files/WindowsApps/OpenAI.Codex_*/app/resources/`. \\u041f\\u0430\\u043a\\u0435\\u0442 \\u043d\\u0430 \\u043c\\u0430\\u0448\\u0438\\u043d\\u0435 \\u043e\\u0434\\u0438\\u043d, \\u00abexe \\u0441\\u043e\\u0441\\u0435\\u0434\\u043d\\u0435\\u0439 \\u0432\\u0435\\u0440\\u0441\\u0438\\u0438\\u00bb \\u043d\\u0435\\u0442. \\u0418\\u0437 PowerShell: `Get-Content <prompt> -Raw -Encoding UTF8 \\| & $exe exec -C <repo> -s workspace-write -c 'windows.sandbox=\"unelevated\"' --skip-git-repo-check -` (`$OutputEncoding` \\u0438 `[Console]::OutputEncoding` \\u2014 UTF-8). \\u0424\\u043b\\u0430\\u0433 `windows.sandbox=\"unelevated\"` \\u043e\\u0431\\u044f\\u0437\\u0430\\u0442\\u0435\\u043b\\u0435\\u043d: \\u0431\\u0435\\u0437 \\u043d\\u0435\\u0433\\u043e \\u043f\\u0440\\u0438 \\u043e\\u0442\\u043a\\u0440\\u044b\\u0442\\u043e\\u043c \\u043f\\u0440\\u0438\\u043b\\u043e\\u0436\\u0435\\u043d\\u0438\\u0438 \\u043f\\u0435\\u0441\\u043e\\u0447\\u043d\\u0438\\u0446\\u0430 \\u043d\\u0435 \\u0437\\u0430\\u043f\\u0443\\u0441\\u043a\\u0430\\u0435\\u0442 \\u043a\\u043e\\u043c\\u0430\\u043d\\u0434, \\u0430 \\u043a\\u043e\\u0434 \\u0432\\u044b\\u0445\\u043e\\u0434\\u0430 \\u0432\\u0441\\u0451 \\u0440\\u0430\\u0432\\u043d\\u043e 0 (concept-sheet \\u00a75.2). Exec \\u0437\\u0430\\u043d\\u044f\\u0442 \\u0438 \\u043a\\u043e\\u043f\\u0438\\u0435\\u0439 \\u2014 \\u043f\\u0440\\u0438\\u043b\\u043e\\u0436\\u0435\\u043d\\u0438\\u0435 ChatGPT \\u0447\\u0435\\u0440\\u0435\\u0437 \\u0443\\u043f\\u0440\\u0430\\u0432\\u043b\\u0435\\u043d\\u0438\\u0435 \\u0440\\u0430\\u0431\\u043e\\u0447\\u0438\\u043c \\u0441\\u0442\\u043e\\u043b\\u043e\\u043c (computer-use \\u0438\\u043b\\u0438 Windows-MCP): Ctrl+N \\u0432 \\u043f\\u0440\\u043e\\u0435\\u043a\\u0442\\u0435 `unmached`, \\u0441\\u043e\\u043e\\u0431\\u0449\\u0435\\u043d\\u0438\\u0435 \\u00ab\\u041f\\u0440\\u043e\\u0447\\u0438\\u0442\\u0430\\u0439 `<prompt file>` \\u0438 \\u0432\\u044b\\u043f\\u043e\\u043b\\u043d\\u0438 \\u0437\\u0430\\u0434\\u0430\\u0447\\u0443\\u00bb (`docs/game-design/visual/07-prompt-templates.md` \\u00a71.1; concept-sheet \\u00a75.3). \\u041f\\u0440\\u0438\\u043b\\u043e\\u0436\\u0435\\u043d\\u0438\\u0435 \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044f \\u043d\\u0435 \\u0437\\u0430\\u043a\\u0440\\u044b\\u0432\\u0430\\u0442\\u044c. npm-`codex` \\u043d\\u0435 \\u0440\\u0430\\u0431\\u043e\\u0442\\u0430\\u0435\\u0442 | \\u041f\\u0440\\u043e\\u043c\\u043f\\u0442-\\u0444\\u0430\\u0439\\u043b \\u043f\\u0438\\u0448\\u0435\\u0442 Claude: `docs/game-design/visual/06-tasks/prompts/<ASSET_ID>-concept.codex.md`. Codex \\u043f\\u0438\\u0448\\u0435\\u0442 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u0432 `art/imagegen/concept-<key>-codex/` \\u0438 \\u043d\\u0435 \\u043a\\u043e\\u043c\\u043c\\u0438\\u0442\\u0438\\u0442 |\n| \\u041f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a \\u00abOpus xhigh\\u00bb (\\u043f\\u043e \\u0443\\u043c\\u043e\\u043b\\u0447\\u0430\\u043d\\u0438\\u044e) | \\u0410\\u0433\\u0435\\u043d\\u0442 Workflow `agent(prompt, {model: 'opus', effort: 'xhigh', schema: <\\u0441\\u0445\\u0435\\u043c\\u0430 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0438>, label})`, \\u0441\\u0432\\u0435\\u0436\\u0438\\u0439 \\u043a\\u043e\\u043d\\u0442\\u0435\\u043a\\u0441\\u0442 (\\u0441\\u043a\\u0440\\u0438\\u043f\\u0442 \\u0438 \\u043f\\u0440\\u043e\\u043c\\u043f\\u0442 \\u2014 `references/acceptance-and-blender.md` \\u00a78.2\\u20138.3). \\u041d\\u0430 \\u0432\\u0445\\u043e\\u0434 \\u2014 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043a\\u0430\\u0434\\u0440\\u044b, \\u043e\\u0442\\u0447\\u0451\\u0442\\u044b, \\u043a\\u043e\\u043d\\u0446\\u0435\\u043f\\u0442 \\u0438 \\u0440\\u0443\\u0431\\u0440\\u0438\\u043a\\u0430 | \\u041d\\u0435 \\u043f\\u0440\\u0430\\u0432\\u0438\\u0442. \\u0415\\u0433\\u043e \\u0441\\u0435\\u0441\\u0441\\u0438\\u044f \\u043e\\u0442\\u043b\\u0438\\u0447\\u043d\\u0430 \\u043e\\u0442 \\u0441\\u0435\\u0441\\u0441\\u0438\\u0438 \\u0438\\u0441\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u044f. `session_id` \\u043e\\u0431\\u043e\\u0438\\u0445 \\u043f\\u0438\\u0448\\u0443\\u0442\\u0441\\u044f \\u0432 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0443 |\n| \\u041f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a \\u00abSol 6.1 xhigh\\u00bb | \\u0422\\u043e\\u0442 \\u0436\\u0435 `$exe`, \\u043f\\u0440\\u043e\\u0448\\u0435\\u0434\\u0448\\u0438\\u0439 \\u043f\\u0440\\u043e\\u0431\\u0443 exec (\\u043d\\u0435 npm-`codex`; GUI-\\u043f\\u0443\\u0442\\u044c \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a\\u0443 \\u043d\\u0435 \\u043f\\u043e\\u0434\\u0445\\u043e\\u0434\\u0438\\u0442 \\u2014 \\u043d\\u0443\\u0436\\u043d\\u044b `--output-schema` \\u0438 `-o`): `Get-Content <acceptor-prompt.md> -Raw -Encoding UTF8 \\| & $exe exec --ignore-user-config -m gpt-6.1-sol -c 'model_reasoning_effort=\"xhigh\"' -c 'windows.sandbox=\"unelevated\"' -s read-only -C <repo> --skip-git-repo-check --output-schema tools/art/acceptance/asset-acceptance-2.output-<kind>.schema.json -o <evidence>/card.json --json -i <\\u043a\\u0430\\u0434\\u04401> -i <\\u043a\\u0430\\u0434\\u04402> -- -` (\\u043f\\u043e\\u043b\\u043d\\u0430\\u044f \\u043a\\u043e\\u043c\\u0430\\u043d\\u0434\\u0430 \\u2014 `references/acceptance-and-blender.md` \\u00a78.4). \\u0421\\u0445\\u0435\\u043c\\u0430 \\u2014 \\u0441\\u0442\\u0440\\u043e\\u0433\\u0430\\u044f \\u043f\\u0440\\u043e\\u0438\\u0437\\u0432\\u043e\\u0434\\u043d\\u0430\\u044f \\u0441\\u0432\\u043e\\u0435\\u0433\\u043e \\u0432\\u0438\\u0434\\u0430 (`model`/`concept`/`anim`), \\u043d\\u0435 \\u043f\\u043e\\u043b\\u043d\\u0430\\u044f `asset-acceptance-2.schema.json`: \\u043f\\u043e\\u043b\\u043d\\u0443\\u044e \\u0441\\u0442\\u0440\\u043e\\u0433\\u0438\\u0439 \\u0440\\u0435\\u0436\\u0438\\u043c \\u043e\\u0442\\u0432\\u0435\\u0440\\u0433\\u0430\\u0435\\u0442. \\u041e\\u0442\\u043a\\u0430\\u0437 \\u0441\\u0445\\u0435\\u043c\\u044b \\u2014 \\u0442\\u043e\\u0442 \\u0436\\u0435 \\u0432\\u044b\\u0437\\u043e\\u0432 \\u0431\\u0435\\u0437 `--output-schema` (\\u00a78.4, \\u043f\\u043e\\u0434 \\u043a\\u043e\\u043c\\u0430\\u043d\\u0434\\u043e\\u0439). \\u041a\\u0430\\u0436\\u0434\\u044b\\u0439 \\u043a\\u0430\\u0434\\u0440 \\u2014 \\u043e\\u0442\\u0434\\u0435\\u043b\\u044c\\u043d\\u044b\\u0439 `-i`, \\u043f\\u0435\\u0440\\u0435\\u0434 `-` \\u0440\\u0430\\u0437\\u0434\\u0435\\u043b\\u0438\\u0442\\u0435\\u043b\\u044c `--` (`codex exec --help`, codex-cli 0.162.0-alpha.2); \\u0437\\u0430\\u0442\\u0435\\u043c `validate_card.py`. \\u041f\\u0440\\u043e\\u0432\\u0435\\u0440\\u0435\\u043d\\u043e \\u0436\\u0438\\u0432\\u044b\\u043c \\u0432\\u044b\\u0437\\u043e\\u0432\\u043e\\u043c 2026-10-09 (\\u043a\\u0430\\u043b\\u0438\\u0431\\u0440\\u043e\\u0432\\u043a\\u0430, 7\\u201312 \\u043c\\u0438\\u043d \\u043d\\u0430 \\u043f\\u0440\\u0438\\u0451\\u043c\\u043a\\u0443); \\u0441\\u0431\\u043e\\u0439 \\u043f\\u0435\\u0441\\u043e\\u0447\\u043d\\u0438\\u0446\\u044b \\u0434\\u0430\\u0451\\u0442 \\u043a\\u043e\\u0434 0 \\u0438 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0443-\\u0437\\u0430\\u0433\\u043b\\u0443\\u0448\\u043a\\u0443 \\u2014 \\u044d\\u0442\\u043e \\u0441\\u0431\\u043e\\u0439 \\u043e\\u043a\\u0440\\u0443\\u0436\\u0435\\u043d\\u0438\\u044f, \\u043d\\u0435 \\u043f\\u043e\\u043f\\u044b\\u0442\\u043a\\u0430 (\\u00a78.4) | \\u0422\\u043e\\u043b\\u044c\\u043a\\u043e \\u043f\\u043e \\u044f\\u0432\\u043d\\u043e\\u043c\\u0443 \\u0432\\u044b\\u0431\\u043e\\u0440\\u0443 \\u0437\\u0430\\u043f\\u0443\\u0441\\u043a\\u0430\\u044e\\u0449\\u0435\\u0433\\u043e. \\u041f\\u043e\\u0432\\u0442\\u043e\\u0440\\u043d\\u0430\\u044f \\u043f\\u0440\\u0438\\u0451\\u043c\\u043a\\u0430 \\u2014 \\u0442\\u0435\\u043c \\u0436\\u0435 \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u0435\\u043c |\n| \\u0414\\u043e\\u0440\\u0430\\u0431\\u043e\\u0442\\u043a\\u0430 \\u00abOpus xhigh\\u00bb (\\u044d\\u0442\\u0430\\u043f\\u044b 5, 6) | \\u0410\\u0433\\u0435\\u043d\\u0442 Workflow `{model: 'opus', effort: 'xhigh'}` \\u0441 \\u0431\\u0440\\u0438\\u0444\\u043e\\u043c \\u0434\\u043e\\u0440\\u0430\\u0431\\u043e\\u0442\\u043a\\u0438 \\u0438\\u0437 `references/acceptance-and-blender.md`, \\u0440\\u0430\\u0431\\u043e\\u0442\\u0430\\u0435\\u0442 headless-\\u0441\\u043a\\u0440\\u0438\\u043f\\u0442\\u0430\\u043c\\u0438 | \\u0414\\u0435\\u043b\\u0430\\u0435\\u0442 \\u043b\\u0438\\u0447\\u043d\\u043e, \\u043d\\u0435 \\u0434\\u0435\\u043b\\u0435\\u0433\\u0438\\u0440\\u0443\\u0435\\u0442, \\u0441\\u0432\\u043e\\u044e \\u0440\\u0430\\u0431\\u043e\\u0442\\u0443 \\u043d\\u0435 \\u043f\\u0440\\u0438\\u043d\\u0438\\u043c\\u0430\\u0435\\u0442 |\n| Tripo Studio (\\u0448\\u0430\\u0433\\u0438 1b \\u0438 2) | \\u0417\\u0430\\u043f\\u0443\\u0441\\u043a\\u0430\\u044e\\u0449\\u0438\\u0439 \\u0430\\u0433\\u0435\\u043d\\u0442 \\u0447\\u0435\\u0440\\u0435\\u0437 Claude in Chrome \\u0432 \\u0441\\u0432\\u043e\\u0435\\u0439 \\u0432\\u043a\\u043b\\u0430\\u0434\\u043a\\u0435. \\u0420\\u0430\\u0437\\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u0442\\u0440\\u0430\\u0442 \\u2014 \\u0441\\u0430\\u043c\\u0430 \\u0437\\u0430\\u044f\\u0432\\u043a\\u0430 \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044f (\\u00a71), \\u0432 \\u043b\\u0438\\u043c\\u0438\\u0442\\u0435 \\u0412\\u0420-04; \\u043e\\u0442\\u0434\\u0435\\u043b\\u044c\\u043d\\u043e \\u043d\\u0435 \\u0441\\u043f\\u0440\\u0430\\u0448\\u0438\\u0432\\u0430\\u0442\\u044c. \\u0415\\u0441\\u043b\\u0438 \\u043a\\u043b\\u0438\\u043a \\u0431\\u043b\\u043e\\u043a\\u0438\\u0440\\u0443\\u0435\\u0442 \\u043a\\u043b\\u0430\\u0441\\u0441\\u0438\\u0444\\u0438\\u043a\\u0430\\u0442\\u043e\\u0440 \\u043f\\u0440\\u0430\\u0432 \\u0441\\u0435\\u0441\\u0441\\u0438\\u0438 (\\u0436\\u0438\\u0432\\u0430\\u044f \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043a\\u0430 2026-10-09: Real-World Transactions) \\u0438\\u043b\\u0438 \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044c \\u2014 \\u0433\\u0435\\u0439\\u0442 \\u00a75 \\u043f.2: \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044c \\u043f\\u0440\\u043e\\u0445\\u043e\\u0434\\u0438\\u0442 \\u0447\\u0435\\u043a-\\u043b\\u0438\\u0441\\u0442 `references/tripo3d-stages.md` \\u00a78 \\u0441\\u0430\\u043c, \\u0430\\u0433\\u0435\\u043d\\u0442 \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u044f\\u0435\\u0442 \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442 | \\u0426\\u0435\\u043d\\u0430 \\u2014 \\u0441 \\u043a\\u043d\\u043e\\u043f\\u043a\\u0438 \\u0434\\u043e \\u043a\\u043b\\u0438\\u043a\\u0430. \\u0421\\u0442\\u0440\\u043e\\u043a\\u0430 \\u0436\\u0443\\u0440\\u043d\\u0430\\u043b\\u0430 \\u2014 \\u043f\\u043e\\u0441\\u043b\\u0435 \\u043a\\u0430\\u0436\\u0434\\u043e\\u0439 \\u043e\\u043f\\u0435\\u0440\\u0430\\u0446\\u0438\\u0438 |\n\n\\u0422\\u0440\\u0435\\u0431\\u043e\\u0432\\u0430\\u043d\\u0438\\u0435 \\u0437\\u0430\\u043a\\u0430\\u0437\\u0447\\u0438\\u043a\\u0430 \\u21163 \\u0438\\u0441\\u043f\\u043e\\u043b\\u043d\\u044f\\u0435\\u0442\\u0441\\u044f \\u0431\\u0443\\u043a\\u0432\\u0430\\u043b\\u044c\\u043d\\u043e. \\u041a\\u043e\\u044d\\u0444\\u0444\\u0438\\u0446\\u0438\\u0435\\u043d\\u0442 \\u0441\\u0442\\u0430\\u0432\\u0438\\u0442 \\u00abOpus xhigh\\u00bb \\u0438\\u043b\\u0438 \\u00abSol 6.1 xhigh\\u00bb. \\u041d\\u0438\\u0436\\u0435 \\u043f\\u043e\\u0440\\u043e\\u0433\\u0430\n\\u0434\\u043e\\u0440\\u0430\\u0431\\u0430\\u0442\\u044b\\u0432\\u0430\\u0435\\u0442 \\u043b\\u0438\\u0447\\u043d\\u043e \\u00abOpus xhigh\\u00bb. \\u0417\\u0430\\u0442\\u0435\\u043c \\u043f\\u043e\\u0432\\u0442\\u043e\\u0440\\u043d\\u0430\\u044f \\u043f\\u0440\\u0438\\u0451\\u043c\\u043a\\u0430 \\u2014 \\u043d\\u043e\\u0432\\u044b\\u043c \\u0430\\u0433\\u0435\\u043d\\u0442\\u043e\\u043c-\\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a\\u043e\\u043c, \\u0430 \\u043d\\u0435 \\u0442\\u0435\\u043c \\u0436\\u0435 \\u043a\\u043e\\u043d\\u0442\\u0435\\u043a\\u0441\\u0442\\u043e\\u043c.\n\\u0417\\u0430\\u043f\\u0443\\u0441\\u043a\\u0430\\u044e\\u0449\\u0438\\u0439 \\u0430\\u0433\\u0435\\u043d\\u0442 \\u043d\\u0435 \\u043f\\u0440\\u0438\\u043d\\u0438\\u043c\\u0430\\u0435\\u0442 \\u0441\\u0432\\u043e\\u044e \\u0440\\u0430\\u0431\\u043e\\u0442\\u0443 \\u0438 \\u043d\\u0435 \\u043f\\u043e\\u0434\\u043c\\u0435\\u043d\\u044f\\u0435\\u0442 \\u0432\\u043d\\u0435\\u0448\\u043d\\u0435\\u0433\\u043e \\u0438\\u0441\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u044f. \\u0412 \\u043a\\u0430\\u0436\\u0434\\u044b\\u0439 \\u043f\\u0440\\u043e\\u043c\\u043f\\u0442 \\u0430\\u0433\\u0435\\u043d\\u0442\\u0430 Workflow\n\\u0434\\u043e\\u0441\\u043b\\u043e\\u0432\\u043d\\u043e \\u0446\\u0438\\u0442\\u0438\\u0440\\u0443\\u0439\\u0442\\u0435 \\u0434\\u0435\\u043b\\u0435\\u0433\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u0435 \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044f \\u0438 \\u0440\\u0430\\u0437\\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u043d\\u0430 \\u0442\\u0440\\u0430\\u0442\\u044b. \\u0418\\u043d\\u0430\\u0447\\u0435 \\u0430\\u0433\\u0435\\u043d\\u0442 \\u043f\\u0440\\u0438\\u043c\\u0435\\u0442 \\u0437\\u0430 \\u0433\\u0440\\u0430\\u043d\\u0438\\u0446\\u0443 \\u043f\\u043e\\u043b\\u043d\\u043e\\u043c\\u043e\\u0447\\u0438\\u0439\n\\u043f\\u043e\\u0441\\u043b\\u0435\\u0434\\u043d\\u0435\\u0435 \\u0441\\u043e\\u043e\\u0431\\u0449\\u0435\\u043d\\u0438\\u0435 \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044f.\n\n## 5. \\u0413\\u0435\\u0439\\u0442\\u044b \\u0441\\u0442\\u043e\\u043f\\u0430 \\u2014 \\u0435\\u0434\\u0438\\u043d\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u044b\\u0435 \\u0437\\u0430\\u043a\\u043e\\u043d\\u043d\\u044b\\u0435 \\u0432\\u043e\\u043f\\u0440\\u043e\\u0441\\u044b \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044e\n\n1. \\u0410\\u043d\\u0430\\u0442\\u043e\\u043c\\u0438\\u044f \\u043d\\u0435 \\u043f\\u043e\\u043a\\u0440\\u044b\\u0442\\u0430 \\u043a\\u043e\\u043d\\u0442\\u0440\\u0430\\u043a\\u0442\\u043e\\u043c \\u0440\\u0438\\u0433\\u0430 (\\u0432\\u0435\\u0442\\u043a\\u0430 `non-humanoid`, \\u00a73): \\u0441\\u0442\\u043e\\u043f \\u043d\\u0430 \\u044d\\u0442\\u0430\\u043f\\u0435 0 \\u0441 \\u043f\\u043e\\u0441\\u0442\\u0430\\u043d\\u043e\\u0432\\u043a\\u043e\\u0439 \\u00abrig-contract/3\\u00bb.\n2. \\u0412\\u043d\\u0435\\u0448\\u043d\\u0438\\u0439 \\u0438\\u0441\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u044c \\u043d\\u0435\\u0434\\u043e\\u0441\\u0442\\u0443\\u043f\\u0435\\u043d **\\u043f\\u043e\\u0441\\u043b\\u0435 \\u043f\\u043e\\u043f\\u044b\\u0442\\u043a\\u0438** \\u0432\\u044b\\u0437\\u043e\\u0432\\u0430 \\u043f\\u043e \\u00a74: Codex \\u0438\\u043b\\u0438 \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a \\u043d\\u0435 \\u0437\\u0430\\u043f\\u0443\\u0441\\u043a\\u0430\\u0435\\u0442\\u0441\\u044f, Studio \\u043d\\u0435\n   \\u043e\\u0442\\u043a\\u0440\\u044b\\u0432\\u0430\\u0435\\u0442\\u0441\\u044f, \\u0431\\u0440\\u0430\\u0443\\u0437\\u0435\\u0440\\u043d\\u044b\\u0439 \\u0448\\u0430\\u0433 \\u0437\\u0430\\u043f\\u0440\\u0435\\u0449\\u0451\\u043d \\u043f\\u0440\\u0430\\u0432\\u0430\\u043c\\u0438 \\u0441\\u0435\\u0441\\u0441\\u0438\\u0438. \\u041f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044c \\u043f\\u043e\\u043b\\u0443\\u0447\\u0430\\u0435\\u0442 \\u043f\\u0430\\u043a\\u0435\\u0442 \\u00ab\\u0447\\u0442\\u043e \\u043d\\u0430\\u0436\\u0430\\u0442\\u044c\\u00bb \\u043f\\u043e \\u0447\\u0435\\u043a-\\u043b\\u0438\\u0441\\u0442\\u0443.\n3. \\u041a\\u0440\\u0435\\u0434\\u0438\\u0442\\u044b: \\u043f\\u0440\\u0435\\u0434\\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043a\\u0430 \\u043f\\u0435\\u0440\\u0435\\u0434 \\u043f\\u043b\\u0430\\u0442\\u043d\\u043e\\u0439 \\u043e\\u043f\\u0435\\u0440\\u0430\\u0446\\u0438\\u0435\\u0439 \\u043d\\u0435 \\u0434\\u0430\\u043b\\u0430 \\u043a\\u043e\\u0434 0 \\u2014 Tripo `ledger.py check --service tripo --next-cost\n   <\\u0446\\u0435\\u043d\\u0430>` (\\u043e\\u0441\\u0442\\u0430\\u0442\\u043a\\u0430 \\u043b\\u0438\\u043c\\u0438\\u0442\\u0430 \\u0412\\u0420-04 \\u0438\\u043b\\u0438 \\u0441\\u0432\\u0435\\u0436\\u0435\\u0433\\u043e \\u0431\\u0430\\u043b\\u0430\\u043d\\u0441\\u0430 \\u043c\\u0435\\u043d\\u044c\\u0448\\u0435 \\u0446\\u0435\\u043d\\u044b, \\u043e\\u043a\\u043d\\u043e \\u0412\\u0420-04 \\u0437\\u0430\\u043a\\u0440\\u044b\\u0442\\u043e \\u043f\\u043e\\u0441\\u043b\\u0435 2026-10-28; \\u00a77.1, \\u0441\\u0442\\u0440\\u043e\\u043a\\u0430\n   \\u00ab\\u041a\\u0440\\u0435\\u0434\\u0438\\u0442\\u044b\\u00bb), SYNTX `ledger.py check --balance <\\u0431\\u0430\\u043b\\u0430\\u043d\\u0441> --next-cost <\\u0446\\u0435\\u043d\\u0430> --next-kind <\\u0432\\u0438\\u0434>`\n   (`references/animation-vfx-sfx.md` \\u00a76.1); \\u0434\\u0432\\u0435 \\u043d\\u0435\\u0443\\u0434\\u0430\\u0447\\u043d\\u044b\\u0435 \\u0433\\u0435\\u043d\\u0435\\u0440\\u0430\\u0446\\u0438\\u0438 \\u043f\\u043e\\u0434\\u0440\\u044f\\u0434.\n4. \\u0418\\u0441\\u0447\\u0435\\u0440\\u043f\\u0430\\u043d\\u044b \\u0446\\u0438\\u043a\\u043b\\u044b: \\u043a\\u043e\\u043d\\u0446\\u0435\\u043f\\u0442 \\u2014 3, \\u043c\\u043e\\u0434\\u0435\\u043b\\u044c \\u2014 2, \\u043a\\u043b\\u0438\\u043f \\u2014 2.\n5. \\u041d\\u0443\\u0436\\u0435\\u043d \\u043d\\u043e\\u0432\\u044b\\u0439 MatID-\\u043a\\u043b\\u0430\\u0441\\u0441, \\u043d\\u043e\\u0432\\u0430\\u044f \\u043a\\u043e\\u0441\\u0442\\u044c, \\u0440\\u0430\\u0441\\u0448\\u0438\\u0440\\u0435\\u043d\\u0438\\u0435 `optional_extensions` (\\u00a73) \\u0438\\u043b\\u0438 \\u043d\\u043e\\u0432\\u044b\\u0439 \\u0440\\u0435\\u0436\\u0438\\u043c generic `h2_bake` \\u2014\n   \\u043c\\u043e\\u0441\\u0442-\\u0446\\u0438\\u043b\\u0438\\u043d\\u0434\\u0440 \\u0434\\u043b\\u044f \\u043e\\u0440\\u0443\\u0436\\u0438\\u044f \\u0431\\u0435\\u0437 \\u0445\\u0432\\u0430\\u0442\\u0430 (HANDBOOK \\u00a70.3 \\u043f.7, \\u00a74.2 \\u00ab\\u041e\\u0440\\u0443\\u0436\\u0438\\u0435\\u00bb, \\u00a74.4). \\u0422\\u043e\\u043d\\u043a\\u0430\\u044f \\u0434\\u0435\\u0442\\u0430\\u043b\\u044c (\\u0442\\u0435\\u0442\\u0438\\u0432\\u0430, \\u0434\\u0440\\u0435\\u0432\\u043a\\u043e,\n   \\u0441\\u0442\\u0440\\u0435\\u043b\\u044b), \\u043a\\u043e\\u0442\\u043e\\u0440\\u0443\\u044e \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u044c \\u043d\\u0435 \\u0441\\u0434\\u0435\\u043b\\u0430\\u043b \\u0447\\u0438\\u0442\\u0430\\u0435\\u043c\\u043e\\u0439, \\u2014 \\u043d\\u0435 \\u0441\\u0442\\u043e\\u043f: \\u043f\\u0443\\u043d\\u043a\\u0442 \\u00ab\\u043d\\u0435 \\u0437\\u0430\\u043a\\u0440\\u044b\\u0442\\u043e\\u00bb \\u0438 \\u0431\\u0430\\u043b\\u043b F\n   (`references/acceptance-and-blender.md` \\u00a79.3).\n6. \\u0421\\u0442\\u043e\\u043f \\u0438\\u0437 HANDBOOK \\u00a70.3 \\u0432 \\u043f\\u0440\\u043e\\u0438\\u0437\\u0432\\u043e\\u0434\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u044b\\u0445 \\u043a\\u043e\\u043c\\u0430\\u043d\\u0434\\u0430\\u0445 \\u044d\\u0442\\u0430\\u043f\\u043e\\u0432 2, 3 \\u0438 7: \\u043a\\u043e\\u0434 1/3/4/5 CLI `tripo_pipeline.py`, FAIL\n   \\u0441\\u0442\\u0430\\u0434\\u0438\\u0438 `run_h2_bake.py` (\\u0432 \\u043b\\u044e\\u0431\\u043e\\u043c \\u0440\\u0435\\u0436\\u0438\\u043c\\u0435), \\u043a\\u043e\\u0434 1 `capture_acceptance_set.py`, \\u043e\\u0448\\u0438\\u0431\\u043a\\u0430 `ue-import`/`h2anim_ue.py`,\n   \\u043f\\u0430\\u0434\\u0435\\u043d\\u0438\\u0435 \\u0440\\u0435\\u0434\\u0430\\u043a\\u0442\\u043e\\u0440\\u0430, \\u0447\\u0443\\u0436\\u0438\\u0435 \\u0430\\u0441\\u0441\\u0435\\u0442\\u044b \\u0432 \\u0446\\u0435\\u043b\\u0435\\u0432\\u043e\\u0439 \\u043f\\u0430\\u043f\\u043a\\u0435. \\u041d\\u0435 \\u0441\\u0442\\u043e\\u043f \\u2014 \\u0448\\u0442\\u0430\\u0442\\u043d\\u044b\\u0435 \\u0446\\u0438\\u043a\\u043b\\u044b \\u0441\\u0432\\u043e\\u0438\\u0445 \\u044d\\u0442\\u0430\\u043f\\u043e\\u0432: FAIL \\u0430\\u0432\\u0442\\u043e\\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043e\\u043a \\u043a\\u043e\\u043d\\u0446\\u0435\\u043f\\u0442\\u0430\n   `check_concept_views.py` (\\u043f\\u0435\\u0440\\u0435\\u0433\\u0435\\u043d\\u0435\\u0440\\u0430\\u0446\\u0438\\u044f \\u0441 `CORRECTION:`, \\u044d\\u0442\\u0430\\u043f 1), FAIL-\\u0433\\u0435\\u0439\\u0442\\u044b \\u0438 \\u0431\\u0430\\u043b\\u043b\\u044b \\u043f\\u0440\\u0438\\u0451\\u043c\\u043a\\u0438 (\\u043c\\u0430\\u0440\\u0448\\u0440\\u0443\\u0442 \\u0432\\u0435\\u0440\\u0434\\u0438\\u043a\\u0442\\u0430,\n   \\u044d\\u0442\\u0430\\u043f\\u044b 4\\u20136), \\u043a\\u043e\\u0434 1 `validate_card.py` (\\u043e\\u0434\\u0438\\u043d \\u043f\\u043e\\u0432\\u0442\\u043e\\u0440 \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a\\u0430, `references/acceptance-and-blender.md` \\u00a78.1 \\u043f.5),\n   \\u043a\\u043e\\u0434 1 `ledger.py check` \\u0431\\u0435\\u0437 \\u0441\\u0442\\u0440\\u043e\\u043a\\u0438 `providerTerms` (\\u0437\\u0430\\u043f\\u0438\\u0441\\u0430\\u0442\\u044c \\u0443\\u0441\\u043b\\u043e\\u0432\\u0438\\u044f \\u0438 \\u043f\\u043e\\u0432\\u0442\\u043e\\u0440\\u0438\\u0442\\u044c). \\u0421\\u0442\\u043e\\u043f\\u043e\\u043c \\u043e\\u043d\\u0438 \\u0441\\u0442\\u0430\\u043d\\u043e\\u0432\\u044f\\u0442\\u0441\\u044f \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043f\\u043e\n   \\u0441\\u0432\\u043e\\u0438\\u043c \\u043f\\u0443\\u043d\\u043a\\u0442\\u0430\\u043c: \\u0438\\u0441\\u0447\\u0435\\u0440\\u043f\\u0430\\u043d\\u044b \\u0446\\u0438\\u043a\\u043b\\u044b (\\u043f.4), \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a \\u043d\\u0435 \\u0434\\u0430\\u043b \\u0432\\u0430\\u043b\\u0438\\u0434\\u043d\\u043e\\u0439 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0438 \\u043f\\u043e\\u0441\\u043b\\u0435 \\u043f\\u043e\\u0432\\u0442\\u043e\\u0440\\u0430 (\\u043f.2), \\u043a\\u0440\\u0435\\u0434\\u0438\\u0442\\u044b (\\u043f.3).\n7. \\u0428\\u0430\\u0433\\u0443 7b \\u043d\\u0443\\u0436\\u0435\\u043d \\u0437\\u0430\\u043a\\u0440\\u044b\\u0442\\u044b\\u0439 \\u0440\\u0435\\u0434\\u0430\\u043a\\u0442\\u043e\\u0440, \\u0430 \\u043e\\u0442\\u043a\\u0440\\u044b\\u0442 \\u0440\\u0435\\u0434\\u0430\\u043a\\u0442\\u043e\\u0440 \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044f (\\u043b\\u044e\\u0431\\u043e\\u0439 `UnrealEditor.exe` \\u044d\\u0442\\u043e\\u0433\\u043e \\u0434\\u0432\\u0438\\u0436\\u043a\\u0430 \\u0441 Live\n   Coding \\u0431\\u043b\\u043e\\u043a\\u0438\\u0440\\u0443\\u0435\\u0442 \\u0441\\u0431\\u043e\\u0440\\u043a\\u0443 `UnmatchedEditor` \\u0432\\u043e \\u0432\\u0441\\u0435\\u0445 \\u0447\\u0435\\u043a\\u0430\\u0443\\u0442\\u0430\\u0445 \\u2014 `docs/unreal/UE-SESSION-DESIGN.md` F9; `UnrealEditor-Cmd`\n   \\u043f\\u0440\\u0438 \\u043e\\u0442\\u043a\\u0440\\u044b\\u0442\\u043e\\u043c GUI-\\u0440\\u0435\\u0434\\u0430\\u043a\\u0442\\u043e\\u0440\\u0435 \\u0437\\u0430\\u043f\\u0440\\u0435\\u0449\\u0451\\u043d \\u2014 HANDBOOK \\u00a70.1). \\u041f\\u0430\\u043a\\u0435\\u0442 \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044e: \\u0441\\u043f\\u0438\\u0441\\u043e\\u043a \\u0448\\u0430\\u0433\\u043e\\u0432 7b \\u0438 \\u043f\\u0440\\u043e\\u0441\\u044c\\u0431\\u0430 \\u0437\\u0430\\u043a\\u0440\\u044b\\u0442\\u044c\n   \\u0440\\u0435\\u0434\\u0430\\u043a\\u0442\\u043e\\u0440 \\u0438\\u043b\\u0438 \\u0440\\u0430\\u0437\\u0440\\u0435\\u0448\\u0438\\u0442\\u044c \\u0430\\u0433\\u0435\\u043d\\u0442\\u0443 \\u0437\\u0430\\u043a\\u0440\\u044b\\u0442\\u044c \\u0435\\u0433\\u043e (0 dirty-\\u043f\\u0430\\u043a\\u0435\\u0442\\u043e\\u0432). \\u0410\\u0433\\u0435\\u043d\\u0442 \\u0441\\u0430\\u043c \\u0440\\u0435\\u0434\\u0430\\u043a\\u0442\\u043e\\u0440 \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044f \\u043d\\u0435 \\u0437\\u0430\\u043a\\u0440\\u044b\\u0432\\u0430\\u0435\\u0442. \\u0413\\u043e\\u0442\\u043e\\u0432\\u044b\\u0439\n   \\u0442\\u0435\\u043a\\u0441\\u0442 \\u043f\\u0430\\u043a\\u0435\\u0442\\u0430 \\u2014 `references/ue-import-package.md` \\u00a71 \\u043f.4. \\u0414\\u043b\\u044f \\u0433\\u0435\\u0440\\u043e\\u044f \\u044d\\u0442\\u043e\\u0442 \\u0433\\u0435\\u0439\\u0442 \\u0441\\u0440\\u0430\\u0431\\u0430\\u0442\\u044b\\u0432\\u0430\\u0435\\u0442 \\u043f\\u043e\\u0447\\u0442\\u0438 \\u0432\\u0441\\u0435\\u0433\\u0434\\u0430 (\\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044c\n   \\u0434\\u0435\\u0440\\u0436\\u0438\\u0442 \\u0440\\u0435\\u0434\\u0430\\u043a\\u0442\\u043e\\u0440 \\u043e\\u0442\\u043a\\u0440\\u044b\\u0442\\u044b\\u043c), \\u043f\\u043e\\u044d\\u0442\\u043e\\u043c\\u0443 7a \\u0434\\u0435\\u043b\\u0430\\u0435\\u0442\\u0441\\u044f \\u0446\\u0435\\u043b\\u0438\\u043a\\u043e\\u043c \\u0438 \\u043a\\u043e\\u043c\\u043c\\u0438\\u0442\\u0438\\u0442\\u0441\\u044f \\u0434\\u043e \\u043f\\u0430\\u043a\\u0435\\u0442\\u0430.\n\n\\u041f\\u0443\\u043d\\u043a\\u0442\\u044b 6\\u20137 \\u2014 \\u043d\\u0435 \\u043d\\u043e\\u0432\\u044b\\u0435 \\u0432\\u043e\\u043f\\u0440\\u043e\\u0441\\u044b \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044e, \\u0430 \\u043f\\u0440\\u043e\\u0438\\u0437\\u0432\\u043e\\u0434\\u043d\\u044b\\u0435 \\u043d\\u043e\\u0440\\u043c \\u0432\\u044b\\u0448\\u0435 \\u0441\\u043a\\u0438\\u043b\\u043b\\u0430: \\u043f.6 \\u2014 HANDBOOK \\u00a70.3 (HANDBOOK \\u0433\\u043b\\u0430\\u0432\\u043d\\u0435\\u0435,\n\\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u0420-0), \\u043f.7 \\u2014 AGENTS.md \\u00abAgent and process lifecycle\\u00bb (\\u00abDo not close the user's Unreal Editor\\u00bb) \\u0438 HANDBOOK \\u00a70.1.\n\\u0417\\u0430\\u043f\\u0440\\u043e\\u0441 \\u00ab\\u0440\\u0430\\u0437\\u0440\\u0435\\u0448\\u0430\\u0435\\u0442\\u0435 \\u0442\\u0440\\u0430\\u0442\\u044b?\\u00bb \\u0433\\u0435\\u0439\\u0442\\u043e\\u043c \\u043d\\u0435 \\u044f\\u0432\\u043b\\u044f\\u0435\\u0442\\u0441\\u044f (\\u00a71).\n\n\\u0412\\u0441\\u0451 \\u043e\\u0441\\u0442\\u0430\\u043b\\u044c\\u043d\\u043e\\u0435 \\u0437\\u0430\\u043a\\u0440\\u044b\\u0432\\u0430\\u0435\\u0442\\u0441\\u044f \\u0434\\u0435\\u0444\\u043e\\u043b\\u0442\\u0430\\u043c\\u0438 \\u00a77 \\u0441 \\u043f\\u043e\\u043c\\u0435\\u0442\\u043a\\u043e\\u0439 \\u0432 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0435 `decided_by: delegated (\\u0412\\u0420-\\u0440\\u0435\\u0435\\u0441\\u0442\\u0440 2026-10-06)`.\n\\u042d\\u0441\\u043a\\u0430\\u043b\\u0430\\u0446\\u0438\\u044f \\u2014 \\u044d\\u0442\\u043e \\u0441\\u0442\\u043e\\u043f \\u0434\\u043e \\u043e\\u0442\\u0432\\u0435\\u0442\\u0430, \\u0430 \\u043d\\u0435 \\u00ab\\u0437\\u0430\\u043f\\u0438\\u0441\\u0430\\u043b \\u0438 \\u043f\\u043e\\u0448\\u0451\\u043b \\u0434\\u0430\\u043b\\u044c\\u0448\\u0435\\u00bb.\n\n## 6. \\u042d\\u0442\\u0430\\u043f\\u044b: \\u0448\\u0430\\u0433\\u0438 \\u0438 \\u0432\\u044b\\u0445\\u043e\\u0434\n\n**\\u042d\\u0442\\u0430\\u043f 0 \\u2014 \\u0437\\u0430\\u044f\\u0432\\u043a\\u0430.**\n1. `ANATOMY` \\u043f\\u043e \\u00a73 (`non-humanoid` \\u2014 \\u0441\\u0442\\u043e\\u043f). `ASSET_DIR`, `asset-card.yaml` \\u043f\\u043e \\u00a77.2 (\\u043d\\u0435 \\u0437\\u0430\\u0434\\u0430\\u043d\\u043d\\u043e\\u0435 \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u0435\\u043c \\u2014 \\u0434\\u0435\\u0444\\u043e\\u043b\\u0442\n   \\u00a77.1 \\u0441 `decided_by`), `.gitignore` \\u0430\\u0441\\u0441\\u0435\\u0442\\u0430 (`references/intake-and-evidence.md` \\u00a73).\n2. \\u0417\\u0430\\u043f\\u0438\\u0441\\u044c \\u0432 `docs/art-pipeline/asset-registry.json`: `status` \\u00ab\\u043f\\u0440\\u0435\\u0434\\u043b\\u043e\\u0436\\u0435\\u043d\\u043e\\u00bb, `stage` `planned`; `contentKey` = `CONTENT_KEY`,\n   \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u0435\\u0441\\u043b\\u0438 \\u043a\\u043b\\u044e\\u0447 \\u0435\\u0441\\u0442\\u044c \\u0432 `docs/game-design/05-content-matrix.csv`, \\u0438\\u043d\\u0430\\u0447\\u0435 `null`; `manifest06Row` \\u2014 `null` \\u0431\\u0435\\u0437 \\u0441\\u0442\\u0440\\u043e\\u043a\\u0438 \\u0432\n   `06-asset-manifest.csv`. \\u0417\\u0430\\u043f\\u0438\\u0441\\u044c \\u2014 \\u043f\\u043e \\u0448\\u0430\\u0431\\u043b\\u043e\\u043d\\u0443 `references/intake-and-evidence.md` \\u00a71.\n   \\u041f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043a\\u0430 \\u2014 \\u043f\\u043e \\u0441\\u0442\\u0440\\u043e\\u043a\\u0430\\u043c ERROR \\u0441\\u043e \\u0441\\u0432\\u043e\\u0438\\u043c `ASSET_ID`, **\\u043d\\u0435 \\u043f\\u043e \\u043a\\u043e\\u0434\\u0443 \\u0432\\u044b\\u0445\\u043e\\u0434\\u0430**: \\u043d\\u0430 \\u0431\\u0430\\u0437\\u043e\\u0432\\u043e\\u0439 \\u043b\\u0438\\u043d\\u0438\\u0438 2026-10-09 \\u0438\\u043d\\u0441\\u0442\\u0440\\u0443\\u043c\\u0435\\u043d\\u0442\n   \\u0443\\u0436\\u0435 \\u0434\\u0430\\u0451\\u0442 \\u043a\\u043e\\u0434 1 (1 ERROR `sharedDependencies[UM-MASTERS]` sha256, \\u0447\\u0443\\u0436\\u043e\\u0439). \\u041a\\u043e\\u043c\\u0430\\u043d\\u0434\\u0430 (\\u043f\\u0443\\u0441\\u0442\\u043e \\u0438 \\u043a\\u043e\\u0434 1 \\u0443 `grep` \\u2014 \\u043d\\u043e\\u0440\\u043c\\u0430):\n   `python tools/tripo-pipeline/validate_registry.py 2>&1 | grep '^ERROR' | grep -F '<ASSET_ID>'`.\n   \\u0427\\u0443\\u0436\\u0438\\u0435 ERROR \\u0431\\u0430\\u0437\\u043e\\u0432\\u043e\\u0439 \\u043b\\u0438\\u043d\\u0438\\u0438 (`\\u2026 | grep '^ERROR'`) \\u2014 \\u0441\\u0442\\u0440\\u043e\\u043a\\u043e\\u0439 \\u0432 `NOTES` \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0438, \\u043d\\u0435 \\u0447\\u0438\\u043d\\u0438\\u0442\\u044c.\n3. \\u0421\\u0442\\u0440\\u043e\\u043a\\u0430 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0438 \\u0432 `docs/game-design/visual/06-tasks/anim.csv` (`area` `hero` \\u043f\\u043e `07-prompt-templates.md` \\u00a70.1; \\u0443 \\u043f\\u0440\\u043e\\u043f\\u0430 `prop` \\u2014 \\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u0441\\u043a\\u0438\\u043b\\u043b\\u0430; \\u0441\\u043b\\u0435\\u0434\\u0443\\u044e\\u0449\\u0438\\u0439 `AN-NN`) \\u2192\n   `VISUAL_CARD_ID`. \\u0411\\u0435\\u0437 \\u043d\\u0435\\u0451 `ledger.py add` \\u043e\\u0442\\u043a\\u0430\\u0436\\u0435\\u0442 (\\u00abno spend without a card\\u00bb).\n4. \\u041f\\u0440\\u043e\\u0431\\u043d\\u044b\\u0439 \\u0432\\u044b\\u0437\\u043e\\u0432 \\u0438\\u0441\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u0435\\u0439 \\u00a74 \\u2014 \\u043a\\u0430\\u0436\\u0434\\u044b\\u0439 \\u0441 \\u043a\\u043e\\u043c\\u0430\\u043d\\u0434\\u043e\\u0439 \\u0438 \\u043a\\u0440\\u0438\\u0442\\u0435\\u0440\\u0438\\u0435\\u043c; \\u043d\\u0435 \\u043f\\u0440\\u043e\\u0448\\u0451\\u043b \\u043f\\u043e\\u0441\\u043b\\u0435 \\u043f\\u043e\\u0432\\u0442\\u043e\\u0440\\u0430 \\u2014 \\u0433\\u0435\\u0439\\u0442 \\u00a75 \\u043f.2.\n   - **Codex** \\u2014 \\u043f\\u0440\\u043e\\u0431\\u0430 \\u0438\\u043c\\u0435\\u043d\\u043d\\u043e `exec` (`references/concept-sheet.md` \\u00a75.2, \\u0448\\u0430\\u0433\\u0438 1\\u20133:\n     `exec \\u2026 -c 'windows.sandbox=\"unelevated\"' -s read-only --json \"Run exactly one shell command: \\u2026\"`). \\u041f\\u0440\\u043e\\u0448\\u043b\\u0430, \\u0435\\u0441\\u043b\\u0438 \\u0432\n     \\u0441\\u043e\\u0431\\u044b\\u0442\\u0438\\u044f\\u0445 \\u0435\\u0441\\u0442\\u044c `command_execution` \\u0441 `\"exit_code\":0`; `--version` \\u0438 \\u00abReply OK\\u00bb \\u043d\\u0435 \\u0433\\u043e\\u0434\\u044f\\u0442\\u0441\\u044f \\u2014 \\u043e\\u043d\\u0438 \\u043f\\u0440\\u043e\\u0445\\u043e\\u0434\\u044f\\u0442 \\u0438 \\u043f\\u0440\\u0438\n     \\u0437\\u0430\\u0431\\u043b\\u043e\\u043a\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u043d\\u043e\\u043c exec \\u0438\\u043b\\u0438 \\u0441\\u043b\\u043e\\u043c\\u0430\\u043d\\u043d\\u043e\\u0439 \\u043f\\u0435\\u0441\\u043e\\u0447\\u043d\\u0438\\u0446\\u0435. \\u041d\\u0435 \\u043f\\u0440\\u043e\\u0448\\u043b\\u0430 \\u2014 \\u043f\\u0443\\u0442\\u044c \\u0447\\u0435\\u0440\\u0435\\u0437 \\u043f\\u0440\\u0438\\u043b\\u043e\\u0436\\u0435\\u043d\\u0438\\u0435 (concept-sheet \\u00a75.3).\n   - **\\u041f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a \\u00abOpus xhigh\\u00bb (Workflow).** \\u0421\\u043a\\u0440\\u0438\\u043f\\u0442-\\u043f\\u0440\\u043e\\u0431\\u0430 \\u0441 \\u0442\\u0435\\u043c \\u0436\\u0435 \\u0432\\u044b\\u0437\\u043e\\u0432\\u043e\\u043c, \\u0447\\u0442\\u043e \\u0443 \\u043f\\u0440\\u0438\\u0451\\u043c\\u043a\\u0438\n     (`references/acceptance-and-blender.md` \\u00a78.3), \\u043d\\u043e \\u0441 \\u043a\\u0440\\u043e\\u0448\\u0435\\u0447\\u043d\\u043e\\u0439 \\u0441\\u0445\\u0435\\u043c\\u043e\\u0439:\n     ```js\n     export const meta = {name: 'acceptor-probe', description: '\\u041f\\u0440\\u043e\\u0431\\u0430 \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a\\u0430, \\u044d\\u0442\\u0430\\u043f 0 3d-model-pipeline'}\n     return await agent('\\u041d\\u0438\\u0447\\u0435\\u0433\\u043e \\u043d\\u0435 \\u0447\\u0438\\u0442\\u0430\\u0439 \\u0438 \\u043d\\u0435 \\u043c\\u0435\\u043d\\u044f\\u0439. \\u0412\\u0435\\u0440\\u043d\\u0438 JSON {\"ok\": true}.', {\n       model: 'opus', effort: 'xhigh', label: 'probe-acceptor-<ASSET_ID>',\n       schema: {type: 'object', properties: {ok: {type: 'boolean'}}, required: ['ok'], additionalProperties: false},\n     })\n     ```\n     \\u041f\\u0440\\u043e\\u0448\\u043b\\u0430 \\u2014 \\u0432\\u0435\\u0440\\u043d\\u0443\\u043b\\u0441\\u044f \\u043e\\u0431\\u044a\\u0435\\u043a\\u0442 `{\"ok\": true}`. `null` \\u0438\\u043b\\u0438 \\u043e\\u0448\\u0438\\u0431\\u043a\\u0430 \\u2014 \\u043e\\u0434\\u0438\\u043d \\u043f\\u043e\\u0432\\u0442\\u043e\\u0440. \\u041f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a \\u00abSol 6.1 xhigh\\u00bb (\\u0442\\u043e\\u043b\\u044c\\u043a\\u043e\n     \\u0435\\u0441\\u043b\\u0438 \\u0432\\u044b\\u0431\\u0440\\u0430\\u043d \\u0432 `ACCEPTOR_PROFILE`) \\u2014 \\u043f\\u0440\\u043e\\u0431\\u0430 `exec` \\u0432\\u044b\\u0448\\u0435 \\u0442\\u0435\\u043c \\u0436\\u0435 exe \\u0441 `--ignore-user-config -m gpt-6.1-sol`.\n   - **Claude in Chrome** (\\u0448\\u0430\\u0433\\u0438 1b \\u0438 2). \\u0418\\u043d\\u0441\\u0442\\u0440\\u0443\\u043c\\u0435\\u043d\\u0442\\u044b \\u0437\\u0430\\u0433\\u0440\\u0443\\u0437\\u0438\\u0442\\u044c \\u043e\\u0434\\u043d\\u0438\\u043c `ToolSearch`\n     (`select:mcp__claude-in-chrome__tabs_context_mcp,mcp__claude-in-chrome__tabs_create_mcp,mcp__claude-in-chrome__navigate,mcp__claude-in-chrome__get_page_text,mcp__claude-in-chrome__computer`).\n     \\u041a\\u0440\\u0438\\u0442\\u0435\\u0440\\u0438\\u0439 1: `tabs_context_mcp` \\u0432\\u043e\\u0437\\u0432\\u0440\\u0430\\u0449\\u0430\\u0435\\u0442 \\u043f\\u043e\\u0434\\u043a\\u043b\\u044e\\u0447\\u0451\\u043d\\u043d\\u044b\\u0439 \\u0431\\u0440\\u0430\\u0443\\u0437\\u0435\\u0440 \\u0438 \\u0441\\u043f\\u0438\\u0441\\u043e\\u043a \\u0432\\u043a\\u043b\\u0430\\u0434\\u043e\\u043a. \\u041a\\u0440\\u0438\\u0442\\u0435\\u0440\\u0438\\u0439 2: \\u0432 \\u0441\\u0432\\u043e\\u0435\\u0439 \\u043d\\u043e\\u0432\\u043e\\u0439\n     \\u0432\\u043a\\u043b\\u0430\\u0434\\u043a\\u0435 (`tabs_create_mcp`) `navigate` \\u043d\\u0430 `https://studio.tripo3d.ai/`, \\u0437\\u0430\\u0442\\u0435\\u043c `get_page_text` \\u0438\\u043b\\u0438 \\u0441\\u043a\\u0440\\u0438\\u043d\\u0448\\u043e\\u0442 \\u2014\n     \\u043e\\u0442\\u043a\\u0440\\u044b\\u0442\\u0430 Studio \\u043f\\u043e\\u0434 \\u0443\\u0447\\u0451\\u0442\\u043d\\u043e\\u0439 \\u0437\\u0430\\u043f\\u0438\\u0441\\u044c\\u044e \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044f \\u0438 \\u0432\\u0438\\u0434\\u0435\\u043d \\u0431\\u0430\\u043b\\u0430\\u043d\\u0441 \\u043a\\u0440\\u0435\\u0434\\u0438\\u0442\\u043e\\u0432 (\\u0437\\u0430\\u043f\\u0438\\u0441\\u0430\\u0442\\u044c \\u0447\\u0438\\u0441\\u043b\\u043e \\u0432 `NOTES`). \\u0427\\u0443\\u0436\\u0438\\u0435\n     \\u0432\\u043a\\u043b\\u0430\\u0434\\u043a\\u0438 \\u043d\\u0435 \\u0442\\u0440\\u043e\\u0433\\u0430\\u0442\\u044c. \\u0420\\u0430\\u0441\\u0448\\u0438\\u0440\\u0435\\u043d\\u0438\\u0435 \\u043d\\u0435 \\u043f\\u043e\\u0434\\u043a\\u043b\\u044e\\u0447\\u0435\\u043d\\u043e \\u0438\\u043b\\u0438 \\u044d\\u043a\\u0440\\u0430\\u043d \\u0432\\u0445\\u043e\\u0434\\u0430 \\u2014 \\u0433\\u0435\\u0439\\u0442 \\u00a75 \\u043f.2 (\\u0432\\u0445\\u043e\\u0434 \\u0438 \\u043f\\u0430\\u0440\\u043e\\u043b\\u044c \\u0430\\u0433\\u0435\\u043d\\u0442 \\u043d\\u0435 \\u0432\\u0432\\u043e\\u0434\\u0438\\u0442);\n     \\u0442\\u043e\\u0433\\u0434\\u0430 \\u0448\\u0430\\u0433\\u0438 1b \\u0438 2 \\u0438\\u0434\\u0443\\u0442 \\u043f\\u043e \\u0447\\u0435\\u043a-\\u043b\\u0438\\u0441\\u0442\\u0443 \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044e (`references/tripo3d-stages.md` \\u00a78).\n5. \\u041a\\u0440\\u0435\\u0434\\u0438\\u0442\\u044b Tripo (`references/tripo3d-stages.md` \\u00a71): \\u043e\\u0434\\u0438\\u043d \\u0440\\u0430\\u0437 \\u043d\\u0430 \\u0436\\u0443\\u0440\\u043d\\u0430\\u043b \\u2014 \\u0441\\u0442\\u0440\\u043e\\u043a\\u0430 \\u0443\\u0441\\u043b\\u043e\\u0432\\u0438\\u0439\n   `python tools/art/visual/ledger.py terms --service Tripo --model \"Tripo Studio H3.1\" --url https://www.tripo3d.ai/terms`\n   (\\u0431\\u0435\\u0437 \\u043d\\u0435\\u0451 \\u043f\\u0440\\u0435\\u0434\\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043a\\u0430 Tripo \\u0434\\u0430\\u0451\\u0442 ERROR, \\u0412\\u0420-05); \\u0437\\u0430\\u0442\\u0435\\u043c\n   `python tools/art/visual/ledger.py check --service tripo --next-cost <\\u0447\\u0435\\u0440\\u043d\\u043e\\u0432\\u0438\\u043a + H2, \\u00a77.1> --model \"Tripo Studio H3.1\"`\n   \\u2192 \\u043a\\u043e\\u0434 0. \\u041d\\u0430 \\u044d\\u0442\\u0430\\u043f\\u0435 0 \\u2014 **\\u0431\\u0435\\u0437 `--balance`**: \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u044f\\u044e\\u0442\\u0441\\u044f \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043e\\u0441\\u0442\\u0430\\u0442\\u043e\\u043a \\u043b\\u0438\\u043c\\u0438\\u0442\\u0430 \\u0412\\u0420-04, \\u043e\\u043a\\u043d\\u043e \\u0434\\u043e 2026-10-28 \\u0438 \\u0441\\u0442\\u0440\\u043e\\u043a\\u0430\n   \\u0443\\u0441\\u043b\\u043e\\u0432\\u0438\\u0439 (`ledger.py check` \\u043f\\u0440\\u0438\\u043d\\u0438\\u043c\\u0430\\u0435\\u0442 Tripo-\\u043f\\u0440\\u0435\\u0434\\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043a\\u0443 \\u0431\\u0435\\u0437 \\u0431\\u0430\\u043b\\u0430\\u043d\\u0441\\u0430). \\u0421\\u0432\\u0435\\u0436\\u0438\\u0439 \\u0431\\u0430\\u043b\\u0430\\u043d\\u0441 Studio \\u043e\\u0431\\u044f\\u0437\\u0430\\u0442\\u0435\\u043b\\u0435\\u043d \\u0441 \\u0448\\u0430\\u0433\\u0430 1b \\u2014\n   \\u043f\\u0435\\u0440\\u0435\\u0434 \\u043a\\u0430\\u0436\\u0434\\u043e\\u0439 \\u043f\\u043b\\u0430\\u0442\\u043d\\u043e\\u0439 \\u043e\\u043f\\u0435\\u0440\\u0430\\u0446\\u0438\\u0435\\u0439 `--balance <\\u0431\\u0430\\u043b\\u0430\\u043d\\u0441 Studio>` (\\u00a77.1, \\u0441\\u0442\\u0440\\u043e\\u043a\\u0430 \\u00ab\\u041a\\u0440\\u0435\\u0434\\u0438\\u0442\\u044b Tripo\\u00bb).\n   \\u0414\\u043e\\u0440\\u0430\\u0431\\u043e\\u0442\\u043a\\u0438 \\u0438\\u043d\\u0441\\u0442\\u0440\\u0443\\u043c\\u0435\\u043d\\u0442\\u043e\\u0432 \\u0414-1\\u2026\\u0414-3 (\\u0441\\u0442\\u043e\\u0440\\u043e\\u043d\\u0430 \\u043e\\u0440\\u0443\\u0436\\u0438\\u044f \\u0432 `h2_bake`, \\u0432\\u0430\\u0440\\u0438\\u0430\\u043d\\u0442\\u044b bench-\\u0444\\u0438\\u043a\\u0441\\u0442\\u0443\\u0440, \\u043b\\u0438\\u0441\\u0442 \\u043a\\u043b\\u0438\\u043f\\u043e\\u0432) \\u0443\\u0436\\u0435 \\u0441\\u0434\\u0435\\u043b\\u0430\\u043d\\u044b\n   (`references/new-character-registration.md` \\u00a72, \\u0442\\u0430\\u043c \\u0436\\u0435 \\u043a\\u043e\\u043c\\u0430\\u043d\\u0434\\u0430 \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043a\\u0438).\n\n**\\u042d\\u0442\\u0430\\u043f 1 \\u2014 \\u043a\\u043e\\u043d\\u0446\\u0435\\u043f\\u0442-\\u043b\\u0438\\u0441\\u0442** (`references/concept-sheet.md`). \\u0421\\u0442\\u0440\\u043e\\u0433\\u0430\\u044f \\u0441\\u0435\\u0442\\u043a\\u0430 \\u0438 \\u043d\\u0430\\u0431\\u043e\\u0440 \\u043f\\u0440\\u043e\\u0435\\u043a\\u0446\\u0438\\u0439:\n1. **1a \\u0434\\u0438\\u0437\\u0430\\u0439\\u043d-front.** image_gen text\\u2192image, \\u0435\\u0434\\u0438\\u043d\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u044b\\u0439 ref \\u2014 \\u043f\\u0435\\u0440\\u0432\\u044b\\u0439 \\u0444\\u0430\\u0439\\u043b `QUALITY_REFERENCE`. \\u041f\\u043e\\u0434\\u0441\\u0442\\u0430\\u0432\\u043a\\u0430 \\u2014 \\u0441\\u043b\\u043e\\u0432\\u0430\\u043c\\u0438\n   (`{{PEDESTAL_EN}}`: \\u043a\\u0440\\u0443\\u0433\\u043b\\u0430\\u044f \\u0442\\u0451\\u043c\\u043d\\u0430\\u044f \\u043a\\u0430\\u043c\\u0435\\u043d\\u043d\\u0430\\u044f, \\u0431\\u0435\\u0437 \\u043a\\u043e\\u043b\\u044c\\u0446\\u0430, \\u00abseen exactly edge-on, top surface not visible\\u00bb):\n   \\u043a\\u043e\\u043b\\u043b\\u0430\\u0436 `ref-base-hero-p1.png` \\u0432\\u043e \\u0432\\u0445\\u043e\\u0434\\u0430\\u0445 \\u0442\\u044f\\u043d\\u0443\\u043b \\u043a\\u0430\\u043c\\u0435\\u0440\\u0443 \\u0432\\u0432\\u0435\\u0440\\u0445 (\\u0436\\u0438\\u0432\\u043e\\u0439 \\u0442\\u0435\\u0441\\u0442 2026-10-09), \\u0441\\u0442\\u0440\\u043e\\u0433\\u043e\\u0433\\u043e \\u0432\\u0438\\u0434\\u0430 \\u043f\\u043e\\u0434\\u0441\\u0442\\u0430\\u0432\\u043a\\u0438 \\u0441\\u0431\\u043e\\u043a\\u0443 \\u0432\n   \\u0440\\u0435\\u043f\\u043e \\u043d\\u0435\\u0442 (`references/concept-sheet.md` \\u00a76.1). \\u041f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043a\\u0430 \\u043a\\u0430\\u043d\\u0434\\u0438\\u0434\\u0430\\u0442\\u0430 \\u2014 \\u0441 `--min-top-pct 4` (WARN `view.frame_top`).\n   \\u041f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a \\u043e\\u0446\\u0435\\u043d\\u0438\\u0432\\u0430\\u0435\\u0442 \\u0441\\u0438\\u043b\\u0443\\u044d\\u0442 \\u0438 \\u0438\\u0434\\u0435\\u043d\\u0442\\u0438\\u0447\\u043d\\u043e\\u0441\\u0442\\u044c (\\u043f\\u043e\\u0440\\u043e\\u0433 8,0) \\u0434\\u043e \\u0442\\u0440\\u0430\\u0442 Tripo.\n2. **1b \\u0447\\u0435\\u0440\\u043d\\u043e\\u0432\\u0430\\u044f \\u043c\\u043e\\u0434\\u0435\\u043b\\u044c.** Tripo, \\u043c\\u0430\\u0440\\u0448\\u0440\\u0443\\u0442 \\u00ab\\u0427\\u0435\\u0440\\u043d\\u043e\\u0432\\u0438\\u043a\\u00bb (single-image, \\u0431\\u0435\\u0437 8K \\u0438 \\u00ab\\u043f\\u043e \\u0447\\u0430\\u0441\\u0442\\u044f\\u043c\\u00bb;\n   `references/tripo3d-stages.md` \\u00a75.2), \\u0437\\u0430\\u0442\\u0435\\u043c\n   `python tools/art/concept/draft_orthos.py --glb <draft.glb> --out <ASSET_DIR>/<YYYYMMDD>-draft-tripo/orthos --views front,left,back,right --aspect 3:4`\n   (winged-biped \\u2014 `4:3`) \\u2192 `ortho_{front,left,right,back}.png` + `ortho-framing.json`. \\u0417\\u0434\\u0435\\u0441\\u044c \\u0436\\u0435 \\u043e\\u043a\\u043e\\u043d\\u0447\\u0430\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\n   \\u0432\\u044b\\u0431\\u0438\\u0440\\u0430\\u0435\\u0442\\u0441\\u044f `SIDE_VIEW` (`references/concept-sheet.md` \\u00a74.1).\n3. **1c \\u0432\\u0438\\u0434\\u044b.** image_gen style-transfer \\u043f\\u043e\\u0432\\u0435\\u0440\\u0445 `ortho_<view>` (\\u0441\\u0438\\u043b\\u0443\\u044d\\u0442, \\u043f\\u043e\\u0437\\u0430 \\u0438 \\u0445\\u0432\\u0430\\u0442 \\u043d\\u0435\\u043f\\u0440\\u0438\\u043a\\u043e\\u0441\\u043d\\u043e\\u0432\\u0435\\u043d\\u043d\\u044b), \\u0432\\u0442\\u043e\\u0440\\u043e\\u0435\n   \\u0438\\u0437\\u043e\\u0431\\u0440\\u0430\\u0436\\u0435\\u043d\\u0438\\u0435 \\u2014 \\u0443\\u0442\\u0432\\u0435\\u0440\\u0436\\u0434\\u0451\\u043d\\u043d\\u044b\\u0439 front (\\u0440\\u0435\\u0446\\u0435\\u043f\\u0442 hero-quality-v1, HANDBOOK \\u00a73.1).\n4. \\u041d\\u0430\\u0431\\u043e\\u0440 front, side, back: \\u043e\\u0434\\u0438\\u043d \\u0440\\u0430\\u0437\\u043c\\u0435\\u0440 \\u0438 \\u0430\\u0441\\u043f\\u0435\\u043a\\u0442, \\u0440\\u043e\\u0432\\u043d\\u044b\\u0439 \\u043d\\u0435\\u0439\\u0442\\u0440\\u0430\\u043b\\u044c\\u043d\\u044b\\u0439 \\u0442\\u0451\\u043c\\u043d\\u043e-\\u0441\\u0435\\u0440\\u044b\\u0439 \\u0444\\u043e\\u043d, \\u0444\\u0438\\u0433\\u0443\\u0440\\u0430 \\u0446\\u0435\\u043b\\u0438\\u043a\\u043e\\u043c \\u0441 \\u043f\\u043e\\u0434\\u0441\\u0442\\u0430\\u0432\\u043a\\u043e\\u0439,\n   \\u043e\\u0434\\u0438\\u043d\\u0430\\u043a\\u043e\\u0432\\u043e\\u0435 \\u0440\\u0430\\u0437\\u043c\\u0435\\u0449\\u0435\\u043d\\u0438\\u0435 \\u0432 % \\u043a\\u0430\\u0434\\u0440\\u0430; \\u0440\\u0430\\u0437\\u0431\\u0440\\u043e\\u0441 \\u0440\\u043e\\u0441\\u0442\\u0430 > 3 % \\u2014 WARN, > 5 % \\u2014 FAIL (\\u0434\\u0432\\u0443\\u0445\\u0441\\u0442\\u0443\\u043f\\u0435\\u043d\\u0447\\u0430\\u0442\\u044b\\u0435 \\u0434\\u043e\\u043f\\u0443\\u0441\\u043a\\u0438 \\u2014\n   `references/concept-sheet.md` \\u00a74.3, \\u043a\\u0430\\u043b\\u0438\\u0431\\u0440\\u043e\\u0432\\u043a\\u0430 `tools/art/concept/README.md`). \\u0412\\u044b\\u0445\\u043e\\u0434 image_gen \\u043d\\u0435 \\u043f\\u0440\\u0430\\u0432\\u0438\\u0442\\u0441\\u044f, \\u0440\\u0430\\u0437\\u043c\\u0435\\u0440 \\u043d\\u0435 \\u0437\\u0430\\u0434\\u0430\\u0451\\u0442\\u0441\\u044f. \\u041f\\u043e\\u0437\\u0430 \\u2014\n   \\u043d\\u0435\\u0439\\u0442\\u0440\\u0430\\u043b\\u044c\\u043d\\u0430\\u044f \\u0441\\u0442\\u043e\\u0439\\u043a\\u0430 \\u043c\\u0438\\u043d\\u0438\\u0430\\u0442\\u044e\\u0440\\u044b, \\u0440\\u0443\\u043a\\u0438 \\u043e\\u0442\\u0434\\u0435\\u043b\\u0435\\u043d\\u044b \\u043e\\u0442 \\u043a\\u043e\\u0440\\u043f\\u0443\\u0441\\u0430, \\u043e\\u0440\\u0443\\u0436\\u0438\\u0435 \\u0432 `WEAPON_HAND`; \\u043d\\u0435 A/T-\\u043f\\u043e\\u0437\\u0430 (`rig-contract.json` \\u2192\n   `rest_pose`). \\u0421\\u0435\\u0442\\u043a\\u0430 \\u2014 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043d\\u0430 \\u043b\\u0438\\u0441\\u0442\\u0435 \\u043f\\u0440\\u0438\\u0451\\u043c\\u043a\\u0438:\n   `python tools/art/concept/check_concept_views.py --set <\\u043f\\u0430\\u043f\\u043a\\u0430 \\u0432\\u0438\\u0434\\u043e\\u0432> --key <key> --views front,side,back --role <ROLE> --palette <\\u043f\\u0430\\u043f\\u043a\\u0430>/palette.json --sheet`\n   \\u2192 `checks-report.json` + `sheet-<key>.png` (\\u043a\\u043e\\u0434 0 \\u2014 0 FAIL, 1 \\u2014 \\u0435\\u0441\\u0442\\u044c FAIL, 2 \\u2014 \\u043e\\u0448\\u0438\\u0431\\u043a\\u0430 \\u0432\\u0445\\u043e\\u0434\\u0430 \\u0438\\u043b\\u0438 \\u0441\\u0431\\u043e\\u0439 \\u0438\\u043d\\u0441\\u0442\\u0440\\u0443\\u043c\\u0435\\u043d\\u0442\\u0430:\n   \\u043d\\u0435 FAIL, \\u0431\\u0435\\u0437 \\u043f\\u0435\\u0440\\u0435\\u0433\\u0435\\u043d\\u0435\\u0440\\u0430\\u0446\\u0438\\u0438; \\u043f\\u0430\\u0439\\u043f cp1251 \\u0438\\u043d\\u0441\\u0442\\u0440\\u0443\\u043c\\u0435\\u043d\\u0442 \\u043d\\u0435 \\u0440\\u043e\\u043d\\u044f\\u0435\\u0442); \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a \\u0441\\u043c\\u043e\\u0442\\u0440\\u0438\\u0442 \\u043b\\u0438\\u0441\\u0442 \\u0432 \\u0446\\u0432\\u0435\\u0442\\u0435, \\u0432 \\u0441\\u0435\\u0440\\u043e\\u043c \\u0438 \\u0441\\u0438\\u043b\\u0443\\u044d\\u0442 \\u043d\\u0430 \\u0431\\u0435\\u043b\\u043e\\u043c\n   (`docs/game-design/visual/02-visual-design.md` \\u00a78.6, \\u0448\\u0430\\u0433 1).\n5. \\u0422\\u043e\\u043d\\u043a\\u0438\\u0435 \\u044d\\u043b\\u0435\\u043c\\u0435\\u043d\\u0442\\u044b (\\u0442\\u0435\\u0442\\u0438\\u0432\\u0430, \\u0434\\u0440\\u0435\\u0432\\u043a\\u043e, \\u0441\\u0442\\u0440\\u0435\\u043b\\u044b) \\u043d\\u0430 \\u043a\\u043e\\u043d\\u0446\\u0435\\u043f\\u0442\\u0435 \\u2014 \\u043d\\u0435 FAIL, \\u0432 \\u043f\\u0440\\u043e\\u043c\\u043f\\u0442\\u0435 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u00abthin parts readable\\u00bb; \\u0438\\u0445\n   \\u0447\\u0438\\u0442\\u0430\\u0435\\u043c\\u043e\\u0441\\u0442\\u044c \\u0440\\u0435\\u0448\\u0430\\u044e\\u0442 \\u044d\\u0442\\u0430\\u043f 3 (\\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u044c) \\u0438 \\u044d\\u0442\\u0430\\u043f 4 (\\u0431\\u0430\\u043b\\u043b\\u044b F/T). \\u0420\\u0435\\u0442\\u0440\\u0430\\u0438 \\u2014 \\u2264 4 \\u0433\\u0435\\u043d\\u0435\\u0440\\u0430\\u0446\\u0438\\u0438 \\u043d\\u0430 \\u0432\\u0438\\u0434, `CORRECTION:` \\u2264 3 \\u0441\\u0442\\u0440\\u043e\\u043a\n   \\u0434\\u043b\\u044f \\u043b\\u044e\\u0431\\u043e\\u0433\\u043e \\u0432\\u0438\\u0434\\u0430 (\\u0431\\u043b\\u043e\\u043a \\u0434\\u043e\\u0441\\u043b\\u043e\\u0432\\u043d\\u043e \\u0432 \\u0448\\u0430\\u0431\\u043b\\u043e\\u043d\\u0430\\u0445 \\u0437\\u0430\\u0434\\u0430\\u043d\\u0438\\u0439 1a/1c). \\u0413\\u0435\\u043d\\u0435\\u0440\\u0430\\u0446\\u0438\\u0438 \\u0437\\u0430\\u043f\\u0443\\u0441\\u043a\\u0430 \\u0438\\u0441\\u0447\\u0435\\u0440\\u043f\\u0430\\u043d\\u044b, \\u0430 \\u043f\\u0443\\u043d\\u043a\\u0442 \\u0447\\u0435\\u043a-\\u043b\\u0438\\u0441\\u0442\\u0430 Codex\n   \\u043f\\u0440\\u043e\\u0432\\u0430\\u043b\\u0435\\u043d \\u043f\\u0440\\u0438 0 FAIL \\u0430\\u0432\\u0442\\u043e\\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043e\\u043a \\u2014 \\u043b\\u0438\\u0441\\u0442 \\u0438\\u0434\\u0451\\u0442 \\u043a \\u043f\\u0440\\u0438\\u0451\\u043c\\u043a\\u0435 \\u0441 \\u043f\\u043e\\u043c\\u0435\\u0442\\u043a\\u043e\\u0439 `verification.json#limit_reached`, \\u0440\\u0435\\u0448\\u0430\\u0435\\u0442\n   \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a (`references/concept-sheet.md` \\u00a75.5 \\u043f.5). \\u0426\\u0438\\u043a\\u043b \\u2014 \\u043e\\u0434\\u043d\\u0430 \\u043f\\u0440\\u0438\\u0451\\u043c\\u043a\\u0430 \\u043b\\u0438\\u0441\\u0442\\u0430; \\u2264 3 \\u0446\\u0438\\u043a\\u043b\\u0430 \\u043f\\u043e\\u0441\\u043b\\u0435 \\u043f\\u0435\\u0440\\u0432\\u043e\\u0439 \\u043f\\u0440\\u0438\\u0451\\u043c\\u043a\\u0438\n   (r1\\u2026r4), \\u0434\\u0430\\u043b\\u044c\\u0448\\u0435 \\u00a75 \\u043f.4.\n6. \\u0412\\u044b\\u0445\\u043e\\u0434: 0 FAIL \\u0438 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0430 kind `concept` \\u0441 `score` \\u2265 8,0.\n\n**\\u042d\\u0442\\u0430\\u043f 2 \\u2014 Tripo H2** (`references/tripo3d-stages.md`: 12 \\u0438\\u043d\\u0441\\u0442\\u0440\\u0443\\u043c\\u0435\\u043d\\u0442\\u043e\\u0432 Studio, \\u044d\\u043a\\u0441\\u043f\\u043e\\u0440\\u0442, API v3, \\u0446\\u0435\\u043d\\u044b).\n1. \\u0414\\u043e \\u043a\\u043b\\u0438\\u043a\\u0430 \\u0441\\u0432\\u0435\\u0440\\u0438\\u0442\\u044c sha256 \\u0432\\u0445\\u043e\\u0434\\u043e\\u0432 \\u0441\\u043e \\u0432\\u0441\\u0435\\u043c\\u0438 `<ASSET_ID>/source-specs/*.json` (\\u043a\\u043e\\u0434 3 `prepare-generation` \\u043b\\u043e\\u0432\\u0438\\u0442 \\u0434\\u0443\\u0431\\u043b\\u044c\n   \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u0432\\u043d\\u0443\\u0442\\u0440\\u0438 run). CLI: `init` \\u0432 `generation-request/` \\u0441 `--primary-source tripo-pending`, \\u043f\\u043e\\u0442\\u043e\\u043c\n   `prepare-generation --dry-run`.\n2. \\u0421\\u043b\\u043e\\u0442\\u044b: FRONT = front, \\u0441\\u043b\\u043e\\u0442 `SIDE_VIEW` = side (\\u043f\\u043e \\u0443\\u043c\\u043e\\u043b\\u0447\\u0430\\u043d\\u0438\\u044e LEFT, HANDBOOK \\u00a73.2 \\u043f.3), BACK = back, \\u0432\\u0442\\u043e\\u0440\\u043e\\u0439 \\u0431\\u043e\\u043a\\u043e\\u0432\\u043e\\u0439\n   \\u0441\\u043b\\u043e\\u0442 \\u043f\\u0443\\u0441\\u0442 (`references/tripo3d-stages.md` \\u00a75.5). \\u041e\\u043f\\u0435\\u0440\\u0430\\u0446\\u0438\\u0438: H3.1 \\u00ab\\u043f\\u043e \\u0447\\u0430\\u0441\\u0442\\u044f\\u043c\\u00bb 60 \\u2192 \\u0442\\u0435\\u043a\\u0441\\u0442\\u0443\\u0440\\u0430 8K \\u00ab\\u0423\\u0434\\u0430\\u043b\\u0438\\u0442\\u044c \\u043e\\u0441\\u0432\\u0435\\u0449\\u0435\\u043d\\u0438\\u0435\\u00bb\n   30 \\u2192 PBR 5; \\u043f\\u0435\\u0440\\u0435\\u0434 \\u043a\\u0430\\u0436\\u0434\\u043e\\u0439 \\u2014 `ledger.py check --service tripo --next-cost <\\u0446\\u0435\\u043d\\u0430 \\u0441 \\u043a\\u043d\\u043e\\u043f\\u043a\\u0438> --balance <\\u0431\\u0430\\u043b\\u0430\\u043d\\u0441>` (\\u043a\\u043e\\u0434 0),\n   \\u043f\\u043e\\u0441\\u043b\\u0435 \\u2014 \\u0431\\u0430\\u043b\\u0430\\u043d\\u0441 \\u0438 \\u0441\\u0442\\u0440\\u043e\\u043a\\u0430 `ledger.py add --task <VISUAL_CARD_ID>`.\n3. \\u0412\\u044b\\u0445\\u043e\\u0434 \\u2014 \\u0447\\u0435\\u043a-\\u043b\\u0438\\u0441\\u0442 \\u044d\\u0442\\u0430\\u043f\\u0430 2: GLB \\u0432 `source/` \\u0441 \\u0434\\u043b\\u0438\\u043d\\u043e\\u0439 \\u043f\\u043e \\u0437\\u0430\\u0433\\u043e\\u043b\\u043e\\u0432\\u043a\\u0443, source-spec, `reports/tripo-run.json`,\n   `claims.art_accepted: false`.\n\n**\\u042d\\u0442\\u0430\\u043f 3 \\u2014 \\u0441\\u0431\\u043e\\u0440\\u043a\\u0430 \\u0432 Blender** (HANDBOOK \\u00a74.1\\u20134.4, `references/acceptance-and-blender.md`).\n1. \\u0414\\u043e \\u043f\\u0435\\u0440\\u0432\\u043e\\u0433\\u043e \\u043f\\u0440\\u043e\\u0433\\u043e\\u043d\\u0430 \\u2014 \\u0440\\u0435\\u0433\\u0438\\u0441\\u0442\\u0440\\u0430\\u0446\\u0438\\u044f \\u044d\\u0442\\u0430\\u043f\\u0430 3 (`references/new-character-registration.md` \\u00a73): `CHARACTER` \\u0432\n   `docs/art-pipeline/rig/rig-contract.json` \\u2192 `skeletons.UM_HUMANOID_17_v2.characters` \\u0441 \\u043f\\u043e\\u0434\\u044a\\u0451\\u043c\\u043e\\u043c `revision`;\n   \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043a\\u0430 `python -m unittest tools/tripo-pipeline/tests/test_rig_rules.py` \\u2192 OK. \\u0421\\u0442\\u043e\\u0440\\u043e\\u043d\\u0443 \\u043e\\u0440\\u0443\\u0436\\u0438\\u044f `h2_bake` \\u0431\\u0435\\u0440\\u0451\\u0442 \\u0438\\u0437\n   \\u043a\\u043e\\u043d\\u0442\\u0440\\u0430\\u043a\\u0442\\u0430 \\u043f\\u043e `rig.character`; \\u0447\\u0430\\u0441\\u0442\\u044c \\u0438 \\u043c\\u0435\\u0448 \\u043e\\u0440\\u0443\\u0436\\u0438\\u044f, \\u043a\\u043e\\u0441\\u0442\\u0438 `weapon.*` \\u0438 \\u0441\\u043e\\u043a\\u0435\\u0442 `Weapon` \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u044f \\u2014 \\u043f\\u043e `WEAPON_HAND`\n   (\\u0442\\u0430\\u0431\\u043b\\u0438\\u0446\\u0430 \\u0414-1, \\u0442\\u0430\\u043c \\u0436\\u0435 \\u00a72; \\u043f\\u0440\\u0430\\u0432\\u0448\\u0430 \\u2014 \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043a\\u0430 `export_frame_bow_on_rotated_right`, \\u0431\\u0435\\u0437 \\u043e\\u0440\\u0443\\u0436\\u0438\\u044f \\u2014 \\u0431\\u0435\\u0437 \\u0447\\u0430\\u0441\\u0442\\u0438 `weapon`).\n2. \\u041d\\u043e\\u0432\\u044b\\u0439 \\u0444\\u0430\\u0439\\u043b \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u044f `<key>-h2-bake-h2.json` \\u043f\\u043e HANDBOOK \\u00a74.2 (\\u043e\\u0431\\u0440\\u0430\\u0437\\u0435\\u0446 \\u2014 `medusa-h2-bake-h2.json`, \\u043d\\u0435 \\u0434\\u0440\\u0430\\u0439\\u0432\\u0435\\u0440\\u044b\n   `h2_bake_arthur/merlin/harpy`). \\u041a\\u0430\\u0436\\u0434\\u044b\\u0439 \\u043a\\u043b\\u044e\\u0447 \\u043f\\u0440\\u043e\\u0439\\u0442\\u0438, \\u043a\\u043e\\u043e\\u0440\\u0434\\u0438\\u043d\\u0430\\u0442\\u044b \\u043a\\u043e\\u0441\\u0442\\u0435\\u0439 \\u0437\\u0430\\u0434\\u0430\\u0442\\u044c \\u043f\\u043e \\u043d\\u043e\\u0432\\u043e\\u0439 \\u0433\\u0435\\u043e\\u043c\\u0435\\u0442\\u0440\\u0438\\u0438. \\u0411\\u043b\\u043e\\u043a `preview`\n   (h2-bake 0.6.1): `previous_candidate` \\u0438 `baseline` **\\u0443\\u0434\\u0430\\u043b\\u0438\\u0442\\u044c** \\u2014 \\u044d\\u0442\\u043e \\u043f\\u0440\\u0435\\u0436\\u043d\\u0438\\u0439 \\u043a\\u0430\\u043d\\u0434\\u0438\\u0434\\u0430\\u0442 W4-B \\u0438 \\u0442\\u0435\\u043a\\u0441\\u0442\\u0443\\u0440\\u044b H2 \\u0434\\u043e H2.1\n   Medusa; \\u0443 \\u043d\\u043e\\u0432\\u043e\\u0433\\u043e \\u043f\\u0435\\u0440\\u0441\\u043e\\u043d\\u0430\\u0436\\u0430 \\u0438\\u0445 \\u043d\\u0435\\u0442, \\u0431\\u0435\\u0437 \\u043a\\u043b\\u044e\\u0447\\u0435\\u0439 \\u0441\\u0442\\u0430\\u0434\\u0438\\u044f `preview` \\u0438 `compose` \\u043e\\u0431\\u0445\\u043e\\u0434\\u044f\\u0442\\u0441\\u044f \\u0431\\u0435\\u0437 \\u043d\\u0438\\u0445. `concepts` \\u2014 \\u0441\\u0432\\u043e\\u0438\n   \\u0432\\u0438\\u0434\\u044b; `closeups`, `pose_closeups`, `channel_views` \\u043f\\u0435\\u0440\\u0435\\u043f\\u0438\\u0441\\u0430\\u0442\\u044c \\u043f\\u043e\\u0434 \\u0441\\u0432\\u043e\\u044e \\u0444\\u0438\\u0433\\u0443\\u0440\\u0443 (\\u0446\\u0435\\u043b\\u0438 \\u0432 \\u043c\\u0435\\u0442\\u0440\\u0430\\u0445 \\u0444\\u0438\\u043d\\u0430\\u043b\\u044c\\u043d\\u043e\\u0439 \\u0440\\u0430\\u043c\\u043a\\u0438,\n   `pose_closeups` \\u2014 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043f\\u043e\\u0437\\u044b `st_seams.pose`, \\u043c\\u043e\\u0436\\u043d\\u043e `[]`); `frame` = `{\"checks_report\":\n   \"<\\u043f\\u0430\\u043f\\u043a\\u0430 \\u0432\\u0438\\u0434\\u043e\\u0432>/checks-report.json\", \"side\": \"<SIDE_VIEW>\"}` \\u2014 \\u043e\\u0440\\u0442\\u043e-\\u043a\\u0430\\u0434\\u0440\\u044b \\u043f\\u043e \\u043a\\u0430\\u0434\\u0440\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044e \\u0441\\u0432\\u043e\\u0435\\u0433\\u043e \\u043a\\u043e\\u043d\\u0446\\u0435\\u043f\\u0442\\u0430\n   (`h2_bake/framing.py`; \\u0431\\u0435\\u0437 \\u043a\\u043b\\u044e\\u0447\\u0430 \\u2014 \\u043a\\u0430\\u043d\\u043e\\u043d Medusa 1021 \\u00d7 1540). \\u0422\\u043e\\u0442 \\u0436\\u0435 `frame` \\u2014 \\u0432 look-dev \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u0435\n   `<key>-h2-lookdev.json` (\\u0432\\u0435\\u0440\\u0445\\u043d\\u0438\\u0439 \\u0443\\u0440\\u043e\\u0432\\u0435\\u043d\\u044c): `ld_measure` \\u0441\\u0440\\u0430\\u0432\\u043d\\u0438\\u0432\\u0430\\u0435\\u0442 \\u043a\\u043e\\u043d\\u0446\\u0435\\u043f\\u0442 \\u0441 \\u043f\\u0440\\u043e\\u0445\\u043e\\u0434\\u043e\\u043c ID \\u043f\\u0438\\u043a\\u0441\\u0435\\u043b\\u044c \\u0432 \\u043f\\u0438\\u043a\\u0441\\u0435\\u043b\\u044c \\u0438\n   \\u043e\\u0442\\u043a\\u0430\\u0437\\u044b\\u0432\\u0430\\u0435\\u0442 \\u043a\\u043e\\u043d\\u0446\\u0435\\u043f\\u0442\\u0443 \\u0434\\u0440\\u0443\\u0433\\u043e\\u0433\\u043e \\u0430\\u0441\\u043f\\u0435\\u043a\\u0442\\u0430, \\u0430 `tone.json` (\\u043f\\u043e\\u0442\\u043e\\u043b\\u043e\\u043a T \\u044d\\u0442\\u0430\\u043f\\u0430 4) \\u0432\\u0435\\u0440\\u0435\\u043d \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043f\\u0440\\u0438 \\u0442\\u0430\\u043a\\u043e\\u0439 \\u0440\\u0430\\u043c\\u043a\\u0435.\n3. `python tools/tripo-pipeline/blender/h2_bake/run_h2_bake.py` \\u043f\\u043e \\u043e\\u0434\\u043d\\u043e\\u0439 \\u0441\\u0442\\u0430\\u0434\\u0438\\u0438 (HANDBOOK \\u00a74.3), \\u0437\\u0430\\u0442\\u0435\\u043c\n   `--mode lookdev` \\u0438 `--mode teamaccent` (HANDBOOK \\u00a74.4). TeamAccent (`team_accent` \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u044f, \\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u043e 5\\u201312 % \\u043f\\u043b\\u043e\\u0449\\u0430\\u0434\\u0438 \\u2014\n   `docs/art-pipeline/material-library/team-accent.md`): \\u043a\\u043e\\u043c\\u043f\\u043e\\u043d\\u0435\\u043d\\u0442\\u044b `hem` (\\u043f\\u043e\\u043b\\u043e\\u0441\\u0430 \\u0442\\u043a\\u0430\\u043d\\u0438 `cloth_class` \\u0432\\u0434\\u043e\\u043b\\u044c \\u043a\\u0440\\u043e\\u043c\\u043a\\u0438\n   \\u043a\\u043b\\u0430\\u0441\\u0441\\u0430 `band_class` \\u043d\\u0438\\u0436\\u0435 `band_z_max_m`) \\u0438 `ribbon` (\\u0440\\u0435\\u043c\\u0435\\u043d\\u044c/\\u043f\\u0435\\u0440\\u0435\\u0432\\u044f\\u0437\\u044c \\u043a\\u043b\\u0430\\u0441\\u0441\\u0430 `class` \\u0432\\u044b\\u0448\\u0435 `z_min_m`) \\u2014 \\u043a\\u0430\\u0436\\u0434\\u044b\\u0439\n   \\u043d\\u0435\\u043e\\u0431\\u044f\\u0437\\u0430\\u0442\\u0435\\u043b\\u0435\\u043d, \\u043d\\u0443\\u0436\\u0435\\u043d \\u0445\\u043e\\u0442\\u044f \\u0431\\u044b \\u043e\\u0434\\u0438\\u043d. \\u0422\\u043a\\u0430\\u043d\\u044c \\u0431\\u0435\\u0437 \\u043a\\u0440\\u043e\\u043c\\u043a\\u0438 (\\u043b\\u0430\\u0442\\u044b, \\u0442\\u0443\\u043d\\u0438\\u043a\\u0430 \\u0431\\u0435\\u0437 \\u043a\\u0430\\u0439\\u043c\\u044b) \\u2014 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e `ribbon` \\u043d\\u0430 \\u043f\\u043e\\u044f\\u0441\\u0435, \\u043f\\u0435\\u0440\\u0435\\u0432\\u044f\\u0437\\u0438,\n   \\u043a\\u043e\\u043b\\u0447\\u0430\\u043d\\u043d\\u043e\\u0439 \\u043b\\u044f\\u043c\\u043a\\u0435 \\u0438\\u043b\\u0438 \\u043f\\u043b\\u0430\\u0449\\u0435 (`class` \\u2014 \\u0438\\u0445 \\u043a\\u043b\\u0430\\u0441\\u0441 \\u0441 `teamDyeAllowed`; \\u0431\\u0435\\u0437 `hem` \\u043e\\u0431\\u044f\\u0437\\u0430\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e \\u0437\\u0430\\u0434\\u0430\\u0442\\u044c `cloth_class`/`trim_class`\n   \\u0432\\u0435\\u0440\\u0445\\u043d\\u0435\\u0433\\u043e \\u0443\\u0440\\u043e\\u0432\\u043d\\u044f \\u2014 \\u043e\\u0441\\u043d\\u043e\\u0432\\u043d\\u0430\\u044f \\u0442\\u043a\\u0430\\u043d\\u044c \\u0438 \\u043e\\u0442\\u0434\\u0435\\u043b\\u043a\\u0430 \\u0434\\u043b\\u044f \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043a\\u0438 `dress_parts` \\u0438 \\u043a\\u043e\\u043d\\u0442\\u0440\\u0430\\u0441\\u0442\\u0430 `ta_report`). \\u041f\\u0443\\u0441\\u0442\\u043e\\u0439 \\u043a\\u043e\\u043c\\u043f\\u043e\\u043d\\u0435\\u043d\\u0442 \\u043f\\u0440\\u043e\\u043f\\u0443\\u0441\\u043a\\u0430\\u0435\\u0442\\u0441\\u044f \\u0441 `skipped` \\u0432 \\u043e\\u0442\\u0447\\u0451\\u0442\\u0435; \\u0434\\u043e\\u043b\\u044e \\u0440\\u0435\\u0448\\u0430\\u0435\\u0442\n   `area_share_range` (5\\u201312 %). \\u041d\\u0438 \\u043e\\u0434\\u0438\\u043d \\u043a\\u043e\\u043c\\u043f\\u043e\\u043d\\u0435\\u043d\\u0442 \\u043d\\u0435 \\u0434\\u0430\\u043b \\u0430\\u043a\\u0446\\u0435\\u043d\\u0442\\u0430 \\u2014 `ta_maps` \\u043f\\u0430\\u0434\\u0430\\u0435\\u0442 \\u0441 \\u0441\\u043e\\u043e\\u0431\\u0449\\u0435\\u043d\\u0438\\u0435\\u043c: \\u0432\\u044b\\u0431\\u0440\\u0430\\u0442\\u044c \\u043a\\u043b\\u0430\\u0441\\u0441\\u044b\n   \\u0437\\u0430\\u043d\\u043e\\u0432\\u043e (\\u043d\\u0435 \\u0441\\u0442\\u043e\\u043f; \\u043d\\u043e\\u0432\\u044b\\u0439 \\u0440\\u0435\\u0436\\u0438\\u043c \\u0438\\u043b\\u0438 \\u043d\\u043e\\u0432\\u044b\\u0439 \\u043a\\u043b\\u0430\\u0441\\u0441 MatID \\u2014 \\u0441\\u0442\\u043e\\u043f \\u00a75 \\u043f.5). \\u0422\\u043e\\u043d\\u043a\\u043e\\u0435 \\u043e\\u0440\\u0443\\u0436\\u0438\\u0435 (\\u0442\\u0435\\u0442\\u0438\\u0432\\u0430, \\u0441\\u0442\\u0440\\u0435\\u043b\\u044b) \\u2014 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u0441\\u0440\\u0435\\u0434\\u0441\\u0442\\u0432\\u0430\\u043c\\u0438\n   \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u044f: `retopo.target_tris` \\u0438 `retopo.dense_regions` \\u0434\\u043b\\u044f \\u0447\\u0430\\u0441\\u0442\\u0438 \\u043e\\u0440\\u0443\\u0436\\u0438\\u044f, `uv.texel_priority` (`st_retopo.py:217-227`,\n   `st_uv.py:417`). \\u0420\\u0435\\u0436\\u0438\\u043c\\u0430 \\u0443\\u0442\\u043e\\u043b\\u0449\\u0435\\u043d\\u0438\\u044f \\u0438 \\u043c\\u043e\\u0441\\u0442\\u0430 \\u0432 generic `h2_bake` \\u043d\\u0435\\u0442 (grep `solidify|thicken|bridge` \\u043f\\u0443\\u0441\\u0442). \\u041d\\u0435\n   \\u0447\\u0438\\u0442\\u0430\\u0435\\u0442\\u0441\\u044f \\u043d\\u0430 \\u044d\\u0442\\u0430\\u043f\\u0435 4 \\u2014 \\u043f\\u0443\\u043d\\u043a\\u0442 `rework_fix_list` (\\u044d\\u0442\\u0430\\u043f 5, \\u0442\\u043e\\u0442 \\u0436\\u0435 \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u044c\\u043d\\u044b\\u0439 \\u043f\\u0443\\u0442\\u044c), \\u0430 \\u0435\\u0441\\u043b\\u0438 \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u044c \\u043d\\u0435 \\u043f\\u043e\\u043c\\u043e\\u0433 \\u2014\n   \\u043f\\u043e\\u043c\\u0435\\u0442\\u043a\\u0430 \\u00ab\\u043d\\u0435 \\u0437\\u0430\\u043a\\u0440\\u044b\\u0442\\u043e\\u00bb, \\u0431\\u0435\\u0437 \\u0441\\u0442\\u043e\\u043f\\u0430. \\u041e\\u0440\\u0443\\u0436\\u0438\\u0435 \\u0431\\u0435\\u0437 \\u0445\\u0432\\u0430\\u0442\\u0430 (\\u043d\\u0443\\u0436\\u0435\\u043d \\u043c\\u043e\\u0441\\u0442-\\u0446\\u0438\\u043b\\u0438\\u043d\\u0434\\u0440) \\u2014 \\u0441\\u0442\\u043e\\u043f \\u00a75 \\u043f.5.\n4. \\u0412\\u044b\\u0445\\u043e\\u0434: \\u043c\\u0430\\u0440\\u043a\\u0435\\u0440\\u044b \\u0432\\u0441\\u0435\\u0445 \\u0441\\u0442\\u0430\\u0434\\u0438\\u0439, `probes-report.json` 7/7 \\u043d\\u0430 .blend \\u0438 FBX, `determinism-report.json`, `ld-*`, `ld-team-*`.\n\n**\\u042d\\u0442\\u0430\\u043f 3 \\u2014 \\u043f\\u0440\\u043e\\u043f** (\\u0432\\u0435\\u0442\\u043a\\u0430 `prop`; \\u0440\\u0435\\u0433\\u0438\\u0441\\u0442\\u0440\\u0430\\u0446\\u0438\\u044f \\u043f\\u0435\\u0440\\u0441\\u043e\\u043d\\u0430\\u0436\\u0430, h2_bake, look-dev \\u0438 TeamAccent \\u043d\\u0435 \\u0434\\u0435\\u043b\\u0430\\u044e\\u0442\\u0441\\u044f).\n1. Run-\\u043a\\u0430\\u0442\\u0430\\u043b\\u043e\\u0433 `R=art/pipeline-candidates/<ASSET_ID>/<YYYYMMDD>-prop-build` (\\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u0441\\u043a\\u0438\\u043b\\u043b\\u0430; \\u043d\\u043e\\u0432\\u044b\\u0439 \\u043d\\u0430 \\u043a\\u0430\\u0436\\u0434\\u044b\\u0439 \\u043f\\u0440\\u043e\\u0433\\u043e\\u043d,\n   \\u0434\\u043e\\u0440\\u0430\\u0431\\u043e\\u0442\\u043a\\u0430 \\u2014 `\\u2026-prop-build-r<N>`). \\u0412\\u0445\\u043e\\u0434 \\u2014 GLB \\u044d\\u0442\\u0430\\u043f\\u0430 2 \\u0438\\u0437 `<YYYYMMDD>-prop-tripo/source/`.\n2. HANDBOOK \\u00a75 \\u043f.1\\u20135: `candidate-params.json` \\u043f\\u043e \\u043e\\u0431\\u0440\\u0430\\u0437\\u0446\\u0443 \\u043f\\u0440\\u043e\\u043f\\u0430 \\u0442\\u043e\\u0433\\u043e \\u0436\\u0435 \\u0432\\u0438\\u0434\\u0430\n   (`art/pipeline-candidates/ASSET-DECOR-KIT-001/20260928-{p15-barrel,lantern-tripo-h31}/reports/candidate-params.json`),\n   `target_height_m` = `FIGURE_HEIGHT_M` \\u0437\\u0430\\u044f\\u0432\\u043a\\u0438, `asset_name` `SM_<Name>`, `texture_prefix` `T_<Name>`; \\u0440\\u0435\\u043c\\u043e\\u043d\\u0442\n   \\u0433\\u0435\\u043e\\u043c\\u0435\\u0442\\u0440\\u0438\\u0438, \\u0444\\u0440\\u043e\\u043d\\u0442, \\u0441\\u0432\\u0435\\u0447\\u0435\\u043d\\u0438\\u0435; \\u0441\\u0431\\u043e\\u0440\\u043a\\u0430 `static_prop_candidate.py` \\u0438 read-back `check_static_prop_fbx.py`.\n3. \\u0412\\u044b\\u0445\\u043e\\u0434: `$R/export/SM_<Name>.fbx` + `T_<Name>_{BC,N,ORM}.png`, `$R/reports/candidate-report.json` \\u0441\n   `checks_passed: true` \\u0438 \\u043f\\u0443\\u0441\\u0442\\u044b\\u043c \\u0441\\u043f\\u0438\\u0441\\u043a\\u043e\\u043c \\u043d\\u0435\\u043f\\u0440\\u043e\\u0439\\u0434\\u0435\\u043d\\u043d\\u044b\\u0445 `checks`, `$R/reports/fbx-readback.json`. \\u0414\\u0430\\u043b\\u044c\\u0448\\u0435 \\u2014 \\u044d\\u0442\\u0430\\u043f 4 \\u0441\n   `--no-base` (`references/acceptance-and-blender.md` \\u00a73).\n\n**\\u042d\\u0442\\u0430\\u043f 4 \\u2014 \\u043f\\u0440\\u0438\\u0451\\u043c\\u043a\\u0430 \\u043c\\u043e\\u0434\\u0435\\u043b\\u0438** (`references/acceptance-and-blender.md`). \\u041e\\u0431\\u044a\\u0435\\u043a\\u0442 \\u2014 \\u043e\\u0442\\u0433\\u0440\\u0443\\u0436\\u0430\\u0435\\u043c\\u044b\\u0439 H2LD-\\u043d\\u0430\\u0431\\u043e\\u0440.\n1. \\u041a\\u0430\\u0434\\u0440\\u044b: `python tools/art/acceptance/capture_acceptance_set.py --fbx <SK_<Key>_H2LD.fbx> --textures <dir> --out <evidence>/frames --key <Key> --side-view <SIDE_VIEW> --sheet art/imagegen/concept-<key>-codex/sheet-<key>.png`\n   \\u2192 8 `turn-*`, `close-{head,head-back,torso,torso-back,legs,legs-back,weapon,hands,base}`, `wire-{front,34,back}`,\n   `uv-layout.png`, `pose-01\\u202604` + `pose-03b`, `sheet.png`, `compare-{front,side,back}`, `tone.json` (\\u0438\\u0437\n   `measure-report.json` look-dev; \\u0443 \\u0433\\u0435\\u0440\\u043e\\u044f \\u0431\\u0435\\u0437 \\u043d\\u0435\\u0433\\u043e \\u2014 \\u043a\\u043e\\u0434 1), `frames.json` (`references/acceptance-and-blender.md` \\u00a73).\n2. \\u0413\\u0435\\u0439\\u0442\\u044b PASS/FAIL \\u043f\\u043e \\u043e\\u0442\\u0447\\u0451\\u0442\\u0430\\u043c: G-TOPO (\\u043f\\u043e \\u0444\\u0438\\u043d\\u0430\\u043b\\u044c\\u043d\\u043e\\u043c\\u0443 FBX, `ld-fbx-report`), G-UV, G-TEX, G-RIG, G-NAMES. \\u0411\\u0430\\u043b\\u043b\\u044b S/F/T/D\n   0\\u20132, `score = round(sum / (2 \\u00d7 n) \\u00d7 10, 1)`; \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a \\u0432\\u043e\\u0437\\u0432\\u0440\\u0430\\u0449\\u0430\\u0435\\u0442 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e JSON, `card.json` \\u043f\\u0438\\u0448\\u0435\\u0442 \\u0437\\u0430\\u043f\\u0443\\u0441\\u043a\\u0430\\u044e\\u0449\\u0438\\u0439.\n   \\u041f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a \\u00abSol 6.1 xhigh\\u00bb \\u2014 `codex exec` \\u0441 `-c 'windows.sandbox=\"unelevated\"'` \\u0438 `--ignore-user-config`; \\u0441\\u0431\\u043e\\u0439\n   \\u043f\\u0435\\u0441\\u043e\\u0447\\u043d\\u0438\\u0446\\u044b (\\u043a\\u043e\\u0434 0, \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0430-\\u0437\\u0430\\u0433\\u043b\\u0443\\u0448\\u043a\\u0430) \\u2014 \\u0441\\u0431\\u043e\\u0439 \\u043e\\u043a\\u0440\\u0443\\u0436\\u0435\\u043d\\u0438\\u044f, \\u043d\\u0435 \\u043f\\u043e\\u043f\\u044b\\u0442\\u043a\\u0430 (`references/acceptance-and-blender.md` \\u00a78.4).\n3. `python tools/art/acceptance/validate_card.py <card.json> --print-verdict --check-files`. \\u041a\\u043e\\u0434 0: `pass` \\u2192 \\u044d\\u0442\\u0430\\u043f 6;\n   `rework_blender` \\u2192 \\u044d\\u0442\\u0430\\u043f 5; `return_to_stage_1` \\u0438\\u043b\\u0438 `return_to_stage_2` (S < 1,5 \\u0438\\u043b\\u0438 \\u0434\\u0435\\u0444\\u0435\\u043a\\u0442 \\u0438\\u0441\\u0445\\u043e\\u0434\\u043d\\u0438\\u043a\\u0430) \\u2192 \\u043d\\u0430\\u0437\\u0430\\u0434;\n   \\u043f\\u043e\\u0441\\u043b\\u0435 r3 \\u0431\\u0435\\u0437 pass \\u2014 `escalate_user`. \\u041a\\u043e\\u0434 3 `needs_second_acceptor` (pass \\u0441 `score` 8,0\\u20138,4; \\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u043e \\u043e\\u0431\\u0449\\u0435\\u0435 \\u0434\\u043b\\u044f\n   \\u043c\\u043e\\u0434\\u0435\\u043b\\u0438, \\u043b\\u0438\\u0441\\u0442\\u0430 \\u043a\\u043e\\u043d\\u0446\\u0435\\u043f\\u0442\\u0430 \\u0438 \\u043a\\u043b\\u0438\\u043f\\u0430): \\u0432\\u0442\\u043e\\u0440\\u043e\\u0439 \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a \\u0434\\u0440\\u0443\\u0433\\u0438\\u043c \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u0435\\u043c \\u043d\\u0430 \\u0442\\u0435\\u0445 \\u0436\\u0435 \\u043a\\u0430\\u0434\\u0440\\u0430\\u0445 \\u2192 `card-2.json`, \\u0437\\u0430\\u0442\\u0435\\u043c\n   `validate_card.py card.json --second card-2.json --final-json final.json` \\u2014 \\u0438\\u0442\\u043e\\u0433 \\u043f\\u043e \\u043c\\u0438\\u043d\\u0438\\u043c\\u0443\\u043c\\u0443 \\u0438 \\u0431\\u043e\\u043b\\u0435\\u0435 \\u0441\\u0442\\u0440\\u043e\\u0433\\u043e\\u043c\\u0443\n   \\u043c\\u0430\\u0440\\u0448\\u0440\\u0443\\u0442\\u0443 (`references/acceptance-and-blender.md` \\u00a76, \\u00a78.5). \\u041a\\u043e\\u0434 1 \\u2014 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0430 \\u043d\\u0435\\u0432\\u0430\\u043b\\u0438\\u0434\\u043d\\u0430, \\u0431\\u0430\\u043b\\u043b\\u044b \\u043d\\u0435 \\u043f\\u0440\\u0430\\u0432\\u0438\\u0442\\u044c.\n   \\u0414\\u043e \\u0432\\u044b\\u0437\\u043e\\u0432\\u0430 \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a\\u0430 \\u2014 \\u00ab\\u0421\\u0432\\u0435\\u0440\\u043a\\u0430 \\u0432\\u0445\\u043e\\u0434\\u0430\\u00bb (`references/acceptance-and-blender.md` \\u00a73): \\u043b\\u0438\\u0441\\u0442 \\u0442\\u043e\\u0433\\u043e \\u0436\\u0435 \\u0430\\u0441\\u0441\\u0435\\u0442\\u0430\n   (`frames.json#sheet.key_match`), `accepted_object` = `frames.json#accepted_object`; S = 0 (\\u0434\\u0440\\u0443\\u0433\\u043e\\u0439 \\u043f\\u0435\\u0440\\u0441\\u043e\\u043d\\u0430\\u0436) \\u043f\\u043e\\u0441\\u043b\\u0435\n   \\u0432\\