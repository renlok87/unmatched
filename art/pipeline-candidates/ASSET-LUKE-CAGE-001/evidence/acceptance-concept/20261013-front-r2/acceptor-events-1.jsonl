u0431\\u043e\\u0432\\u0430\\u043d\\u0438\\u0435 \\u0437\\u0430\\u043a\\u0430\\u0437\\u0447\\u0438\\u043a\\u0430 \\u21163 |\n| \\u041f\\u043e\\u0440\\u043e\\u0433 \\u0438 \\u0432\\u0435\\u0442\\u043e | `score` \\u2265 8,0; \\u043b\\u044e\\u0431\\u043e\\u0435 \\u0438\\u0437\\u043c\\u0435\\u0440\\u0435\\u043d\\u0438\\u0435 < 1,0 \\u2192 \\u043d\\u0435 pass; S < 1,5 \\u2192 \\u0432\\u043e\\u0437\\u0432\\u0440\\u0430\\u0442 \\u043d\\u0430 \\u044d\\u0442\\u0430\\u043f 1 \\u0438\\u043b\\u0438 2; pass \\u043c\\u043e\\u0434\\u0435\\u043b\\u0438 \\u0441 `score` 8,0\\u20138,4 \\u2014 \\u0432\\u0442\\u043e\\u0440\\u043e\\u0439 \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a \\u0434\\u0440\\u0443\\u0433\\u0438\\u043c \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u0435\\u043c, \\u0438\\u0442\\u043e\\u0433 \\u043f\\u043e \\u043c\\u0438\\u043d\\u0438\\u043c\\u0443\\u043c\\u0443 | \\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u0441\\u043a\\u0438\\u043b\\u043b\\u0430 (`references/acceptance-and-blender.md` \\u00a76, \\u00a78.5) |\n| \\u0426\\u0438\\u043a\\u043b\\u044b | \\u043a\\u043e\\u043d\\u0446\\u0435\\u043f\\u0442 3, \\u043c\\u043e\\u0434\\u0435\\u043b\\u044c 2 (r1\\u2192r3), \\u043a\\u043b\\u0438\\u043f 2; \\u0433\\u0435\\u043d\\u0435\\u0440\\u0430\\u0446\\u0438\\u0439 \\u043d\\u0430 \\u0432\\u0438\\u0434 \\u2264 4 | \\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u0441\\u043a\\u0438\\u043b\\u043b\\u0430 |\n| \\u041a\\u0440\\u0435\\u0434\\u0438\\u0442\\u044b Tripo | \\u043b\\u0438\\u043c\\u0438\\u0442 \\u0412\\u0420-04: 3000 \\u0434\\u043e 2026-10-28; \\u043f\\u0435\\u0440\\u0435\\u0434 \\u043a\\u0430\\u0436\\u0434\\u043e\\u0439 \\u043e\\u043f\\u0435\\u0440\\u0430\\u0446\\u0438\\u0435\\u0439 \\u0441 \\u0448\\u0430\\u0433\\u0430 1b `ledger.py check --service tripo --next-cost <\\u0446\\u0435\\u043d\\u0430 \\u0441 \\u043a\\u043d\\u043e\\u043f\\u043a\\u0438> --balance <\\u0431\\u0430\\u043b\\u0430\\u043d\\u0441 Studio>` \\u2192 \\u043a\\u043e\\u0434 0 (\\u043e\\u0441\\u0442\\u0430\\u0442\\u043e\\u043a \\u043b\\u0438\\u043c\\u0438\\u0442\\u0430 \\u0438 \\u0431\\u0430\\u043b\\u0430\\u043d\\u0441 \\u2265 \\u0446\\u0435\\u043d\\u044b, \\u0441\\u0442\\u0440\\u043e\\u043a\\u0430 \\u0443\\u0441\\u043b\\u043e\\u0432\\u0438\\u0439 \\u0435\\u0441\\u0442\\u044c); \\u043d\\u0430 \\u044d\\u0442\\u0430\\u043f\\u0435 0 \\u2014 \\u0442\\u043e\\u0442 \\u0436\\u0435 \\u0432\\u044b\\u0437\\u043e\\u0432 \\u0431\\u0435\\u0437 `--balance` (\\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043e\\u0441\\u0442\\u0430\\u0442\\u043e\\u043a \\u0412\\u0420-04 \\u043d\\u0430 \\u0432\\u0435\\u0441\\u044c \\u043f\\u043b\\u0430\\u043d). \\u041e\\u0436\\u0438\\u0434\\u0430\\u0435\\u043c\\u043e \\u043d\\u0430 \\u0433\\u0435\\u0440\\u043e\\u044f: \\u0447\\u0435\\u0440\\u043d\\u043e\\u0432\\u0438\\u043a \\u2248 30 (\\u0437\\u0430\\u043c\\u0435\\u0440 \\u0444\\u043e\\u0440\\u043c\\u044b Studio 2026-10-09: \\u0440\\u0435\\u0436\\u0438\\u043c \\u043f\\u043e \\u0443\\u043c\\u043e\\u043b\\u0447\\u0430\\u043d\\u0438\\u044e H3.1 \\u0431\\u0435\\u0437 8K, \\u043d\\u0435 \\u0441\\u043f\\u0438\\u0441\\u044b\\u0432\\u0430\\u043b\\u043e\\u0441\\u044c; \\u0442\\u043e\\u0447\\u043d\\u0430\\u044f \\u0446\\u0435\\u043d\\u0430 \\u2014 \\u0441 \\u043a\\u043d\\u043e\\u043f\\u043a\\u0438 \\u0434\\u043e \\u043a\\u043b\\u0438\\u043a\\u0430) + H2 95 (60 + 30 + 5; 65 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043f\\u0440\\u0438 \\u043d\\u0435\\u0438\\u0437\\u0440\\u0430\\u0441\\u0445\\u043e\\u0434\\u043e\\u0432\\u0430\\u043d\\u043d\\u043e\\u0439 \\u043f\\u0440\\u043e\\u0431\\u0435 8K) | \\u0412\\u0420-\\u0440\\u0435\\u0435\\u0441\\u0442\\u0440 \\u0412\\u0420-04; `references/tripo3d-stages.md` \\u00a73 |\n| \\u041e\\u043f\\u0438\\u0441\\u0430\\u043d\\u0438\\u0435 \\u0438 \\u0438\\u043c\\u044f \\u0431\\u043e\\u0439\\u0446\\u0430 | `DESCRIPTION`, `ANCHORS`, `FIGHTER_NAME` \\u2014 \\u0438\\u0437 `scraped-data/api/heroes/<slug>.json` \\u0438 \\u044d\\u0442\\u0430\\u043b\\u043e\\u043d\\u043d\\u043e\\u0439 \\u0411\\u0414 (\\u0438\\u043c\\u044f, \\u043e\\u0440\\u0443\\u0436\\u0438\\u0435, \\u043f\\u043e\\u043c\\u043e\\u0449\\u043d\\u0438\\u043a\\u0438) \\u0442\\u0435\\u043a\\u0441\\u0442\\u043e\\u043c; \\u0430\\u0432\\u0430\\u0442\\u0430\\u0440 \\u0438 \\u0441\\u043a\\u0430\\u043d\\u044b \\u0432 \\u0433\\u0435\\u043d\\u0435\\u0440\\u0430\\u0442\\u043e\\u0440 \\u043d\\u0435 \\u043f\\u043e\\u0434\\u0430\\u044e\\u0442\\u0441\\u044f. \\u041f\\u0435\\u0440\\u0441\\u043e\\u043d\\u0430\\u0436\\u0430 \\u0442\\u0430\\u043c \\u043d\\u0435\\u0442 (\\u043d\\u043e\\u0432\\u044b\\u0439 \\u043f\\u043e\\u043c\\u043e\\u0449\\u043d\\u0438\\u043a, \\u043d\\u0430\\u043f\\u0440\\u0438\\u043c\\u0435\\u0440 Sir Gawain) \\u2014 \\u043f\\u0438\\u0448\\u0443\\u0442\\u0441\\u044f \\u043f\\u043e \\u0437\\u0430\\u044f\\u0432\\u043a\\u0435 \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044f \\u0441 `decided_by: delegated (\\u0412\\u0420-\\u0440\\u0435\\u0435\\u0441\\u0442\\u0440 2026-10-06)`; \\u044d\\u0442\\u043e \\u043d\\u0435 \\u0433\\u0435\\u0439\\u0442 \\u0441\\u0442\\u043e\\u043f\\u0430 | `07-prompt-templates.md` \\u00a73.1, \\u0412\\u0420-PR08; \\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u0441\\u043a\\u0438\\u043b\\u043b\\u0430 |\n| \\u041f\\u043e\\u043c\\u043e\\u0449\\u043d\\u0438\\u043a \\u0431\\u0435\\u0437 \\u043d\\u043e\\u0432\\u043e\\u0433\\u043e \\u0433\\u0435\\u0440\\u043e\\u044f | `OWNER_HERO_SLUG` \\u2014 \\u0441\\u043b\\u0430\\u0433 \\u0433\\u0435\\u0440\\u043e\\u044f-\\u0432\\u043b\\u0430\\u0434\\u0435\\u043b\\u044c\\u0446\\u0430 (\\u0438\\u0437 \\u0437\\u0430\\u044f\\u0432\\u043a\\u0438; \\u043d\\u0435 \\u0437\\u0430\\u0434\\u0430\\u043d \\u2014 \\u0431\\u043b\\u0438\\u0436\\u0430\\u0439\\u0448\\u0438\\u0439 \\u043f\\u043e \\u0441\\u044e\\u0436\\u0435\\u0442\\u0443 \\u0433\\u0435\\u0440\\u043e\\u0439 \\u0440\\u043e\\u0441\\u0442\\u0435\\u0440\\u0430, \\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u043f\\u043e \\u0434\\u0435\\u043b\\u0435\\u0433\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044e); `HERO_SLUG` = \\u043e\\u043d \\u0436\\u0435; \\u0432\\u0430\\u0440\\u0438\\u0430\\u043d\\u0442 bench-\\u0444\\u0438\\u043a\\u0441\\u0442\\u0443\\u0440\\u044b: `--hero-name \"<FighterName \\u0432\\u043b\\u0430\\u0434\\u0435\\u043b\\u044c\\u0446\\u0430>\" --hero-slug <OWNER_HERO_SLUG> --sidekick-name \"<FIGHTER_NAME>\"`; `S08FighterNames.json` \\u043d\\u0435 \\u0442\\u0440\\u043e\\u0433\\u0430\\u0435\\u0442\\u0441\\u044f (\\u0444\\u043e\\u0440\\u043c\\u0430\\u0442 \\u0434\\u0435\\u0440\\u0436\\u0438\\u0442 \\u043e\\u0434\\u043d\\u043e\\u0433\\u043e \\u043f\\u043e\\u043c\\u043e\\u0449\\u043d\\u0438\\u043a\\u0430 \\u043d\\u0430 \\u0433\\u0435\\u0440\\u043e\\u044f), \\u0441\\u0442\\u0440\\u043e\\u043a\\u0430 \\u0432 NOTES | \\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u0441\\u043a\\u0438\\u043b\\u043b\\u0430; `references/new-character-registration.md` \\u00a70, \\u0414-2, \\u04207-8 |\n| SYNTX \\u0438 Codex | SYNTX \\u2014 \\u0431\\u0435\\u0437 \\u043f\\u043e\\u0434\\u0442\\u0432\\u0435\\u0440\\u0436\\u0434\\u0435\\u043d\\u0438\\u044f \\u043a\\u0430\\u0436\\u0434\\u043e\\u0439 \\u0433\\u0435\\u043d\\u0435\\u0440\\u0430\\u0446\\u0438\\u0438, \\u0432 \\u043b\\u0438\\u043c\\u0438\\u0442\\u0430\\u0445 \\u0412\\u0420-04/\\u0412\\u0420-PR04; Codex \\u2014 \\u043f\\u043e \\u043f\\u043e\\u0434\\u043f\\u0438\\u0441\\u043a\\u0435, \\u0441\\u0442\\u0440\\u043e\\u043a\\u0430 \\u0436\\u0443\\u0440\\u043d\\u0430\\u043b\\u0430 \\u043d\\u0430 \\u043f\\u0430\\u043a\\u0435\\u0442 | `07-prompt-templates.md` \\u00a74 |\n| \\u0411\\u044e\\u0434\\u0436\\u0435\\u0442 \\u043f\\u043e\\u043b\\u0438\\u0433\\u043e\\u043d\\u043e\\u0432 | \\u2264 45 000 tris LOD0 \\u0444\\u0438\\u0433\\u0443\\u0440\\u0430 \\u0441 \\u043e\\u0440\\u0443\\u0436\\u0438\\u0435\\u043c, \\u043f\\u043e\\u0434\\u0441\\u0442\\u0430\\u0432\\u043a\\u0430 \\u2264 2 500 | `docs/game-design/evidence/GD-058/final-2026-10-03/README.md`; \\u043f\\u0440\\u0430\\u043a\\u0442\\u0438\\u043a\\u0430 \\u2014 HANDBOOK \\u00a72.10 |\n| \\u0420\\u043e\\u0441\\u0442 \\u0438 \\u0434\\u043b\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u0438 | \\u0440\\u043e\\u0441\\u0442 \\u0438 \\u043a\\u0430\\u0434\\u0440 \\u043a\\u043e\\u043d\\u0442\\u0430\\u043a\\u0442\\u0430 \\u2014 \\u043f\\u043e \\u0431\\u043b\\u0438\\u0436\\u0430\\u0439\\u0448\\u0435\\u043c\\u0443 \\u0441\\u0443\\u0449\\u0435\\u0441\\u0442\\u0432\\u0443\\u044e\\u0449\\u0435\\u043c\\u0443 \\u0433\\u0435\\u0440\\u043e\\u044e \\u0442\\u043e\\u0439 \\u0436\\u0435 \\u0440\\u043e\\u043b\\u0438 \\u0438 \\u043e\\u0440\\u0443\\u0436\\u0438\\u044f (\\u0442\\u0430\\u0431\\u043b\\u0438\\u0446\\u0430 `Specs()` \\u0432 `unreal/Unmatched/Source/Unmatched/S08/S08HeroesV2.cpp:105-108`, HANDBOOK \\u00a72.10; \\u043f\\u043e\\u043c\\u043e\\u0449\\u043d\\u0438\\u043a \\u043a \\u0433\\u0435\\u0440\\u043e\\u044e \\u2014 0,78 \\u00b1 0,06). Idle \\u2014 \\u0442\\u043e\\u0436\\u0435 \\u043f\\u043e \\u0431\\u043b\\u0438\\u0436\\u0430\\u0439\\u0448\\u0435\\u043c\\u0443 \\u0433\\u0435\\u0440\\u043e\\u044e; \\u0441\\u043e\\u0432\\u043f\\u0430\\u0434\\u0435\\u043d\\u0438\\u0435 \\u0441 \\u0447\\u0443\\u0436\\u0438\\u043c Idle \\u0434\\u043e\\u043f\\u0443\\u0441\\u0442\\u0438\\u043c\\u043e: \\u043b\\u0438\\u0441\\u0442 K1/K2 \\u043e\\u043f\\u043e\\u0437\\u043d\\u0430\\u0451\\u0442 \\u0431\\u043e\\u0439\\u0446\\u0430 \\u043f\\u043e \\u0444\\u043e\\u043a\\u0443\\u0441\\u0443 \\u0437\\u0430\\u043f\\u0443\\u0441\\u043a\\u0430 (\\u0414-3, `references/animation-vfx-sfx.md` \\u00a72.1) | \\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u0441\\u043a\\u0438\\u043b\\u043b\\u0430 |\n| \\u0421\\u043b\\u043e\\u0442\\u044b \\u044d\\u0442\\u0430\\u043f\\u0430 6 | `HIT_TYPE` \\u043f\\u043e \\u043e\\u0440\\u0443\\u0436\\u0438\\u044e \\u0438\\u0437 `BLADE`, `CLAW`, `ARROW`, `MAGIC`; \\u0441\\u043c\\u0435\\u0440\\u0442\\u044c \\u2014 `DTH-TEMPLATE`; FX \\u0438 \\u0437\\u0432\\u0443\\u043a \\u0441\\u043f\\u043e\\u0441\\u043e\\u0431\\u043d\\u043e\\u0441\\u0442\\u0438, VO \\u2014 \\u043d\\u0435\\u0442 | `references/animation-vfx-sfx.md` \\u00a78\\u2013\\u00a79 |\n| \\u042d\\u0442\\u0430\\u043b\\u043e\\u043d \\u043a\\u0430\\u0447\\u0435\\u0441\\u0442\\u0432\\u0430 | \\u043a\\u0430\\u043d\\u043e\\u043d \\u0412\\u0420-08 hero-quality-v1 | \\u0412\\u0420-\\u0440\\u0435\\u0435\\u0441\\u0442\\u0440 \\u0412\\u0420-08 |\n| \\u041f\\u0440\\u043e\\u0433\\u043e\\u043d\\u044b \\u0438 \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u0438 | \\u0432\\u0441\\u0435\\u0433\\u0434\\u0430 \\u043d\\u043e\\u0432\\u044b\\u0439 run-\\u043a\\u0430\\u0442\\u0430\\u043b\\u043e\\u0433 \\u0438 \\u043d\\u043e\\u0432\\u044b\\u0439 \\u0444\\u0430\\u0439\\u043b \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u044f | HANDBOOK \\u00a70.1, \\u00a74.1 |\n\n### 7.2 \\u0428\\u0430\\u0431\\u043b\\u043e\\u043d `asset-card.yaml`\n\n\\u0424\\u0430\\u0439\\u043b \\u043e\\u0431\\u044f\\u0437\\u0430\\u043d \\u0447\\u0438\\u0442\\u0430\\u0442\\u044c\\u0441\\u044f YAML-\\u043f\\u0430\\u0440\\u0441\\u0435\\u0440\\u043e\\u043c (`python -c \"import yaml,sys;yaml.safe_load(open(sys.argv[1],encoding='utf-8'))\" <ASSET_DIR>/asset-card.yaml`\n\\u2192 \\u0431\\u0435\\u0437 \\u043e\\u0448\\u0438\\u0431\\u043a\\u0438): \\u0442\\u0435\\u043a\\u0441\\u0442 \\u0441 \\u0434\\u0432\\u043e\\u0435\\u0442\\u043e\\u0447\\u0438\\u044f\\u043c\\u0438 \\u0438 \\u0441\\u043f\\u0435\\u0446\\u0441\\u0438\\u043c\\u0432\\u043e\\u043b\\u0430\\u043c\\u0438 \\u2014 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u0432 \\u0434\\u0432\\u043e\\u0439\\u043d\\u044b\\u0445 \\u043a\\u0430\\u0432\\u044b\\u0447\\u043a\\u0430\\u0445, \\u0447\\u0438\\u0441\\u043b\\u0430 \\u2014 \\u0447\\u0438\\u0441\\u043b\\u0430\\u043c\\u0438. \\u041f\\u043e\\u043c\\u0435\\u0442\\u043a\\u0430 \\u00ab\\u043f\\u0440\\u043e\\u043f:\\u00bb\n\\u0432 \\u043a\\u043e\\u043c\\u043c\\u0435\\u043d\\u0442\\u0430\\u0440\\u0438\\u0438 \\u2014 \\u0437\\u043d\\u0430\\u0447\\u0435\\u043d\\u0438\\u0435 \\u043f\\u043e\\u043b\\u044f \\u0443 \\u0432\\u0435\\u0442\\u043a\\u0438 `prop`; `null` \\u0443 \\u043f\\u0440\\u043e\\u043f\\u0430 \\u043f\\u0438\\u0448\\u0435\\u0442\\u0441\\u044f \\u0441 `decided_by` \\u00ab\\u043d\\u0435 \\u043f\\u0440\\u0438\\u043c\\u0435\\u043d\\u0438\\u043c\\u043e \\u043a \\u043f\\u0440\\u043e\\u043f\\u0443\\u00bb.\n\n```yaml\n# \\u0417\\u0430\\u044f\\u0432\\u043a\\u0430 \\u044d\\u0442\\u0430\\u043f\\u0430 0. \\u0424\\u0430\\u0439\\u043b: <ASSET_DIR>/asset-card.yaml. \\u041f\\u043e\\u043b\\u0435 \\u0431\\u0435\\u0437 \\u0437\\u043d\\u0430\\u0447\\u0435\\u043d\\u0438\\u044f \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044f \\u0431\\u0435\\u0440\\u0451\\u0442 \\u0434\\u0435\\u0444\\u043e\\u043b\\u0442 \\u00a77.1 \\u0441 decided_by.\nASSET_ID: \"ASSET-<NAME>-001\"        # \\u043a\\u0430\\u0442\\u0430\\u043b\\u043e\\u0433 art/pipeline-candidates/<ASSET_ID>; \\u043e\\u0431\\u0440\\u0430\\u0437\\u0435\\u0446 ASSET-KING-ARTHUR-001\nCONTENT_KEY: \"<kebab>\"              # king-arthur; \\u043f\\u0430\\u043f\\u043a\\u0430 \\u043a\\u043e\\u043d\\u0446\\u0435\\u043f\\u0442\\u0430 art/imagegen/concept-<key>-codex/, \\u0438\\u043c\\u0435\\u043d\\u0430 \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u0435\\u0439 <key>-*\nKEY: \"<PascalCase>\"                 # KingArthur; /Game/PipelineCandidates/<Key>/, Specs().Key, \\u0438\\u043c\\u0435\\u043d\\u0430 SK_/AM_/T_, cue-table\n                                    #   \\u043f\\u0440\\u043e\\u043f: PascalCase \\u0431\\u0435\\u0437 \"_\" \\u0434\\u043b\\u044f \\u043f\\u0430\\u043f\\u043a\\u0438 (DecorBarrel \\u2192 /Game/PipelineCandidates/DecorBarrel/\n                                    #   <run>/Candidate), \\u0438\\u043c\\u044f \\u043c\\u0435\\u0448\\u0430 \\u2014 UE_NAMES.prop_name\nCHARACTER: \"<\\u0438\\u043c\\u044f \\u0432 rig-contract>\"   # \\u0438\\u043c\\u044f \\u0411\\u0415\\u0417 \\u0442\\u0438\\u0442\\u0443\\u043b\\u0430 (King, Queen, Sir, Lady, Lord, Doctor, Captain\\u2026), PascalCase, \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e\n                                    #   ASCII-\\u0431\\u0443\\u043a\\u0432\\u044b, \\u0443\\u043d\\u0438\\u043a\\u0430\\u043b\\u044c\\u043d\\u043e \\u0432 rig-contract.json characters (\\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u043e\\u0440\\u043a\\u0435\\u0441\\u0442\\u0440\\u0430\\u0442\\u043e\\u0440\\u0430\n                                    #   2026-10-09): King Arthur \\u2192 Arthur (KEY KingArthur), Sir Gawain \\u2192 Gawain,\n                                    #   Robin Hood \\u2192 RobinHood (\\u00abHood\\u00bb \\u2014 \\u0447\\u0430\\u0441\\u0442\\u044c \\u0438\\u043c\\u0435\\u043d\\u0438, \\u043d\\u0435 \\u0442\\u0438\\u0442\\u0443\\u043b), Little John \\u2192 LittleJohn.\n                                    #   \\u0417\\u0430\\u043d\\u044f\\u0442\\u044b\\u0435 \\u0438\\u043c\\u0435\\u043d\\u0430: references/new-character-registration.md \\u00a71 (\\u043a\\u043e\\u043c\\u0430\\u043d\\u0434\\u0430).\n                                    #   rig.character h2_bake, --character validate_clip, clip_manifest CHARS,\n                                    #   LUT T_UM_MatLUT_<CHARACTER>, AUDIO_KEY; \\u043f\\u0440\\u043e\\u043f: null\nFIGHTER_NAME: \"<\\u0438\\u043c\\u044f \\u0431\\u043e\\u0439\\u0446\\u0430 \\u0441\\u0435\\u0440\\u0432\\u0435\\u0440\\u0430>\" # \"King Arthur\", \"Harpies\"; Specs().FighterName (Find() \\u0431\\u0435\\u0437 \\u0443\\u0447\\u0451\\u0442\\u0430 \\u0440\\u0435\\u0433\\u0438\\u0441\\u0442\\u0440\\u0430),\n                                    #   --hero-name \\u0432\\u0430\\u0440\\u0438\\u0430\\u043d\\u0442\\u0430 bench-\\u0444\\u0438\\u043a\\u0441\\u0442\\u0443\\u0440\\u044b (\\u0440\\u0435\\u0433\\u0438\\u0441\\u0442\\u0440\\u0430\\u0446\\u0438\\u044f \\u04207-11); \\u043f\\u0440\\u043e\\u043f: null\nFIGHTER_NAME_RU: \"<\\u0438\\u043c\\u044f \\u043f\\u043e-\\u0440\\u0443\\u0441\\u0441\\u043a\\u0438>\"  # S08FighterNames.json (\\u0440\\u0435\\u0433\\u0438\\u0441\\u0442\\u0440\\u0430\\u0446\\u0438\\u044f \\u04207-8); \\u043f\\u0440\\u043e\\u043f: null\nHERO_SLUG: \"<slug>\"                 # scraped-data/api/heroes/<slug>.json; heroSlug \\u0444\\u0438\\u043a\\u0441\\u0442\\u0443\\u0440\\u044b \\u0438 \\u043a\\u043b\\u044e\\u0447 S08FighterNames.json;\n                                    #   \\u043f\\u043e\\u043c\\u043e\\u0449\\u043d\\u0438\\u043a \\u0431\\u0435\\u0437 \\u043d\\u043e\\u0432\\u043e\\u0433\\u043e \\u0433\\u0435\\u0440\\u043e\\u044f: = OWNER_HERO_SLUG; \\u043f\\u0440\\u043e\\u043f: null\nOWNER_HERO_SLUG: null               # \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043f\\u043e\\u043c\\u043e\\u0449\\u043d\\u0438\\u043a \\u0431\\u0435\\u0437 \\u043d\\u043e\\u0432\\u043e\\u0433\\u043e \\u0433\\u0435\\u0440\\u043e\\u044f (GAME_ROLE sidekick, \\u0432\\u043b\\u0430\\u0434\\u0435\\u043b\\u0435\\u0446 \\u0443\\u0436\\u0435 \\u0432 Specs()):\n                                    #   \\u0441\\u043b\\u0430\\u0433 \\u0432\\u043b\\u0430\\u0434\\u0435\\u043b\\u044c\\u0446\\u0430, \"king-arthur\"; --hero-slug \\u0432\\u0430\\u0440\\u0438\\u0430\\u043d\\u0442\\u0430 \\u0444\\u0438\\u043a\\u0441\\u0442\\u0443\\u0440\\u044b (\\u0440\\u0435\\u0433\\u0438\\u0441\\u0442\\u0440\\u0430\\u0446\\u0438\\u044f \\u0414-2);\n                                    #   \\u0438\\u043d\\u0430\\u0447\\u0435 \\u0438 \\u0443 \\u043f\\u0440\\u043e\\u043f\\u0430: null\nROLE: \"hero\"                        # hero | creature | prop; check_concept_views.py --role\nANATOMY: \"humanoid\"                 # humanoid | winged-biped | non-humanoid | prop; \\u0432\\u0435\\u0442\\u043a\\u0430 \\u00a73; non-humanoid = \\u0441\\u0442\\u043e\\u043f\nGAME_ROLE: \"hero\"                   # hero | sidekick | none; Specs().bHero (dissolve 0,5/0,4 \\u0441), \\u0440\\u043e\\u0441\\u0442, \\u043f\\u043e\\u0434\\u0441\\u0442\\u0430\\u0432\\u043a\\u0430 1a,\n                                    #   \\u0430\\u0432\\u0442\\u043e\\u0442\\u0435\\u0441\\u0442 \\u00ab\\u0433\\u0435\\u0440\\u043e\\u0439 \\u0432\\u044b\\u0448\\u0435 \\u043f\\u043e\\u043c\\u043e\\u0449\\u043d\\u0438\\u043a\\u0430\\u00bb; \\u043f\\u0440\\u043e\\u043f: none\nWEAPON_HAND: \"right\"                # left | right | none; \\u043f\\u0440\\u043e\\u043c\\u043f\\u0442\\u044b \\u043a\\u043e\\u043d\\u0446\\u0435\\u043f\\u0442\\u0430; \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u044c h2-bake: \\u0447\\u0430\\u0441\\u0442\\u044c, \\u043c\\u0435\\u0448 \\u0438 \\u043a\\u043e\\u0441\\u0442\\u044c\n                                    #   \\u043e\\u0440\\u0443\\u0436\\u0438\\u044f, \\u0441\\u043e\\u043a\\u0435\\u0442 Weapon (\\u0442\\u0430\\u0431\\u043b\\u0438\\u0446\\u0430 \\u0414-1 \\u0440\\u0435\\u0433\\u0438\\u0441\\u0442\\u0440\\u0430\\u0446\\u0438\\u0438); \\u043f\\u0440\\u043e\\u043f: none\nWEAPON_BONE: \"weapon.R\"             # weapon.L | weapon.R | null; rig-contract characters.<CHARACTER>.weapon_bone;\n                                    #   ue_weapon_bone = weapon_L|weapon_R; \\u043f\\u0440\\u043e\\u043f: null\nWEAPON_SOCKET_BONE: null            # \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043f\\u0440\\u0438 WEAPON_BONE null: \\u043a\\u043e\\u0441\\u0442\\u044c \\u0441\\u043e\\u043a\\u0435\\u0442\\u0430 Weapon \\u0432 \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u0435 ue-import (Harpy \\u2014 foot.R);\n                                    #   \\u043f\\u0440\\u043e\\u043f: null\nSIDE_VIEW: \"left\"                   # \\u043d\\u0430\\u0440\\u0438\\u0441\\u043e\\u0432\\u0430\\u043d\\u043d\\u044b\\u0439 \\u0431\\u043e\\u043a \\u0432\\u0438\\u0434\\u0430 side = \\u0441\\u043b\\u043e\\u0442 Tripo; \\u0434\\u0435\\u0444\\u043e\\u043b\\u0442 left, \\u043e\\u043a\\u043e\\u043d\\u0447\\u0430\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e \\u2014 \\u043d\\u0430 \\u0448\\u0430\\u0433\\u0435 1b\n                                    #   (\\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u043e \\u2014 references/concept-sheet.md \\u00a74.1); \\u043f\\u0440\\u043e\\u043f \\u0430\\u0441\\u0438\\u043c\\u043c\\u0435\\u0442\\u0440\\u0438\\u0447\\u043d\\u044b\\u0439: null (\\u0432\\u0438\\u0434\\u044b front+back)\nPOLY_BUDGET: {figure_tris_max: 45000, base_tris_max: 2500}  # GD-058 final; \\u0433\\u0435\\u0439\\u0442 G-TOPO \\u044d\\u0442\\u0430\\u043f\\u0430 4\n                                    #   \\u043f\\u0440\\u043e\\u043f: {figure_tris_max: <\\u043f\\u043e \\u043f\\u0440\\u043e\\u043f\\u0443 \\u0442\\u043e\\u0433\\u043e \\u0436\\u0435 \\u0432\\u0438\\u0434\\u0430>, base_tris_max: null};\n                                    #   \\u0431\\u043e\\u0447\\u043a\\u0430 \\u2014 4000 \\u0432 \\u0444\\u043e\\u0440\\u043c\\u0435 Tripo (references/tripo3d-stages.md \\u00a75.3)\nFIGURE_HEIGHT_M: 0.55               # Specs().BudgetUU = \\u043c \\u00d7 100; \\u0433\\u0435\\u0440\\u043e\\u0439 0.55 (Arthur, Medusa), \\u043f\\u043e\\u043c\\u043e\\u0449\\u043d\\u0438\\u043a 0.45 / 0.42\n                                    #   \\u043f\\u0440\\u043e\\u043f: target_height_m candidate-params \\u043f\\u0440\\u043e\\u043f\\u0430 \\u0442\\u043e\\u0433\\u043e \\u0436\\u0435 \\u0432\\u0438\\u0434\\u0430 (\\u0431\\u043e\\u0447\\u043a\\u0430 0.26, \\u0444\\u043e\\u043d\\u0430\\u0440\\u044c 0.95 \\u2014\n                                    #   ASSET-DECOR-KIT-001/20260928-{p15-barrel,lantern-tripo-h31}/reports/candidate-params.json)\nFIGURE_HEIGHT_RANGE_M: [0.52, 0.56] # Specs() Min/MaxUU \\u0443 \\u0431\\u043b\\u0438\\u0436\\u0430\\u0439\\u0448\\u0435\\u0433\\u043e \\u043f\\u043e \\u0440\\u043e\\u043b\\u0438 \\u0438 \\u043e\\u0440\\u0443\\u0436\\u0438\\u044e (\\u00a77.1 \\u00ab\\u0420\\u043e\\u0441\\u0442 \\u0438 \\u0434\\u043b\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u0438\\u00bb;\n                                    #   S08HeroesV2.cpp:105-108): Arthur 52\\u201356 (\\u043c\\u0435\\u0447), Medusa 50\\u201355 (\\u043b\\u0443\\u043a), Merlin 40\\u201348\n                                    #   (\\u043f\\u043e\\u0441\\u043e\\u0445, \\u043f\\u043e\\u043c\\u043e\\u0449\\u043d\\u0438\\u043a), Harpy 35\\u201342 (\\u043a\\u043e\\u0433\\u0442\\u0438, \\u043a\\u0440\\u044b\\u043b\\u0430\\u0442\\u044b\\u0439 \\u043f\\u043e\\u043c\\u043e\\u0449\\u043d\\u0438\\u043a). \\u0414\\u0435\\u0444\\u043e\\u043b\\u0442 [0.52, 0.56] \\u2014\n                                    #   \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u0434\\u043b\\u044f \\u0433\\u0435\\u0440\\u043e\\u044f \\u0431\\u043b\\u0438\\u0436\\u043d\\u0435\\u0433\\u043e \\u0431\\u043e\\u044f; \\u0433\\u0435\\u0440\\u043e\\u0439-\\u043b\\u0443\\u0447\\u043d\\u0438\\u043a \\u2014 [0.50, 0.55] (\\u043a\\u0430\\u043a Medusa);\n                                    #   FIGURE_HEIGHT_M 0.55 \\u0432 \\u043e\\u0431\\u043e\\u0438\\u0445 \\u0441\\u043b\\u0443\\u0447\\u0430\\u044f\\u0445; \\u043f\\u0440\\u043e\\u043f: null\nIDLE_SECONDS: 2.5                  # \\u0447\\u0438\\u0441\\u043b\\u043e, \\u043d\\u0435 \\u0434\\u0440\\u043e\\u0431\\u044c (56/24 \\u2192 2.3333); clips.Idle.frames = round(\\u00d7 24) = 60; Specs() \\u2014\n                                    #   2.5f \\u0438\\u043b\\u0438 N.0f / 24.0f; \\u0441\\u043e\\u0432\\u043f\\u0430\\u0434\\u0435\\u043d\\u0438\\u0435 \\u0441 \\u0447\\u0443\\u0436\\u0438\\u043c Idle \\u0434\\u043e\\u043f\\u0443\\u0441\\u0442\\u0438\\u043c\\u043e (\\u00a77.1); \\u043f\\u0440\\u043e\\u043f: null\nLUNGE_CONTACT_FRAME: 7              # Specs().LungeContactFrame, de010: \\u043c\\u0435\\u0447 Arthur 7, \\u043f\\u043e\\u0441\\u043e\\u0445 Merlin 8, \\u043b\\u0443\\u043a Medusa 8,\n                                    #   \\u043a\\u043e\\u0433\\u0442\\u0438 Harpy 7; \\u043f\\u0440\\u043e\\u043f: null\nPALETTE:                            # 2\\u20133 \\u043e\\u0441\\u043d\\u043e\\u0432\\u043d\\u044b\\u0445 + 1 \\u0430\\u043a\\u0446\\u0435\\u043d\\u0442; \\u0444\\u043e\\u0440\\u043c\\u0430\\u0442 palette.json (references/concept-sheet.md \\u00a74.5)\n  main:                             # \\u0438\\u043c\\u0435\\u043d\\u0430 \\u2192 {{PALETTE_EN}}\n    - {name: \"<english name>\", hex: \"#RRGGBB\"}\n    - {name: \"<english name>\", hex: \"#RRGGBB\"}\n  accent: {name: \"<english name>\", hex: \"#RRGGBB\"}   # \\u0438\\u0437\\u043c\\u0435\\u0440\\u0435\\u043d\\u0438\\u044f P/S \\u043f\\u0440\\u0438\\u0451\\u043c\\u043a\\u0438; TeamColor \\u2014 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u0440\\u0430\\u043d\\u0442\\u0430\\u0439\\u043c (HANDBOOK \\u00a72.9)\nDESCRIPTION: \"<\\u0440\\u0443\\u0441.: \\u0432\\u043d\\u0435\\u0448\\u043d\\u043e\\u0441\\u0442\\u044c, \\u043a\\u043e\\u0441\\u0442\\u044e\\u043c, \\u043c\\u0430\\u0442\\u0435\\u0440\\u0438\\u0430\\u043b\\u044b, \\u043e\\u0440\\u0443\\u0436\\u0438\\u0435 \\u0438 \\u0440\\u0443\\u043a\\u0430, \\u043f\\u0440\\u0438\\u0437\\u043d\\u0430\\u043a\\u0438 \\u0441\\u0438\\u043b\\u0443\\u044d\\u0442\\u0430; \\u0438\\u0437 scraped-data \\u0438 \\u0411\\u0414 (\\u00a77.1)>\"\nDESCRIPTION_EN: \"<\\u0442\\u043e \\u0436\\u0435 \\u043f\\u043e-\\u0430\\u043d\\u0433\\u043b\\u0438\\u0439\\u0441\\u043a\\u0438, 1\\u20133 \\u043f\\u0440\\u0435\\u0434\\u043b\\u043e\\u0436\\u0435\\u043d\\u0438\\u044f; \\u0431\\u043b\\u043e\\u043a SUBJECT \\u043f\\u0440\\u043e\\u043c\\u043f\\u0442\\u043e\\u0432 1a/1c>\"\nANCHORS: \"<\\u0447\\u0442\\u043e \\u0434\\u0435\\u0440\\u0436\\u0438\\u0442 \\u0438\\u0434\\u0435\\u043d\\u0442\\u0438\\u0447\\u043d\\u043e\\u0441\\u0442\\u044c \\u043c\\u0435\\u0436\\u0434\\u0443 \\u0432\\u0438\\u0434\\u0430\\u043c\\u0438: \\u043e\\u0440\\u0443\\u0436\\u0438\\u0435 \\u0438 \\u0440\\u0443\\u043a\\u0430, \\u0433\\u043e\\u043b\\u043e\\u0432\\u043d\\u043e\\u0439 \\u0443\\u0431\\u043e\\u0440, \\u0447\\u0438\\u0441\\u043b\\u043e \\u0433\\u043e\\u043b\\u043e\\u0432 \\u0438\\u043b\\u0438 \\u043a\\u0440\\u044b\\u043b\\u044c\\u0435\\u0432>\"\nANCHORS_EN: \"<\\u0442\\u043e \\u0436\\u0435 \\u043f\\u043e-\\u0430\\u043d\\u0433\\u043b\\u0438\\u0439\\u0441\\u043a\\u0438, 3\\u20136 \\u043f\\u0440\\u0438\\u0437\\u043d\\u0430\\u043a\\u043e\\u0432 \\u0447\\u0435\\u0440\\u0435\\u0437 '; '; \\u043f\\u0440\\u043e\\u043c\\u043f\\u0442\\u044b 1a/1c>\"\n                                    # \\u043a\\u043e\\u043b\\u0447\\u0430\\u043d \\u0438 \\u043d\\u043e\\u0436\\u043d\\u044b, \\u0435\\u0441\\u043b\\u0438 \\u0437\\u0430\\u044f\\u0432\\u043a\\u0430 \\u043d\\u0435 \\u0437\\u0430\\u0434\\u0430\\u043b\\u0430 \\u0441\\u0442\\u043e\\u0440\\u043e\\u043d\\u0443, \\u2014 \\u043f\\u0440\\u043e\\u0442\\u0438\\u0432 WEAPON_HAND (\\u043d\\u0430\\u0442\\u044f\\u0433\\u0438\\u0432\\u0430\\u044e\\u0449\\u0430\\u044f\n                                    #   \\u0438\\u043b\\u0438 \\u0441\\u0432\\u043e\\u0431\\u043e\\u0434\\u043d\\u0430\\u044f \\u0440\\u0443\\u043a\\u0430): \\u043b\\u0443\\u043a \\u0432 \\u043b\\u0435\\u0432\\u043e\\u0439 \\u2192 \"quiver over the RIGHT shoulder\"; \\u043c\\u0435\\u0447 \\u0432 \\u043f\\u0440\\u0430\\u0432\\u043e\\u0439 \\u2192\n                                    #   \"scabbard on the LEFT hip\" (references/concept-sheet.md \\u00a79)\nQUALITY_REFERENCE:                  # \\u043a\\u0430\\u043d\\u043e\\u043d \\u0412\\u0420-08; \\u043f\\u0435\\u0440\\u0432\\u044b\\u0439 \\u0444\\u0430\\u0439\\u043b \\u2014 image 1 \\u043f\\u0440\\u043e\\u043c\\u043f\\u0442\\u0430 1a, \\u0432\\u0435\\u0441\\u044c \\u0441\\u043f\\u0438\\u0441\\u043e\\u043a \\u2014 \\u044d\\u0442\\u0430\\u043b\\u043e\\u043d \\u043f\\u0440\\u0438\\u0451\\u043c\\u043e\\u043a\n  - \"art/imagegen/hero-quality-v1/reference/medusa-quality-reference.png\"\n  - \"art/imagegen/hero-quality-v1/<\\u0431\\u043b\\u0438\\u0436\\u0430\\u0439\\u0448\\u0438\\u0439 \\u0433\\u0435\\u0440\\u043e\\u0439>/\"  # harpy | king-arthur | medusa | merlin; \\u0431\\u043b\\u0438\\u0436\\u0430\\u0439\\u0448\\u0438\\u0439 \\u2014 \\u043f\\u043e \\u0440\\u043e\\u043b\\u0438\n                                    #   \\u0438 \\u043e\\u0440\\u0443\\u0436\\u0438\\u044e, \\u0442\\u043e \\u0436\\u0435 \\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u043e, \\u0447\\u0442\\u043e \\u0440\\u043e\\u0441\\u0442 (\\u00a77.1 \\u00ab\\u0420\\u043e\\u0441\\u0442 \\u0438 \\u0434\\u043b\\u0438\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\\u0441\\u0442\\u0438\\u00bb): \\u043c\\u0435\\u0447, \\u0431\\u043b\\u0438\\u0436\\u043d\\u0438\\u0439 \\u0431\\u043e\\u0439 \\u2192\n                                    #   king-arthur; \\u043b\\u0443\\u043a \\u2192 medusa; \\u043f\\u043e\\u0441\\u043e\\u0445, \\u043c\\u0430\\u0433\\u0438\\u044f \\u2192 merlin; \\u043a\\u0440\\u044b\\u043b\\u044c\\u044f, \\u043a\\u043e\\u0433\\u0442\\u0438 \\u2192 harpy\nUE_NAMES:                           # \\u0438\\u0437 KEY \\u0438 \\u043f\\u043e\\u043a\\u043e\\u043b\\u0435\\u043d\\u0438\\u044f H2 (Stage = H2LD; H3LD \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043f\\u0440\\u0438 \\u0432\\u0442\\u043e\\u0440\\u043e\\u043c \\u043f\\u043e\\u043a\\u043e\\u043b\\u0435\\u043d\\u0438\\u0438)\n  stage: \"H2LD\"                     # Specs().Stage, \\u043f\\u0430\\u043f\\u043a\\u0430 /Game/PipelineCandidates/<Key>/<Stage>/; \\u043f\\u0440\\u043e\\u043f: null\n  skeletal_mesh: \"SK_<Key>_H2LD\"    # \\u043f\\u0440\\u043e\\u043f: null\n  base: \"SM_<Key>_H2LD_Base\"        # \\u043f\\u0440\\u043e\\u043f: null\n  materials:                        # \\u0441\\u043b\\u043e\\u0442 FBX \\u2014 materials.atlas \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u044f bake: M_<Key>_H2_Atlas; \\u043f\\u0440\\u043e\\u043f: [MI \\u043f\\u043e \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u044e \\u00a75 \\u043f.6]\n    - \"MI_<Key>_H2LD\"\n    - \"MI_<Key>_H2LD_Base\"\n    - \"MI_<Key>_H2LD_P1\"\n    - \"MI_<Key>_H2LD_P2\"\n    - \"MI_<Key>_H2LD_Base_P1\"\n    - \"MI_<Key>_H2LD_Base_P2\"\n  dissolve: \"/Game/UM/Materials/v2/Dissolve/MI_<Key>_H2LD_{P1,P2}_Dissolve\"   # \\u043f\\u0440\\u043e\\u043f: null\n  skeleton: \"/Game/PipelineCandidates/<Key>/Rig/SK_<Key>_Skeleton\"            # \\u043f\\u0440\\u043e\\u043f: null\n  clips: \"/Game/PipelineCandidates/<Key>/H2Anim/AM_<Key>_{Idle,LungeAttack,HitReact,DeathSettle}\"  # \\u043f\\