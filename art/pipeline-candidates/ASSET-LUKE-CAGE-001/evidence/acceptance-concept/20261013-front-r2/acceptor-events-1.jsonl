044d\\u0442\\u0430\\u043f\\u043e\\u0432 3\\u20134 | \\u043f\\u043e\\u0437\\u0430, \\u043f\\u0440\\u043e\\u043f\\u043e\\u0440\\u0446\\u0438\\u0438, \\u044f\\u043a\\u043e\\u0440\\u044f \\u0438 \\u0441\\u0442\\u043e\\u0440\\u043e\\u043d\\u0430 \\u043e\\u0440\\u0443\\u0436\\u0438\\u044f \\u0441\\u043e\\u0432\\u043f\\u0430\\u0434\\u0430\\u044e\\u0442; \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u044c \\u0438 \\u0432\\u0438\\u0434 \\u0441\\u0437\\u0430\\u0434\\u0438 \\u0441\\u0442\\u0440\\u043e\\u0433\\u0438\\u0435 | \\u0443\\u0440\\u043e\\u0432\\u0435\\u043d\\u044c \\u044d\\u0442\\u0430\\u043b\\u043e\\u043d\\u0430: \\u0440\\u0430\\u0441\\u043f\\u0438\\u0441\\u0430\\u043d\\u043d\\u0430\\u044f \\u043a\\u043e\\u043b\\u043b\\u0435\\u043a\\u0446\\u0438\\u043e\\u043d\\u043d\\u0430\\u044f \\u043c\\u0438\\u043d\\u0438\\u0430\\u0442\\u044e\\u0440\\u0430, \\u0434\\u0435\\u0442\\u0430\\u043b\\u0438 \\u0432\\u043d\\u0443\\u0442\\u0440\\u0438 \\u0441\\u0438\\u043b\\u0443\\u044d\\u0442\\u0430 | \\u043f\\u0430\\u043b\\u0438\\u0442\\u0440\\u0430 = `PALETTE` (\\u0441\\u0432\\u043e\\u0442\\u0447\\u0438 \\u043b\\u0438\\u0441\\u0442\\u0430 \\u0441\\u043e\\u0432\\u043f\\u0430\\u0434\\u0430\\u044e\\u0442 \\u0441 \\u0444\\u0438\\u0433\\u0443\\u0440\\u043e\\u0439), \\u0432\\u0441\\u0435 \\u044f\\u043a\\u043e\\u0440\\u044f \\u043d\\u0430 \\u043c\\u0435\\u0441\\u0442\\u0435 \\u0442\\u0430\\u043c, \\u0433\\u0434\\u0435 \\u0432\\u0438\\u0434\\u0438\\u043c\\u044b |\n\n`score = round(sum / (2 \\u00d7 n_applicable) \\u00d7 10, 1)`, n = 4 \\u0432\\u0441\\u0435\\u0433\\u0434\\u0430 (\\u0441\\u0445\\u0435\\u043c\\u0430 \\u0442\\u0440\\u0435\\u0431\\u0443\\u0435\\u0442 \\u0447\\u0438\\u0441\\u043b\\u043e\\u0432\\u044b\\u0435 S, C, Q, P; null \\u0443\n\\u043a\\u043e\\u043d\\u0446\\u0435\\u043f\\u0442\\u0430 \\u043d\\u0435 \\u0434\\u043e\\u043f\\u0443\\u0441\\u043a\\u0430\\u0435\\u0442\\u0441\\u044f). \\u0421\\u0440\\u0430\\u0432\\u043d\\u0435\\u043d\\u0438\\u0435 `score >= 8.0`.\n\n**C \\u043d\\u0430 1a \\u2014 \\u0444\\u0438\\u043a\\u0441\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u043d\\u043e\\u0435 \\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u043e (\\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u0441\\u043a\\u0438\\u043b\\u043b\\u0430).** \\u041d\\u0430 1a \\u043e\\u0434\\u0438\\u043d \\u0432\\u0438\\u0434, \\u0441\\u043e\\u0433\\u043b\\u0430\\u0441\\u043e\\u0432\\u0430\\u043d\\u043d\\u043e\\u0441\\u0442\\u044c \\u0432\\u0438\\u0434\\u043e\\u0432 \\u043d\\u0435 \\u043e\\u0446\\u0435\\u043d\\u0438\\u0432\\u0430\\u0435\\u0442\\u0441\\u044f, \\u043d\\u043e \\u0441\\u0445\\u0435\\u043c\\u0430\n\\u0442\\u0440\\u0435\\u0431\\u0443\\u0435\\u0442 \\u0447\\u0438\\u0441\\u043b\\u043e. \\u041f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a \\u0441\\u0442\\u0430\\u0432\\u0438\\u0442 `C = 1,5` \\u0441 \\u043e\\u0431\\u043e\\u0441\\u043d\\u043e\\u0432\\u0430\\u043d\\u0438\\u0435\\u043c \\u00ab1a: \\u043e\\u0434\\u0438\\u043d \\u0432\\u0438\\u0434, C \\u043d\\u0435 \\u043e\\u0446\\u0435\\u043d\\u0438\\u0432\\u0430\\u0435\\u0442\\u0441\\u044f; \\u0444\\u0438\\u043a\\u0441\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u043d\\u043e\\u0435 \\u0437\\u043d\\u0430\\u0447\\u0435\\u043d\\u0438\\u0435\nconcept-sheet.md \\u00a711\\u00bb \\u0438 `frames: [\"<key>-front.png\"]`; \\u0432 `rework_fix_list` C \\u043d\\u0430 1a \\u043d\\u0435 \\u043f\\u043e\\u043f\\u0430\\u0434\\u0430\\u0435\\u0442. \\u041f\\u043e\\u0447\\u0435\\u043c\\u0443 1,5: \\u043f\\u0440\\u0438 \\u0448\\u0430\\u0433\\u0435\n0,5 \\u0443\\u0441\\u043b\\u043e\\u0432\\u0438\\u0435 pass `(S + Q + P + 1,5) / 8 \\u00d7 10 \\u2265 8,0` \\u0440\\u0430\\u0432\\u043d\\u043e\\u0441\\u0438\\u043b\\u044c\\u043d\\u043e `S + Q + P \\u2265 5,0`, \\u0442\\u043e \\u0435\\u0441\\u0442\\u044c \\u0440\\u043e\\u0432\\u043d\\u043e \\u043f\\u043e\\u0440\\u043e\\u0433\\u0443 8,0 \\u043f\\u043e \\u0442\\u0440\\u0451\\u043c\n\\u043e\\u0446\\u0435\\u043d\\u0438\\u0432\\u0430\\u0435\\u043c\\u044b\\u043c \\u0438\\u0437\\u043c\\u0435\\u0440\\u0435\\u043d\\u0438\\u044f\\u043c (`5,0 / 6 \\u00d7 10 = 8,3`, `4,5 / 6 \\u00d7 10 = 7,5`); 1,5 \\u043d\\u0435 \\u0441\\u0440\\u0430\\u0431\\u0430\\u0442\\u044b\\u0432\\u0430\\u0435\\u0442 \\u043a\\u0430\\u043a \\u0432\\u0435\\u0442\\u043e (< 1,0). \\u041f\\u0440\\u043e\\u0432\\u0435\\u0440\\u0435\\u043d\\u043e\n`validate_card.py` \\u043d\\u0430 \\u043f\\u0440\\u043e\\u0431\\u043d\\u044b\\u0445 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0430\\u0445 1a: S 1,5 + C 1,5 + Q 1,5 + P 2 \\u2192 8,1 `pass` (\\u043a\\u043e\\u0434 3: \\u0432\\u0442\\u043e\\u0440\\u043e\\u0439 \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a, \\u00ab\\u0423\\u0441\\u0442\\u043e\\u0439\\u0447\\u0438\\u0432\\u044b\\u0439 pass \\u043b\\u0438\\u0441\\u0442\\u0430\\u00bb \\u043d\\u0438\\u0436\\u0435); S 1 + C 1,5 + Q 1,5 + P 2 \\u2192 7,5\n`return_to_stage_1`.\n\n**\\u0412\\u0435\\u0440\\u0434\\u0438\\u043a\\u0442** (\\u0434\\u0435\\u0442\\u0435\\u0440\\u043c\\u0438\\u043d\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u043d\\u043e, \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u044f\\u0435\\u0442 `validate_card.py`): \\u0433\\u0435\\u0439\\u0442 `G-CHECKS` FAIL \\u2192 `return_to_stage_1`; \\u043b\\u044e\\u0431\\u043e\\u0435\n\\u0438\\u0437\\u043c\\u0435\\u0440\\u0435\\u043d\\u0438\\u0435 < 1,0 \\u2192 `return_to_stage_1` \\u043f\\u0440\\u0438 \\u043b\\u044e\\u0431\\u043e\\u0439 \\u0441\\u0443\\u043c\\u043c\\u0435; `score < 8.0` \\u2192 `return_to_stage_1`; \\u0438\\u043d\\u0430\\u0447\\u0435 `pass`. \\u0426\\u0438\\u043a\\u043b `r4`\n\\u0431\\u0435\\u0437 pass \\u2192 `escalate_user` (`validate_card.py` `LAST_CYCLE[\"concept\"] = 4`). \\u0417\\u0430\\u043f\\u0440\\u0435\\u0449\\u0451\\u043d\\u043d\\u0430\\u044f \\u043f\\u043e\\u0437\\u0430 (T \\u0438\\u043b\\u0438 A) \\u2014 S = 0, \\u0442\\u043e\n\\u0435\\u0441\\u0442\\u044c \\u0432\\u0435\\u0442\\u043e: \\u043b\\u0438\\u0441\\u0442 \\u043d\\u0435 \\u043f\\u0440\\u043e\\u0445\\u043e\\u0434\\u0438\\u0442 \\u043f\\u0440\\u0438 \\u043b\\u044e\\u0431\\u043e\\u0439 \\u0441\\u0443\\u043c\\u043c\\u0435.\n\n**\\u0423\\u0441\\u0442\\u043e\\u0439\\u0447\\u0438\\u0432\\u044b\\u0439 pass \\u043b\\u0438\\u0441\\u0442\\u0430** (\\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u043e\\u0440\\u043a\\u0435\\u0441\\u0442\\u0440\\u0430\\u0442\\u043e\\u0440\\u0430 \\u043f\\u043e \\u043a\\u0430\\u043b\\u0438\\u0431\\u0440\\u043e\\u0432\\u043a\\u0435 2026-10-09, \\u0440\\u0430\\u0443\\u043d\\u0434 3; \\u0442\\u043e \\u0436\\u0435 \\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u043e, \\u0447\\u0442\\u043e \\u0443 \\u043c\\u043e\\u0434\\u0435\\u043b\\u0438,\n`references/acceptance-and-blender.md` \\u00a76, \\u00a78.5, \\u00a713). `pass` \\u0441\\u043e `score` 8,0\\u20138,4 \\u043e\\u0434\\u043d\\u043e\\u0439 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u043e\\u0439 \\u043d\\u0435 \\u043e\\u043a\\u043e\\u043d\\u0447\\u0430\\u0442\\u0435\\u043b\\u0435\\u043d:\n`validate_card.py` \\u0434\\u0430\\u0451\\u0442 \\u043a\\u043e\\u0434 **3** \\u0438 \\u043f\\u0435\\u0447\\u0430\\u0442\\u0430\\u0435\\u0442 `needs_second_acceptor`. \\u041d\\u0430 1a \\u044d\\u0442\\u043e \\u043b\\u044e\\u0431\\u043e\\u0439 pass \\u0441 `S + Q + P` = 5,0 (C = 1,5\n\\u0444\\u0438\\u043a\\u0441\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u043e), \\u0442\\u043e \\u0435\\u0441\\u0442\\u044c 8,1. \\u041f\\u043e\\u0440\\u044f\\u0434\\u043e\\u043a:\n\n1. \\u0412\\u0442\\u043e\\u0440\\u043e\\u0439 \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a \\u2014 **\\u0434\\u0440\\u0443\\u0433\\u043e\\u0439 \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u044c** (\\u00abSol 6.1 xhigh\\u00bb \\u043f\\u0440\\u0438 \\u043f\\u0435\\u0440\\u0432\\u043e\\u043c \\u00abOpus xhigh\\u00bb \\u0438 \\u043d\\u0430\\u043e\\u0431\\u043e\\u0440\\u043e\\u0442), \\u0442\\u043e\\u0442 \\u0436\\u0435 \\u043f\\u0440\\u043e\\u043c\\u043f\\u0442 \\u043d\\u0438\\u0436\\u0435, \\u0442\\u0435\n   \\u0436\\u0435 \\u0444\\u0430\\u0439\\u043b\\u044b, \\u043d\\u043e\\u0432\\u044b\\u0439 \\u043a\\u043e\\u043d\\u0442\\u0435\\u043a\\u0441\\u0442; \\u043f\\u0435\\u0440\\u0432\\u0443\\u044e \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0443 \\u043e\\u043d \\u043d\\u0435 \\u0432\\u0438\\u0434\\u0438\\u0442. \\u041e\\u0442\\u0432\\u0435\\u0442 \\u2014 `card-2.json` \\u0440\\u044f\\u0434\\u043e\\u043c \\u0441 `card.json` (\\u0434\\u043b\\u044f Sol \\u2014\n   `--output-schema tools/art/acceptance/asset-acceptance-2.output-concept.schema.json -o <\\u043a\\u0430\\u0442\\u0430\\u043b\\u043e\\u0433>/card-2.json`;\n   \\u043e\\u0441\\u0442\\u0430\\u043b\\u044c\\u043d\\u043e\\u0435 \\u2014 \\u043a\\u043e\\u043c\\u0430\\u043d\\u0434\\u0430 `references/acceptance-and-blender.md` \\u00a78.4, \\u0441 `windows.sandbox=\"unelevated\"`).\n2. \\u0418\\u0442\\u043e\\u0433 \\u043f\\u0430\\u0440\\u044b:\n   ```bash\n   python tools/art/acceptance/validate_card.py <\\u043a\\u0430\\u0442\\u0430\\u043b\\u043e\\u0433>/card.json --second <\\u043a\\u0430\\u0442\\u0430\\u043b\\u043e\\u0433>/card-2.json \\\n       --final-json <\\u043a\\u0430\\u0442\\u0430\\u043b\\u043e\\u0433>/final.json --print-verdict --check-files\n   ```\n   `score` \\u2014 \\u043c\\u0438\\u043d\\u0438\\u043c\\u0443\\u043c \\u0434\\u0432\\u0443\\u0445; \\u0432\\u0435\\u0440\\u0434\\u0438\\u043a\\u0442 \\u2014 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0438 \\u0441 \\u043c\\u0435\\u043d\\u044c\\u0448\\u0438\\u043c `score` (\\u043f\\u0440\\u0438 \\u0440\\u0430\\u0432\\u0435\\u043d\\u0441\\u0442\\u0432\\u0435 \\u2014 \\u0431\\u043e\\u043b\\u0435\\u0435 \\u0441\\u0442\\u0440\\u043e\\u0433\\u0438\\u0439), \\u043d\\u043e \\u0441\\u0442\\u0440\\u043e\\u0433\\u0438\\u0439 \\u043c\\u0430\\u0440\\u0448\\u0440\\u0443\\u0442\n   \\u0434\\u0440\\u0443\\u0433\\u043e\\u0439 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0438 (`return_to_stage_1`, FAIL `G-CHECKS`, \\u0432\\u0435\\u0442\\u043e) \\u043f\\u043e\\u0431\\u0435\\u0436\\u0434\\u0430\\u0435\\u0442. \\u041c\\u0430\\u0440\\u0448\\u0440\\u0443\\u0442 \\u0438 `rework_fix_list` (\\u043f\\u0443\\u043d\\u043a\\u0442\\u044b\n   CORRECTION) \\u2014 \\u0438\\u0437 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0438 `final.json#source_card`.\n3. \\u0412\\u0442\\u043e\\u0440\\u043e\\u0439 `pass` \\u0432 \\u0442\\u043e\\u0439 \\u0436\\u0435 \\u043f\\u043e\\u043b\\u043e\\u0441\\u0435 \\u2014 \\u0438\\u0442\\u043e\\u0433 `pass`; \\u0442\\u0440\\u0435\\u0442\\u0438\\u0439 \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a \\u043d\\u0435 \\u043d\\u0443\\u0436\\u0435\\u043d. \\u0414\\u0440\\u0443\\u0433\\u043e\\u0439 \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u044c \\u043d\\u0435 \\u0437\\u0430\\u043f\\u0443\\u0441\\u043a\\u0430\\u0435\\u0442\\u0441\\u044f \\u043f\\u043e\\u0441\\u043b\\u0435 \\u043f\\u0440\\u043e\\u0431\\u044b\n   (\\u00a75.2) \\u2014 \\u0432\\u0442\\u043e\\u0440\\u043e\\u0439 \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a \\u0442\\u043e\\u0433\\u043e \\u0436\\u0435 \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u044f \\u0432 \\u043d\\u043e\\u0432\\u043e\\u043c \\u043a\\u043e\\u043d\\u0442\\u0435\\u043a\\u0441\\u0442\\u0435 \\u0438 `--same-profile-ok`.\n\n**\\u041a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0430** (\\u0444\\u043e\\u0440\\u043c\\u0430 \\u2014 \\u0441\\u0445\\u0435\\u043c\\u0430 `tools/art/acceptance/asset-acceptance-2.schema.json`, \\u0432\\u0435\\u0442\\u043a\\u0430 `kind: concept`; \\u043f\\u043e\\u043b\\u044f:)\n\n| \\u041f\\u043e\\u043b\\u0435 | \\u0417\\u043d\\u0430\\u0447\\u0435\\u043d\\u0438\\u0435 \\u043d\\u0430 \\u044d\\u0442\\u0430\\u043f\\u0435 1 |\n|---|---|\n| `schema`, `kind` | `\"unmatched.concept-acceptance/1\"`, `\"concept\"` |\n| `asset_id` | `ASSET_ID` |\n| `cycle` | `r1`\\u2013`r4` (1a \\u0438 1c \\u0441\\u0447\\u0438\\u0442\\u0430\\u044e\\u0442\\u0441\\u044f \\u0440\\u0430\\u0437\\u0434\\u0435\\u043b\\u044c\\u043d\\u043e, \\u0440\\u0430\\u0437\\u0434\\u0435\\u043b 10) |\n| `date` | \\u0434\\u0430\\u0442\\u0430 \\u043f\\u0440\\u0438\\u0451\\u043c\\u043a\\u0438 `YYYY-MM-DD` (\\u043e\\u0431\\u044f\\u0437\\u0430\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e) |\n| `previous_card` | `null` \\u0443 r1; \\u0443 r2+ \\u2014 \\u043f\\u0443\\u0442\\u044c \\u043e\\u0442 \\u043a\\u043e\\u0440\\u043d\\u044f \\u0440\\u0435\\u043f\\u043e \\u043a `card.json` \\u043f\\u0440\\u0435\\u0434\\u044b\\u0434\\u0443\\u0449\\u0435\\u0433\\u043e \\u0446\\u0438\\u043a\\u043b\\u0430 \\u0442\\u043e\\u0433\\u043e \\u0436\\u0435 \\u0448\\u0430\\u0433\\u0430 (\\u043e\\u0431\\u044f\\u0437\\u0430\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e, `validate_card.py:308-311`) |\n| `accepted_object` | `[{path, sha256}]`, \\u043f\\u0443\\u0442\\u0438 \\u043e\\u0442 \\u043a\\u043e\\u0440\\u043d\\u044f \\u0440\\u0435\\u043f\\u043e: 1a \\u2014 `art/imagegen/concept-<key>-codex/design/<key>-front.png`; 1c \\u2014 `<key>-front.png`, `<key>-side.png`, `<key>-back.png` \\u043f\\u0430\\u043a\\u0435\\u0442\\u0430 |\n| `frames` | \\u043e\\u0431\\u044a\\u0435\\u043a\\u0442 `{dir, files}`: `dir` \\u2014 \\u043a\\u0430\\u0442\\u0430\\u043b\\u043e\\u0433 \\u043e\\u0442 \\u043a\\u043e\\u0440\\u043d\\u044f \\u0440\\u0435\\u043f\\u043e, `files` \\u2014 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u0438\\u043c\\u0435\\u043d\\u0430 \\u0431\\u0435\\u0437 `/` (\\u0448\\u0430\\u0431\\u043b\\u043e\\u043d `^[A-Za-z0-9._-]+\\.(jpg\\|png\\|json)$`). 1a: `dir` = `art/imagegen/concept-<key>-codex/design`, `files` = [`<key>-front.png`, `checks-report.json`]. 1c: `dir` = `art/imagegen/concept-<key>-codex`, `files` = [`sheet-<key>.png`, `<key>-front.png`, `<key>-side.png`, `<key>-back.png`, `checks-report.json`] |\n| `reports` | \\u043f\\u0443\\u0442\\u0438 \\u043e\\u0442 \\u043a\\u043e\\u0440\\u043d\\u044f \\u0440\\u0435\\u043f\\u043e: `checks-report.json` \\u044d\\u0442\\u043e\\u0433\\u043e \\u0448\\u0430\\u0433\\u0430, `generation-records.json`, `verification.json` |\n| `gates` | `{\"G-CHECKS\": {\"status\": \"PASS\"\\|\"FAIL\", \"source\": \"<\\u043f\\u0443\\u0442\\u044c checks-report.json>\", \"note\": \"\\u2026\"}}` \\u2014 \\u0438 \\u0431\\u043e\\u043b\\u044c\\u0448\\u0435 \\u043d\\u0438\\u0447\\u0435\\u0433\\u043e |\n| `scores` | `S`, `C`, `Q`, `P`: `{value: 0\\u20132 \\u0448\\u0430\\u0433 0,5, rationale, frames}`; `frames` \\u2014 \\u0438\\u043c\\u0435\\u043d\\u0430 \\u0438\\u0437 `frames.files` |\n| `score`, `verdict` | \\u043f\\u043e \\u0444\\u043e\\u0440\\u043c\\u0443\\u043b\\u0435 \\u0438 \\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u0430\\u043c \\u0432\\u044b\\u0448\\u0435 |\n| `verdict_reason` | \\u043e\\u0431\\u044f\\u0437\\u0430\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e \\u043f\\u0440\\u0438 `verdict` \\u2260 `pass` (\\u2265 10 \\u0441\\u0438\\u043c\\u0432\\u043e\\u043b\\u043e\\u0432): \\u043a\\u0430\\u043a\\u043e\\u0435 \\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u043e \\u0441\\u0440\\u0430\\u0431\\u043e\\u0442\\u0430\\u043b\\u043e |\n| `rework_fix_list` | `[{item, frame, fix, tool}]`: `item` \\u2014 \\u0438\\u0437\\u043c\\u0435\\u0440\\u0435\\u043d\\u0438\\u0435 < 2 \\u0438\\u043b\\u0438 `G-CHECKS` \\u043f\\u0440\\u0438 FAIL; `frame` \\u2014 \\u0432\\u0438\\u0434/\\u0444\\u0430\\u0439\\u043b; `fix` \\u2014 \\u043e\\u0434\\u043d\\u0430 \\u0430\\u043d\\u0433\\u043b\\u0438\\u0439\\u0441\\u043a\\u0430\\u044f \\u0441\\u0442\\u0440\\u043e\\u043a\\u0430, \\u043f\\u0440\\u0438\\u0433\\u043e\\u0434\\u043d\\u0430\\u044f \\u0434\\u043b\\u044f CORRECTION; `tool` \\u2014 `Codex 1c CORRECTION` \\| `Tripo 1b \\u0447\\u0435\\u0440\\u043d\\u043e\\u0432\\u0438\\u043a` \\| `Codex 1a` |\n| `acceptor` | `{profile: \"Opus xhigh\"\\|\"Sol 6.1 xhigh\", session_id}` |\n| `executor_session_id` | \\u0441\\u0435\\u0441\\u0441\\u0438\\u044f \\u0437\\u0430\\u043f\\u0443\\u0441\\u043a\\u0430\\u044e\\u0449\\u0435\\u0433\\u043e \\u0430\\u0433\\u0435\\u043d\\u0442\\u0430 (\\u2260 `acceptor.session_id`) |\n| `decided_by` | `\"delegated (\\u0412\\u0420-\\u0440\\u0435\\u0435\\u0441\\u0442\\u0440 2026-10-06)\"` \\u0438\\u043b\\u0438 `\"user\"` |\n| `status_note` | \\u043f\\u0440\\u0438 pass \\u043f\\u043e \\u0434\\u0435\\u043b\\u0435\\u0433\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044e \\u2014 \\u0441\\u043e\\u0434\\u0435\\u0440\\u0436\\u0438\\u0442 \\u00ab\\u043f\\u043e \\u0434\\u0435\\u043b\\u0435\\u0433\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044e\\u00bb (`docs/game-design/decisions/2026-10-06-visual-delegated-decisions.md`) |\n\n\\u041f\\u0443\\u0442\\u044c: `art/pipeline-candidates/<ASSET_ID>/evidence/acceptance-concept/<YYYYMMDD>-front-r<N>/card.json` (1a) \\u0438\n`\\u2026/<YYYYMMDD>-sheet-r<N>/card.json` (1c). \\u041f\\u0443\\u0441\\u0442\\u043e\\u0439 \\u043a\\u0430\\u0442\\u0430\\u043b\\u043e\\u0433 `frames/` \\u043d\\u0435 \\u043d\\u0443\\u0436\\u0435\\u043d: \\u043a\\u0430\\u0434\\u0440\\u044b \\u2014 \\u0444\\u0430\\u0439\\u043b\\u044b \\u043f\\u0430\\u043a\\u0435\\u0442\\u0430.\n\n```bash\npython tools/art/acceptance/validate_card.py \\\n    art/pipeline-candidates/<ASSET_ID>/evidence/acceptance-concept/<YYYYMMDD>-<front|sheet>-r<N>/card.json \\\n    --print-verdict --check-files\n# \\u043a\\u043e\\u0434 0 = \\u0441\\u0445\\u0435\\u043c\\u0430 \\u0432\\u0430\\u043b\\u0438\\u0434\\u043d\\u0430 \\u0438 \\u0432\\u0435\\u0440\\u0434\\u0438\\u043a\\u0442 \\u0441\\u043e\\u0433\\u043b\\u0430\\u0441\\u043e\\u0432\\u0430\\u043d \\u0441 \\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u0430\\u043c\\u0438; 1 = \\u043d\\u0435\\u0442. --check-files \\u0441\\u0432\\u0435\\u0440\\u044f\\u0435\\u0442 sha256 accepted_object\n# \\u0438 \\u043d\\u0430\\u043b\\u0438\\u0447\\u0438\\u0435 frames/reports/previous_card; \\u0437\\u0430\\u043f\\u0443\\u0441\\u043a \\u0438\\u0437 \\u043a\\u043e\\u0440\\u043d\\u044f \\u0440\\u0435\\u043f\\u043e\n```\n\n**\\u041f\\u0440\\u043e\\u043c\\u043f\\u0442 \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a\\u0430** (\\u043d\\u0430 \\u0432\\u0445\\u043e\\u0434 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u0444\\u0430\\u0439\\u043b\\u044b, \\u043e\\u0442\\u0447\\u0451\\u0442\\u044b, \\u0432\\u044b\\u0434\\u0435\\u0440\\u0436\\u043a\\u0430 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0438 \\u0438 \\u0440\\u0443\\u0431\\u0440\\u0438\\u043a\\u0430; \\u043e\\u0442\\u0432\\u0435\\u0442 \\u2014 JSON \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0438 \\u043f\\u043e \\u0441\\u0445\\u0435\\u043c\\u0435):\n\n```text\n\\u0422\\u044b \\u2014 \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a \\u044d\\u0442\\u0430\\u043f\\u0430 1 \\u0441\\u043a\\u0438\\u043b\\u043b\\u0430 3d-model-pipeline (\\u043a\\u043e\\u043d\\u0446\\u0435\\u043f\\u0442-\\u043b\\u0438\\u0441\\u0442). \\u0424\\u0430\\u0439\\u043b\\u044b \\u043d\\u0435 \\u043f\\u0440\\u0430\\u0432\\u0438\\u0448\\u044c, \\u043d\\u0438\\u0447\\u0435\\u0433\\u043e \\u043d\\u0435 \\u0433\\u0435\\u043d\\u0435\\u0440\\u0438\\u0440\\u0443\\u0435\\u0448\\u044c.\n\\u041e\\u0431\\u044a\\u0435\\u043a\\u0442: <1a: \\u0434\\u0438\\u0437\\u0430\\u0439\\u043d-front design/<key>-front.png | 1c: \\u0432\\u0438\\u0434\\u044b <key>-front/side/back.png \\u0438 \\u043b\\u0438\\u0441\\u0442 sheet-<key>.png>.\n\\u041e\\u0442\\u043a\\u0440\\u043e\\u0439 \\u043a\\u0430\\u0436\\u0434\\u044b\\u0439 \\u0444\\u0430\\u0439\\u043b \\u043a\\u0430\\u043a \\u043a\\u0430\\u0440\\u0442\\u0438\\u043d\\u043a\\u0443. \\u041f\\u0440\\u043e\\u0447\\u0438\\u0442\\u0430\\u0439 checks-report.json \\u0438 generation-records.json.\n\\u0412\\u044b\\u0434\\u0435\\u0440\\u0436\\u043a\\u0430 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0438 \\u0430\\u0441\\u0441\\u0435\\u0442\\u0430: DESCRIPTION, ANCHORS, PALETTE, ANATOMY, WEAPON_HAND, SIDE_VIEW (<\\u0437\\u043d\\u0430\\u0447\\u0435\\u043d\\u0438\\u044f>).\n\\u042d\\u0442\\u0430\\u043b\\u043e\\u043d \\u043a\\u0430\\u0447\\u0435\\u0441\\u0442\\u0432\\u0430: <QUALITY_REFERENCE> (\\u043e\\u0442\\u043a\\u0440\\u043e\\u0439). \\u0414\\u043b\\u044f 1c \\u2014 \\u0435\\u0449\\u0451 \\u0434\\u0438\\u0437\\u0430\\u0439\\u043d design/<key>-front.png \\u0438 \\u043e\\u0440\\u0442\\u043e\\u043f\\u0440\\u043e\\u0435\\u043a\\u0446\\u0438\\u0438 1b.\n\\u0420\\u0443\\u0431\\u0440\\u0438\\u043a\\u0430: references/concept-sheet.md \\u0440\\u0430\\u0437\\u0434\\u0435\\u043b 11 (\\u0442\\u0430\\u0431\\u043b\\u0438\\u0446\\u0430 S, C, Q, P). \\u041d\\u0430 1a C = 1,5 \\u043f\\u043e \\u0444\\u0438\\u043a\\u0441\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u043d\\u043e\\u043c\\u0443 \\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u0443\n\\u0440\\u0430\\u0437\\u0434\\u0435\\u043b\\u0430 11, \\u0432 rework_fix_list C \\u043d\\u0430 1a \\u043d\\u0435 \\u0432\\u043a\\u043b\\u044e\\u0447\\u0430\\u0439. T- \\u0438\\u043b\\u0438 A-\\u043f\\u043e\\u0437\\u0430 = S 0. \\u0411\\u0430\\u043b\\u043b \\u2014 \\u043f\\u043e \\u044f\\u043a\\u043e\\u0440\\u044f\\u043c, \\u0448\\u0430\\u0433 0,5; \\u043e\\u0431\\u043e\\u0441\\u043d\\u043e\\u0432\\u0430\\u043d\\u0438\\u0435 \\u0441\n\\u0438\\u043c\\u0435\\u043d\\u0430\\u043c\\u0438 \\u0444\\u0430\\u0439\\u043b\\u043e\\u0432 \\u0438\\u0437 frames.files. \\u0413\\u0435\\u0439\\u0442 \\u043e\\u0434\\u0438\\u043d \\u2014 G-CHECKS \\u043f\\u043e checks-report.json (\\u043a\\u043e\\u0434 0 \\u2192 PASS); WARN \\u043d\\u0435 \\u0433\\u0435\\u0439\\u0442, \\u0443\\u0447\\u0438\\u0442\\u044b\\u0432\\u0430\\u0439 \\u0438\\u0445\n\\u0432 C. rework_fix_list \\u2014 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u0438\\u0437\\u043c\\u0435\\u0440\\u0435\\u043d\\u0438\\u044f < 2 \\u0438 G-CHECKS \\u043f\\u0440\\u0438 FAIL; \\u0443 \\u043f\\u0443\\u043d\\u043a\\u0442\\u0430: item, frame (\\u0432\\u0438\\u0434), fix (\\u043e\\u0434\\u043d\\u0430 \\u0430\\u043d\\u0433\\u043b\\u0438\\u0439\\u0441\\u043a\\u0430\\u044f\n\\u0441\\u0442\\u0440\\u043e\\u043a\\u0430 \\u0434\\u043b\\u044f CORRECTION), tool (Codex 1c CORRECTION | Tripo 1b \\u0447\\u0435\\u0440\\u043d\\u043e\\u0432\\u0438\\u043a | Codex 1a). \\u0412\\u0435\\u0440\\u0434\\u0438\\u043a\\u0442 \\u043f\\u043e\\u0441\\u0447\\u0438\\u0442\\u0430\\u0439 \\u043f\\u043e \\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u0430\