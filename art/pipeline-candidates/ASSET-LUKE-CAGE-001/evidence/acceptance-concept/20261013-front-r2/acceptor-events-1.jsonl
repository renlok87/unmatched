34\\u0440\\u044b \\u043f\\u0435\\u0440\\u0435\\u0441\\u043d\\u0438\\u043c\\u0430\\u044e\\u0442\\u0441\\u044f \\u0441\n  \\u0432\\u0435\\u0440\\u043d\\u044b\\u043c \\u0432\\u0445\\u043e\\u0434\\u043e\\u043c, \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a \\u0432\\u044b\\u0437\\u044b\\u0432\\u0430\\u0435\\u0442\\u0441\\u044f \\u0437\\u0430\\u043d\\u043e\\u0432\\u043e. \\u041e\\u0431\\u044b\\u0447\\u043d\\u043e \\u043e\\u0448\\u0438\\u0431\\u043a\\u0443 \\u043b\\u043e\\u0432\\u0438\\u0442 \\u00ab\\u0421\\u0432\\u0435\\u0440\\u043a\\u0430 \\u0432\\u0445\\u043e\\u0434\\u0430\\u00bb \\u0435\\u0449\\u0451 \\u0434\\u043e \\u0432\\u044b\\u0437\\u043e\\u0432\\u0430 \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a\\u0430;\n- **\\u043d\\u0435\\u0433\\u0430\\u0442\\u0438\\u0432\\u043d\\u044b\\u0439 \\u043a\\u043e\\u043d\\u0442\\u0440\\u043e\\u043b\\u044c \\u043a\\u0430\\u043b\\u0438\\u0431\\u0440\\u043e\\u0432\\u043a\\u0438** (\\u00a712) \\u2014 \\u0432\\u0445\\u043e\\u0434 \\u043d\\u0435\\u0432\\u0435\\u0440\\u0435\\u043d \\u043d\\u0430\\u043c\\u0435\\u0440\\u0435\\u043d\\u043d\\u043e: \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0430 \\u0441 `return_to_stage_1` \\u0438\n  `verdict_reason` \\u00ab\\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u043e 1\\u0430: \\u0434\\u0440\\u0443\\u0433\\u043e\\u0439 \\u043f\\u0435\\u0440\\u0441\\u043e\\u043d\\u0430\\u0436 \\u2026 ; \\u0432\\u0445\\u043e\\u0434: \\u043b\\u0438\\u0441\\u0442 \\u043d\\u0430\\u043c\\u0435\\u0440\\u0435\\u043d\\u043d\\u043e \\u0447\\u0443\\u0436\\u043e\\u0439 (\\u043d\\u0435\\u0433\\u0430\\u0442\\u0438\\u0432\\u043d\\u044b\\u0439 \\u043a\\u043e\\u043d\\u0442\\u0440\\u043e\\u043b\\u044c)\\u00bb \\u0437\\u0430\\u043f\\u0438\\u0441\\u044b\\u0432\\u0430\\u0435\\u0442\\u0441\\u044f \\u043a\\u0430\\u043a\n  \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442 \\u043a\\u0430\\u043b\\u0438\\u0431\\u0440\\u043e\\u0432\\u043a\\u0438, \\u043c\\u0430\\u0440\\u0448\\u0440\\u0443\\u0442\\u0430 \\u043d\\u0435\\u0442.\n\n\\u041f\\u0440\\u0430\\u0432\\u0438\\u043b\\u043e 1\\u0431 \\u0440\\u0435\\u0448\\u0430\\u0435\\u0442\\u0441\\u044f\n\\u043e\\u0434\\u043d\\u0438\\u043c \\u0432\\u043e\\u043f\\u0440\\u043e\\u0441\\u043e\\u043c \\u043a \\u043b\\u0438\\u0441\\u0442\\u0443: \\u00ab\\u044d\\u0442\\u043e\\u0442 \\u0434\\u0435\\u0444\\u0435\\u043a\\u0442 (\\u043a\\u043e\\u043d\\u0442\\u0443\\u0440, \\u043f\\u0440\\u043e\\u043f\\u043e\\u0440\\u0446\\u0438\\u044f, \\u044f\\u043a\\u043e\\u0440\\u044c, \\u043f\\u044f\\u0442\\u043d\\u043e \\u0446\\u0432\\u0435\\u0442\\u0430) \\u0435\\u0441\\u0442\\u044c \\u043d\\u0430 \\u043b\\u0438\\u0441\\u0442\\u0435 \\u0432 \\u0442\\u043e\\u043c \\u0436\\u0435 \\u043c\\u0435\\u0441\\u0442\\u0435?\\u00bb \\u0414\\u0430 \\u2014 \\u044d\\u0442\\u0430\\u043f 1;\n\\u043d\\u0435\\u0442 \\u2014 \\u044d\\u0442\\u0430\\u043f 2. \\u041e\\u0442\\u0432\\u0435\\u0442 \\u0438 \\u0432\\u0438\\u0434 \\u043b\\u0438\\u0441\\u0442\\u0430 \\u043f\\u0438\\u0448\\u0443\\u0442\\u0441\\u044f \\u0432 `verdict_reason`.\n\n**`rework_fix_list` \\u043f\\u0440\\u0438 \\u0432\\u043e\\u0437\\u0432\\u0440\\u0430\\u0442\\u0435 \\u043f\\u043e S \\u2014 \\u043f\\u0443\\u0441\\u0442\\u043e\\u0439** (`[]`, \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u044f\\u0435\\u0442 `validate_card.py`): \\u043c\\u043e\\u0434\\u0435\\u043b\\u044c \\u043f\\u0435\\u0440\\u0435\\u0433\\u0435\\u043d\\u0435\\u0440\\u0438\\u0440\\u0443\\u044e\\u0442, \\u043f\\u0443\\u043d\\u043a\\u0442\\u044b\n\\u0434\\u043e\\u0440\\u0430\\u0431\\u043e\\u0442\\u043a\\u0438 \\u0431\\u0435\\u0441\\u0441\\u043c\\u044b\\u0441\\u043b\\u0435\\u043d\\u043d\\u044b. \\u0417\\u0430\\u043c\\u0435\\u0447\\u0430\\u043d\\u0438\\u044f F, T, D \\u043d\\u0438\\u0436\\u0435 2,0 \\u0437\\u0430\\u043f\\u0438\\u0441\\u044b\\u0432\\u0430\\u044e\\u0442\\u0441\\u044f \\u0432 `known_issues` (\\u043e\\u043d\\u0438 \\u043d\\u0443\\u0436\\u043d\\u044b \\u0441\\u043b\\u0435\\u0434\\u0443\\u044e\\u0449\\u0435\\u043c\\u0443 \\u0446\\u0438\\u043a\\u043b\\u0443 \\u043a\\u0430\\u043a\n\\u0441\\u043f\\u0438\\u0441\\u043e\\u043a \\u0442\\u043e\\u0433\\u043e, \\u0447\\u0442\\u043e \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u0438\\u0442\\u044c). \\u041f\\u0440\\u0438 \\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u0435 2 (`source_defect`) \\u0441\\u043f\\u0438\\u0441\\u043e\\u043a \\u0442\\u043e\\u0436\\u0435 \\u043c\\u043e\\u0436\\u0435\\u0442 \\u0431\\u044b\\u0442\\u044c \\u043f\\u0443\\u0441\\u0442\\u044b\\u043c.\n\n\\u041f\\u0440\\u0430\\u0432\\u0438\\u043b\\u043e 2 \\u0432\\u0430\\u043b\\u0438\\u0434\\u0430\\u0442\\u043e\\u0440 \\u0440\\u0430\\u0437\\u043b\\u0438\\u0447\\u0430\\u0435\\u0442 \\u0441 \\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u043e\\u043c 3 **\\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043f\\u043e \\u0444\\u043b\\u0430\\u0433\\u0443** `gates.<G>.source_defect: true`. \\u0421\\u043b\\u043e\\u0432\\u0435\\u0441\\u043d\\u043e\\u0435 \\u043e\\u043f\\u0438\\u0441\\u0430\\u043d\\u0438\\u0435\n\\u0434\\u0435\\u0444\\u0435\\u043a\\u0442\\u0430 \\u0431\\u0435\\u0437 \\u0444\\u043b\\u0430\\u0433\\u0430 \\u0434\\u0430\\u0451\\u0442 `rework_blender`, \\u0438 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0430 \\u0441 `return_to_stage_2` \\u043f\\u043e\\u043b\\u0443\\u0447\\u0438\\u0442 \\u043a\\u043e\\u0434 1. \\u0421\\u0430\\u043c \\u0434\\u0435\\u0444\\u0435\\u043a\\u0442 \\u043e\\u043f\\u0438\\u0441\\u044b\\u0432\\u0430\\u0435\\u0442\\u0441\\u044f \\u0432\n`gates.<G>.note` \\u0438 \\u0432 `verdict_reason`.\n\n`verdict_reason` (\\u0441\\u0442\\u0440\\u043e\\u043a\\u0430 \\u2265 10 \\u0441\\u0438\\u043c\\u0432\\u043e\\u043b\\u043e\\u0432) \\u043e\\u0431\\u044f\\u0437\\u0430\\u0442\\u0435\\u043b\\u0435\\u043d \\u043f\\u0440\\u0438 **\\u043b\\u044e\\u0431\\u043e\\u043c** \\u0432\\u0435\\u0440\\u0434\\u0438\\u043a\\u0442\\u0435, \\u043a\\u0440\\u043e\\u043c\\u0435 `pass` (\\u0441\\u0445\\u0435\\u043c\\u0430, `allOf` if/then):\n\n- `return_to_stage_1` / `return_to_stage_2` \\u043f\\u043e \\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u0443 1 \\u2014 1\\u0430: \\u00ab\\u0434\\u0440\\u0443\\u0433\\u043e\\u0439 \\u043f\\u0435\\u0440\\u0441\\u043e\\u043d\\u0430\\u0436\\u00bb, \\u043a\\u0430\\u043a\\u0438\\u0435 \\u044f\\u043a\\u043e\\u0440\\u044f \\u043b\\u0438\\u0441\\u0442\\u0430 \\u043e\\u0442\\u0441\\u0443\\u0442\\u0441\\u0442\\u0432\\u0443\\u044e\\u0442; 1\\u0431:\n  \\u0435\\u0441\\u0442\\u044c \\u043b\\u0438 \\u0434\\u0435\\u0444\\u0435\\u043a\\u0442 \\u043d\\u0430 \\u043b\\u0438\\u0441\\u0442\\u0435 \\u0432 \\u0442\\u043e\\u043c \\u0436\\u0435 \\u043c\\u0435\\u0441\\u0442\\u0435 (\\u044d\\u0442\\u0430\\u043f 1) \\u0438\\u043b\\u0438 \\u043d\\u0435\\u0442 (\\u044d\\u0442\\u0430\\u043f 2) \\u0438 \\u043d\\u0430 \\u043a\\u0430\\u043a\\u043e\\u043c \\u0432\\u0438\\u0434\\u0435 \\u043b\\u0438\\u0441\\u0442\\u0430; \\u043f\\u043e \\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u0443 2 \\u2014 \\u043a\\u0430\\u043a\\u043e\\u0439 \\u0434\\u0435\\u0444\\u0435\\u043a\\u0442\n  \\u0438\\u0441\\u0445\\u043e\\u0434\\u043d\\u0438\\u043a\\u0430 \\u0438 \\u0432 \\u043a\\u0430\\u043a\\u043e\\u043c \\u0433\\u0435\\u0439\\u0442\\u0435;\n- `rework_blender` \\u2014 \\u043a\\u0430\\u043a\\u043e\\u0435 \\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u043e \\u0441\\u0440\\u0430\\u0431\\u043e\\u0442\\u0430\\u043b\\u043e (\\u0433\\u0435\\u0439\\u0442, \\u0432\\u0435\\u0442\\u043e \\u0438\\u043b\\u0438 `score`); \\u043f\\u0440\\u0438 `score` < 8,0 `rework_fix_list` \\u0441\\u043e\\u0434\\u0435\\u0440\\u0436\\u0438\\u0442\n  \\u043f\\u0443\\u043d\\u043a\\u0442 \\u0434\\u043b\\u044f \\u043a\\u0430\\u0436\\u0434\\u043e\\u0433\\u043e \\u0438\\u0437 F, T, D \\u043d\\u0438\\u0436\\u0435 2,0 (\\u0438\\u0445 \\u0438 \\u043f\\u043e\\u0434\\u043d\\u0438\\u043c\\u0430\\u0435\\u0442 \\u0434\\u043e\\u0440\\u0430\\u0431\\u043e\\u0442\\u043a\\u0430: S \\u0432 Blender \\u043d\\u0435 \\u043f\\u0440\\u0430\\u0432\\u0438\\u0442\\u0441\\u044f, \\u00a79.4);\n- `escalate_user` \\u2014 \\u043c\\u0430\\u0440\\u0448\\u0440\\u0443\\u0442, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0439 \\u0434\\u0430\\u043b\\u0438 \\u0431\\u044b \\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u0430 1\\u20134, \\u0438 \\u043f\\u043e\\u0447\\u0435\\u043c\\u0443.\n\n\\u041f\\u043e\\u0440\\u044f\\u0434\\u043e\\u043a \\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u044f \\u0441\\u043a\\u0438\\u043b\\u043b\\u0430: \\u0432\\u043e\\u0437\\u0432\\u0440\\u0430\\u0442 (\\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u0430 1\\u20132) \\u0438\\u0434\\u0451\\u0442 \\u0440\\u0430\\u043d\\u044c\\u0448\\u0435 \\u0434\\u043e\\u0440\\u0430\\u0431\\u043e\\u0442\\u043a\\u0438, \\u043f\\u043e\\u0442\\u043e\\u043c\\u0443 \\u0447\\u0442\\u043e \\u0434\\u043e\\u0440\\u0430\\u0431\\u043e\\u0442\\u043a\\u0430 \\u043c\\u043e\\u0434\\u0435\\u043b\\u0438, \\u043a\\u043e\\u0442\\u043e\\u0440\\u0443\\u044e \\u0432\\u0441\\u0451 \\u0440\\u0430\\u0432\\u043d\\u043e\n\\u043f\\u0435\\u0440\\u0435\\u0433\\u0435\\u043d\\u0435\\u0440\\u0438\\u0440\\u0443\\u044e\\u0442, \\u2014 \\u043f\\u0443\\u0441\\u0442\\u0430\\u044f \\u0442\\u0440\\u0430\\u0442\\u0430 \\u0446\\u0438\\u043a\\u043b\\u0430. \\u0413\\u0440\\u0430\\u043d\\u0438\\u0446\\u0430 5,0 \\u0438 \\u043e\\u0442\\u0434\\u0435\\u043b\\u044c\\u043d\\u044b\\u0439 \\u043f\\u043e\\u0440\\u043e\\u0433 \\u0434\\u043b\\u044f \\u0430\\u0441\\u0441\\u0435\\u0442\\u043e\\u0432 \\u0431\\u0435\\u0437 \\u0440\\u0438\\u0433\\u0430 \\u0443\\u043f\\u0440\\u0430\\u0437\\u0434\\u043d\\u0435\\u043d\\u044b. \\u041f\\u0440\\u0430\\u0432\\u0438\\u043b\\u0430 \\u0438 \\u043f\\u043e\\u0440\\u044f\\u0434\\u043e\\u043a\n\\u0441\\u043e\\u0432\\u043f\\u0430\\u0434\\u0430\\u044e\\u0442 \\u0441 `compute_verdict` \\u0432 `validate_card.py` \\u0438 \\u0441 `tools/art/acceptance/README.md` \\u00a72.\n\n**\\u0423\\u0441\\u0442\\u043e\\u0439\\u0447\\u0438\\u0432\\u044b\\u0439 pass** (\\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u0441\\u043a\\u0438\\u043b\\u043b\\u0430 \\u043f\\u043e \\u043a\\u0430\\u043b\\u0438\\u0431\\u0440\\u043e\\u0432\\u043a\\u0435 2026-10-09; \\u043f\\u043e\\u0440\\u043e\\u0433 8,0 \\u043d\\u0435 \\u043c\\u0435\\u043d\\u044f\\u0435\\u0442\\u0441\\u044f). Medusa, \\u043f\\u0440\\u0438\\u043d\\u044f\\u0442\\u0430\\u044f \\u0432 \\u043f\\u0440\\u043e\\u0435\\u043a\\u0442\\u0435,\n\\u043d\\u0430\\u0431\\u0440\\u0430\\u043b\\u0430 8,1: \\u0443 \\u0433\\u0435\\u0440\\u043e\\u044f \\u044d\\u0442\\u043e \\u0440\\u043e\\u0432\\u043d\\u043e \\u0442\\u0440\\u0438 \\u043f\\u043e\\u0442\\u0435\\u0440\\u044f\\u043d\\u043d\\u044b\\u0445 \\u043f\\u043e\\u043b\\u0443\\u0448\\u0430\\u0433\\u0430, \\u0438 \\u043e\\u0434\\u0438\\u043d \\u043f\\u043e\\u043b\\u0443\\u0448\\u0430\\u0433 \\u0434\\u0440\\u0443\\u0433\\u043e\\u0433\\u043e \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a\\u0430 (S 1,5 \\u0438\\u043b\\u0438 T 1,0) \\u0434\\u0430\\u0451\\u0442 7,5 \\u0438\n`rework_blender`. \\u0417\\u0430\\u0449\\u0438\\u0442\\u0430 \\u043e\\u0442 \\u0440\\u0430\\u0437\\u0431\\u0440\\u043e\\u0441\\u0430 \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a\\u043e\\u0432 \\u00b10,5:\n\n- `pass` \\u0441\\u043e `score` \\u2265 8,0 \\u0438 < 8,5 (\\u0443 \\u0433\\u0435\\u0440\\u043e\\u044f 8,1, \\u0443 \\u043f\\u0440\\u043e\\u043f\\u0430 8,3, \\u0443 \\u043b\\u0438\\u0441\\u0442\\u0430 \\u043a\\u043e\\u043d\\u0446\\u0435\\u043f\\u0442\\u0430 \\u0438 \\u043a\\u043b\\u0438\\u043f\\u0430 8,1) \\u043e\\u0434\\u043d\\u043e\\u0439 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u043e\\u0439 \\u043d\\u0435\n  \\u043e\\u043a\\u043e\\u043d\\u0447\\u0430\\u0442\\u0435\\u043b\\u0435\\u043d: `validate_card.py` \\u0434\\u0430\\u0451\\u0442 \\u043a\\u043e\\u0434 **3** \\u0438 \\u043f\\u0435\\u0447\\u0430\\u0442\\u0430\\u0435\\u0442 `needs_second_acceptor`;\n- \\u0432\\u0442\\u043e\\u0440\\u043e\\u0439 \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a \\u2014 **\\u0434\\u0440\\u0443\\u0433\\u043e\\u0439 \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u044c** (\\u00a71), \\u0442\\u0435 \\u0436\\u0435 \\u043a\\u0430\\u0434\\u0440\\u044b, \\u0442\\u043e\\u0442 \\u0436\\u0435 \\u043f\\u0440\\u043e\\u043c\\u043f\\u0442, \\u043d\\u043e\\u0432\\u044b\\u0439 \\u043a\\u043e\\u043d\\u0442\\u0435\\u043a\\u0441\\u0442; \\u043e\\u043d \\u043d\\u0435 \\u0432\\u0438\\u0434\\u0438\\u0442 \\u043f\\u0435\\u0440\\u0432\\u0443\\u044e \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0443\n  (\\u00a78.5) \\u0438 \\u043f\\u0438\\u0448\\u0435\\u0442 `card-2.json`;\n- \\u0438\\u0442\\u043e\\u0433 \\u043f\\u0430\\u0440\\u044b (`validate_card.py card.json --second card-2.json`): `score` \\u2014 \\u043c\\u0438\\u043d\\u0438\\u043c\\u0443\\u043c \\u0434\\u0432\\u0443\\u0445; \\u0432\\u0435\\u0440\\u0434\\u0438\\u043a\\u0442 \\u2014 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0438 \\u0441 \\u043c\\u0435\\u043d\\u044c\\u0448\\u0438\\u043c\n  `score` (\\u043f\\u0440\\u0438 \\u0440\\u0430\\u0432\\u0435\\u043d\\u0441\\u0442\\u0432\\u0435 \\u2014 \\u0431\\u043e\\u043b\\u0435\\u0435 \\u0441\\u0442\\u0440\\u043e\\u0433\\u0438\\u0439), \\u043d\\u043e \\u0435\\u0441\\u043b\\u0438 \\u0443 \\u0434\\u0440\\u0443\\u0433\\u043e\\u0439 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0438 \\u043c\\u0430\\u0440\\u0448\\u0440\\u0443\\u0442 \\u0441\\u0442\\u0440\\u043e\\u0436\\u0435 (\\u0432\\u043e\\u0437\\u0432\\u0440\\u0430\\u0442, FAIL-\\u0433\\u0435\\u0439\\u0442, \\u0432\\u0435\\u0442\\u043e), \\u043f\\u043e\\u0431\\u0435\\u0436\\u0434\\u0430\\u0435\\u0442\n  \\u043e\\u043d. \\u041c\\u0430\\u0440\\u0448\\u0440\\u0443\\u0442 \\u0438 `rework_fix_list` \\u0431\\u0435\\u0440\\u0443\\u0442\\u0441\\u044f \\u0438\\u0437 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0438, \\u0434\\u0430\\u0432\\u0448\\u0435\\u0439 \\u0438\\u0442\\u043e\\u0433 (`source_card` \\u0432 `final.json`);\n- \\u0432\\u0442\\u043e\\u0440\\u043e\\u0439 `pass` \\u0432 \\u0442\\u043e\\u0439 \\u0436\\u0435 \\u043f\\u043e\\u043b\\u043e\\u0441\\u0435 8,0\\u20138,4 \\u2014 \\u0438\\u0442\\u043e\\u0433 `pass` (\\u043c\\u0438\\u043d\\u0438\\u043c\\u0443\\u043c \\u2265 8,0), \\u0442\\u0440\\u0435\\u0442\\u0438\\u0439 \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a \\u043d\\u0435 \\u043d\\u0443\\u0436\\u0435\\u043d;\n- \\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u043e \\u0434\\u0435\\u0439\\u0441\\u0442\\u0432\\u0443\\u0435\\u0442 \\u0434\\u043b\\u044f **\\u0432\\u0441\\u0435\\u0445** \\u0432\\u0438\\u0434\\u043e\\u0432 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u0435\\u043a \\u2014 `model`, `concept`, `anim` (\\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u043e\\u0440\\u043a\\u0435\\u0441\\u0442\\u0440\\u0430\\u0442\\u043e\\u0440\\u0430 \\u043f\\u043e \\u043a\\u0430\\u043b\\u0438\\u0431\\u0440\\u043e\\u0432\\u043a\\u0435\n  2026-10-09, \\u0440\\u0430\\u0443\\u043d\\u0434 3: \\u0443 \\u043b\\u0438\\u0441\\u0442\\u0430 \\u0438 \\u043a\\u043b\\u0438\\u043f\\u0430 \\u0442\\u0430 \\u0436\\u0435 \\u0448\\u043a\\u0430\\u043b\\u0430 0\\u20132 \\u0441 \\u0448\\u0430\\u0433\\u043e\\u043c 0,5 \\u0438 \\u0442\\u043e\\u0442 \\u0436\\u0435 \\u0440\\u0430\\u0437\\u0431\\u0440\\u043e\\u0441 \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a\\u043e\\u0432). \\u0412\\u044b\\u0437\\u043e\\u0432 \\u0432\\u0442\\u043e\\u0440\\u043e\\u0433\\u043e\n  \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a\\u0430 \\u2014 \\u00a78.5; \\u0443 \\u043a\\u043e\\u043d\\u0446\\u0435\\u043f\\u0442\\u0430 \\u0438 \\u043a\\u043b\\u0438\\u043f\\u0430 \\u043c\\u0435\\u043d\\u044f\\u044e\\u0442\\u0441\\u044f \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u0444\\u0430\\u0439\\u043b\\u044b (`references/concept-sheet.md` \\u00a711,\n  `references/animation-vfx-sfx.md` \\u00a710.5).\n\n\\u041d\\u0443\\u043c\\u0435\\u0440\\u0430\\u0446\\u0438\\u044f `r<N>` \\u0441\\u043a\\u0432\\u043e\\u0437\\u043d\\u0430\\u044f \\u0434\\u043b\\u044f \\u043c\\u043e\\u0434\\u0435\\u043b\\u0438 \\u0430\\u0441\\u0441\\u0435\\u0442\\u0430 \\u0438 \\u043d\\u0435 \\u043e\\u0431\\u043d\\u0443\\u043b\\u044f\\u0435\\u0442\\u0441\\u044f \\u043f\\u043e\\u0441\\u043b\\u0435 \\u0432\\u043e\\u0437\\u0432\\u0440\\u0430\\u0442\\u0430 \\u043d\\u0430 \\u044d\\u0442\\u0430\\u043f 1 \\u0438\\u043b\\u0438 2 (\\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u0441\\u043a\\u0438\\u043b\\u043b\\u0430). \\u0412\\u043e\\u0437\\u0432\\u0440\\u0430\\u0442 \\u0442\\u043e\\u0436\\u0435\n\\u0442\\u0440\\u0430\\u0442\\u0438\\u0442 \\u0446\\u0438\\u043a\\u043b. \\u041f\\u043e\\u044d\\u0442\\u043e\\u043c\\u0443 \\u043f\\u0440\\u0438\\u0451\\u043c\\u043e\\u043a \\u043c\\u043e\\u0434\\u0435\\u043b\\u0438 \\u043d\\u0435 \\u0431\\u043e\\u043b\\u044c\\u0448\\u0435 \\u0442\\u0440\\u0451\\u0445 (r1\\u2013r3), \\u0430 \\u043f\\u043e\\u0441\\u043b\\u0435 r3 \\u2014 \\u044d\\u0441\\u043a\\u0430\\u043b\\u0430\\u0446\\u0438\\u044f (\\u00a711). \\u041b\\u0438\\u043c\\u0438\\u0442\\u044b \\u043a\\u043e\\u043d\\u0446\\u0435\\u043f\\u0442\\u0430 \\u0438 Tripo\n\\u0441\\u0447\\u0438\\u0442\\u0430\\u044e\\u0442\\u0441\\u044f \\u043e\\u0442\\u0434\\u0435\\u043b\\u044c\\u043d\\u043e (SKILL.md \\u00a75 \\u043f.4).\n\n## 7. \\u041a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0430 `unmatched.asset-acceptance/2`\n\n\\u0421\\u0445\\u0435\\u043c\\u0430 \\u2014 `tools/art/acceptance/asset-acceptance-2.schema.json` (\\u043e\\u0434\\u0438\\u043d \\u0444\\u0430\\u0439\\u043b \\u043d\\u0430 \\u0442\\u0440\\u0438 \\u0432\\u0438\\u0434\\u0430 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u0435\\u043a, \\u043f\\u043e\\u043b\\u0435 `kind`:\n`model` | `concept` | `anim`). \\u041f\\u0440\\u0438 \\u0440\\u0430\\u0441\\u0445\\u043e\\u0436\\u0434\\u0435\\u043d\\u0438\\u0438 \\u0441 \\u044d\\u0442\\u0438\\u043c \\u0440\\u0430\\u0437\\u0434\\u0435\\u043b\\u043e\\u043c \\u0432\\u044b\\u0438\\u0433\\u0440\\u044b\\u0432\\u0430\\u0435\\u0442 \\u0441\\u0445\\u0435\\u043c\\u0430. \\u041f\\u0443\\u0442\\u044c \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0438:\n`art/pipeline-candidates/<ASSET_ID>/evidence/acceptance/<YYYYMMDD>-r<N>/card.json`, \\u0440\\u044f\\u0434\\u043e\\u043c `frames/`.\n\n| \\u041f\\u043e\\u043b\\u0435 | \\u0421\\u043e\\u0434\\u0435\\u0440\\u0436\\u0438\\u043c\\u043e\\u0435 |\n|---|---|\n| `schema` | `\"unmatched.asset-acceptance/2\"` (\\u0443 \\u043a\\u043e\\u043d\\u0446\\u0435\\u043f\\u0442\\u0430 `unmatched.concept-acceptance/1`, \\u0443 \\u043a\\u043b\\u0438\\u043f\\u0430 `unmatched.anim-acceptance/1`) |\n| `kind` | `\"model\"` |\n| `asset_id`, `date` | id \\u0437\\u0430\\u044f\\u0432\\u043a\\u0438; \\u0434\\u0430\\u0442\\u0430 \\u043f\\u0440\\u0438\\u0451\\u043c\\u043a\\u0438 `YYYY-MM-DD` |\n| `cycle` | `\"r1\"` \\| `\"r2\"` \\| `\"r3\"` |\n| `previous_card` | \\u043f\\u0443\\u0442\\u044c \\u043e\\u0442 \\u043a\\u043e\\u0440\\u043d\\u044f \\u0440\\u0435\\u043f\\u043e\\u0437\\u0438\\u0442\\u043e\\u0440\\u0438\\u044f \\u043a `card.json` \\u043f\\u0440\\u0435\\u0434\\u044b\\u0434\\u0443\\u0449\\u0435\\u0433\\u043e \\u0446\\u0438\\u043a\\u043b\\u0430; \\u0443 r1 \\u2014 `null`, \\u0441 r2 \\u043e\\u0431\\u044f\\u0437\\u0430\\u0442\\u0435\\u043b\\u0435\\u043d |\n| `accepted_object` | \\u043c\\u0430\\u0441\\u0441\\u0438\\u0432 `{path, sha256}`: SK \\u0438 SM FBX \\u0438 \\u0432\\u0441\\u0435 2K-\\u0442\\u0435\\u043a\\u0441\\u0442\\u0443\\u0440\\u044b \\u00a72.1 (`BC`, `N`, `ORM`, `MatID`, `Edge`, `TeamAccent_2K`); \\u043f\\u0443\\u0442\\u0438 \\u043e\\u0442 \\u043a\\u043e\\u0440\\u043d\\u044f \\u0440\\u0435\\u043f\\u043e\\u0437\\u0438\\u0442\\u043e\\u0440\\u0438\\u044f |\n| `frames` | \\u043e\\u0431\\u044a\\u0435\\u043a\\u0442 `{dir, files}`: `dir` \\u2014 \\u043a\\u0430\\u0442\\u0430\\u043b\\u043e\\u0433 \\u043a\\u0430\\u0434\\u0440\\u043e\\u0432 **\\u043e\\u0442 \\u043a\\u043e\\u0440\\u043d\\u044f \\u0440\\u0435\\u043f\\u043e\\u0437\\u0438\\u0442\\u043e\\u0440\\u0438\\u044f** (`art/pipeline-candidates/<ASSET_ID>/evidence/acceptance/<YYYYMMDD>-r<N>/frames`; \\u043a\\u0430\\u043b\\u0438\\u0431\\u0440\\u043e\\u0432\\u043a\\u0430 \\u2014 `docs/art-pipeline/evidence/acceptance-calibration-<YYYYMMDD>/<\\u043f\\u0440\\u043e\\u0433\\u043e\\u043d>/frames`, \\u00a712); \\u043a\\u0430\\u0434\\u0440\\u044b \\u0432\\u043e \\u0432\\u0440\\u0435\\u043c\\u0435\\u043d\\u043d\\u043e\\u043c \\u043a\\u0430\\u0442\\u0430\\u043b\\u043e\\u0433\\u0435 \\u0432\\u043d\\u0435 \\u0440\\u0435\\u043f\\u043e\\u0437\\u0438\\u0442\\u043e\\u0440\\u0438\\u044f \\u0432 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0443 \\u043d\\u0435 \\u043f\\u043e\\u043f\\u0430\\u0434\\u0430\\u044e\\u0442 \\u2014 \\u0438\\u0445 \\u0441\\u043d\\u0430\\u0447\\u0430\\u043b\\u0430 \\u0441\\u043d\\u0438\\u043c\\u0430\\u044e\\u0442 \\u0438\\u043b\\u0438 \\u043a\\u043e\\u043f\\u0438\\u0440\\u0443\\u044e\\u0442 \\u0432 `dir`; `files` = `frames.json#files` (\\u043a\\u0430\\u0434\\u0440\\u044b \\u00a73, `frames.json`, `sheet.png`, `tone.json`, \\u0435\\u0441\\u043b\\u0438 \\u0435\\u0441\\u0442\\u044c) |\n| `reports` | \\u043f\\u0443\\u0442\\u0438 \\u043e\\u0442 \\u043a\\u043e\\u0440\\u043d\\u044f \\u0440\\u0435\\u043f\\u043e\\u0437\\u0438\\u0442\\u043e\\u0440\\u0438\\u044f \\u043a\\u043e \\u0432\\u0441\\u0435\\u043c \\u043e\\u0442\\u0447\\u0451\\u0442\\u0430\\u043c, \\u043d\\u0430 \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0435 \\u0441\\u0441\\u044b\\u043b\\u0430\\u044e\\u0442\\u0441\\u044f \\u0433\\u0435\\u0439\\u0442\\u044b |\n| `gates` | `{\"G-TOPO\"\\|\"G-UV\"\\|\"G-TEX\"\\|\"G-RIG\"\\|\"G-NAMES\": {status: PASS\\|FAIL\\|n/a, source, note, source_defect?}}` \\u2014 \\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u0430 \\u0437\\u0430\\u043f\\u0438\\u0441\\u0438 \\u00a74; \\u0434\\u0440\\u0443\\u0433\\u0438\\u0445 \\u043a\\u043b\\u044e\\u0447\\u0435\\u0439 \\u043d\\u0435\\u0442 |\n| `scores` | `{\"S\"\\|\"F\"\\|\"T\"\\|\"D\": {value: 0\\u20262 (\\u0448\\u0430\\u0433 0,5) \\| null, rationale: \"\\u2026\", frames: [\"turn-045.jpg\", \\u2026]}}`; \\u0438\\u043c\\u0435\\u043d\\u0430 \\u0432 `frames` \\u2014 \\u0438\\u0437 `frames.files` |\n| `score` | \\u0447\\u0438\\u0441\\u043b\\u043e \\u043f\\u043e \\u0444\\u043e\\u0440\\u043c\\u0443\\u043b\\u0435 \\u00a76, \\u043e\\u043a\\u0440\\u0443\\u0433\\u043b\\u0435\\u043d\\u0438\\u0435 half-up |\n| `verdict` | `pass` \\| `rework_blender` \\| `return_to_stage_1` \\| `return_to_stage_2` \\| `escalate_user` |\n| `verdict_reason` | \\u043e\\u0431\\u044f\\u0437\\u0430\\u0442\\u0435\\u043b\\u0435\\u043d \\u043f\\u0440\\u0438 \\u043b\\u044e\\u0431\\u043e\\u043c `verdict`, \\u043a\\u0440\\u043e\\u043c\\u0435 `pass` (\\u00a76); \\u0443 `pass` \\u043f\\u043e\\u043b\\u0435 \\u043d\\u0435 \\u043f\\u0438\\u0448\\u0435\\u0442\\u0441\\u044f |\n| `rework_fix_list` | \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e F, T, D \\u043d\\u0438\\u0436\\u0435 2 \\u0438 FAIL-\\u0433\\u0435\\u0439\\u0442\\u044b (S \\u043d\\u0438\\u043a\\u043e\\u0433\\u0434\\u0430: \\u0432 Blender \\u043d\\u0435 \\u043f\\u0440\\u0430\\u0432\\u0438\\u0442\\u0441\\u044f, \\u0432\\u0430\\u043b\\u0438\\u0434\\u0430\\u0442\\u043e\\u0440 \\u043e\\u0442\\u0432\\u0435\\u0440\\u0433\\u0430\\u0435\\u0442); \\u043f\\u0443\\u043d\\u043a\\u0442 = `{item, frame, fix, tool}`, \\u0434\\u0440\\u0443\\u0433\\u0438\\u0445 \\u043a\\u043b\\u044e\\u0447\\u0435\\u0439 \\u043d\\u0435\\u0442; `item` \\u2014 `F`, `T`, `D` \\u0438\\u043b\\u0438 id \\u0433\\u0435\\u0439\\u0442\\u0430 (`G-UV`). \\u041f\\u0440\\u0438 `rework_blender` \\u2014 \\u043d\\u0435 \\u043f\\u0443\\u0441\\u0442\\u043e\\u0439 \\u0438 \\u043f\\u043e\\u043a\\u0440\\u044b\\u0432\\u0430\\u0435\\u0442 \\u043a\\u0430\\u0436\\u0434\\u044b\\u0439 FAIL-\\u0433\\u0435\\u0439\\u0442, \\u043a\\u0430\\u0436\\u0434\\u043e\\u0435 \\u0438\\u0437\\u043c\\u0435\\u0440\\u0435\\u043d\\u0438\\u0435 < 1,0, \\u0430 \\u043f\\u0440\\u0438 `score` < 8,0 \\u2014 \\u043a\\u0430\\u0436\\u0434\\u043e\\u0435 \\u0438\\u0437 F, T, D \\u043d\\u0438\\u0436\\u0435 2,0 (`validate_card.py`). \\u041f\\u0440\\u0438 `pass` \\u0438 \\u043f\\u0440\\u0438 \\u0432\\u043e\\u0437\\u0432\\u0440\\u0430\\u0442\\u0435 \\u043f\\u043e S (\\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u043e 1) \\u2014 \\u043f\\u0443\\u0441\\u0442\\u043e\\u0439 \\u043c\\u0430\\u0441\\u0441\\u0438\\u0432. \\u0423 \\u0430\\u0441\\u0441\\u0435\\u0442\\u0430, \\u0441\\u043e\\u0431\\u0440\\u0430\\u043d\\u043d\\u043e\\u0433\\u043e \\u0444\\u043e\\u0440\\u043a\\u043e\\u043c (`h2_bake_arthur` \\u0438 \\u0442. \\u043f.), `tool` \\u0443\\u043a\\u0430\\u0437\\u044b\\u0432\\u0430\\u0435\\u0442 \\u043a\\u043b\\u044e\\u0447 **\\u0433\\u0435\\u043d\\u0435\\u0440\\u0438\\u0447\\u0435\\u0441\\u043a\\u043e\\u0433\\u043e** bake-\\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u044f: \\u0434\\u043e\\u0440\\u0430\\u0431\\u043e\\u0442\\u043a\\u0430 \\u0444\\u043e\\u0440\\u043a\\u0430 \\u2014 \\u043d\\u043e\\u0432\\u0430\\u044f \\u0441\\u0431\\u043e\\u0440\\u043a\\u0430 \\u044d\\u0442\\u0430\\u043f\\u0430 3 \\u0433\\u0435\\u043d\\u0435\\u0440\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438\\u043c `h2_bake` (\\u00a79.1) |\n| `known_issues` | \\u043d\\u0435\\u043e\\u0431\\u044f\\u0437\\u0430\\u0442\\u0435\\u043b\\u044c\\u043d\\u044b\\u0439 \\u043c\\u0430\\u0441\\u0441\\u0438\\u0432 `{item, frame, note}` (\\u0434\\u0440\\u0443\\u0433\\u0438\\u0445 \\u043a\\u043b\\u044e\\u0447\\u0435\\u0439 \\u043d\\u0435\\u0442): \\u0437\\u0430\\u043c\\u0435\\u0447\\u0430\\u043d\\u0438\\u044f, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0435 \\u0432\\u0435\\u0440\\u0434\\u0438\\u043a\\u0442 \\u043d\\u0435 \\u043c\\u0435\\u043d\\u044f\\u044e\\u0442, \\u043d\\u043e \\u0434\\u043e\\u043b\\u0436\\u043d\\u044b \\u0434\\u043e\\u0439\\u0442\\u0438 \\u0434\\u043e \\u0434\\u043e\\u0440\\u0430\\u0431\\u043e\\u0442\\u043a\\u0438 \\u0438 \\u044d\\u0442\\u0430\\u043f\\u0430 7 \\u2014 \\u043c\\u0435\\u043b\\u043e\\u0447\\u0438 \\u043d\\u0430 \\u043a\\u0440\\u0443\\u043f\\u043d\\u044b\\u0445 \\u043f\\u043b\\u0430\\u043d\\u0430\\u0445 \\u043f\\u0440\\u0438 pass, \\u043a\\u043b\\u0430\\u0441\\u0441\\u044b `floor` \\u0438\\u0437 `tone.json`, \\u0441\\u043f\\u0440\\u0430\\u0432\\u043e\\u0447\\u043d\\u044b\\u0435 \\u0447\\u0438\\u0441\\u043b\\u0430 \\u0433\\u0435\\u0439\\u0442\\u043e\\u0432 (\\u043f\\u043e\\u0447\\u0442\\u0438 \\u0432\\u044b\\u0440\\u043e\\u0436\\u0434\\u0435\\u043d\\u043d\\u044b\\u0435 \\u0442\\u0440\\u0435\\u0443\\u0433\\u043e\\u043b\\u044c\\u043d\\u0438\\u043a\\u0438), \\u043a\\u0430\\u0441\\u0430\\u043d\\u0438\\u0435 \\u043e\\u0440\\u0443\\u0436\\u0438\\u044f \\u0432 \\u043f\\u043e\\u0437\\u0430\\u0445 \\u043f\\u0440\\u043e\\u0431 (`pose_checks.*_contact`), \\u0442\\u043e\\u043d \\u0431\\u0435\\u0437 `tone.json`, \\u0430 \\u043f\\u0440\\u0438 \\u0432\\u043e\\u0437\\u0432\\u0440\\u0430\\u0442\\u0435 \\u043f\\u043e S \\u2014 \\u0437\\u0430\\u043c\\u0435\\u0447\\u0430\\u043d\\u0438\\u044f F, T, D \\u043d\\u0438\\u0436\\u0435 2,0; `item` \\u2014 \\u0438\\u0437\\u043c\\u0435\\u0440\\u0435\\u043d\\u0438\\u0435 \\u0438\\u043b\\u0438 \\u0433\\u0435\\u0439\\u0442, `frame` \\u2014 \\u0438\\u0437 `frames.files` |\n| `acceptor` | `{profile: \"Opus xhigh\" \\| \"Sol 6.1 xhigh\", session_id}`; \\u0441\\u043e\\u043e\\u0442\\u0432\\u0435\\u0442\\u0441\\u0442\\u0432\\u0438\\u0435 \\u043f\\u043e\\u043b\\u044f \\u0437\\u0430\\u044f\\u0432\\u043a\\u0438 `ACCEPTOR_PROFILE` (SKILL.md \\u00a77.2): `opus-xhigh` \\u2192 `\"Opus xhigh\"`, `sol-6.1-xhigh` \\u2192 `\"Sol 6.1 xhigh\"`. \\u0423 `card-2.json` \\u0432\\u0442\\u043e\\u0440\\u043e\\u0433\\u043e \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a\\u0430 \\u2014 \\u0434\\u0440\\u0443\\u0433\\u043e\\u0439 \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u044c (\\u00a78.5) |\n| `executor_session_id` | id \\u0441\\u0435\\u0441\\u0441\\u0438\\u0438 \\u0438\\u0441\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u044f (\\u00a71 \\u043f.2), \\u2260 `acceptor.session_id` |\n| `decided_by` | `\"delegated (\\u0412\\u0420-\\u0440\\u0435\\u0435\\u0441\\u0442\\u0440 2026-10-06)\"` |\n| `status_note` | \\u043f\\u0440\\u0438 `pass` \\u2014 \\u00ab\\u0445\\u0443\\u0434\\u043e\\u0436\\u0435\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u043e \\u043f\\u0440\\u0438\\u043d\\u044f\\u0442\\u043e, \\u043f\\u043e \\u0434\\u0435\\u043b\\u0435\\u0433\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044e\\u00bb \\u0441\\u043e \\u0441\\u0441\\u044b\\u043b\\u043a\\u043e\\u0439 \\u043d\\u0430 `docs/game-design/decisions/2026-10-06-visual-delegated-decisions.md` (\\u0432\\u0430\\u043b\\u0438\\u0434\\u0430\\u0442\\u043e\\u0440 \\u0438\\u0449\\u0435\\u0442 \\u043f\\u043e\\u0434\\u0441\\u0442\\u0440\\u043e\\u043a\\u0443 \\u00ab\\u043f\\u043e \\u0434\\u0435\\u043b\\u0435\\u0433\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044e\\u00bb); \\u0438\\u043d\\u0430\\u0447\\u0435 \\u2014 \\u043f\\u0443\\u0441\\u0442\\u0430\\u044f \\u0441\\u0442\\u0440\\u043e\\u043a\\u0430 \\u0438\\u043b\\u0438 \\u043a\\u043e\\u0440\\u043e\\u0442\\u043a\\u0430\\u044f \\u043f\\u043e\\u043c\\u0435\\u0442\\u043a\\u0430 |\n\n\\u0420\\u044f\\u0434\\u043e\\u043c \\u0441 `card.json` \\u043f\\u0440\\u0438 \\u0432\\u0442\\u043e\\u0440\\u043e\\u043c \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a\\u0435 \\u043b\\u0435\\u0436\\u0430\\u0442 `card-2.json` (\\u0442\\u0430 \\u0436\\u0435 \\u0441\\u0445\\u0435\\u043c\\u0430) \\u0438 `final.json`\n(`unmatched.acceptance-final/1`: \\u043e\\u0431\\u0435 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0438 \\u0441\\u043e score \\u0438 \\u0432\\u0435\\u0440\\u0434\\u0438\\u043a\\u0442\\u043e\\u043c, \\u0438\\u0442\\u043e\\u0433\\u043e\\u0432\\u044b\\u0435 `score` \\u0438 `verdict`, `source_card`).\n\n\\u041f\\u0440\\u0438\\u043c\\u0435\\u0440: Medusa, \\u0444\\u043e\\u0440\\u043c\\u0430\\u0442 \\u043a\\u0430\\u043b\\u0438\\u0431\\u0440\\u043e\\u0432\\u043a\\u0438 \\u00a712. **\\u0411\\u0430\\u043b\\u043b\\u044b \\u0443\\u0441\\u043b\\u043e\\u0432\\u043d\\u044b\\u0435**, \\u044d\\u0442\\u043e \\u0438\\u043b\\u043b\\u044e\\u0441\\u0442\\u0440\\u0430\\u0446\\u0438\\u044f \\u0444\\u043e\\u0440\\u043c\\u0430\\u0442\\u0430, \\u0430 \\u043d\\u0435 \\u0440\\u0435\\u0437\\u0443\\u043b\\u044c\\u0442\\u0430\\u0442 \\u04