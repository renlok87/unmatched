\u043e\\u0435\\u0433\\u043e \\u0432\\u0438\\u0434\\u0430 (\\u043d\\u0438\\u0436\\u0435) |\\n| `-o \\\"$E/card.json\\\"` | \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0443 \\u043f\\u0438\\u0448\\u0435\\u0442 CLI, \\u0430 \\u043d\\u0435 \\u043c\\u043e\\u0434\\u0435\\u043b\\u044c |\\n| `--json \\u2026 \\\\| Out-File` | \\u0441\\u043e\\u0431\\u044b\\u0442\\u0438\\u044f \\u0434\\u043b\\u044f `thread_id` \\u0438 \\u0434\\u043b\\u044f \\u0440\\u0430\\u0437\\u0431\\u043e\\u0440\\u0430 \\u0441\\u0431\\u043e\\u0435\\u0432 |\\n| `$OutputEncoding`, `[Console]::OutputEncoding` = UTF-8 | \\u0432 Windows PowerShell 5.1 \\u043f\\u043e \\u0443\\u043c\\u043e\\u043b\\u0447\\u0430\\u043d\\u0438\\u044e \\u043f\\u0440\\u043e\\u043c\\u043f\\u0442 \\u0443\\u0445\\u043e\\u0434\\u0438\\u0442 \\u0432 stdin \\u0432 ASCII (\\u043a\\u0438\\u0440\\u0438\\u043b\\u043b\\u0438\\u0446\\u0430 \\u2192 \\u00ab?\\u00bb), \\u0430 stdout exe \\u0447\\u0438\\u0442\\u0430\\u0435\\u0442\\u0441\\u044f \\u0432 \\u043a\\u043e\\u0434\\u043e\\u0432\\u043e\\u0439 \\u0441\\u0442\\u0440\\u0430\\u043d\\u0438\\u0446\\u0435 \\u043a\\u043e\\u043d\\u0441\\u043e\\u043b\\u0438 (\\u043a\\u0438\\u0440\\u0438\\u043b\\u043b\\u0438\\u0446\\u0430 \\u0441\\u043e\\u0431\\u044b\\u0442\\u0438\\u0439 \\u2014 \\u043a\\u0440\\u0430\\u043a\\u043e\\u0437\\u044f\\u0431\\u0440\\u044b). \\u0417\\u0430\\u043f\\u0443\\u0441\\u043a `powershell -NoProfile`, \\u043e\\u0431\\u0435 \\u043a\\u043e\\u0434\\u0438\\u0440\\u043e\\u0432\\u043a\\u0438 \\u2014 UTF-8 \\u0431\\u0435\\u0437 BOM (\\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u0435\\u043d\\u043e 2026-10-09). `2>` \\u0443 exe \\u0432 PS 5.1 \\u043f\\u0438\\u0448\\u0435\\u0442 stderr \\u0437\\u0430\\u043f\\u0438\\u0441\\u044f\\u043c\\u0438 `NativeCommandError` \\u0432 UTF-16 \\u2014 \\u0447\\u0438\\u0442\\u0430\\u0442\\u044c \\u043a\\u0430\\u043a UTF-16 |\\n\\n\\u0421\\u0445\\u0435\\u043c\\u0430 \\u0432\\u044b\\u0432\\u043e\\u0434\\u0430 \\u2014 **\\u043d\\u0435** \\u043f\\u043e\\u043b\\u04