\"frames\": [\n        \"skunk-ape-front.png\"\n      ]\n    },\n    \"Q\": {\n      \"value\": 2,\n      \"rationale\": \"skunk-ape-front.png соответствует уровню расписанной коллекционной миниатюры medusa-quality-reference.png: многослойные скульптурные пряди шерсти, зернистый мох, морщины лица и кистей, ногти и фактура подставки подробно проработаны внутри силуэта. Шерсть, мох и открытая кожа различаются по фактуре и световым акцентам; заметно обеднённых зон нет.\",\n      \"frames\": [\n        \"skunk-ape-front.png\"\n      ]\n    },\n    \"P\": {\n      \"value\": 1.5,\n      \"rationale\": \"В skunk-ape-front.png присутствуют все цвета palette.json и все четыре якоря: тёмно-коричневая шерсть, болотный мох, серая кожа, янтарные глаза; высокое сутулое тело, спутанная шерсть, длинные руки и большие стопы. Мох визуально несколько желтее заданного #5E6A36, кожа местами теплее #6A625A. Это небольшое отклонение тона при сохранении палитры и идентичности.\",\n      \"frames\": [\n        \"skunk-ape-front.png\"\n      ]\n    }\n  },\n  \"score\": 8.8,\n  \"verdict\": \"pass\",\n  \"verdict_reason\": null,\n  \"rework_fix_list\": [],\n  \"known_issues\": [\n    {\n      \"item\": \"G-CHECKS\",\n      \"frame\": \"checks-report.json\",\n      \"note\": \"view.frame_top: верхний отступ 2.486% при ориентире 4%; низ подставки на 96.133% вместо ориентира 93%, указанного в verification.json. Фигура и подставка полностью видны, обрезки нет; гейт остаётся PASS.\"\n    },\n    {\n      \"item\": \"G-CHECKS\",\n      \"frame\": \"checks-report.json\",\n      \"note\": \"view.single_component: дополнительная компонента маски 1.118% при пороге WARN 0.5%. На skunk-ape-front.png второй фигуры или отдельного предмета не видно; предупреждение сегментации не является FAIL.\"\n    },\n    {\n      \"item\": \"P\",\n      \"frame\": \"skunk-ape-front.png\",\n      \"note\": \"Допустимое небольшое потепление оттенков мха и открытой кожи относительно заданной палитры.\"\n    },\n    {\n      \"item\": \"S\",\n      \"frame\": \"skunk-ape-front.png\",\n      \"note\": \"Тонкие свисающие нити мха выходят за основной силуэт. Их геометрическая прочность и сохранность после генерации модели по концепту не проверяются на этапе 1a.\"\n    }\n  ],\n  \"acceptor\": {\n    \"profile\": \"Sol 6.1 xhigh\",\n    \"session_id\": \"codex:pending\"\n  },\n  \"executor_session_id\": \"codex:01a13452-2645-7b71-a93a-74e194e082ff\",\n  \"decided_by\": \"delegated (ВР-реестр 2026-10-06)\",\n  \"status_note\": \"художественно принято, по делегированию (docs/game-design/decisions/2026-10-06-visual-delegated-decisions.md)\"\n}"}}
