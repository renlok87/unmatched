30 front \\u043f\\u0440\\u043e\\u0442\\u0438\\u0432 \\u0437\\u0435\\u0440\\u043a\\u0430\\u043b\\u044c\\u043d\\u043e\\u0433\\u043e back (\\u0443 mvp-v1-\\u043a\\u043e\\u043c\\u043f\\u043b\\u0435\\u043a\\u0442\\u043e\\u0432 \\u0447\\u0435\\u0442\\u044b\\u0440\\u0451\\u0445 \\u0433\\u0435\\u0440\\u043e\\u0435\\u0432 0,89\\u20130,94,\n`CONSISTENCY-REVIEW.md:54`; \\u0442\\u0430\\u043c \\u0436\\u0435 \\u2014 \\u00ab\\u043e\\u0440\\u0438\\u0435\\u043d\\u0442\\u0438\\u0440 \\u043d\\u0430 \\u043f\\u0435\\u0440\\u0441\\u043f\\u0435\\u043a\\u0442\\u0438\\u0432\\u043d\\u044b\\u0445 \\u0438\\u0437\\u043e\\u0431\\u0440\\u0430\\u0436\\u0435\\u043d\\u0438\\u044f\\u0445\\u00bb). \\u0412\\u044b\\u0441\\u043e\\u043a\\u0438\\u0439 IoU \\u043d\\u0435 \\u0434\\u043e\\u043a\\u0430\\u0437\\u044b\\u0432\\u0430\\u0435\\u0442 \\u043e\\u0434\\u043d\\u0443\n3D-\\u0444\\u043e\\u0440\\u043c\\u0443; \\u0440\\u0435\\u0448\\u0430\\u044e\\u0442 \\u0433\\u043b\\u0430\\u0437\\u0430 \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a\\u0430.\n\n### 4.4 \\u041f\\u043e\\u0437\\u0430 \\u0438 \\u0441\\u0442\\u043e\\u0440\\u043e\\u043d\\u0430 \\u043e\\u0440\\u0443\\u0436\\u0438\\u044f\n\n\\u041f\\u043e\\u0437\\u0430 \\u2014 \\u041d\\u0415 T \\u0438 \\u041d\\u0415 A: rest-\\u043f\\u043e\\u0437\\u0430 \\u0440\\u0438\\u0433\\u0430 = \\u043f\\u043e\\u0437\\u0430 \\u043c\\u0438\\u043d\\u0438\\u0430\\u0442\\u044e\\u0440\\u044b, \\u0432 \\u043a\\u043e\\u0442\\u043e\\u0440\\u043e\\u0439 \\u0441\\u043c\\u043e\\u0434\\u0435\\u043b\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d \\u043c\\u0435\\u0448 (`docs/art-pipeline/rig/rig-contract.json`\n`rest_pose`: \\u00ab\\u043d\\u0435 T/A-\\u043f\\u043e\\u0437\\u0430\\u00bb; HANDBOOK \\u00a72.6). \\u041c\\u0435\\u0448 \\u0438\\u0437 A-\\u043f\\u043e\\u0437\\u043d\\u043e\\u0433\\u043e \\u043a\\u043e\\u043d\\u0446\\u0435\\u043f\\u0442\\u0430 \\u0441\\u0442\\u0430\\u043b \\u0431\\u044b \\u043f\\u043e\\u0437\\u043e\\u0439 \\u0444\\u0438\\u0433\\u0443\\u0440\\u044b \\u043d\\u0430 \\u0434\\u043e\\u0441\\u043a\\u0435.\n\n| ANATOMY | `{{POSE_EN}}` (\\u0434\\u043e\\u0441\\u043b\\u043e\\u0432\\u043d\\u043e) |\n|---|---|\n| humanoid | `Neutral standing pose of a tabletop miniature: both feet planted on the pedestal, weight even, both arms held slightly away from the torso with a visible gap between each arm and the body, elbows slightly bent; not a T-pose and not an A-pose.` |\n| winged-biped | `Stable standing pose on the pedestal. The wings are the arms: exactly two wings, spread sideways and swept back, each clearly separated from the body; no separate human arms or hands; not a T-pose.` |\n| prop | `Upright, in its natural resting orientation; all hardware such as hinges, latches and handles is visible from the front.` |\n\n\\u041a\\u0440\\u044b\\u043b\\u043e = \\u0446\\u0435\\u043f\\u043e\\u0447\\u043a\\u0430 \\u0440\\u0443\\u043a\\u0438 (HANDBOOK \\u00a72.6, \\u00abHarpy: \\u043a\\u0440\\u044b\\u043b\\u044c\\u044f = \\u0446\\u0435\\u043f\\u043e\\u0447\\u043a\\u0430 arm_upper \\u2192 arm_lower \\u2192 hand\\u00bb). \\u041a\\u0440\\u044b\\u043b\\u044c\\u044f \\u0438 \\u043e\\u0442\\u0434\\u0435\\u043b\\u044c\\u043d\\u044b\\u0435 \\u0440\\u0443\\u043a\\u0438\n\\u043e\\u0434\\u043d\\u043e\\u0432\\u0440\\u0435\\u043c\\u0435\\u043d\\u043d\\u043e \\u2014 \\u043d\\u043e\\u0432\\u0430\\u044f \\u043a\\u043e\\u0441\\u0442\\u044c, \\u0433\\u0435\\u0439\\u0442 \\u0441\\u0442\\u043e\\u043f\\u0430 \\u044d\\u0442\\u0430\\u043f\\u0430 0. \\u041f\\u043e\\u0437\\u044b \\u0447\\u0435\\u0442\\u0432\\u0435\\u0440\\u043e\\u043d\\u043e\\u0433\\u0438\\u0445 \\u0438 \\u043c\\u043d\\u043e\\u0433\\u043e\\u0433\\u043e\\u043b\\u043e\\u0432\\u044b\\u0445 (\\u0432\\u0441\\u0435 \\u043b\\u0430\\u043f\\u044b \\u043d\\u0430 \\u043f\\u043e\\u0434\\u0441\\u0442\\u0430\\u0432\\u043a\\u0435, \\u0441\\u043f\\u0438\\u043d\\u0430\n\\u0433\\u043e\\u0440\\u0438\\u0437\\u043e\\u043d\\u0442\\u0430\\u043b\\u044c\\u043d\\u0430, \\u0447\\u0438\\u0441\\u043b\\u043e \\u0433\\u043e\\u043b\\u043e\\u0432 \\u2014 \\u044f\\u043a\\u043e\\u0440\\u044c \\u0432\\u0441\\u0435\\u0445 \\u0432\\u0438\\u0434\\u043e\\u0432) \\u0434\\u0435\\u0439\\u0441\\u0442\\u0432\\u0443\\u044e\\u0442 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043f\\u043e\\u0441\\u043b\\u0435 \\u043f\\u0440\\u0438\\u043d\\u044f\\u0442\\u0438\\u044f rig-contract/3; \\u0434\\u043e \\u0442\\u043e\\u0433\\u043e \\u0442\\u0430\\u043a\\u043e\\u0439 \\u0430\\u0441\\u0441\\u0435\\u0442\n\\u043e\\u0441\\u0442\\u0430\\u043d\\u0430\\u0432\\u043b\\u0438\\u0432\\u0430\\u0435\\u0442\\u0441\\u044f \\u043d\\u0430 \\u044d\\u0442\\u0430\\u043f\\u0435 0.\n\n\\u041a\\u043e\\u043b\\u0447\\u0430\\u043d \\u0438 \\u043d\\u043e\\u0436\\u043d\\u044b \\u043f\\u043e \\u0443\\u043c\\u043e\\u043b\\u0447\\u0430\\u043d\\u0438\\u044e \\u2014 \\u043d\\u0430 \\u0441\\u0442\\u043e\\u0440\\u043e\\u043d\\u0435, \\u043f\\u0440\\u043e\\u0442\\u0438\\u0432\\u043e\\u043f\\u043e\\u043b\\u043e\\u0436\\u043d\\u043e\\u0439 `WEAPON_HAND` (\\u043d\\u0430\\u0442\\u044f\\u0433\\u0438\\u0432\\u0430\\u044e\\u0449\\u0430\\u044f \\u0438\\u043b\\u0438 \\u0441\\u0432\\u043e\\u0431\\u043e\\u0434\\u043d\\u0430\\u044f \\u0440\\u0443\\u043a\\u0430;\n\\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u043e \\u2014 \\u0440\\u0430\\u0437\\u0434\\u0435\\u043b 9, `{{ANCHORS_EN}}`).\n\n\\u0421\\u0442\\u043e\\u0440\\u043e\\u043d\\u0430 \\u043e\\u0440\\u0443\\u0436\\u0438\\u044f \\u2014 \\u043f\\u0430\\u0440\\u0430\\u043c\\u0435\\u0442\\u0440 `WEAPON_HAND` \\u0432\\u043e \\u0432\\u0441\\u0435\\u0445 \\u0444\\u043e\\u0440\\u043c\\u0443\\u043b\\u0438\\u0440\\u043e\\u0432\\u043a\\u0430\\u0445 (`rig-contract.json:57-60`: Medusa \\u043b\\u0443\\u043a `weapon.L`,\nArthur \\u0438 Merlin `weapon.R`, Harpy \\u0431\\u0435\\u0437 \\u043e\\u0440\\u0443\\u0436\\u0438\\u044f):\n\n| WEAPON_HAND | `{{WEAPON_SIDE_EN}}` | `{{BACK_WEAPON_EN}}` |\n|---|---|---|\n| right | `The weapon is held in the figure's own RIGHT hand, which appears on the viewer's LEFT in the front view.` | `The weapon in the figure's own RIGHT hand appears on the viewer's RIGHT.` |\n| left | `The weapon is held in the figure's own LEFT hand, which appears on the viewer's RIGHT in the front view.` | `The weapon in the figure's own LEFT hand appears on the viewer's LEFT.` |\n| none | `No weapon or held object.` | \\u043f\\u0443\\u0441\\u0442\\u043e |\n\n\\u041f\\u0440\\u043e\\u0432\\u0435\\u0440\\u0435\\u043d\\u043e \\u043d\\u0430 mvp-v1-\\u043d\\u0430\\u0431\\u043e\\u0440\\u0430\\u0445: \\u043c\\u0435\\u0447 Arthur \\u0432 \\u043f\\u0440\\u0430\\u0432\\u043e\\u0439 \\u0440\\u0443\\u043a\\u0435 \\u2014 \\u0441\\u043b\\u0435\\u0432\\u0430 \\u0432 \\u043a\\u0430\\u0434\\u0440\\u0435 \\u043d\\u0430 front, \\u0441\\u043f\\u0440\\u0430\\u0432\\u0430 \\u043d\\u0430 back; \\u043b\\u0443\\u043a Medusa \\u0432 \\u043b\\u0435\\u0432\\u043e\\u0439 \\u2014\n\\u0441\\u043f\\u0440\\u0430\\u0432\\u0430 \\u043d\\u0430 front, \\u0441\\u043b\\u0435\\u0432\\u0430 \\u043d\\u0430 back (`CONSISTENCY-REVIEW.md:71,86`; \\u0441\\u0440\\u0435\\u0437 2026-09-28, \\u043d\\u0438 \\u043e\\u0434\\u0438\\u043d \\u0438\\u0437 \\u044d\\u0442\\u0438\\u0445 \\u043a\\u043e\\u043c\\u043f\\u043b\\u0435\\u043a\\u0442\\u043e\\u0432 \\u043d\\u0435 \\u043f\\u0440\\u0438\\u043d\\u044f\\u0442\n\\u0445\\u0443\\u0434\\u043e\\u0436\\u0435\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u043e). \\u0422\\u043e \\u0436\\u0435 \\u0432 \\u043f\\u0440\\u0438\\u043d\\u044f\\u0442\\u044b\\u0445 \\u043d\\u0430\\u0431\\u043e\\u0440\\u0430\\u0445 hero-quality-v1: \\u00absword on viewer RIGHT\\u00bb \\u043d\\u0430 back Arthur, \\u00abbow on viewer\nLEFT\\u00bb \\u043d\\u0430 back Medusa, \\u043f\\u043e\\u0441\\u043e\\u0445 Merlin \\u00abon viewer LEFT\\u00bb \\u043d\\u0430 front \\u0438 \\u00abon viewer RIGHT\\u00bb \\u043d\\u0430 back\n(`art/imagegen/hero-quality-v1/{king-arthur,medusa,merlin}/prompts.md`).\n\n### 4.5 \\u0421\\u0432\\u0435\\u0442, \\u0444\\u043e\\u043d, \\u043f\\u0430\\u043b\\u0438\\u0442\\u0440\\u0430, \\u0437\\u0430\\u043f\\u0440\\u0435\\u0442\\u044b\n\n- \\u0424\\u043e\\u043d: \\u0440\\u043e\\u0432\\u043d\\u044b\\u0439 \\u043d\\u0435\\u0439\\u0442\\u0440\\u0430\\u043b\\u044c\\u043d\\u044b\\u0439 \\u0442\\u0451\\u043c\\u043d\\u043e-\\u0441\\u0435\\u0440\\u044b\\u0439, \\u0431\\u0435\\u0437 \\u0433\\u0440\\u0430\\u0434\\u0438\\u0435\\u043d\\u0442\\u0430, \\u0432\\u0438\\u043d\\u044c\\u0435\\u0442\\u043a\\u0438, \\u043f\\u043e\\u043b\\u0430 \\u0438 \\u043f\\u0430\\u0434\\u0430\\u044e\\u0449\\u0435\\u0439 \\u0442\\u0435\\u043d\\u0438 \\u043d\\u0430 \\u0444\\u043e\\u043d. \\u0421\\u0432\\u0435\\u0442 \\u043c\\u044f\\u0433\\u043a\\u0438\\u0439 \\u0440\\u043e\\u0432\\u043d\\u044b\\u0439\n  \\u0441\\u0442\\u0443\\u0434\\u0438\\u0439\\u043d\\u044b\\u0439, \\u0431\\u0435\\u0437 \\u0441\\u0438\\u043b\\u044c\\u043d\\u043e\\u0433\\u043e \\u043a\\u043e\\u043d\\u0442\\u0440\\u043e\\u0432\\u043e\\u0433\\u043e \\u0438 \\u0431\\u0435\\u0437 \\u0433\\u043b\\u0443\\u0431\\u0438\\u043d\\u044b \\u0440\\u0435\\u0437\\u043a\\u043e\\u0441\\u0442\\u0438. \\u0422\\u0451\\u043c\\u043d\\u043e-\\u0441\\u0435\\u0440\\u044b\\u0439 \\u2014 \\u043f\\u043e \\u043a\\u0430\\u043d\\u043e\\u043d\\u0443 hero-quality-v1 (HANDBOOK \\u00a73.1).\n  \\u0420\\u0438\\u0441\\u043a: \\u0441\\u0435\\u0440\\u044b\\u0439 \\u043a\\u0430\\u043c\\u0435\\u043d\\u044c \\u043f\\u043e\\u0434\\u0441\\u0442\\u0430\\u0432\\u043a\\u0438 \\u043d\\u0430 \\u0441\\u0435\\u0440\\u043e\\u043c \\u0444\\u043e\\u043d\\u0435 \\u2014 Tripo \\u0441\\u0440\\u0435\\u0437\\u0430\\u0435\\u0442 \\u043a\\u0440\\u0430\\u0439 (HANDBOOK \\u00a73.1, \\u00ab\\u041f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043a\\u0430 \\u043a\\u043e\\u043c\\u043f\\u043b\\u0435\\u043a\\u0442\\u0430\\u00bb).\n- \\u041f\\u0430\\u043b\\u0438\\u0442\\u0440\\u0430: 2\\u20133 \\u043e\\u0441\\u043d\\u043e\\u0432\\u043d\\u044b\\u0445 \\u0446\\u0432\\u0435\\u0442\\u0430 + 1 \\u0430\\u043a\\u0446\\u0435\\u043d\\u0442, hex \\u0438\\u0437 `PALETTE` \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0438. \\u042d\\u0442\\u043e **\\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u0441\\u043a\\u0438\\u043b\\u043b\\u0430, \\u043e\\u0442\\u0441\\u0442\\u0443\\u043f\\u043b\\u0435\\u043d\\u0438\\u0435 \\u043e\\u0442 07 \\u00a70.4**\n  (`docs/game-design/visual/07-prompt-templates.md:98-103`: \\u00abHex \\u2014 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u0438\\u0437 02 \\u00a72\\u00bb; \\u0438\\u0441\\u043a\\u043b\\u044e\\u0447\\u0435\\u043d\\u0438\\u0439 \\u0434\\u043b\\u044f \\u0444\\u0438\\u0433\\u0443\\u0440 \\u0442\\u0430\\u043c \\u043d\\u0435\\u0442).\n  \\u041e\\u0441\\u043d\\u043e\\u0432\\u0430\\u043d\\u0438\\u0435: \\u043f\\u043e\\u043b\\u0435 `PALETTE` \\u0437\\u0430\\u044f\\u0432\\u043a\\u0438 (\\u0448\\u0430\\u0431\\u043b\\u043e\\u043d `asset-card.yaml` \\u0432 SKILL.md: 2\\u20133 hex + 1 \\u0430\\u043a\\u0446\\u0435\\u043d\\u0442) \\u0438 \\u0434\\u0435\\u043b\\u0435\\u0433\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u0435 \\u0432\\u0438\\u0437\\u0443\\u0430\\u043b\\u044c\\u043d\\u044b\\u0445 \\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0439\n  (`docs/game-design/decisions/2026-10-06-visual-delegated-decisions.md`). \\u0422\\u043e\\u043a\\u0435\\u043d\\u044b 02 \\u00a72 \\u0434\\u043b\\u044f \\u043f\\u0430\\u043b\\u0438\\u0442\\u0440\\u044b \\u0444\\u0438\\u0433\\u0443\\u0440\\u044b \\u043d\\u0435\n  \\u0437\\u0430\\u0432\\u043e\\u0434\\u044f\\u0442\\u0441\\u044f. \\u0426\\u0432\\u0435\\u0442 \\u043a\\u043e\\u043c\\u0430\\u043d\\u0434\\u044b \\u043d\\u0430 \\u0444\\u0438\\u0433\\u0443\\u0440\\u0435 \\u0438 \\u043a\\u043e\\u043b\\u044c\\u0446\\u043e \\u043d\\u0430 \\u043f\\u043e\\u0434\\u0441\\u0442\\u0430\\u0432\\u043a\\u0435 \\u043d\\u0435 \\u0440\\u0438\\u0441\\u0443\\u044e\\u0442\\u0441\\u044f: \\u043a\\u043e\\u043c\\u0430\\u043d\\u0434\\u0430 \\u2014 \\u0440\\u0430\\u043d\\u0442\\u0430\\u0439\\u043c-\\u043c\\u0430\\u0441\\u043a\\u0430 TeamAccent \\u0438 \\u043a\\u043e\\u043b\\u044c\\u0446\\u043e \\u0432\n  UE (HANDBOOK \\u00a72.9).\n- `palette.json` \\u043f\\u0438\\u0448\\u0435\\u0442 \\u0437\\u0430\\u043f\\u0443\\u0441\\u043a\\u0430\\u044e\\u0449\\u0438\\u0439 \\u0430\\u0433\\u0435\\u043d\\u0442 \\u0434\\u043e \\u043f\\u0435\\u0440\\u0432\\u043e\\u0433\\u043e \\u0437\\u0430\\u043f\\u0443\\u0441\\u043a\\u0430 Codex, \\u0432 \\u0444\\u043e\\u0440\\u043c\\u0435, \\u043a\\u043e\\u0442\\u043e\\u0440\\u0443\\u044e \\u043f\\u043e\\u043d\\u0438\\u043c\\u0430\\u0435\\u0442\n  `check_concept_views.py` (`load_palette`, `tools/art/concept/README.md` \\u00abpalette.json\\u00bb):\n  `{\"asset_id\": \"<ASSET_ID>\", \"main\": [{\"name\": \"midnight blue\", \"hex\": \"#1F2A5A\"}, {\"name\": \"\\u2026\", \"hex\": \"#\\u2026\"}], \"accent\": {\"name\": \"\\u2026\", \"hex\": \"#\\u2026\"}}`.\n  \\u042d\\u0442\\u043e \\u043a\\u043e\\u043f\\u0438\\u044f \\u043f\\u043e\\u043b\\u044f `PALETTE` \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0438 (\\u0448\\u0430\\u0431\\u043b\\u043e\\u043d SKILL.md \\u00a77.2 \\u0445\\u0440\\u0430\\u043d\\u0438\\u0442 \\u0442\\u0435 \\u0436\\u0435 `name` \\u0438 `hex`); \\u0430\\u043d\\u0433\\u043b\\u0438\\u0439\\u0441\\u043a\\u0438\\u0435 \\u0438\\u043c\\u0435\\u043d\\u0430 \\u2014 \\u0442\\u0435 \\u0436\\u0435, \\u0447\\u0442\\u043e \\u0432\n  `{{PALETTE_EN}}` (\\u0440\\u0430\\u0437\\u0434\\u0435\\u043b 9).\n- \\u0422\\u043e\\u043d\\u043a\\u0438\\u0435 \\u044d\\u043b\\u0435\\u043c\\u0435\\u043d\\u0442\\u044b (\\u0442\\u0435\\u0442\\u0438\\u0432\\u0430, \\u0434\\u0440\\u0435\\u0432\\u043a\\u043e, \\u0441\\u0442\\u0440\\u0435\\u043b\\u044b, \\u043f\\u043e\\u0441\\u043e\\u0445): \\u0432 \\u043f\\u0440\\u043e\\u043c\\u043f\\u0442\\u0435 \\u043f\\u043e\\u0436\\u0435\\u043b\\u0430\\u043d\\u0438\\u0435 \\u00abclearly readable, not hair-thin\\u00bb; \\u0432\n  \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043a\\u0430\\u0445 \\u044d\\u0442\\u043e \\u043d\\u0435 FAIL \\u0438 \\u043d\\u0435 \\u043f\\u043e\\u0432\\u043e\\u0434 \\u0434\\u043b\\u044f \\u0440\\u0435\\u0442\\u0440\\u0430\\u044f. \\u0423\\u0442\\u043e\\u043b\\u0449\\u0430\\u044e\\u0449\\u0435\\u0433\\u043e \\u0440\\u0435\\u0436\\u0438\\u043c\\u0430 \\u0432 \\u0433\\u0435\\u043d\\u0435\\u0440\\u0438\\u0447\\u0435\\u0441\\u043a\\u043e\\u043c `h2_bake` \\u043d\\u0435\\u0442\n  (`tools/tripo-pipeline/blender/h2_bake/`; \\u043c\\u043e\\u0441\\u0442\\u044b \\u0435\\u0441\\u0442\\u044c \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u0432 \\u0440\\u0443\\u0447\\u043d\\u044b\\u0445 \\u0444\\u043e\\u0440\\u043a\\u0430\\u0445 `h2_bake_merlin/`,\n  `h2_bake_arthur/repairs.py`). \\u041f\\u043e\\u0440\\u044f\\u0434\\u043e\\u043a \\u2014 \\u043f\\u043e HANDBOOK \\u00a74.2, \\u0430\\u0431\\u0437\\u0430\\u0446 \\u00ab\\u041e\\u0440\\u0443\\u0436\\u0438\\u0435\\u00bb, \\u0438 SKILL.md, \\u044d\\u0442\\u0430\\u043f 3: \\u0442\\u043e\\u043d\\u043a\\u0430\\u044f \\u0438\\u043b\\u0438\n  \\u043d\\u0435\\u0447\\u0438\\u0442\\u0430\\u0435\\u043c\\u0430\\u044f \\u043f\\u043e\\u0441\\u043b\\u0435 Tripo \\u0434\\u0435\\u0442\\u0430\\u043b\\u044c \\u2014 \\u0437\\u0430\\u043f\\u0438\\u0441\\u044c \\u0432 \\u043e\\u0442\\u0447\\u0451\\u0442 \\u044d\\u0442\\u0430\\u043f\\u0430 3 \\u0438 \\u0431\\u0430\\u043b\\u043b F/T \\u043d\\u0430 \\u044d\\u0442\\u0430\\u043f\\u0435 4; \\u0435\\u0441\\u043b\\u0438 \\u043d\\u0443\\u0436\\u0435\\u043d \\u043c\\u043e\\u0441\\u0442-\\u0446\\u0438\\u043b\\u0438\\u043d\\u0434\\u0440 \\u0438\\u043b\\u0438 \\u0441\\u0431\\u043e\\u0440\\u043a\\u0430\n  \\u0438\\u0437 \\u0447\\u0430\\u0441\\u0442\\u0435\\u0439 \\u2014 \\u044d\\u0442\\u043e \\u0441\\u0442\\u043e\\u043f \\u0441 \\u043e\\u043f\\u0438\\u0441\\u0430\\u043d\\u0438\\u0435\\u043c, \\u0430 \\u043d\\u0435 \\u0440\\u0443\\u0442\\u0438\\u043d\\u043d\\u0430\\u044f \\u0434\\u043e\\u0440\\u0430\\u0431\\u043e\\u0442\\u043a\\u0430.\n- \\u0417\\u0430\\u043f\\u0440\\u0435\\u0449\\u0435\\u043d\\u043e \\u0432 \\u043f\\u0440\\u043e\\u043c\\u043f\\u0442\\u0430\\u0445: \\u0441\\u043b\\u043e\\u0432\\u0430 \\u00abUnmatched\\u00bb, \\u00abDigital Edition\\u00bb, \\