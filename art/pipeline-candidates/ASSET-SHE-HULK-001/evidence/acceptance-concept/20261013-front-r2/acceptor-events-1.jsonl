3f\\u0438\\u0448\\u0435\\u0442 \\u043d\\u043e\\u0432\\u043e\\u0435 \\u0437\\u043d\\u0430\\u0447\\u0435\\u043d\\u0438\\u0435 \\u0432\n  `asset-card.yaml` \\u0441 `decided_by` \\u0438 \\u043f\\u0440\\u0438\\u0447\\u0438\\u043d\\u043e\\u0439. \\u0414\\u0430\\u043b\\u044c\\u0448\\u0435 `SIDE_VIEW` \\u043d\\u0435 \\u043c\\u0435\\u043d\\u044f\\u0435\\u0442\\u0441\\u044f: 1c \\u0440\\u0438\\u0441\\u0443\\u0435\\u0442 \\u044d\\u0442\\u043e\\u0442 \\u0431\\u043e\\u043a, \\u044d\\u0442\\u0430\\u043f 2 \\u043a\\u043b\\u0430\\u0434\\u0451\\u0442 \\u0435\\u0433\\u043e \\u0432\n  \\u043e\\u0434\\u043d\\u043e\\u0438\\u043c\\u0451\\u043d\\u043d\\u044b\\u0439 \\u0441\\u043b\\u043e\\u0442.\n- \\u0421\\u043b\\u0443\\u0447\\u0430\\u0439 `right` \\u2014 **\\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u0441\\u043a\\u0438\\u043b\\u043b\\u0430, \\u043e\\u0442\\u0441\\u0442\\u0443\\u043f\\u043b\\u0435\\u043d\\u0438\\u0435 \\u043e\\u0442 HANDBOOK \\u00a73.2 \\u043f. 3**. \\u041e\\u0441\\u043d\\u043e\\u0432\\u0430\\u043d\\u0438\\u0435 \\u2014 \\u043f\\u0440\\u0435\\u0446\\u0435\\u0434\\u0435\\u043d\\u0442 Merlin: \\u043f\\u0440\\u0430\\u0432\\u044b\\u0439 \\u0432\\u0438\\u0434 \\u0432\n  \\u0441\\u043b\\u043e\\u0442\\u0435 RIGHT, \\u0431\\u0435\\u0437 \\u0444\\u0430\\u043d\\u0442\\u043e\\u043c\\u043e\\u0432 (`art/pipeline-candidates/ASSET-MERLIN-001/source-specs/tripo-de0654b5-h2.json` `slot_note`:\n  \\u00ab\\u0411\\u043e\\u043a\\u043e\\u0432\\u043e\\u0439 \\u043a\\u043e\\u043d\\u0446\\u0435\\u043f\\u0442 \\u2014 \\u043f\\u0440\\u0430\\u0432\\u044b\\u0439 \\u0432\\u0438\\u0434 (prompts.md), \\u043f\\u043e\\u0434\\u0430\\u043d \\u0432 \\u0441\\u043b\\u043e\\u0442 RIGHT: \\u0441\\u043e\\u0433\\u043b\\u0430\\u0441\\u043e\\u0432\\u0430\\u043d\\u043e (\\u043a\\u0430\\u043a \\u0443 \\u043f\\u0440\\u0435\\u0436\\u043d\\u0435\\u0433\\u043e H3.1 Merlin d9ff4260)\\u00bb).\n  \\u0417\\u0430\\u043f\\u0440\\u0435\\u0449\\u0435\\u043d\\u043e \\u043f\\u043e HANDBOOK \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043d\\u0435\\u0441\\u043e\\u043e\\u0442\\u0432\\u0435\\u0442\\u0441\\u0442\\u0432\\u0438\\u0435 \\u0431\\u043e\\u043a\\u0430 \\u0438 \\u0441\\u043b\\u043e\\u0442\\u0430; \\u043e\\u043d\\u043e \\u0437\\u0434\\u0435\\u0441\\u044c \\u0438\\u0441\\u043a\\u043b\\u044e\\u0447\\u0435\\u043d\\u043e.\n- \\u0412\\u0438\\u0434\\u044b `three-quarter` \\u0438 `top` \\u043d\\u0435 \\u0434\\u0435\\u043b\\u0430\\u044e\\u0442\\u0441\\u044f.\n\n### 4.2 \\u0425\\u043e\\u043b\\u0441\\u0442 \\u0438 \\u0440\\u0430\\u0437\\u043c\\u0435\\u0449\\u0435\\u043d\\u0438\\u0435 (\\u00ab\\u0441\\u0435\\u0442\\u043a\\u0430\\u00bb \\u0432 \\u0447\\u0438\\u0441\\u043b\\u0430\\u0445)\n\n- \\u0420\\u0430\\u0437\\u043c\\u0435\\u0440 \\u0432 \\u043f\\u0438\\u043a\\u0441\\u0435\\u043b\\u044f\\u0445 \\u043d\\u0435 \\u0437\\u0430\\u0434\\u0430\\u0451\\u0442\\u0441\\u044f \\u0438 \\u043d\\u0435 \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u044f\\u0435\\u0442\\u0441\\u044f \\u043f\\u0440\\u043e\\u0442\\u0438\\u0432 \\u0447\\u0438\\u0441\\u043b\\u0430: `image_gen` \\u0440\\u0430\\u0437\\u043c\\u0435\\u0440 \\u0438\\u0433\\u043d\\u043e\\u0440\\u0438\\u0440\\u0443\\u0435\\u0442 (\\u043a\\u0432\\u0430\\u0434\\u0440\\u0430\\u0442 \\u2192 1254\\u00d71254,\n  \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u0435\\u043d\\u043e 2026-10-09 \\u0438 109 \\u0441\\u044b\\u0440\\u044b\\u043c\\u0438 PNG `art/imagegen/mvp-v1`). \\u0410\\u0441\\u043f\\u0435\\u043a\\u0442 \\u0437\\u0430\\u0434\\u0430\\u0451\\u0442\\u0441\\u044f \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u0442\\u0435\\u043a\\u0441\\u0442\\u043e\\u043c \\u043f\\u0440\\u043e\\u043c\\u043f\\u0442\\u0430, \\u0438 \\u0438\\u043d\\u0441\\u0442\\u0440\\u0443\\u043c\\u0435\\u043d\\u0442\n  \\u0435\\u0433\\u043e \\u0434\\u0435\\u0440\\u0436\\u0438\\u0442: \\u043f\\u0440\\u0438\\u043d\\u044f\\u0442\\u044b\\u0435 \\u043d\\u0430\\u0431\\u043e\\u0440\\u044b \\u2014 Medusa 1021\\u00d71540, Arthur \\u0438 Merlin 1190\\u00d71322, Harpy 1470\\u00d71070 (HANDBOOK \\u00a73.1).\n- \\u0410\\u0441\\u043f\\u0435\\u043a\\u0442 \\u043d\\u0430\\u0431\\u043e\\u0440\\u0430 (\\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u0441\\u043a\\u0438\\u043b\\u043b\\u0430): `3:4` \\u043f\\u043e\\u0440\\u0442\\u0440\\u0435\\u0442; `4:3` \\u043b\\u0430\\u043d\\u0434\\u0448\\u0430\\u0444\\u0442 \\u0434\\u043b\\u044f `winged-biped` (\\u043a\\u0440\\u044b\\u043b\\u044c\\u044f \\u0432\\u0448\\u0438\\u0440\\u044c, \\u043a\\u0430\\u043a \\u0443 Harpy).\n  \\u042d\\u0442\\u043e\\u0442 \\u0436\\u0435 \\u0430\\u0441\\u043f\\u0435\\u043a\\u0442 \\u043f\\u043e\\u043b\\u0443\\u0447\\u0430\\u044e\\u0442 \\u043e\\u0440\\u0442\\u043e\\u043f\\u0440\\u043e\\u0435\\u043a\\u0446\\u0438\\u0438 1b (`draft_orthos.py --aspect`).\n- \\u0412\\u044b\\u0445\\u043e\\u0434 `image_gen` \\u043d\\u0435 \\u043f\\u0440\\u0430\\u0432\\u0438\\u0442\\u0441\\u044f: \\u043d\\u0438 \\u0440\\u0435\\u0441\\u0430\\u0439\\u0437\\u0430, \\u043d\\u0438 \\u043e\\u0431\\u0440\\u0435\\u0437\\u043a\\u0438, \\u043d\\u0438 \\u043f\\u0435\\u0440\\u0435\\u043a\\u0440\\u0430\\u0441\\u043a\\u0438, \\u043d\\u0438 \\u043f\\u0435\\u0440\\u0435\\u0441\\u043e\\u0445\\u0440\\u0430\\u043d\\u0435\\u043d\\u0438\\u044f. \\u041d\\u043e\\u0440\\u043c\\u0430\\u043b\\u0438\\u0437\\u0430\\u0446\\u0438\\u0438 \\u043d\\u0435\\u0442.\n- \\u0412\\u0441\\u0435 \\u0432\\u0438\\u0434\\u044b \\u043d\\u0430\\u0431\\u043e\\u0440\\u0430 \\u2014 \\u043e\\u0434\\u0438\\u043d \\u0440\\u0430\\u0437\\u043c\\u0435\\u0440 \\u0438 \\u0430\\u0441\\u043f\\u0435\\u043a\\u0442; \\u043e\\u0434\\u0438\\u043d \\u0440\\u043e\\u0432\\u043d\\u044b\\u0439 \\u043d\\u0435\\u0439\\u0442\\u0440\\u0430\\u043b\\u044c\\u043d\\u044b\\u0439 \\u0442\\u0451\\u043c\\u043d\\u043e-\\u0441\\u0435\\u0440\\u044b\\u0439 \\u0444\\u043e\\u043d; \\u0444\\u0438\\u0433\\u0443\\u0440\\u0430 \\u0441 \\u043f\\u043e\\u0434\\u0441\\u0442\\u0430\\u0432\\u043a\\u043e\\u0439 \\u0446\\u0435\\u043b\\u0438\\u043a\\u043e\\u043c.\n- \\u0420\\u0430\\u0437\\u043c\\u0435\\u0449\\u0435\\u043d\\u0438\\u0435 \\u0432 % \\u043a\\u0430\\u0434\\u0440\\u0430 \\u043e\\u0434\\u0438\\u043d\\u0430\\u043a\\u043e\\u0432\\u043e \\u0432\\u043e \\u0432\\u0441\\u0435\\u0445 \\u0432\\u0438\\u0434\\u0430\\u0445: \\u0446\\u0435\\u043d\\u0442\\u0440 \\u043f\\u043e\\u0434\\u0441\\u0442\\u0430\\u0432\\u043a\\u0438 \\u043f\\u043e x, \\u043d\\u0438\\u0437 \\u043f\\u043e\\u0434\\u0441\\u0442\\u0430\\u0432\\u043a\\u0438 \\u043f\\u043e y, \\u0432\\u0435\\u0440\\u0445\\u043d\\u044f\\u044f \\u0442\\u043e\\u0447\\u043a\\u0430 \\u043f\\u043e y. \\u041d\\u0430 1a \\u2014\n  \\u0444\\u0438\\u043a\\u0441\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u043d\\u044b\\u0435 \\u0447\\u0438\\u0441\\u043b\\u0430 \\u044f\\u0434\\u0440\\u0430: \\u043f\\u043e\\u0434\\u0441\\u0442\\u0430\\u0432\\u043a\\u0430 \\u043f\\u043e \\u0446\\u0435\\u043d\\u0442\\u0440\\u0443, \\u043d\\u0438\\u0437 \\u043d\\u0430 y 93 %, \\u0432\\u0435\\u0440\\u0445\\u043d\\u044f\\u044f \\u0442\\u043e\\u0447\\u043a\\u0430 \\u043d\\u0435 \\u0432\\u044b\\u0448\\u0435 y 4 %, \\u0442\\u043e \\u0435\\u0441\\u0442\\u044c \\u0435\\u0451 y \\u2265 4 %\n  (\\u043d\\u0435 \\u0431\\u043b\\u0438\\u0436\\u0435 4 % \\u0432\\u044b\\u0441\\u043e\\u0442\\u044b \\u043a \\u0432\\u0435\\u0440\\u0445\\u043d\\u0435\\u043c\\u0443 \\u043a\\u0440\\u0430\\u044e; \\u043d\\u0430\\u0440\\u0443\\u0448\\u0435\\u043d\\u0438\\u0435 \\u2014 WARN `view.frame_top` \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043a\\u0438 \\u0441 `--min-top-pct 4`, \\u0440\\u0430\\u0437\\u0434\\u0435\\u043b 4.3;\n  \\u0436\\u0438\\u0432\\u043e\\u0439 \\u0442\\u0435\\u0441\\u0442 2026-10-09 \\u0434\\u0430\\u043b 3,3 %) (\\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u0441\\u043a\\u0438\\u043b\\u043b\\u0430 \\u043f\\u043e\n  \\u043f\\u0440\\u0438\\u043d\\u044f\\u0442\\u044b\\u043c \\u043d\\u0430\\u0431\\u043e\\u0440\\u0430\\u043c `hero-quality-v1/*/prompts.md`: \\u0432\\u0435\\u0440\\u0445 \\u043c\\u0435\\u0447\\u0430 Arthur y 3\\u20134,2 %; \\u043d\\u0438\\u0437 \\u043f\\u043e\\u0434\\u0441\\u0442\\u0430\\u0432\\u043a\\u0438 \\u043e\\u0442 y 90,2 % \\u0443 Harpy \\u0434\\u043e\n  y 96,8 % \\u0443 Medusa). \\u041d\\u0430 1c \\u2014 \\u0447\\u0438\\u0441\\u043b\\u0430 \\u0438\\u0437 `ortho-framing.json` \\u0448\\u0430\\u0433\\u0430 1b (\\u043c\\u0430\\u043f\\u043f\\u0438\\u043d\\u0433 \\u2014 \\u0440\\u0430\\u0437\\u0434\\u0435\\u043b 7, \\u043f. 5): \\u0432\\u0441\\u0435 \\u043e\\u0440\\u0442\\u043e \\u0441\\u043d\\u044f\\u0442\\u044b \\u043e\\u0434\\u043d\\u043e\\u0439\n  \\u043a\\u0430\\u043c\\u0435\\u0440\\u043e\\u0439 \\u0438 \\u043e\\u0434\\u043d\\u0438\\u043c \\u043c\\u0430\\u0441\\u0448\\u0442\\u0430\\u0431\\u043e\\u043c, \\u043f\\u043e\\u044d\\u0442\\u043e\\u043c\\u0443 y-\\u0447\\u0438\\u0441\\u043b\\u0430 \\u0438 \\u0446\\u0435\\u043d\\u0442\\u0440 \\u043f\\u043e\\u0434\\u0441\\u0442\\u0430\\u0432\\u043a\\u0438 \\u0443 \\u0432\\u0441\\u0435\\u0445 \\u0432\\u0438\\u0434\\u043e\\u0432 \\u043e\\u0431\\u0449\\u0438\\u0435, \\u043f\\u043e \\u0432\\u0438\\u0434\\u0430\\u043c \\u0440\\u0430\\u0437\\u043b\\u0438\\u0447\\u0430\\u0435\\u0442\\u0441\\u044f \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u0448\\u0438\\u0440\\u0438\\u043d\\u0430\n  \\u043f\\u043e\\u0434\\u0441\\u0442\\u0430\\u0432\\u043a\\u0438.\n- \\u0420\\u043e\\u0441\\u0442 \\u0432 \\u043f\\u0438\\u043a\\u0441\\u0435\\u043b\\u044f\\u0445 \\u043d\\u0435 \\u043d\\u043e\\u0440\\u043c\\u0438\\u0440\\u0443\\u0435\\u0442\\u0441\\u044f. \\u041f\\u0440\\u043e\\u0432\\u0435\\u0440\\u044f\\u0435\\u0442\\u0441\\u044f \\u0440\\u0430\\u0437\\u0431\\u0440\\u043e\\u0441 \\u0440\\u043e\\u0441\\u0442\\u0430 \\u043c\\u0435\\u0436\\u0434\\u0443 \\u0432\\u0438\\u0434\\u0430\\u043c\\u0438: > 3 % \\u2014 WARN, > 5 % \\u2014 FAIL (\\u0440\\u0430\\u0437\\u0434\\u0435\\u043b 4.3).\n  \\u0420\\u043e\\u0441\\u0442 = \\u043d\\u0438\\u0437 \\u043f\\u043e\\u0434\\u0441\\u0442\\u0430\\u0432\\u043a\\u0438 \\u2212 \\u0432\\u0435\\u0440\\u0445 \\u043c\\u0430\\u0441\\u043a\\u0438 \\u043f\\u043e \\u0432\\u0441\\u0435\\u0439 \\u043c\\u0430\\u0441\\u043a\\u0435, \\u0432\\u043a\\u043b\\u044e\\u0447\\u0430\\u044f \\u043e\\u0440\\u0443\\u0436\\u0438\\u0435. \\u0412\\u0435\\u0440\\u0445\\u043d\\u044f\\u044f \\u0442\\u043e\\u0447\\u043a\\u0430 \\u0436\\u0451\\u0441\\u0442\\u043a\\u043e\\u0439 \\u0444\\u0438\\u0433\\u0443\\u0440\\u044b \\u0432 \\u0433\\u043e\\u0440\\u0438\\u0437\\u043e\\u043d\\u0442\\u0430\\u043b\\u044c\\u043d\\u043e\\u0439\n  \\u043e\\u0440\\u0442\\u043e\\u043f\\u0440\\u043e\\u0435\\u043a\\u0446\\u0438\\u0438 \\u043e\\u0434\\u043d\\u0430 \\u0438 \\u0442\\u0430 \\u0436\\u0435 \\u0432\\u043e \\u0432\\u0441\\u0435\\u0445 \\u0432\\u0438\\u0434\\u0430\\u0445, \\u043f\\u043e\\u044d\\u0442\\u043e\\u043c\\u0443 \\u043e\\u0440\\u0443\\u0436\\u0438\\u0435 \\u0432\\u044b\\u0448\\u0435 \\u0433\\u043e\\u043b\\u043e\\u0432\\u044b (\\u043b\\u0443\\u043a, \\u043f\\u043e\\u0441\\u043e\\u0445) \\u0438\\u0437\\u043c\\u0435\\u0440\\u0435\\u043d\\u0438\\u0435 \\u043d\\u0435 \\u043b\\u043e\\u043c\\u0430\\u0435\\u0442.\n- \\u0421\\u0435\\u0442\\u043a\\u0438 \\u0432 \\u0444\\u0430\\u0439\\u043b\\u0430\\u0445 \\u0432\\u0438\\u0434\\u043e\\u0432 \\u043d\\u0435\\u0442. \\u0421\\u0435\\u0442\\u043a\\u0430 \\u2014 \\u043d\\u0430 \\u043b\\u0438\\u0441\\u0442\\u0435 \\u043f\\u0440\\u0438\\u0451\\u043c\\u043a\\u0438 `sheet-<key>.png`, \\u043a\\u043e\\u0442\\u043e\\u0440\\u044b\\u0439 \\u0440\\u0438\\u0441\\u0443\\u0435\\u0442 `check_concept_views.py --sheet`:\n  \\u0432\\u0438\\u0434\\u044b \\u0432 \\u0440\\u044f\\u0434 \\u043f\\u043e \\u043e\\u0431\\u0449\\u0435\\u0439 \\u043b\\u0438\\u043d\\u0438\\u0438 \\u0437\\u0435\\u043c\\u043b\\u0438, \\u043d\\u0430\\u043f\\u0440\\u0430\\u0432\\u043b\\u044f\\u044e\\u0449\\u0438\\u0435 `#00C8FF` \\u0447\\u0435\\u0440\\u0435\\u0437 \\u0432\\u0441\\u0435 \\u0432\\u0438\\u0434\\u044b, \\u043b\\u0438\\u043d\\u0435\\u0439\\u043a\\u0430 \\u0432 % \\u0432\\u044b\\u0441\\u043e\\u0442\\u044b \\u043a\\u0430\\u0434\\u0440\\u0430, \\u0441\\u0432\\u043e\\u0442\\u0447\\u0438 \\u043f\\u0430\\u043b\\u0438\\u0442\\u0440\\u044b \\u0441\n  hex. \\u0421\\u0435\\u0442\\u043a\\u0430 scratch-\\u043f\\u043e\\u0442\\u043e\\u043a\\u0430 (1 \\u0441\\u043c / 5 \\u0441\\u043c, `docs/art-pipeline/SCRATCH-MODEL-PIPELINE.md:137`) \\u0441\\u044e\\u0434\\u0430 \\u043d\\u0435 \\u043f\\u0435\\u0440\\u0435\\u043d\\u043e\\u0441\\u0438\\u0442\\u0441\\u044f: \\u0442\\u0430\\u043c\n  \\u0441\\u0435\\u0442\\u043a\\u0430 \\u043d\\u0443\\u0436\\u043d\\u0430 \\u0434\\u043b\\u044f \\u0447\\u0435\\u0440\\u0442\\u0435\\u0436\\u0430 \\u043f\\u043e \\u0441\\u0430\\u043d\\u0442\\u0438\\u043c\\u0435\\u0442\\u0440\\u0430\\u043c, \\u0437\\u0434\\u0435\\u0441\\u044c \\u0432\\u0438\\u0434\\u044b \\u0440\\u0438\\u0441\\u0443\\u044e\\u0442\\u0441\\u044f \\u043f\\u043e\\u0432\\u0435\\u0440\\u0445 \\u043e\\u0440\\u0442\\u043e\\u043f\\u0440\\u043e\\u0435\\u043a\\u0446\\u0438\\u0438 \\u0438 \\u0441\\u0435\\u0442\\u043a\\u0430 \\u0432 \\u0432\\u0438\\u0434\\u0435 \\u043d\\u0435 \\u043d\\u0443\\u0436\\u043d\\u0430.\n\n### 4.3 \\u0410\\u0432\\u0442\\u043e\\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043a\\u0438 \\u0438 \\u0434\\u043e\\u043f\\u0443\\u0441\\u043a\\u0438\n\n```bash\nexport PYTHONIOENCODING=utf-8   # \\u0441\\u0442\\u0440\\u0430\\u0445\\u043e\\u0432\\u043a\\u0430 \\u0434\\u043b\\u044f \\u0447\\u0442\\u0435\\u043d\\u0438\\u044f \\u043a\\u0438\\u0440\\u0438\\u043b\\u043b\\u0438\\u0446\\u044b; \\u0438\\u043d\\u0441\\u0442\\u0440\\u0443\\u043c\\u0435\\u043d\\u0442 \\u0441\\u0430\\u043c \\u043f\\u0435\\u0440\\u0435\\u043a\\u043b\\u044e\\u0447\\u0430\\u0435\\u0442 \\u0432\\u044b\\u0432\\u043e\\u0434 \\u043d\\u0430 UTF-8\npython tools/art/concept/check_concept_views.py --set art/imagegen/concept-<key>-codex --key <key> \\\n    --views front,side,back --role hero --palette art/imagegen/concept-<key>-codex/palette.json --sheet\n# \\u0447\\u0438\\u0442\\u0430\\u0435\\u0442 <set>/<key>-<view>.png (\\u043d\\u0435 \\u043c\\u0435\\u043d\\u044f\\u0435\\u0442); \\u043f\\u0438\\u0448\\u0435\\u0442 <set>/checks-report.json (unmatched.concept-checks/1)\n# \\u0438 <set>/sheet-<key>.png; \\u043a\\u043e\\u0434 0 = 0 FAIL, 1 = \\u0435\\u0441\\u0442\\u044c FAIL, 2 = \\u043e\\u0448\\u0438\\u0431\\u043a\\u0430 \\u0432\\u0445\\u043e\\u0434\\u0430 \\u0438\\u043b\\u0438 \\u0441\\u0431\\u043e\\u0439 \\u0438\\u043d\\u0441\\u0442\\u0440\\u0443\\u043c\\u0435\\u043d\\u0442\\u0430\n```\n\n\\u041a\\u043e\\u0434 2 \\u2014 \\u043d\\u0435 FAIL \\u043d\\u0430\\u0431\\u043e\\u0440\\u0430: \\u0432\\u0438\\u0434\\u044b \\u043d\\u0435 \\u043f\\u0435\\u0440\\u0435\\u0433\\u0435\\u043d\\u0435\\u0440\\u0438\\u0440\\u0443\\u044e\\u0442\\u0441\\u044f, \\u0442\\u0435\\u043a\\u0441\\u0442 \\u043e\\u0448\\u0438\\u0431\\u043a\\u0438 (stderr) \\u0438\\u0434\\u0451\\u0442 \\u0432 `verification.json`, \\u0440\\u0430\\u0437\\u0431\\u0438\\u0440\\u0430\\u0435\\u0442\n\\u0437\\u0430\\u043f\\u0443\\u0441\\u043a\\u0430\\u044e\\u0449\\u0438\\u0439 \\u0430\\u0433\\u0435\\u043d\\u0442. \\u041f\\u0430\\u0439\\u043f cp1251 (Codex \\u0447\\u0435\\u0440\\u0435\\u0437 PowerShell, Git Bash \\u0430\\u0433\\u0435\\u043d\\u0442\\u0430) \\u0438\\u043d\\u0441\\u0442\\u0440\\u0443\\u043c\\u0435\\u043d\\u0442 \\u043d\\u0435 \\u0440\\u043e\\u043d\\u044f\\u0435\\u0442: `main()` \\u043f\\u0435\\u0440\\u0435\\u043a\\u043b\\u044e\\u0447\\u0430\\u0435\\u0442\nstdout/stderr \\u043d\\u0430 UTF-8, \\u043d\\u0435\\u043f\\u043e\\u0439\\u043c\\u0430\\u043d\\u043d\\u044b\\u0439 \\u0441\\u0431\\u043e\\u0439 \\u0434\\u0430\\u0451\\u0442 \\u043a\\u043e\\u0434 2 (\\u0442\\u0435\\u0441\\u0442\\u044b `tools/art/concept/tests`, `test_cli_cp1251_*`).\n\n`--role`: `hero` (humanoid), `creature` (winged-biped), `prop`. `--views`: \\u043d\\u0430\\u0431\\u043e\\u0440 \\u0438\\u0437 \\u0440\\u0430\\u0437\\u0434\\u0435\\u043b\\u0430 4.1. \\u0414\\u043b\\u044f \\u043e\\u0434\\u043d\\u043e\\u0433\\u043e \\u0432\\u0438\\u0434\\u0430\n(\\u0434\\u0438\\u0437\\u0430\\u0439\\u043d 1a, \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043a\\u0430 \\u043a\\u0430\\u043d\\u0434\\u0438\\u0434\\u0430\\u0442\\u0430 1c) \\u2014 `--views <\\u0432\\u0438\\u0434>` \\u0441 `--set` \\u043f\\u0430\\u043f\\u043a\\u0438 \\u044d\\u0442\\u043e\\u0433\\u043e \\u0432\\u0438\\u0434\\u0430. `--out <\\u043a\\u0430\\u0442\\u0430\\u043b\\u043e\\u0433>` \\u2014 \\u043a\\u0443\\u0434\\u0430 \\u043f\\u0438\\u0441\\u0430\\u0442\\u044c \\u043e\\u0442\\u0447\\u0451\\u0442\n(\\u043a\\u0430\\u043d\\u0434\\u0438\\u0434\\u0430\\u0442 \\u2014 `checks/<view>-g<N>/`, \\u043f\\u0435\\u0440\\u0435\\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043a\\u0430 \\u0437\\u0430\\u043f\\u0443\\u0441\\u043a\\u0430\\u044e\\u0449\\u0435\\u0433\\u043e \\u2014 \\u0432\\u043d\\u0435 \\u043f\\u0430\\u043a\\u0435\\u0442\\u0430; \\u0440\\u0430\\u0437\\u0434\\u0435\\u043b 3, 5.5). `--min-top-pct 4` \\u2014 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e\n\\u043d\\u0430 1a: \\u0440\\u0430\\u043c\\u043a\\u0430 \\u044f\\u0434\\u0440\\u0430 CORE-1A, WARN `view.frame_top` (`tools/art/concept/README.md`).\n\n\\u0414\\u043e\\u043f\\u0443\\u0441\\u043a\\u0438 \\u0434\\u0432\\u0443\\u0445\\u0441\\u0442\\u0443\\u043f\\u0435\\u043d\\u0447\\u0430\\u0442\\u044b\\u0435 (\\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u0441\\u043a\\u0438\\u043b\\u043b\\u0430): \\u0438\\u0441\\u0445\\u043e\\u0434\\u043d\\u043e\\u0435 \\u0447\\u0438\\u0441\\u043b\\u043e \\u2014 \\u043f\\u043e\\u0440\\u043e\\u0433 WARN, FAIL \\u2014 \\u043d\\u0430\\u0431\\u043b\\u044e\\u0434\\u0430\\u0435\\u043c\\u044b\\u0439 \\u043c\\u0430\\u043a\\u0441\\u0438\\u043c\\u0443\\u043c \\u0447\\u0435\\u0442\\u044b\\u0440\\u0451\\u0445 \\u043f\\u0440\\u0438\\u043d\\u044f\\u0442\\u044b\\u0445 \\u043d\\u0430\\u0431\\u043e\\u0440\\u043e\\u0432\n`art/imagegen/hero-quality-v1/` \\u043f\\u043b\\u044e\\u0441 \\u0437\\u0430\\u043f\\u0430\\u0441 (\\u043a\\u0430\\u043b\\u0438\\u0431\\u0440\\u043e\\u0432\\u043a\\u0430 2026-10-09; \\u0432\\u0441\\u0435 \\u0447\\u0435\\u0442\\u044b\\u0440\\u0435 \\u043d\\u0430\\u0431\\u043e\\u0440\\u0430 \\u0434\\u0430\\u044e\\u0442 0 FAIL). \\u0418\\u0441\\u0442\\u043e\\u0447\\u043d\\u0438\\u043a \\u0447\\u0438\\u0441\\u0435\\u043b \\u2014\n`TOLERANCES` \\u0432 `tools/art/concept/check_concept_views.py:36` \\u0438 \\u0442\\u0430\\u0431\\u043b\\u0438\\u0446\\u0430 \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043e\\u043a `tools/art/concept/README.md`; \\u043f\\u0440\\u0438\n\\u0440\\u0430\\u0441\\u0445\\u043e\\u0436\\u0434\\u0435\\u043d\\u0438\\u0438 \\u0441 \\u044d\\u0442\\u043e\\u0439 \\u0442\\u0430\\u0431\\u043b\\u0438\\u0446\\u0435\\u0439 \\u0434\\u0435\\u0439\\u0441\\u0442\\u0432\\u0443\\u0435\\u0442 \\u0438\\u043d\\u0441\\u0442\\u0440\\u0443\\u043c\\u0435\\u043d\\u0442 (`tolerances` \\u0432 `checks-report.json`).\n\n| \\u041f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043a\\u0430 (`id` \\u0432 \\u043e\\u0442\\u0447\\u0451\\u0442\\u0435) | WARN | FAIL |\n|---|---|---|\n| \\u0420\\u0430\\u0437\\u043c\\u0435\\u0440 \\u0432\\u0438\\u0434\\u043e\\u0432 (`set.size`, `set.size_exact`) | \\u0440\\u0430\\u0437\\u043b\\u0438\\u0447\\u0438\\u0435 \\u0445\\u043e\\u0442\\u044c \\u043d\\u0430 1 px | \\u0440\\u0430\\u0437\\u043b\\u0438\\u0447\\u0438\\u0435 > 0,5 % \\u043f\\u043e \\u0441\\u0442\\u043e\\u0440\\u043e\\u043d\\u0435 |\n| \\u0420\\u0430\\u043c\\u043a\\u0430 2 % \\u043a\\u043e\\u0440\\u043e\\u0442\\u043a\\u043e\\u0439 \\u0441\\u0442\\u043e\\u0440\\u043e\\u043d\\u044b (`view.border_uniform`) | < 99 % \\u0440\\u0430\\u043c\\u043a\\u0438 \\u0432 \\u00b112 \\u043e\\u0442 \\u043c\\u0435\\u0434\\u0438\\u0430\\u043d\\u044b | < 99 % \\u0440\\u0430\\u043c\\u043a\\u0438 \\u0432 \\u00b120 |\n| \\u0424\\u043e\\u043d \\u043d\\u0435\\u0439\\u0442\\u0440\\u0430\\u043b\\u044c\\u043d\\u044b\\u0439 (`view.bg_neutral`) | \\u2014 | \\|R\\u2212G\\| \\u0438\\u043b\\u0438 \\|G\\u2212B\\| \\u043c\\u0435\\u0434\\u0438\\u0430\\u043d\\u044b \\u0440\\u0430\\u043c\\u043a\\u0438 > 6 |\n| \\u0424\\u043e\\u043d \\u0442\\u0451\\u043c\\u043d\\u043e-\\u0441\\u0435\\u0440\\u044b\\u0439 (`view.bg_dark