ass` \\u043f\\u043e\\u043b\\u0435 \\u043d\\u0435 \\u043f\\u0438\\u0448\\u0435\\u0442\\u0441\\u044f |\n| `rework_fix_list` | \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e F, T, D \\u043d\\u0438\\u0436\\u0435 2 \\u0438 FAIL-\\u0433\\u0435\\u0439\\u0442\\u044b (S \\u043d\\u0438\\u043a\\u043e\\u0433\\u0434\\u0430: \\u0432 Blender \\u043d\\u0435 \\u043f\\u0440\\u0430\\u0432\\u0438\\u0442\\u0441\\u044f, \\u0432\\u0430\\u043b\\u0438\\u0434\\u0430\\u0442\\u043e\\u0440 \\u043e\\u0442\\u0432\\u0435\\u0440\\u0433\\u0430\\u0435\\u0442); \\u043f\\u0443\\u043d\\u043a\\u0442 = `{item, frame, fix, tool}`, \\u0434\\u0440\\u0443\\u0433\\u0438\\u0445 \\u043a\\u043b\\u044e\\u0447\\u0435\\u0439 \\u043d\\u0435\\u0442; `item` \\u2014 `F`, `T`, `D` \\u0438\\u043b\\u0438 id \\u0433\\u0435\\u0439\\u0442\\u0430 (`G-UV`). \\u041f\\u0440\\u0438 `rework_blender` \\u2014 \\u043d\\u0435 \\u043f\\u0443\\u0441\\u0442\\u043e\\u0439 \\u0438 \\u043f\\u043e\\u043a\\u0440\\u044b\\u0432\\u0430\\u0435\\u0442 \\u043a\\u0430\\u0436\\u0434\\u044b\\u0439 FAIL-\\u0433\\u0435\\u0439\\u0442, \\u043a\\u0430\\u0436\\u0434\\u043e\\u0435 \\u0438\\u0437\\u043c\\u0435\\u0440\\u0435\\u043d\\u0438\\u0435 < 1,0, \\u0430 \\u043f\\u0440\\u0438 `score` < 8,0 \\u2014 \\u043a\\u0430\\u0436\\u0434\\u043e\\u0435 \\u0438\\u0437 F, T, D \\u043d\\u0438\\u0436\\u0435 2,0 (`validate_card.py`). \\u041f\\u0440\\u0438 `pass` \\u0438 \\u043f\\u0440\\u0438 \\u0432\\u043e\\u0437\\u0432\\u0440\\u0430\\u0442\\u0435 \\u043f\\u043e S (\\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u043e 1) \\u2014 \\u043f\\u0443\\u0441\\u0442\\u043e\\u0439 \\u043c\\u0430\\u0441\\u0441\\u0438\\u0432. \\u0423 \\u0430\\u0441\\u0441\\u0435\\u0442\\u0430, \\u0441\\u043e\\u0431\\u0440\\u0430\\u043d\\u043d\\u043e\\u0433\\u043e \\u0444\\u043e\\u0440\\u043a\\u043e\\u043c (`h2_bake_arthur` \\u0438 \\u0442. \\u043f.), `tool` \\u0443\\u043a\\u0430\\u0437\\u044b\\u0432\\u0430\\u0435\\u0442 \\u043a\\u043b\\u044e\\u0447 **\\u0433\\u0435\\u043d\\u0435\\u0440\\u0438\\u0447\\u0435\\u