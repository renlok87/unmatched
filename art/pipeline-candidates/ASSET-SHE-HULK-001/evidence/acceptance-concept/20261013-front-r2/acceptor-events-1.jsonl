\u0438\\u0447\\u0435\\u0441\\u043a\\u0438 \\u043d\\u0430\\u0440\\u0438\\u0441\\u043e\\u0432\\u0430\\u043d** (`SIDE_VIEW`). `left` \\u2014\n\\u0441\\u043e\\u0431\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u044b\\u0439 \\u043b\\u0435\\u0432\\u044b\\u0439 \\u0431\\u043e\\u043a \\u0444\\u0438\\u0433\\u0443\\u0440\\u044b \\u043a \\u043a\\u0430\\u043c\\u0435\\u0440\\u0435, \\u043b\\u0438\\u0446\\u043e \\u043a \\u043b\\u0435\\u0432\\u043e\\u043c\\u0443 \\u043a\\u0440\\u0430\\u044e \\u043a\\u0430\\u0434\\u0440\\u0430; `right` \\u2014 \\u0437\\u0435\\u0440\\u043a\\u0430\\u043b\\u044c\\u043d\\u043e. \\u041b\\u0435\\u0432\\u044b\\u0439 \\u0432\\u0438\\u0434 \\u0432 \\u0441\\u043b\\u043e\\u0442 RIGHT (\\u0438\n\\u043d\\u0430\\u043e\\u0431\\u043e\\u0440\\u043e\\u0442) \\u0437\\u0430\\u043f\\u0440\\u0435\\u0449\\u0451\\u043d: Tripo \\u0441\\u0442\\u0440\\u043e\\u0438\\u0442 \\u0444\\u0430\\u043d\\u0442\\u043e\\u043c\\u044b. \\u0414\\u043e\\u043a\\u0430\\u0437\\u0430\\u0442\\u0435\\u043b\\u044c\\u0441\\u0442\\u0432\\u0430: HANDBOOK \\u00a73.2 \\u043f. 3 (\\u0432\\u0442\\u043e\\u0440\\u043e\\u0439 \\u043c\\u0435\\u0447, \\u0432\\u0442\\u043e\\u0440\\u0430\\u044f \\u0440\\u0443\\u043a\\u0430 \\u0438 \\u043b\\u0438\\u0446\\u043e \\u0443\nArthur, \\u0434\\u0432\\u0443\\u043b\\u0438\\u043a\\u0430\\u044f \\u0433\\u043e\\u043b\\u043e\\u0432\\u0430 \\u0443 Harpy); `art/pipeline-candidates/ASSET-HARPY-001/source-specs/tripo-bca735a3-h3.json`\n`slot_note` (\\u043b\\u0435\\u0432\\u044b\\u0439 \\u0432\\u0438\\u0434 \\u0432 RIGHT \\u0443 H2 330872a3 \\u2192 \\u0434\\u0432\\u0443\\u043b\\u0438\\u043a\\u0430\\u044f \\u0433\\u043e\\u043b\\u043e\\u0432\\u0430; H3 \\u0441 \\u0442\\u0435\\u043c \\u0436\\u0435 \\u0432\\u0438\\u0434\\u043e\\u043c \\u0432 LEFT \\u2014 \\u0431\\u0435\\u0437 \\u0434\\u0435\\u0444\\u0435\\u043a\\u0442\\u0430). \\u0421\\u043e\\u0433\\u043b\\u0430\\u0448\\u0435\\u043d\\u0438\\u0435\n\\u00ab`left` = \\u043b\\u0435\\u0432\\u044b\\u0439 \\u0431\\u043e\\u043a \\u043f\\u0435\\u0