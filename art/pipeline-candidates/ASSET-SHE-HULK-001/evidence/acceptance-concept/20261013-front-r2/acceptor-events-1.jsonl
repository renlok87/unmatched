u0441\\u044f.\n2. `accepted_object` = `frames.json#accepted_object` (SK, SM \\u0438 2K-\\u043a\\u0430\\u0440\\u0442\\u044b \\u0441 sha256 \\u0441\\u0447\\u0438\\u0442\\u0430\\u0435\\u0442 \\u0441\\u044a\\u0451\\u043c\\u043a\\u0430; \\u0443 \\u0433\\u0435\\u0440\\u043e\\u044f \\u0431\\u0435\\u0437\n   \\u043a\\u0430\\u043a\\u043e\\u0439-\\u043b\\u0438\\u0431\\u043e \\u043a\\u0430\\u0440\\u0442\\u044b \\u2014 WARN `accepted_object: \\u043d\\u0435\\u0442 2K-\\u043a\\u0430\\u0440\\u0442 \\u2026`, \\u044d\\u0442\\u043e \\u0434\\u0435\\u0444\\u0435\\u043a\\u0442 \\u044d\\u0442\\u0430\\u043f\\u0430 3). \\u041f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043a\\u0430 \\u0432\\u0440\\u0443\\u0447\\u043d\\u0443\\u044e, \\u0435\\u0441\\u043b\\u0438 \\u043d\\u0443\\u0436\\u043d\\u0430:\n   ```bash\n   sha256sum $LD/export/SK_<Key>_H2LD.fbx $LD/export/SM_<Key>_H2LD_Base.fbx \\\n       $LD/textures/T_<Key>_H2LD_2K_{BC,N,ORM,MatID,Edge}.png $LD/textures/T_<Key>_H2LD_TeamAccent_2K.png\n   ```\n3. \\u0417\\u0430\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u044c \\u043f\\u0440\\u043e\\u043c\\u043f\\u0442 \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a\\u0430 \\u00a78.2 \\u0438 \\u0441\\u043e\\u0445\\u0440\\u0430\\u043d\\u0438\\u0442\\u044c \\u0435\\u0433\\u043e \\u043a\\u0430\\u043a `$E/acceptor-prompt.md` (\\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u0441\\u043a\\u0438\\u043b\\u043b\\u0430: \\u043f\\u0440\\u043e\\u043c\\u043f\\u0442 \\u0445\\u0440\\u0430\\u043d\\u0438\\u0442\\u0441\\u044f \\u0440\\u044f\\u0434\\u043e\\u043c \\u0441\n   \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u043e\\u0439, \\u0447\\u0442\\u043e\\u0431\\u044b \\u043f\\u0440\\u0438\\u0451\\u043c\\u043a\\u0443 \\u043c\\u043e\\u0436\\u043d\\u043e \\u0431\\u044b\\u043b\\u043e \\u043f\\u043e\\u0432\\u0442\\u043e\\u0440\\u0438\\u0442\\u044c). `{{ACCEPTOR_PROFILE}}` \\u2014 \\u0441\\u0442\\u0440\\u043e\\u043a\\u0430 enum \\u0441\\u0445\\u0435\\u043c\\u044b, \\u0430 \\u043d\\u0435 \\u0437\\u043d\\u0430\\u0447\\u0435\\u043d\\u0438\\u0435 \\u0437\\u0430\\u044f\\u0432\\u043a\\u0438:\n   `opus-xhigh` \\u2192 `Opus xhigh`, `sol-6.1-xhigh` \\u2192 `Sol 6.1 xhigh`. `{{FRAMES_FILES_JSON}}` \\u2014 JSON-\\u043c\\u0430\\u0441\\u0441\\u0438\\u0432\n   `frames.json#files` (\\u0442\\u0430\\u043c \\u0443\\u0436\\u0435 \\u0435\\u0441\\u0442\\u044c `frames.json`, `sheet.png`, `compare-*` \\u0438, \\u0435\\u0441\\u043b\\u0438 \\u0441\\u043e\\u0437\\u0434\\u0430\\u043d, `tone.json`). \\u0412\\u0441\\u0435\n   \\u043f\\u043b\\u0435\\u0439\\u0441\\u0445\\u043e\\u043b\\u0434\\u0435\\u0440\\u044b \\u0437\\u0430\\u043f\\u043e\\u043b\\u043d\\u044f\\u044e\\u0442\\u0441\\u044f \\u0434\\u043e \\u0432\\u044b\\u0437\\u043e\\u0432\\u0430; \\u043d\\u0435\\u0437\\u0430\\u043f\\u043e\\u043b\\u043d\\u0435\\u043d\\u043d\\u044b\\u0439 `{{\\u2026}}` \\u0432 \\u043f\\u0440\\u043e\\u043c\\u043f\\u0442\\u0435 \\u2014 \\u043e\\u0448\\u0438\\u0431\\u043a\\u0430 \\u0437\\u0430\\u043f\\u0443\\u0441\\u043a\\u0430\\u044e\\u0449\\u0435\\u0433\\u043e, \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a\\u0430 \\u043d\\u0435 \\u0432\\u044b\\u0437\\u044b\\u0432\\u0430\\u0442\\u044c.\n4. \\u0412\\u044b\\u0437\\u0432\\u0430\\u0442\\u044c \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a\\u0430 \\u0432\\u044b\\u0431\\u0440\\u0430\\u043d\\u043d\\u044b\\u043c \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u0435\\u043c (\\u00a78.3 \\u0438\\u043b\\u0438 \\u00a78.4). \\u041f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a \\u0432\\u043e\\u0437\\u0432\\u0440\\u0430\\u0449\\u0430\\u0435\\u0442 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e JSON.\n5. \\u0417\\u0430\\u043f\\u0438\\u0441\\u0430\\u0442\\u044c \\u043e\\u0442\\u0432\\u0435\\u0442 **\\u0431\\u0435\\u0437 \\u0438\\u0437\\u043c\\u0435\\u043d\\u0435\\u043d\\u0438\\u0439** \\u0432 `$E/card.json` (\\u044d\\u0442\\u043e \\u0434\\u0435\\u043b\\u0430\\u0435\\u0442 \\u0437\\u0430\\u043f\\u0443\\u0441\\u043a\\u0430\\u044e\\u0449\\u0438\\u0439, \\u043d\\u0435 \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a). \\u0415\\u0434\\u0438\\u043d\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u0430\\u044f \\u0440\\u0430\\u0437\\u0440\\u0435\\u0448\\u0451\\u043d\\u043d\\u0430\\u044f\n   \\u043f\\u0440\\u0430\\u0432\\u043a\\u0430 \\u2014 \\u0443 \\u00abSol 6.1 xhigh\\u00bb: `acceptor.session_id` `codex:pending` \\u2192 `codex:<thread_id>` \\u0438\\u0437 \\u043f\\u0435\\u0440\\u0432\\u043e\\u0433\\u043e \\u0441\\u043e\\u0431\\u044b\\u0442\\u0438\\u044f\n   `acceptor-events*.jsonl` (`{\"type\":\"thread.started\",\"thread_id\":\\u2026}`; \\u00a78.4); \\u0431\\u043e\\u043b\\u044c\\u0448\\u0435 \\u043d\\u0438\\u0447\\u0435\\u0433\\u043e \\u0432 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0435 \\u043d\\u0435 \\u043c\\u0435\\u043d\\u044f\\u0435\\u0442\\u0441\\u044f,\n   \\u043f\\u0440\\u0430\\u0432\\u043a\\u0430 \\u043f\\u0438\\u0448\\u0435\\u0442\\u0441\\u044f \\u0432 \\u043e\\u0442\\u0447\\u0451\\u0442 \\u0437\\u0430\\u043f\\u0443\\u0441\\u043a\\u0430\\u044e\\u0449\\u0435\\u0433\\u043e. \\u0421\\u0431\\u043e\\u0439 \\u043e\\u043a\\u0440\\u0443\\u0436\\u0435\\u043d\\u0438\\u044f Codex (\\u00a78.4, \\u00ab\\u0421\\u0431\\u043e\\u0439 \\u043f\\u0435\\u0441\\u043e\\u0447\\u043d\\u0438\\u0446\\u044b\\u00bb) \\u2014 \\u043d\\u0435 \\u043e\\u0442\\u0432\\u0435\\u0442 \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a\\u0430: \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0443 \\u043d\\u0435\n   \\u0437\\u0430\\u043f\\u0438\\u0441\\u044b\\u0432\\u0430\\u0442\\u044c \\u0438 \\u043d\\u0435 \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u044f\\u0442\\u044c, \\u043f\\u043e\\u043f\\u044b\\u0442\\u043a\\u043e\\u0439 \\u043d\\u0435 \\u0441\\u0447\\u0438\\u0442\\u0430\\u0442\\u044c. \\u0417\\u0430\\u0442\\u0435\\u043c \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u0438\\u0442\\u044c:\n   ```bash\n   python tools/art/acceptance/validate_card.py $E/card.json --print-verdict --check-files\n   ```\n   \\u041a\\u043e\\u0434 0 \\u2014 \\u043a\\u0430\\u