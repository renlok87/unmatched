# King Arthur candidate: transient files (the parent .gitignore only matches */*/work/ etc.)
*/work/
*/pipeline/work/
*/pipeline/.staging/
*/pipeline/run.lock
*.blend1
# H2 Tripo originals (44-77 MB each, >50 MB policy): not committed, pinned by sha256/bytes in
# source-specs/tripo-<task8>-h2.json and 20260929-h2-tripo/reports/tripo-run.json.
20260929-h2-tripo/source/*-tex8k-pbr.glb
20260929-h2-tripo/source/*-parts*.glb
# H2 4K master textures: kept local (reproducible from the local build, sha256 pinned in
# 20260929-h2-bake/reports/textures-report.json); the 2K runtime set is committed.
20260929-h2-bake/textures/master_4k/
20260929-h2-bake/textures/4k/
20260929-h2-bake/textures/*_4K.png
# Look-dev v2 (20260929-h2-lookdev): stage logs/timings and the 4K masters are local only (sha256 pinned in
# 20260929-h2-lookdev/reports/textures-report.json); the 2K runtime set, MatID, TeamAccent, EdgeMask, LUT, FBX, reports,
# UE inputs and previews are committed.
20260929-h2-lookdev/logs/
20260929-h2-lookdev/textures/*_4K.png
# Look-dev C (20260929-h2ld-ue): full-resolution UE review frames (PNG 1920x1080, ~3 MB each; sha256 in review/<tag>/review-<tag>.json
# and in the committed .evidence.json sidecars); the sheets, measurements, class maps and JPEG key frames are committed.
20260929-h2ld-ue/review/*/frames/*.png
