30\\u0446\\u0438\\u044f \\u0441 VFX/SFX \\u0438 \\u0443\\u043f\\u0430\\u043a\\u043e\\u0432\\u043a\\u0430 \\u0441 \\u043f\\u043e\\u0434\\u043a\\u043b\\u044e\\u0447\\u0435\\u043d\\u0438\\u0435\\u043c \\u0432 Unreal. \\u0422\\u0440\\u0438\\u0433\\u0433\\u0435\\u0440\\u044b \\u2014 \\u00ab\\u0441\\u0433\\u0435\\u043d\\u0435\\u0440\\u0438\\u0440\\u0443\\u0439 3D-\\u043c\\u043e\\u0434\\u0435\\u043b\\u044c\\u00bb, \\u00ab\\u043d\\u043e\\u0432\\u044b\\u0439 \\u0433\\u0435\\u0440\\u043e\\u0439 / \\u043f\\u043e\\u043c\\u043e\\u0449\\u043d\\u0438\\u043a / \\u0441\\u0443\\u0449\\u0435\\u0441\\u0442\\u0432\\u043e / \\u043f\\u0440\\u043e\\u043f\\u00bb, \\u00ab\\u043d\\u043e\\u0432\\u0430\\u044f \\u0444\\u0438\\u0433\\u0443\\u0440\\u0430\\u00bb, \\u00ab3D model pipeline\\u00bb, \\u00ab\\u043c\\u043e\\u0434\\u0435\\u043b\\u044c \\u0447\\u0435\\u0440\\u0435\\u0437 Tripo\\u00bb, \\u00ab\\u043a\\u043e\\u043d\\u0446\\u0435\\u043f\\u0442-\\u043b\\u0438\\u0441\\u0442 \\u0433\\u0435\\u0440\\u043e\\u044f\\u00bb. \\u0421\\u0442\\u0430\\u0442\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438\\u0439 \\u043f\\u0440\\u043e\\u043f (\\u0431\\u043e\\u0447\\u043a\\u0430, \\u0444\\u043e\\u043d\\u0430\\u0440\\u044c, \\u044f\\u0449\\u0438\\u043a) \\u2014 \\u0434\\u0430, \\u0434\\u043e \\u0438\\u043c\\u043f\\u043e\\u0440\\u0442\\u0430 \\u0432 UE; \\u0435\\u0433\\u043e \\u0440\\u0430\\u0437\\u043c\\u0435\\u0449\\u0435\\u043d\\u0438\\u0435 \\u0432 \\u0440\\u0430\\u0441\\u043a\\u043b\\u0430\\u0434\\u043a\\u0435 \\u0434\\u043e\\u0441\\u043a\\u0438 \\u2014 \\u043d\\u0435\\u0442. \\u041d\\u0415 \\u0434\\u043b\\u044f \\u043e\\u043a\\u0440\\u0443\\u0436\\u0435\\u043d\\u0438\\u044f, \\u0437\\u0430\\u0434\\u043d\\u0438\\u043a\\u043e\\u0432 \\u0438 \\u0441\\u0446\\u0435\\u043d \\u0434\\u043e\\u0441\\u043e\\u043a \\u0438 \\u0440\\u0430\\u0437\\u043c\\u0435\\u0449\\u0435\\u043d\\u0438\\u044f \\u043f\\u0440\\u043e\\u043f\\u043e\\u0432 \\u0432 EnvLayouts (Marmoreal/Sarpedon \\u2014 \\u0442\\u0440\\u0435\\u043a ENV-MAPS) \\u0438 \\u041d\\u0415 \\u0434\\u043b\\u044f \\u0440\\u0430\\u0437\\u043e\\u0432\\u044b\\u0445 \\u043f\\u0440\\u0430\\u0432\\u043e\\u043a \\u0441\\u0443\\u0449\\u0435\\u0441\\u0442\\u0432\\u0443\\u044e\\u0449\\u0438\\u0445 \\u0430\\u0441\\u0441\\u0435\\u0442\\u043e\\u0432.\",\r\n    \"---\",\r\n    \"\",\r\n    \"# 3d-model-pipeline\",\r\n    \"\",\r\n    \"\\u042d\\u0442\\u043e\\u0442 \\u0444\\u0430\\u0439\\u043b \\u2014 \\u043d\\u0430\\u0432\\u0438\\u0433\\u0430\\u0446\\u0438\\u044f \\u0438 \\u043e\\u0440\\u043a\\u0435\\u0441\\u0442\\u0440\\u0430\\u0446\\u0438\\u044f. \\u0414\\u0435\\u0442\\u0430\\u043b\\u0438 \\u043b\\u0435\\u0436\\u0430\\u0442 \\u0432 `references/` \\u0438 \\u043e\\u0442\\u043a\\u0440\\u044b\\u0432\\u0430\\u044e\\u0442\\u0441\\u044f \\u043d\\u0430 \\u0441\\u0432\\u043e\\u0451\\u043c \\u044d\\u0442\\u0430\\u043f\\u0435. \\u041d\\u043e\\u0440\\u043c\\u0430 \\u043f\\u0440\\u043e\\u0438\\u0437\\u0432\\u043e\\u0434\\u0441\\u0442\\u0432\\u0430\",\r\n    \"\\u0433\\u0435\\u0440\\u043e\\u044f \\u0438 \\u043f\\u0440\\u043e\\u043f\\u0430 \\u2014 `docs/art-pipeline/BLENDER-MODEL-HANDBOOK.md` (\\u0434\\u0430\\u043b\\u0435\\u0435 HANDBOOK). \\u041e\\u043d \\u0433\\u043b\\u0430\\u0432\\u043d\\u0435\\u0435 \\u0441\\u043a\\u0438\\u043b\\u043b\\u0430, \\u0430 \\u0441\\u043a\\u0438\\u043b\\u043b \\u0435\\u0433\\u043e \\u0447\\u0438\\u0441\\u043b\\u0430\",\r\n    \"\\u043d\\u0435 \\u043a\\u043e\\u043f\\u0438\\u0440\\u0443\\u0435\\u0442. \\u041f\\u043e\\u043c\\u0435\\u0442\\u043a\\u0430 \\u00ab\\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u0441\\u043a\\u0438\\u043b\\u043b\\u0430\\u00bb \\u043e\\u0437\\u043d\\u0430\\u0447\\u0430\\u0435\\u0442, \\u0447\\u0442\\u043e \\u0438\\u0441\\u0442\\u043e\\u0447\\u043d\\u0438\\u043a\\u0430 \\u0432 \\u0440\\u0435\\u043f\\u043e \\u043d\\u0435\\u0442 \\u0438 \\u0437\\u043d\\u0430\\u0447\\u0435\\u043d\\u0438\\u0435 \\u0432\\u044b\\u0431\\u0440\\u0430\\u043d\\u043e \\u0437\\u0434\\u0435\\u0441\\u044c \\u043f\\u043e \\u0434\\u0435\\u043b\\u0435\\u0433\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044e\",\r\n    \"(`docs/game-design/decisions/2026-10-06-visual-delegated-decisions.md`, \\u0434\\u0430\\u043b\\u0435\\u0435 \\u00ab\\u0412\\u0420-\\u0440\\u0435\\u0435\\u0441\\u0442\\u0440\\u00bb).\",\r\n    \"\",\r\n    \"## 1. \\u041a\\u043e\\u0433\\u0434\\u0430 \\u0438\\u0441\\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u044c\",\r\n    \"\",\r\n    \"- **\\u0414\\u0430:** \\u043d\\u043e\\u0432\\u0430\\u044f \\u0444\\u0438\\u0433\\u0443\\u0440\\u0430 \\u0434\\u043b\\u044f \\u0438\\u0433\\u0440\\u044b, \\u043e\\u0442 \\u0437\\u0430\\u044f\\u0432\\u043a\\u0438 \\u0434\\u043e `/Game/PipelineCandidates/<Key>/` \\u0438 \\u043a\\u0430\\u0434\\u0440\\u043e\\u0432 \\u0432 packaged-\\u043a\\u043b\\u0438\\u0435\\u043d\\u0442\\u0435. \\u041d\\u043e\\u0432\\u044b\\u0439\",\r\n    \"  \\u0441\\u0442\\u0430\\u0442\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438\\u0439 \\u043f\\u0440\\u043e\\u043f (\\u0431\\u043e\\u0447\\u043a\\u0430, \\u0444\\u043e\\u043d\\u0430\\u0440\\u044c, \\u044f\\u0449\\u0438\\u043a, \\u0434\\u0435\\u043a\\u043e\\u0440 \\u2014 HANDBOOK \\u00a71, \\u0441\\u0442\\u0440\\u043e\\u043a\\u0430 \\u00ab\\u0421\\u0442\\u0430\\u0442\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438\\u0439 \\u043f\\u0440\\u043e\\u043f\\u0441\\u00bb) \\u2014 \\u044d\\u0442\\u0438\\u043c \\u0441\\u043a\\u0438\\u043b\\u043b\\u043e\\u043c \\u0434\\u043e \\u0438\\u043c\\u043f\\u043e\\u0440\\u0442\\u0430 \\u0432\",\r\n    \"  UE (\\u0432\\u0435\\u0442\\u043a\\u0430 `prop`, \\u00a73; `references/ue-import-package.md` \\u00a78).\",\r\n    \"  \\u0417\\u0430\\u043f\\u0443\\u0441\\u043a \\u0441\\u043a\\u0438\\u043b\\u043b\\u0430 \\u0437\\u0430\\u044f\\u0432\\u043a\\u043e\\u0439 \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044f \\u0441\\u0447\\u0438\\u0442\\u0430\\u0435\\u0442\\u0441\\u044f \\u0441\\u043e\\u0433\\u043b\\u0430\\u0441\\u0438\\u0435\\u043c \\u043d\\u0430 Workflow-\\u0430\\u0433\\u0435\\u043d\\u0442\\u043e\\u0432 \\u043f\\u0440\\u0438\\u0451\\u043c\\u043a\\u0438 \\u0438 \\u0434\\u043e\\u0440\\u0430\\u0431\\u043e\\u0442\\u043a\\u0438 (\\u00a74) \\u0438 \\u0440\\u0430\\u0437\\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435\\u043c\",\r\n    \"  \\u0442\\u0440\\u0430\\u0442\\u0438\\u0442\\u044c \\u043a\\u0440\\u0435\\u0434\\u0438\\u0442\\u044b Tripo \\u0438 SYNTX \\u0432 \\u043b\\u0438\\u043c\\u0438\\u0442\\u0435 \\u0412\\u0420-04 \\u0441 \\u0437\\u0430\\u043f\\u0438\\u0441\\u044c\\u044e \\u0432 \\u0436\\u0443\\u0440\\u043d\\u0430\\u043b (\\u00a77.1, \\u0441\\u0442\\u0440\\u043e\\u043a\\u0430 \\u00ab\\u041a\\u0440\\u0435\\u0434\\u0438\\u0442\\u044b\\u00bb). \\u041e\\u0442\\u0434\\u0435\\u043b\\u044c\\u043d\\u043e \\u043e \\u0442\\u0440\\u0430\\u0442\\u0430\\u0445 \\u043d\\u0435\",\r\n    \"  \\u0441\\u043f\\u0440\\u0430\\u0448\\u0438\\u0432\\u0430\\u0442\\u044c: \\u0442\\u0430\\u043a\\u043e\\u0433\\u043e \\u0433\\u0435\\u0439\\u0442\\u0430 \\u0432 \\u00a75 \\u043d\\u0435\\u0442.\",\r\n    \"- **\\u041d\\u0435\\u0442:** \\u043e\\u043a\\u0440\\u0443\\u0436\\u0435\\u043d\\u0438\\u0435, \\u0437\\u0430\\u0434\\u043d\\u0438\\u043a, \\u0441\\u0446\\u0435\\u043d\\u044b \\u0434\\u043e\\u0441\\u043e\\u043a \\u0438 \\u0440\\u0430\\u0437\\u043c\\u0435\\u0449\\u0435\\u043d\\u0438\\u0435 \\u043f\\u0440\\u043e\\u043f\\u043e\\u0432 \\u0432 `EnvLayouts` \\u2014 \\u043e\\u0442\\u0434\\u0435\\u043b\\u044c\\u043d\\u044b\\u0439 \\u0442\\u0440\\u0435\\u043a ENV-MAPS (AGENTS.md\",\r\n    \"  \\u00abBoard scenes and heroes\\u00bb, HANDBOOK \\u00a71 \\u00ab\\u041e\\u043a\\u0440\\u0443\\u0436\\u0435\\u043d\\u0438\\u0435/\\u043a\\u0430\\u0440\\u0442\\u044b\\u00bb). \\u041d\\u0435 \\u0434\\u043b\\u044f \\u0440\\u0430\\u0437\\u043e\\u0432\\u044b\\u0445 \\u043f\\u0440\\u0430\\u0432\\u043e\\u043a \\u0433\\u043e\\u0442\\u043e\\u0432\\u043e\\u0433\\u043e \\u0430\\u0441\\u0441\\u0435\\u0442\\u0430: \\u043f\\u0435\\u0440\\u0435\\u043a\\u0440\\u0430\\u0441\\u043a\\u0430 MI, \\u0437\\u0430\\u043c\\u0435\\u043d\\u0430 \\u0442\\u0435\\u043a\\u0441\\u0442\\u0443\\u0440\\u044b,\",\r\n    \"  \\u043f\\u0440\\u0430\\u0432\\u043a\\u0430 \\u043e\\u0434\\u043d\\u043e\\u0433\\u043e \\u043a\\u043b\\u0438\\u043f\\u0430. \\u041e\\u043d\\u0438 \\u0438\\u0434\\u0443\\u0442 \\u043e\\u0431\\u044b\\u0447\\u043d\\u043e\\u0439 \\u0437\\u0430\\u0434\\u0430\\u0447\\u0435\\u0439. \\u041d\\u043e\\u0432\\u0430\\u044f \\u0441\\u043c\\u044b\\u0441\\u043b\\u043e\\u0432\\u0430\\u044f \\u0434\\u0435\\u0442\\u0430\\u043b\\u044c \\u0441\\u0443\\u0449\\u0435\\u0441\\u0442\\u0432\\u0443\\u044e\\u0449\\u0435\\u0439 \\u0444\\u0438\\u0433\\u0443\\u0440\\u044b \\u2014 \\u044d\\u0442\\u043e \\u043d\\u043e\\u0432\\u0430\\u044f \\u0437\\u0430\\u044f\\u0432\\u043a\\u0430.\",\r\n    \"- \\u0420\\u043e\\u0441\\u0442\\u0435\\u0440 \\u043f\\u043e\\u0441\\u043b\\u0435 MVP \\u0432\\u043d\\u0435 \\u043e\\u0431\\u044a\\u0451\\u043c\\u0430 \\u0412\\u0420-18 (`docs/game-design/visual/02-visual-design.md` \\u00a78.6). \\u0421\\u043a\\u0438\\u043b\\u043b \\u043f\\u0438\\u0448\\u0435\\u0442 \\u043e\\u0431 \\u044d\\u0442\\u043e\\u043c\",\r\n    \"  \\u043f\\u0440\\u0435\\u0434\\u0443\\u043f\\u0440\\u0435\\u0436\\u0434\\u0435\\u043d\\u0438\\u0435 \\u0432 \\u043f\\u043e\\u043b\\u0435 `NOTES` \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0438, \\u043d\\u043e \\u0440\\u0430\\u0431\\u043e\\u0442\\u0443 \\u043d\\u0435 \\u043e\\u0441\\u0442\\u0430\\u043d\\u0430\\u0432\\u043b\\u0438\\u0432\\u0430\\u0435\\u0442: \\u0437\\u0430\\u043f\\u0440\\u043e\\u0441 \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044f \\u0438 \\u0435\\u0441\\u0442\\u044c \\u043e\\u0441\\u043d\\u043e\\u0432\\u0430\\u043d\\u0438\\u0435 \\u0434\\u043b\\u044f \\u0437\\u0430\\u043f\\u0443\\u0441\\u043a\\u0430.\"\r\n  ],\r\n  \"headings\": [\r\n    \"# 3d-model-pipeline\",\r\n    \"## 1. \\u041a\\u043e\\u0433\\u0434\\u0430 \\u0438\\u0441\\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u044c\",\r\n    \"## 2. \\u041a\\u0430\\u0440\\u0442\\u0430 \\u044d\\u0442\\u0430\\u043f\\u043e\\u0432 0\\u20137\",\r\n    \"## 3. \\u0412\\u0435\\u0442\\u043a\\u0438 \\u043f\\u043e \\u0430\\u043d\\u0430\\u0442\\u043e\\u043c\\u0438\\u0438 (\\u043f\\u043e\\u043b\\u0435 `ANATOMY`)\",\r\n    \"## 4. \\u0418\\u0441\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u0438 \\u0438 \\u043a\\u0430\\u043a \\u0438\\u0445 \\u0432\\u044b\\u0437\\u044b\\u0432\\u0430\\u0442\\u044c\",\r\n    \"## 5. \\u0413\\u0435\\u0439\\u0442\\u044b \\u0441\\u0442\\u043e\\u043f\\u0430 \\u2014 \\u0435\\u0434\\u0438\\u043d\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u044b\\u0435 \\u0437\\u0430\\u043a\\u043e\\u043d\\u043d\\u044b\\u0435 \\u0432\\u043e\\u043f\\u0440\\u043e\\u0441\\u044b \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044e\",\r\n    \"## 6. \\u042d\\u0442\\u0430\\u043f\\u044b: \\u0448\\u0430\\u0433\\u0438 \\u0438 \\u0432\\u044b\\u0445\\u043e\\u0434\",\r\n    \"## 7. \\u0414\\u0435\\u0444\\u043e\\u043b\\u0442\\u044b \\u0438 \\u0437\\u0430\\u044f\\u0432\\u043a\\u0430\",\r\n    \"### 7.1 \\u0414\\u0435\\u0444\\u043e\\u043b\\u0442\\u044b \\u043f\\u043e \\u0434\\u0435\\u043b\\u0435\\u0433\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044e\",\r\n    \"### 7.2 \\u0428\\u0430\\u0431\\u043b\\u043e\\u043d `asset-card.yaml`\",\r\n    \"# \\u0417\\u0430\\u044f\\u0432\\u043a\\u0430 \\u044d\\u0442\\u0430\\u043f\\u0430 0. \\u0424\\u0430\\u0439\\u043b: <ASSET_DIR>/asset-card.yaml. \\u041f\\u043e\\u043b\\u0435 \\u0431\\u0435\\u0437 \\u0437\\u043d\\u0430\\u0447\\u0435\\u043d\\u0438\\u044f \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044f \\u0431\\u0435\\u0440\\u0451\\u0442 \\u0434\\u0435\\u0444\\u043e\\u043b\\u0442 \\u00a77.1 \\u0441 decided_by.\",\r\n    \"### 7.3 \\u0428\\u0430\\u0431\\u043b\\u043e\\u043d\\u044b \\u044d\\u0442\\u0430\\u043f\\u0430 0 \\u0432 \\u0441\\u043f\\u0440\\u0430\\u0432\\u043e\\u0447\\u043d\\u