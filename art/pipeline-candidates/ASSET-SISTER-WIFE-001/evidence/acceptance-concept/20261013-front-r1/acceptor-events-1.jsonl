u044b\\u0439 \\u0448\\u0430\\u0433 \\u0437\\u0430\\u043f\\u0440\\u0435\\u0449\\u0451\\u043d \\u043f\\u0440\\u0430\\u0432\\u0430\\u043c\\u0438 \\u0441\\u0435\\u0441\\u0441\\u0438\\u0438. \\u041f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044c \\u043f\\u043e\\u043b\\u0443\\u0447\\u0430\\u0435\\u0442 \\u043f\\u0430\\u043a\\u0435\\u0442 \\xab\\u0447\\u0442\\u043e \\u043d\\u0430\\u0436\\u0430\\u0442\\u044c\\xbb \\u043f\\u043e \\u0447\\u0435\\u043a-\\u043b\\u0438\\u0441\\u0442\\u0443.\r\n3. \\u041a\\u0440\\u0435\\u0434\\u0438\\u0442\\u044b: \\u043f\\u0440\\u0435\\u0434\\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043a\\u0430 \\u043f\\u0435\\u0440\\u0435\\u0434 \\u043f\\u043b\\u0430\\u0442\\u043d\\u043e\\u0439 \\u043e\\u043f\\u0435\\u0440\\u0430\\u0446\\u0438\\u0435\\u0439 \\u043d\\u0435 \\u0434\\u0430\\u043b\\u0430 \\u043a\\u043e\\u0434 0 \\u2014 Tripo `ledger.py check --service tripo --next-cost\r\n   <\\u0446\\u0435\\u043d\\u0430>` (\\u043e\\u0441\\u0442\\u0430\\u0442\\u043a\\u0430 \\u043b\\u0438\\u043c\\u0438\\u0442\\u0430 \\u0412\\u0420-04 \\u0438\\u043b\\u0438 \\u0441\\u0432\\u0435\\u0436\\u0435\\u0433\\u043e \\u0431\\u0430\\u043b\\u0430\\u043d\\u0441\\u0430 \\u043c\\u0435\\u043d\\u044c\\u0448\\u0435 \\u0446\\u0435\\u043d\\u044b, \\u043e\\u043a\\u043d\\u043e \\u0412\\u0420-04 \\u0437\\u0430\\u043a\\u0440\\u044b\\u0442\\u043e \\u043f\\u043e\\u0441\\u043b\\u0435 2026-10-28; \\xa77.1, \\u0441\\u0442\\u0440\\u043e\\u043a\\u0430\r\n   \\xab\\u041a\\u0440\\u0435\\u0434\\u0438\\u0442\\u044b\\xbb), SYNTX `ledger.py check --balance <\\u0431\\u0430\\u043b\\u0430\\u043d\\u0441> --next-cost <\\u0446\\u0435\\u043d\\u0430> --next-kind <\\u0432\\u0438\\u0434>`\r\n   (`references/animation-vfx-sfx.md` \\xa76.1); \\u0434\\u0432\\u0435 \\u043d\\u0435\\u0443\\u0434\\u0430\\u0447\\u043d\\u044b\\u0435 \\u0433\\u0435\\u043d\\u0435\\u0440\\u0430\\u0446\\u0438\\u0438 \\u043f\\u043e\\u0434\\u0440\\u044f\\u0434.\r\n4. \\u0418\\u0441\\u0447\\u0435\\u0440\\u043f\\u0430\\u043d\\u044b \\u0446\\u0438\\u043a\\u043b\\u044b: \\u043a\\u043e\\u043d\\u0446\\u0435\\u043f\\u0442 \\u2014 3, \\u043c\\u043e\\u0434\\u0435\\u043b\\u044c \\u2014 2, \\u043a\\u043b\\u0438\\u043f \\u2014 2.\r\n5. \\u041d\\u0443\\u0436\\u0435\\u043d \\u043d\\u043e\\u0432\\u044b\\u0439 MatID-\\u043a\\u043b\\u0430\\u0441\\u0441, \\u043d\\u043e\\u0432\\u0430\\u044f \\u043a\\u043e\\u0441\\u0442\\u044c, \\u0440\\u0430\\u0441\\u0448\\u0438\\u0440\\u0435\\u043d\\u0438\\u0435 `optional_extensions` (\\xa73) \\u0438\\u043b\\u0438 \\u043d\\u043e\\u0432\\u044b\\u0439 \\u0440\\u0435\\u0436\\u0438\\u043c generic `h2_bake` \\u2014\r\n   \\u043c\\u043e\\u0441\\u0442-\\u0446\\u0438\\u043b\\u0438\\u043d\\u0434\\u0440 \\u0434\\u043b\\u044f \\u043e\\u0440\\u0443\\u0436\\u0438\\u044f \\u0431\\u0435\\u0437 \\u0445\\u0432\\u0430\\u0442\\u0430 (HANDBOOK \\xa70.3 \\u043f.7, \\xa74.2 \\xab\\u041e\\u0440\\u0443\\u0436\\u0438\\u0435\\xbb, \\xa74.4). \\u0422\\u043e\\u043d\\u043a\\u0430\\u044f \\u0434\\u0435\\u0442\\u0430\\u043b\\u044c (\\u0442\\u0435\\u0442\\u0438\\u0432\\u0430, \\u0434\\u0440\\u0435\\u0432\\u043a\\u043e,\r\n   \\u0441\\u0442\\u0440\\u0435\\u043b\\u044b), \\u043a\\u043e\\u0442\\u043e\\u0440\\u0443\\u044e \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u044c \\u043d\\u0435 \\u0441\\u0434\\u0435\\u043b\\u0430\\u043b \\u0447\\u0438\\u0442\\u0430\\u0435\\u043c\\u043e\\u0439, \\u2014 \\u043d\\u0435 \\u0441\\u0442\\u043e\\u043f: \\u043f\\u0443\\u043d\\u043a\\u0442 \\xab\\u043d\\u0435 \\u0437\\u0430\\u043a\\u0440\\u044b\\u0442\\u043e\\xbb \\u0438 \\u0431\\u0430\\u043b\\u043b F\r\n   (`references/acceptance-and-blender.md` \\xa79.3).\r\n6. \\u0421\\u0442\\u043e\\u043f \\u0438\\u0437 HANDBOOK \\xa70.3 \\u0432 \\u043f\\u0440\\u043e\\u0438\\u0437\\u0432\\u043e\\u0434\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u044b\\u0445 \\u043a\\u043e\\u043c\\u0430\\u043d\\u0434\\u0430\\u0445 \\u044d\\u0442\\u0430\\u043f\\u043e\\u0432 2, 3 \\u0438 7: \\u043a\\u043e\\u0434 1/3/4/5 CLI `tripo_pipeline.py`, FAIL\r\n   \\u0441\\u0442\\u0430\\u0434\\u0438\\u0438 `run_h2_bake.py` (\\u0432 \\u043b\\u044e\\u0431\\u043e\\u043c \\u0440\\u0435\\u0436\\u0438\\u043c\\u0435), \\u043a\\u043e\\u0434 1 `capture_acceptance_set.py`, \\u043e\\u0448\\u0438\\u0431\\u043a\\u0430 `ue-import`/`h2anim_ue.py`,\r\n   \\u043f\\u0430\\u0434\\u0435\\u043d\\u0438\\u0435 \\u0440\\u0435\\u0434\\u0430\\u043a\\u0442\\u043e\\u0440\\u0430, \\u0447\\u0443\\u0436\\u0438\\u0435 \\u0430\\u0441\\u0441\\u0435\\u0442\\u044b \\u0432 \\u0446\\u0435\\u043b\\u0435\\u0432\\u043e\\u0439 \\u043f\\u0430\\u043f\\u043a\\u0435. \\u041d\\u0435 \\u0441\\u0442\\u043e\\u043f \\u2014 \\u0448\\u0442\\u0430\\u0442\\u043d\\u044b\\u0435 \\u0446\\u0438\\u043a\\u043b\\u044b \\u0441\\u0432\\u043e\\u0438\\u0445 \\u044d\\u0442\\u0430\\u043f\\u043e\\u0432: FAIL \\u0430\\u0432\\u0442\\u043e\\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043e\\u043a \\u043a\\u043e\\u043d\\u0446\\u0435\\u043f\\u0442\\u0430\r\n   `check_concept_views.py` (\\u043f\\u0435\\u0440\\u0435\\u0433\\u0435\\u043d\\u0435\\u0440\\u0430\\u0446\\u0438\\u044f \\u0441 `CORRECTION:`, \\u044d\\u0442\\u0430\\u043f 1), FAIL-\\u0433\\u0435\\u0439\\u0442\\u044b \\u0438 \\u0431\\u0430\\u043b\\u043b\\u044b \\u043f\\u0440\\u0438\\u0451\\u043c\\u043a\\u0438 (\\u043c\\u0430\\u0440\\u0448\\u0440\\u0443\\u0442 \\u0432\\u0435\\u0440\\u0434\\u0438\\u043a\\u0442\\u0430,\r\n   \\u044d\\u0442\\u0430\\u043f\\u044b 4\\u20136), \\u043a\\u043e\\u0434 1 `validate_card.py` (\\u043e\\u0434\\u0438\\u043d \\u043f\\u043e\\u0432\\u0442\\u043e\\u0440 \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a\\u0430, `references/acceptance-and-blender.md` \\xa78.1 \\u043f.5),\r\n   \\u043a\\u043e\\u0434 1 `ledger.py check` \\u0431\\u0435\\u0437 \\u0441\\u0442\\u0440\\u043e\\u043a\\u0438 `providerTerms` (\\u0437\\u0430\\u043f\\u0438\\u0441\\u0430\\u0442\\u044c \\u0443\\u0441\\u043b\\u043e\\u0432\\u0438\\u044f \\u0438 \\u043f\\u043e\\u0432\\u0442\\u043e\\u0440\\u0438\\u0442\\u044c). \\u0421\\u0442\\u043e\\u043f\\u043e\\u043c \\u043e\\u043d\\u0438 \\u0441\\u0442\\u0430\\u043d\\u043e\\u0432\\u044f\\u0442\\u0441\\u044f \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043f\\u043e\r\n   \\u0441\\u0432\\u043e\\u0438\\u043c \\u043f\\u0443\\u043d\\u043a\\u0442\\u0430\\u043c: \\u0438\\u0441\\u0447\\u0435\\u0440\\u043f\\u0430\\u043d\\u044b \\u0446\\u0438\\u043a\\u043b\\u044b (\\u043f.4), \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a \\u043d\\u0435 \\u0434\\u0430\\u043b \\u0432\\u0430\\u043b\\u0438\\u0434\\u043d\\u043e\\u0439 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0438 \\u043f\\u043e\\u0441\\u043b\\u0435 \\u043f\\u043e\\u0432\\u0442\\u043e\\u0440\\u0430 (\\u043f.2), \\u043a\\u0440\\u0435\\u0434\\u0438\\u0442\\u044b (\\u043f.3).\r\n7. \\u0428\\u0430\\u0433\\u0443 7b \\u043d\\u0443\\u0436\\u0435\\u043d \\u0437\\u0430\\u043a\\u0440\\u044b\\u0442\\u044b\\u0439 \\u0440\\u0435\\u0434\\u0430\\u043a\\u0442\\u043e\\u0440, \\u0430 \\u043e\\u0442\\u043a\\u0440\\u044b\\u0442 \\u0440\\u0435\\u0434\\u0430\\u043a\\u0442\\u043e\\u0440 \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044f (\\u043b\\u044e\\u0431\\u043e\\u0439 `UnrealEditor.exe` \\u044d\\u0442\\u043e\\u0433\\u043e \\u0434\\u0432\\u0438\\u0436\\u043a\\u0430 \\u0441 Live\r\n   Coding \\u0431\\u043b\\u043e\\u043a\\u0438\\u0440\\u0443\\u0435\\u0442 \\u0441\\u0431\\u043e\\u0440\\u043a\\u0443 `UnmatchedEditor` \\u0432\\u043e \\u0432\\u0441\\u0435\\u0445 \\u0447\\u0435\\u043a\\u0430\\u0443\\u0442\\u0430\\u0445 \\u2014 `docs/unreal/UE-SESSION-DESIGN.md` F9; `UnrealEditor-Cmd`\r\n   \\u043f\\u0440\\u0438 \\u043e\\u0442\\u043a\\u0440\\u044b\\u0442\\u043e\\u043c GUI-\\u0440\\u0435\\u0434\\u0430\\u043a\\u0442\\u043e\\u0440\\u0435 \\u0437\\u0430\\u043f\\u0440\\u0435\\u0449\\u0451\\u043d \\u2014 HANDBOOK \\xa70.1). \\u041f\\u0430\\u043a\\u0435\\u0442 \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044e: \\u0441\\u043f\\u0438\\u0441\\u043e\\u043a \\u0448\\u0430\\u0433\\u043e\\u0432 7b \\u0438 \\u043f\\u0440\\u043e\\u0441\\u044c\\u0431\\u0430 \\u0437\\u0430\\u043a\\u0440\\u044b\\u0442\\u044c\r\n   \\u0440\\u0435\\u0434\\u0430\\u043a\\u0442\\u043e\\u0440 \\u0438\\u043b\\u0438 \\u0440\\u0430\\u0437\\u0440\\u0435\\u0448\\u0438\\u0442\\u044c \\u0430\\u0433\\u0435\\u043d\\u0442\\u0443 \\u0437\\u0430\\u043a\\u0440\\u044b\\u0442\\u044c \\u0435\\u0433\\u043e (0 dirty-\\u043f\\u0430\\u043a\\u0435\\u0442\\u043e\\u0432). \\u0410\\u0433\\u0435\\u043d\\u0442 \\u0441\\u0430\\u043c \\u0440\\u0435\\u0434\\u0430\\u043a\\u0442\\u043e\\u0440 \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044f \\u043d\\u0435 \\u0437\\u0430\\u043a\\u0440\\u044b\\u0432\\u0430\\u0435\\u0442. \\u0413\\u043e\\u0442\\u043e\\u0432\\u044b\\u0439\r\n   \\u0442\\u0435\\u043a\\u0441\\u0442 \\u043f\\u0430\\u043a\\u0435\\u0442\\u0430 \\u2014 `references/ue-import-package.md` \\xa71 \\u043f.4. \\u0414\\u043b\\u044f \\u0433\\u0435\\u0440\\u043e\\u044f \\u044d\\u0442\\u043e\\u0442 \\u0433\\u0435\\u0439\\u0442 \\u0441\\u0440\\u0430\\u0431\\u0430\\u0442\\u044b\\u0432\\u0430\\u0435\\u0442 \\u043f\\u043e\\u0447\\u0442\\u0438 \\u0432\\u0441\\u0435\\u0433\\u0434\\u0430 (\\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044c\r\n   \\u0434\\u0435\\u0440\\u0436\\u0438\\u0442 \\u0440\\u0435\\u0434\\u0430\\u043a\\u0442\\u043e\\u0440 \\u043e\\u0442\\u043a\\u0440\\u044b\\u0442\\u044b\\u043c), \\u043f\\u043e\\u044d\\u0442\\u043e\\u043c\\u0443 7a \\u0434\\u0435\\u043b\\u0430\\u0435\\u0442\\u0441\\u044f \\u0446\\u0435\\u043b\\u0438\\u043a\\u043e\\u043c \\u0438 \\u043a\\u043e\\u043c\\u043c\\u0438\\u0442\\u0438\\u0442\\u0441\\u044f \\u0434\\u043e \\u043f\\u0430\\u043a\\u0435\\u0442\\u0430.\r\n\r\n\\u041f\\u0443\\u043d\\u043a\\u0442\\u044b 6\\u20137 \\u2014 \\u043d\\u0435 \\u043d\\u043e\\u0432\\u044b\\u0435 \\u0432\\u043e\\u043f\\u0440\\u043e\\u0441\\u044b \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044e, \\u0430 \\u043f\\u0440\\u043e\\u0438\\u0437\\u0432\\u043e\\u0434\\u043d\\u044b\\u0435 \\u043d\\u043e\\u0440\\u043c \\u0432\\u044b\\u0448\\u0435 \\u0441\\u043a\\u0438\\u043b\\u043b\\u0430: \\u043f.6 \\u2014 HANDBOOK \\xa70.3 (HANDBOOK \\u0433\\u043b\\u0430\\u0432\\u043d\\u0435\\u0435,\r\n\\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u0420-0), \\u043f.7 \\u2014 AGENTS.md \\xabAgent and process lifecycle\\xbb (\\xabDo not close the user's Unreal Editor\\xbb) \\u0438 HANDBOOK \\xa70.1.\r\n\\u0417\\u0430\\u043f\\u0440\\u043e\\u0441 \\xab\\u0440\\u0430\\u0437\\u0440\\u0435\\u0448\\u0430\\u0435\\u0442\\u0435 \\u0442\\u0440\\u0430\\u0442\\u044b?\\xbb \\u0433\\u0435\\u0439\\u0442\\u043e\\u043c \\u043d\\u0435 \\u044f\\u0432\\u043b\\u044f\\u0435\\u0442\\u0441\\u044f (\\xa71).\r\n\r\n\\u0412\\u0441\\u0451 \\u043e\\u0441\\u0442\\u0430\\u043b\\u044c\\u043d\\u043e\\u0435 \\u0437\\u0430\\u043a\\u0440\\u044b\\u0432\\u0430\\u0435\\u0442\\u0441\\u044f \\u0434\\u0435\\u0444\\u043e\\u043b\\u0442\\u0430\\u043c\\u0438 \\xa77 \\u0441 \\u043f\\u043e\\u043c\\u0435\\u0442\\u043a\\u043e\\u0439 \\u0432 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0435 `decided_by: delegated (\\u0412\\u0420-\\u0440\\u0435\\u0435\\u0441\\u0442\\u0440 2026-10-06)`.\r\n\\u042d\\u0441\\u043a\\u0430\\u043b\\u0430\\u0446\\u0438\\u044f \\u2014 \\u044d\\u0442\\u043e \\u0441\\u0442\\u043e\\u043f \\u0434\\u043e \\u043e\\u0442\\u0432\\u0435\\u0442\\u0430, \\u0430 \\u043d\\u0435 \\xab\\u0437\\u0430\\u043f\\u0438\\u0441\\u0430\\u043b \\u0438 \\u043f\\u043e\\u0448\\u0451\\u043b \\u0434\\u0430\\u043b\\u044c\\u0448\\u0435\\xbb.\r\n\r\n## 6. \\u042d\\u0442\\u0430\\u043f\\u044b: \\u0448\\u0430\\u0433\\u0438 \\u0438 \\u0432\\u044b\\u0445\\u043e\\u0434\r\n\r\n**\\u042d\\u0442\\u0430\\u043f 0 \\u2014 \\u0437\\u0430\\u044f\\u0432\\u043a\\u0430.**\r\n1. `ANATOMY` \\u043f\\u043e \\xa73 (`non-humanoid` \\u2014 \\u0441\\u0442\\u043e\\u043f). `ASSET_DIR`, `asset-card.yaml` \\u043f\\u043e \\xa77.2 (\\u043d\\u0435 \\u0437\\u0430\\u0434\\u0430\\u043d\\u043d\\u043e\\u0435 \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u0435\\u043c \\u2014 \\u0434\\u0435\\u0444\\u043e\\u043b\\u0442\r\n   \\xa77.1 \\u0441 `decided_by`), `.gitignore` \\u0430\\u0441\\u0441\\u0435\\u0442\\u0430 (`references/intake-and-evidence.md` \\xa73).\r\n2. \\u0417\\u0430\\u043f\\u0438\\u0441\\u044c \\u0432 `docs/art-pipeline/asset-registry.json`: `status` \\xab\\u043f\\u0440\\u0435\\u0434\\u043b\\u043e\\u0436\\u0435\\u043d\\u043e\\xbb, `stage` `planned`; `contentKey` = `CONTENT_KEY`,\r\n   \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u0435\\u0441\\u043b\\u0438 \\u043a\\u043b\\u044e\\u0447 \\u0435\\u0441\\u0442\\u044c \\u0432 `docs/game-design/05-content-matrix.csv`, \\u0438\\u043d\\u0430\\u0447\\u0435 `null`; `manifest06Row` \\u2014 `null` \\u0431\\u0435\\u0437 \\u0441\\u0442\\u0440\\u043e\\u043a\\u0438 \\u0432\r\n   `06-asset-manifest.csv`. \\u0417\\u0430\\u043f\\u0438\\u0441\\u044c \\u2014 \\u043f\\u043e \\u0448\\u0430\\u0431\\u043b\\u043e\\u043d\\u0443 `references/intake-and-evidence.md` \\xa71.\r\n   \\u041f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043a\\u0430 \\u2014 \\u043f\\u043e \\u0441\\u0442\\u0440\\u043e\\u043a\\u0430\\u043c ERROR \\u0441\\u043e \\u0441\\u0432\\u043e\\u0438\\u043c `ASSET_ID`, **\\u043d\\u0435 \\u043f\\u043e \\u043a\\u043e\\u0434\\u0443 \\u0432\\u044b\\u0445\\u043e\\u0434\\u0430**: \\u043d\\u0430 \\u0431\\u0430\\u0437\\u043e\\u0432\\u043e\\u0439 \\u043b\\u0438\\u043d\\u0438\\u0438 2026-10-09 \\u0438\\u043d\\u0441\\u0442\\u0440\\u0443\\u043c\\u0435\\u043d\\u0442\r\n   \\u0443\\u0436\\u0435 \\u0434\\u0430\\u0451\\u0442 \\u043a\\u043e\\u0434 1 (1 ERROR `sharedDependencies[UM-MASTERS]` sha256, \\u0447\\u0443\\u0436\\u043e\\u0439). \\u041a\\u043e\\u043c\\u0430\\u043d\\u0434\\u0430 (\\u043f\\u0443\\u0441\\u0442\\u043e \\u0438 \\u043a\\u043e\\u0434 1 \\u0443 `grep` \\u2014 \\u043d\\u043e\\u0440\\u043c\\u0430):\r\n   `python tools/tripo-pipeline/validate_registry.py 2>&1 | grep '^ERROR' | grep -F '<ASSET_ID>'`.\r\n   \\u0427\\u0443\\u0436\\u0438\\u0435 ERROR \\u0431\\u0430\\u0437\\u043e\\u0432\\u043e\\u0439 \\u043b\\u0438\\u043d\\u0438\\u0438 (`\\u2026 | grep '^ERROR'`) \\u2014 \\u0441\\u0442\\u0440\\u043e\\u043a\\u043e\\u0439 \\u0432 `NOTES` \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0438, \\u043d\\u0435 \\u0447\\u0438\\u043d\\u0438\\u0442\\u044c.\r\n3. \\u0421\\u0442\\u0440\\u043e\\u043a\\u0430 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0438 \\u0432 `docs/game-design/visual/06-tasks/anim.csv` (`area` `hero` \\u043f\\u043e `07-prompt-templates.md` \\xa70.1; \\u0443 \\u043f\\u0440\\u043e\\u043f\\u0430 `prop` \\u2014 \\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u0441\\u043a\\u0438\\u043b\\u043b\\u0430; \\u0441\\u043b\\u0435\\u0434\\u0443\\u044e\\u0449\\u0438\\u0439 `AN-NN`) \\u2192\r\n   `VISUAL_CARD_ID`. \\u0411\\u0435\\u0437 \\u043d\\u0435\\u0451 `ledger.py add` \\u043e\\u0442\\u043a\\u0430\\u0436\\u0435\\u0442 (\\xabno spend without a card\\xbb).\r\n4. \\u041f\\u0440\\u043e\\u0431\\u043d\\u044b\\u0439 \\u0432\\u044b\\u0437\\u043e\\u0432 \\u0438\\u0441\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u0435\\u0439 \\xa74 \\u2014 \\u043a\\u0430\\u0436\\u0434\\u044b\\u0439 \\u0441 \\u043a\\u043e\\u043c\\u0430\\u043d\\u0434\\u043e\\u0439 \\u0438 \\u043a\\u0440\\u0438\\u0442\\u0435\\u0440\\u0438\\u0435\\u043c; \\u043d\\u0435 \\u043f\\u0440\\u043e\\u0448\\u0451\\u043b \\u043f\\u043e\\u0441\\u043b\\u0435 \\u043f\\u043e\\u0432\\u0442\\u043e\\u0440\\u0430 \\u2014 \\u0433\\u0435\\u0439\\u0442 \\xa75 \\u043f.2.\r\n   - **Codex** \\u2014 \\u043f\\u0440\\u043e\\u0431\\u0430 \\u0438\\u043c\\u0435\\u043d\\u043d\\u043e `exec` (`references/concept-sheet.md` \\xa75.2, \\u0448\\u0430\\u0433\\u0438 1\\u20133:\r\n     `exec \\u2026 -c 'windows.sandbox=\"unelevated\"' -s read-only --json \"Run exactly one shell command: \\u2026\"`). \\u041f\\u0440\\u043e\\u0448\\u043b\\u0430, \\u0435\\u0441\\u043b\\u0438 \\u0432\r\n     \\u0441\\u043e\\u0431\\u044b\\u0442\\u0438\\u044f\\u0445 \\u0435\\u0441\\u0442\\u044c `command_execution` \\u0441 `\"exit_code\":0`; `--version` \\u0438 \\xabReply OK\\xbb \\u043d\\u0435 \\u0433\\u043e\\u0434\\u044f\\u0442\\u0441\\u044f \\u2014 \\u043e\\u043d\\u0438 \\u043f\\u0440\\u043e\\u0445\\u043e\\u0434\\u044f\\u0442 \\u0438 \\u043f\\u0440\\u0438\r\n     \\u0437\\u0430\\u0431\\u043b\\u043e\\u043a\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u043d\\u043e\\u043c exec \\u0438\\u043b\\u0438 \\u0441\\u043b\\u043e\\u043c\\u0430\\u043d\\u043d\\u043e\\u0439 \\u043f\\u0435\\u0441\\u043e\\u0447\\u043d\\u0438\\u0446\\u0435. \\u041d\\u0435 \\u043f\\u0440\\u043e\\u0448\\u043b\\u0430 \\u2014 \\u043f\\u0443\\u0442\\u044c \\u0447\\u0435\\u0440\\u0435\\u0437 \\u043f\\u0440\\u0438\\u043b\\u043e\\u0436\\u0435\\u043d\\u0438\\u0435 (concept-sheet \\xa75.3).\r\n   - **\\u041f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a \\xabOpus xhigh\\xbb (Workflow).** \\u0421\\u043a\\u0440\\u0438\\u043f\\u0442-\\u043f\\u0440\\u043e\\u0431\\u0430 \\u0441 \\u0442\\u0435\\u043c \\u0436\\u0435 \\u0432\\u044b\\u0437\\u043e\\u0432\\u043e\\u043c, \\u0447\\u0442\\u043e \\u0443 \\u043f\\u0440\\u0438\\u0451\\u043c\\u043a\\u0438\r\n     (`references/acceptance-and-blender.md` \\xa78.3), \\u043d\\u043e \\u0441 \\u043a\\u0440\\u043e\\u0448\\u0435\\u0447\\u043d\\u043e\\u0439 \\u0441\\u0445\\u0435\\u043c\\u043e\\u0439:\r\n     ```js\r\n     export const meta = {name: 'acceptor-probe', description: '\\u041f\\u0440\\u043e\\u0431\\u0430 \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a\\u0430, \\u044d\\u0442\\u0430\\u043f 0 3d-model-pipeline'}\r\n     return await agent('\\u041d\\u0438\\u0447\\u0435\\u0433\\u043e \\u043d\\u0435 \\u0447\\u0438\\u0442\\u0430\\u0439 \\u0438 \\u043d\\u0435 \\u043c\\u0435\\u043d\\u044f\\u0439. \\u0412\\u0435\\u0440\\u043d\\u0438 JSON {\"ok\": true}.', {\r\n       model: 'opus', effort: 'xhigh', label: 'probe-acceptor-<ASSET_ID>',\r\n       schema: {type: 'object', properties: {ok: {type: 'boolean'}}, required: ['ok'], additionalProperties: false},\r\n     })\r\n     ```\r\n     \\u041f\\u0440\\u043e\\u0448\\u043b\\u0430 \\u2014 \\u0432\\u0435\\u0440\\u043d\\u0443\\u043b\\u0441\\u044f \\u043e\\u0431\\u044a\\u0435\\u043a\\u0442 `{\"ok\": true}`. `null` \\u0438\\u043b\\u0438 \\u043e\\u0448\\u0438\\u0431\\u043a\\u0430 \\u2014 \\u043e\\u0434\\u0438\\u043d \\u043f\\u043e\\u0432\\u0442\\u043e\\u0440. \\u041f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a \\xabSol 6.1 xhigh\\xbb (\\u0442\\u043e\\u043b\\u044c\\u043a\\u043e\r\n     \\u0435\\u0441\\u043b\\u0438 \\u0432\\u044b\\u0431\\u0440\\u0430\\u043d \\u0432 `ACCEPTOR_PROFILE`) \\u2014 \\u043f\\u0440\\u043e\\u0431\\u0430 `exec` \\u0432\\u044b\\u0448\\u0435 \\u0442\\u0435\\u043c \\u0436\\u0435 exe \\u0441 `--ignore-user-config -m gpt-6.1-sol`.\r\n   - **Claude in Chrome** (\\u0448\\u0430\\u0433\\u0438 1b \\u0438 2). \\u0418\\u043d\\u0441\\u0442\\u0440\\u0443\\u043c\\u0435\\u043d\\u0442\\u044b \\u0437\\u0430\\u0433\\u0440\\u0443\\u0437\\u0438\\u0442\\u044c \\u043e\\u0434\\u043d\\u0438\\u043c `ToolSearch`\r\n     (`select:mcp__claude-in-chrome__tabs_context_mcp,mcp__claude-in-chrome__tabs_create_mcp,mcp__claude-in-chrome__navigate,mcp__claude-in-chrome__get_page_text,mcp__claude-in-chrome__computer`).\r\n     \\u041a\\u0440\\u0438\\u0442\\u0435\\u0440\\u0438\\u0439 1: `tabs_context_mcp` \\u0432\\u043e\\u0437\\u0432\\u0440\\u0430\\u0449\\u0430\\u0435\\u0442 \\u043f\\u043e\\u0434\\u043a\\u043b\\u044e\\u0447\\u0451\\u043d\\u043d\\u044b\\u0439 \\u0431\\u0440\\u0430\\u0443\\u0437\\u0435\\u0440 \\u0438 \\u0441\\u043f\\u0438\\u0441\\u043e\\u043a \\u0432\\u043a\\u043b\\u0430\\u0434\\u043e\\u043a. \\u041a\\u0440\\u0438\\u0442\\u0435\\u0440\\u0438\\u0439 2: \\u0432 \\u0441\\u0432\\u043e\\u0435\\u0439 \\u043d\\u043e\\u0432\\u043e\\u0439\r\n     \\u0432\\u043a\\u043b\\u0430\\u0434\\u043a\\u0435 (`tabs_create_mcp`) `navigate` \\u043d\\u0430 `https://studio.tripo3d.ai/`, \\u0437\\u0430\\u0442\\u0435\\u043c `get_page_text` \\u0438\\u043b\\u0438 \\u0441\\u043a\\u0440\\u0438\\u043d\\u0448\\u043e\\u0442 \\u2014\r\n     \\u043e\\u0442\\u043a\\u0440\\u044b\\u0442\\u0430 Studio \\u043f\\u043e\\u0434 \\u0443\\u0447\\u0451\\u0442\\u043d\\u043e\\u0439 \\u0437\\u0430\\u043f\\u0438\\u0441\\u044c\\u044e \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044f \\u0438 \\u0432\\u0438\\u0434\\u0435\\u043d \\u0431\\u0430\\u043b\\u0430\\u043d\\u0441 \\u043a\\u0440\\u0435\\u0434\\u0438\\u0442\\u043e\\u0432 (\\u0437\\u0430\\u043f\\u0438\\u0441\\u0430\\u0442\\u044c \\u0447\\u0438\\u0441\\u043b\\u043e \\u0432 `NOTES`). \\u0427\\u0443\\u0436\\u0438\\u0435\r\n     \\u0432\\u043a\\u043b\\u0430\\u0434\\u043a\\u0438 \\u043d\\u0435 \\u0442\\u0440\\u043e\\u0433\\u0430\\u0442\\u044c. \\u0420\\u0430\\u0441\\u0448\\u0438\\u0440\\u0435\\u043d\\u0438\\u0435 \\u043d\\u0435 \\u043f\\u043e\\u0434\\u043a\\u043b\\u044e\\u0447\\u0435\\u043d\\u043e \\u0438\\u043b\\u0438 \\u044d\\u043a\\u0440\\u0430\\u043d \\u0432\\u0445\\u043e\\u0434\\u0430 \\u2014 \\u0433\\u0435\\u0439\\u0442 \\xa75 \\u043f.2 (\\u0432\\u0445\\u043e\\u0434 \\u0438 \\u043f\\u0430\\u0440\\u043e\\u043b\\u044c \\u0430\\u0433\\u0435\\u043d\\u0442 \\u043d\\u0435 \\u0432\\u0432\\u043e\\u0434\\u0438\\u0442);\r\n     \\u0442\\u043e\\u0433\\u0434\\u0430 \\u0448\\u0430\\u0433\\u0438 1b \\u0438 2 \\u0438\\u0434\\u0443\\u0442 \\u043f\\u043e \\u0447\\u0435\\u043a-\\u043b\\u0438\\u0441\\u0442\\u0443 \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044e (`references/tripo3d-stages.md` \\xa78).\r\n5. \\u041a\\u0440\\u0435\\u0434\\u0438\\u0442\\u044b Tripo (`references/tripo3d-stages.md` \\xa71): \\u043e\\u0434\\u0438\\u043d \\u0440\\u0430\\u0437 \\u043d\\u0430 \\u0436\\u0443\\u0440\\u043d\\u0430\\u043b \\u2014 \\u0441\\u0442\\u0440\\u043e\\u043a\\u0430 \\u0443\\u0441\\u043b\\u043e\\u0432\\u0438\\u0439\r\n   `python tools/art/visual/ledger.py terms --service Tripo --model \"Tripo Studio H3.1\" --url https://www.tripo3d.ai/terms`\r\n   (\\u0431\\u0435\\u0437 \\u043d\\u0435\\u0451 \\u043f\\u0440\\u0435\\u0434\\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043a\\u0430 Tripo \\u0434\\u0430\\u0451\\u0442 ERROR, \\u0412\\u0420-05); \\u0437\\u0430\\u0442\\u0435\\u043c\r\n   `python tools/art/visual/ledger.py check --service tripo --next-cost <\\u0447\\u0435\\u0440\\u043d\\u043e\\u0432\\u0438\\u043a + H2, \\xa77.1> --model \"Tripo Studio H3.1\"`\r\n   \\u2192 \\u043a\\u043e\\u0434 0. \\u041d\\u0430 \\u044d\\u0442\\u0430\\u043f\\u0435 0 \\u2014 **\\u0431\\u0435\\u0437 `--balance`**: \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u044f\\u044e\\u0442\\u0441\\u044f \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043e\\u0441\\u0442\\u0430\\u0442\\u043e\\u043a \\u043b\\u0438\\u043c\\u0438\\u0442\\u0430 \\u0412\\u0420-04, \\u043e\\u043a\\u043d\\u043e \\u0434\\u043e 2026-10-28 \\u0438 \\u0441\\u0442\\u0440\\u043e\\u043a\\u0430\r\n   \\u0443\\u0441\\u043b\\u043e\\u0432\\u0438\\u0439 (`ledger.py check` \\u043f\\u0440\\u0438\\u043d\\u0438\\u043c\\u0430\\u0435\\u0442 Tripo-\\u043f\\u0440\\u0435\\u0434\\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043a\\u0443 \\u0431\\u0435\\u0437 \\u0431\\u0430\\u043b\\u0430\\u043d\\u0441\\u0430). \\u0421\\u0432\\u0435\\u0436\\u0438\\u0439 \\u0431\\u0430\\u043b\\u0430\\u043d\\u0441 Studio \\u043e\\u0431\\u044f\\u0437\\u0430\\u0442\\u0435\\u043b\\u0435\\u043d \\u0441 \\u0448\\u0430\\u0433\\u0430 1b \\u2014\r\n   \\u043f\\u0435\\u0440\\u0435\\u0434 \\u043a\\u0430\\u0436\\u0434\\u043e\\u0439 \\u043f\\u043b\\u0430\\u0442\\u043d\\u043e\\u0439 \\u043e\\u043f\\u0435\\u0440\\u0430\\u0446\\u0438\\u0435\\u0439 `--balance <\\u0431\\u0430\\u043b\\u0430\\u043d\\u0441 Studio>` (\\xa77.1, \\u0441\\u0442\\u0440\\u043e\\u043a\\u0430 \\xab\\u041a\\u0440\\u0435\\u0434\\u0438\\u0442\\u044b Tripo\\xbb).\r\n   \\u0414\\u043e\\u0440\\u0430\\u0431\\u043e\\u0442\\u043a\\u0438 \\u0438\\u043d\\u0441\\u0442\\u0440\\u0443\\u043c\\u0435\\u043d\\u0442\\u043e\\u0432 \\u0414-1\\u2026\\u0414-3 (\\u0441\\u0442\\u043e\\u0440\\u043e\\u043d\\u0430 \\u043e\\u0440\\u0443\\u0436\\u0438\\u044f \\u0432 `h2_bake`, \\u0432\\u0430\\u0440\\u0438\\u0430\\u043d\\u0442\\u044b bench-\\u0444\\u0438\\u043a\\u0441\\u0442\\u0443\\u0440, \\u043b\\u0438\\u0441\\u0442 \\u043a\\u043b\\u0438\\u043f\\u043e\\u0432) \\u0443\\u0436\\u0435 \\u0441\\u0434\\u0435\\u043b\\u0430\\u043d\\u044b\r\n   (`references/new-character-registration.md` \\xa72, \\u0442\\u0430\\u043c \\u0436\\u0435 \\u043a\\u043e\\u043c\\u0430\\u043d\\u0434\\u0430 \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043a\\u0438).\r\n\r\n**\\u042d\\u0442\\u0430\\u043f 1 \\u2014 \\u043a\\u043e\\u043d\\u0446\\u0435\\u043f\\u0442-\\u043b\\u0438\\u0441\\u0442** (`references/concept-sheet.md`). \\u0421\\u0442\\u0440\\u043e\\u0433\\u0430\\u044f \\u0441\\u0435\\u0442\\u043a\\u0430 \\u0438 \\u043d\\u0430\\u0431\\u043e\\u0440 \\u043f\\u0440\\u043e\\u0435\\u043a\\u0446\\u0438\\u0439:\r\n1. **1a \\u0434\\u0438\\u0437\\u0430\\u0439\\u043d-front.** image_gen text\\u2192image, \\u0435\\u0434\\u0438\\u043d\\u0441\\u0442\\u0432\\u0435\\u043d\\u043d\\u044b\\u0439 ref \\u2014 \\u043f\\u0435\\u0440\\u0432\\u044b\\u0439 \\u0444\\u0430\\u0439\\u043b `QUALITY_REFERENCE`. \\u041f\\u043e\\u0434\\u0441\\u0442\\u0430\\u0432\\u043a\\u0430 \\u2014 \\u0441\\u043b\\u043e\\u0432\\u0430\\u043c\\u0438\r\n   (`{{PEDESTAL_EN}}`: \\u043a\\u0440\\u0443\\u0433\\u043b\\u0430\\u044f \\u0442\\u0451\\u043c\\u043d\\u0430\\u044f \\u043a\\u0430\\u043c\\u0435\\u043d\\u043d\\u0430\\u044f, \\u0431\\u0435\\u0437 \\u043a\\u043e\\u043b\\u044c\\u0446\\u0430, \\xabseen exactly edge-on, top surface not visible\\xbb):\r\n   \\u043a\\u043e\\u043b\\u043b\\u0430\\u0436 `ref-base-hero-p1.png` \\u0432\\u043e \\u0432\\u0445\\u043e\\u0434\\u0430\\u0445 \\u0442\\u044f\\u043d\\u0443\\u043b \\u043a\\u0430\\u043c\\u0435\\u0440\\u0443 \\u0432\\u0432\\u0435\\u0440\\u0445 (\\u0436\\u0438\\u0432\\u043e\\u0439 \\u0442\\u0435\\u0441\\u0442 2026-10-09), \\u0441\\u0442\\u0440\\u043e\\u0433\\u043e\\u0433\\u043e \\u0432\\u0438\\u0434\\u0430 \\u043f\\u043e\\u0434\\u0441\\u0442\\u0430\\u0432\\u043a\\u0438 \\u0441\\u0431\\u043e\\u043a\\u0443 \\u0432\r\n   \\u0440\\u0435\\u043f\\u043e \\u043d\\u0435\\u0442 (`references/concept-sheet.md` \\xa76.1). \\u041f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043a\\u0430 \\u043a\\u0430\\u043d\\u0434\\u0438\\u0434\\u0430\\u0442\\u0430 \\u2014 \\u0441 `--min-top-pct 4` (WARN `view.frame_top`).\r\n   \\u041f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a \\u043e\\u0446\\u0435\\u043d\\u0438\\u0432\\u0430\\u0435\\u0442 \\u0441\\u0438\\u043b\\u0443\\u044d\\u0442 \\u0438 \\u0438\\u0434\\u0435\\u043d\\u0442\\u0438\\u0447\\u043d\\u043e\\u0441\\u0442\\u044c (\\u043f\\u043e\\u0440\\u043e\\u0433 8,0) \\u0434\\u043e \\u0442\\u0440\\u0430\\u0442 Tripo.\r\n2. **1b \\u0447\\u0435\\u0440\\u043d\\u043e\\u0432\\u0430\\u044f \\u043c\\u043e\\u0434\\u0435\\u043b\\u044c.** Tripo, \\u043c\\u0430\\u0440\\u0448\\u0440\\u0443\\u0442 \\xab\\u0427\\u0435\\u0440\\u043d\\u043e\\u0432\\u0438\\u043a\\xbb (single-image, \\u0431\\u0435\\u0437 8K \\u0438 \\xab\\u043f\\u043e \\u0447\\u0430\\u0441\\u0442\\u044f\\u043c\\xbb;\r\n   `references/tripo3d-stages.md` \\xa75.2), \\u0437\\u0430\\u0442\\u0435\\u043c\r\n   `python tools/art/concept/draft_orthos.py --glb <draft.glb> --out <ASSET_DIR>/<YYYYMMDD>-draft-tripo/orthos --views front,left,back,right --aspect 3:4`\r\n   (winged-biped \\u2014 `4:3`) \\u2192 `ortho_{front,left,right,back}.png` + `ortho-framing.json`. \\u0417\\u0434\\u0435\\u0441\\u044c \\u0436\\u0435 \\u043e\\u043a\\u043e\\u043d\\u0447\\u0430\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e\r\n   \\u0432\\u044b\\u0431\\u0438\\u0440\\u0430\\u0435\\u0442\\u0441\\u044f `SIDE_VIEW` (`references/concept-sheet.md` \\xa74.1).\r\n3. **1c \\u0432\\u0438\\u0434\\u044b.** image_gen style-transfer \\u043f\\u043e\\u0432\\u0435\\u0440\\u0445 `ortho_<view>` (\\u0441\\u0438\\u043b\\u0443\\u044d\\u0442, \\u043f\\u043e\\u0437\\u0430 \\u0438 \\u0445\\u0432\\u0430\\u0442 \\u043d\\u0435\\u043f\\u0440\\u0438\\u043a\\u043e\\u0441\\u043d\\u043e\\u0432\\u0435\\u043d\\u043d\\u044b), \\u0432\\u0442\\u043e\\u0440\\u043e\\u0435\r\n   \\u0438\\u0437\\u043e\\u0431\\u0440\\u0430\\u0436\\u0435\\u043d\\u0438\\u0435 \\u2014 \\u0443\\u0442\\u0432\\u0435\\u0440\\u0436\\u0434\\u0451\\u043d\\u043d\\u044b\\u0439 front (\\u0440\\u0435\\u0446\\u0435\\u043f\\u0442 hero-quality-v1, HANDBOOK \\xa73.1).\r\n4. \\u041d\\u0430\\u0431\\u043e\\u0440 front, side, back: \\u043e\\u0434\\u0438\\u043d \\u0440\\u0430\\u0437\\u043c\\u0435\\u0440 \\u0438 \\u0430\\u0441\\u043f\\u0435\\u043a\\u0442, \\u0440\\u043e\\u0432\\u043d\\u044b\\u0439 \\u043d\\u0435\\u0439\\u0442\\u0440\\u0430\\u043b\\u044c\\u043d\\u044b\\u0439 \\u0442\\u0451\\u043c\\u043d\\u043e-\\u0441\\u0435\\u0440\\u044b\\u0439 \\u0444\\u043e\\u043d, \\u0444\\u0438\\u0433\\u0443\\u0440\\u0430 \\u0446\\u0435\\u043b\\u0438\\u043a\\u043e\\u043c \\u0441 \\u043f\\u043e\\u0434\\u0441\\u0442\\u0430\\u0432\\u043a\\u043e\\u0439,\r\n   \\u043e\\u0434\\u0438\\u043d\\u0430\\u043a\\u043e\\u0432\\u043e\\u0435 \\u0440\\u0430\\u0437\\u043c\\u0435\\u0449\\u0435\\u043d\\u0438\\u0435 \\u0432 % \\u043a\\u0430\\u0434\\u0440\\u0430; \\u0440\\u0430\\u0437\\u0431\\u0440\\u043e\\u0441 \\u0440\\u043e\\u0441\\u0442\\u0430 > 3 % \\u2014 WARN, > 5 % \\u2014 FAIL (\\u0434\\u0432\\u0443\\u0445\\u0441\\u0442\\u0443\\u043f\\u0435\\u043d\\u0447\\u0430\\u0442\\u044b\\u0435 \\u0434\\u043e\\u043f\\u0443\\u0441\\u043a\\u0438 \\u2014\r\n   `references/concept-sheet.md` \\xa74.3, \\u043a\\u0430\\u043b\\u0438\\u0431\\u0440\\u043e\\u0432\\u043a\\u0430 `tools/art/concept/README.md`). \\u0412\\u044b\\u0445\\u043e\\u0434 image_gen \\u043d\\u0435 \\u043f\\u0440\\u0430\\u0432\\u0438\\u0442\\u0441\\u044f, \\u0440\\u0430\\u0437\\u043c\\u0435\\u0440 \\u043d\\u0435 \\u0437\\u0430\\u0434\\u0430\\u0451\\u0442\\u0441\\u044f. \\u041f\\u043e\\u0437\\u0430 \\u2014\r\n   \\u043d\\u0435\\u0439\\u0442\\u0440\\u0430\\u043b\\u044c\\u043d\\u0430\\u044f \\u0441\\u0442\\u043e\\u0439\\u043a\\u0430 \\u043c\\u0438\\u043d\\u0438\\u0430\\u0442\\u044e\\u0440\\u044b, \\u0440\\u0443\\u043a\\u0438 \\u043e\\u0442\\u0434\\u0435\\u043b\\u0435\\u043d\\u044b \\u043e\\u0442 \\u043a\\u043e\\u0440\\u043f\\u0443\\u0441\\u0430, \\u043e\\u0440\\u0443\\u0436\\u0438\\u0435 \\u0432 `WEAPON_HAND`; \\u043d\\u0435 A/T-\\u043f\\u043e\\u0437\\u0430 (`rig-contract.json` \\u2192\r\n   `rest_pose`). \\u0421\\u0435\\u0442\\u043a\\u0430 \\u2014 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043d\\u0430 \\u043b\\u0438\\u0441\\u0442\\u0435 \\u043f\\u0440\\u0438\\u0451\\u043c\\u043a\\u0438:\r\n   `python tools/art/concept/check_concept_views.py --set <\\u043f\\u0430\\u043f\\u043a\\u0430 \\u0432\\u0438\\u0434\\u043e\\u0432> --key <key> --views front,side,back --role <ROLE> --palette <\\u043f\\u0430\\u043f\\u043a\\u0430>/palette.json --sheet`\r\n   \\u2192 `checks-report.json` + `sheet-<key>.png` (\\u043a\\u043e\\u0434 0 \\u2014 0 FAIL, 1 \\u2014 \\u0435\\u0441\\u0442\\u044c FAIL, 2 \\u2014 \\u043e\\u0448\\u0438\\u0431\\u043a\\u0430 \\u0432\\u0445\\u043e\\u0434\\u0430 \\u0438\\u043b\\u0438 \\u0441\\u0431\\u043e\\u0439 \\u0438\\u043d\\u0441\\u0442\\u0440\\u0443\\u043c\\u0435\\u043d\\u0442\\u0430:\r\n   \\u043d\\u0435 FAIL, \\u0431\\u0435\\u0437 \\u043f\\u0435\\u0440\\u0435\\u0433\\u0435\\u043d\\u0435\\u0440\\u0430\\u0446\\u0438\\u0438; \\u043f\\u0430\\u0439\\u043f cp1251 \\u0438\\u043d\\u0441\\u0442\\u0440\\u0443\\u043c\\u0435\\u043d\\u0442 \\u043d\\u0435 \\u0440\\u043e\\u043d\\u044f\\u0435\\u0442); \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a \\u0441\\u043c\\u043e\\u0442\\u0440\\u0438\\u0442 \\u043b\\u0438\\u0441\\u0442 \\u0432 \\u0446\\u0432\\u0435\\u0442\\u0435, \\u0432 \\u0441\\u0435\\u0440\\u043e\\u043c \\u0438 \\u0441\\u0438\\u043b\\u0443\\u044d\\u0442 \\u043d\\u0430 \\u0431\\u0435\\u043b\\u043e\\u043c\r\n   (`docs/game-design/visual/02-visual-design.md` \\xa78.6, \\u0448\\u0430\\u0433 1).\r\n5. \\u0422\\u043e\\u043d\\u043a\\u0438\\u0435 \\u044d\\u043b\\u0435\\u043c\\u0435\\u043d\\u0442\\u044b (\\u0442\\u0435\\u0442\\u0438\\u0432\\u0430, \\u0434\\u0440\\u0435\\u0432\\u043a\\u043e, \\u0441\\u0442\\u0440\\u0435\\u043b\\u044b) \\u043d\\u0430 \\u043a\\u043e\\u043d\\u0446\\u0435\\u043f\\u0442\\u0435 \\u2014 \\u043d\\u0435 FAIL, \\u0432 \\u043f\\u0440\\u043e\\u043c\\u043f\\u0442\\u0435 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\xabthin parts readable\\xbb; \\u0438\\u0445\r\n   \\u0447\\u0438\\u0442\\u0430\\u0435\\u043c\\u043e\\u0441\\u0442\\u044c \\u0440\\u0435\\u0448\\u0430\\u044e\\u0442 \\u044d\\u0442\\u0430\\u043f 3 (\\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u044c) \\u0438 \\u044d\\u0442\\u0430\\u043f 4 (\\u0431\\u0430\\u043b\\u043b\\u044b F/T). \\u0420\\u0435\\u0442\\u0440\\u0430\\u0438 \\u2014 \\u2264 4 \\u0433\\u0435\\u043d\\u0435\\u0440\\u0430\\u0446\\u0438\\u0438 \\u043d\\u0430 \\u0432\\u0438\\u0434, `CORRECTION:` \\u2264 3 \\u0441\\u0442\\u0440\\u043e\\u043a\r\n   \\u0434\\u043b\\u044f \\u043b\\u044e\\u0431\\u043e\\u0433\\u043e \\u0432\\u0438\\u0434\\u0430 (\\u0431\\u043b\\u043e\\u043a \\u0434\\u043e\\u0441\\u043b\\u043e\\u0432\\u043d\\u043e \\u0432 \\u0448\\u0430\\u0431\\u043b\\u043e\\u043d\\u0430\\u0445 \\u0437\\u0430\\u0434\\u0430\\u043d\\u0438\\u0439 1a/1c). \\u0413\\u0435\\u043d\\u0435\\u0440\\u0430\\u0446\\u0438\\u0438 \\u0437\\u0430\\u043f\\u0443\\u0441\\u043a\\u0430 \\u0438\\u0441\\u0447\\u0435\\u0440\\u043f\\u0430\\u043d\\u044b, \\u0430 \\u043f\\u0443\\u043d\\u043a\\u0442 \\u0447\\u0435\\u043a-\\u043b\\u0438\\u0441\\u0442\\u0430 Codex\r\n   \\u043f\\u0440\\u043e\\u0432\\u0430\\u043b\\u0435\\u043d \\u043f\\u0440\\u0438 0 FAIL \\u0430\\u0432\\u0442\\u043e\\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043e\\u043a \\u2014 \\u043b\\u0438\\u0441\\u0442 \\u0438\\u0434\\u0451\\u0442 \\u043a \\u043f\\u0440\\u0438\\u0451\\u043c\\u043a\\u0435 \\u0441 \\u043f\\u043e\\u043c\\u0435\\u0442\\u043a\\u043e\\u0439 `verification.json#limit_reached`, \\u0440\\u0435\\u0448\\u0430\\u0435\\u0442\r\n   \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a (`references/concept-sheet.md` \\xa75.5 \\u043f.5). \\u0426\\u0438\\u043a\\u043b \\u2014 \\u043e\\u0434\\u043d\\u0430 \\u043f\\u0440\\u0438\\u0451\\u043c\\u043a\\u0430 \\u043b\\u0438\\u0441\\u0442\\u0430; \\u2264 3 \\u0446\\u0438\\u043a\\u043b\\u0430 \\u043f\\u043e\\u0441\\u043b\\u0435 \\u043f\\u0435\\u0440\\u0432\\u043e\\u0439 \\u043f\\u0440\\u0438\\u0451\\u043c\\u043a\\u0438\r\n   (r1\\u2026r4), \\u0434\\u0430\\u043b\\u044c\\u0448\\u0435 \\xa75 \\u043f.4.\r\n6. \\u0412\\u044b\\u0445\\u043e\\u0434: 0 FAIL \\u0438 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0430 kind `concept` \\u0441 `score` \\u2265 8,0.\r\n\r\n**\\u042d\\u0442\\u0430\\u043f 2 \\u2014 Tripo H2** (`references/tripo3d-stages.md`: 12 \\u0438\\u043d\\u0441\\u0442\\u0440\\u0443\\u043c\\u0435\\u043d\\u0442\\u043e\\u0432 Studio, \\u044d\\u043a\\u0441\\u043f\\u043e\\u0440\\u0442, API v3, \\u0446\\u0435\\u043d\\u044b).\r\n1. \\u0414\\u043e \\u043a\\u043b\\u0438\\u043a\\u0430 \\u0441\\u0432\\u0435\\u0440\\u0438\\u0442\\u044c sha256 \\u0432\\u0445\\u043e\\u0434\\u043e\\u0432 \\u0441\\u043e \\u0432\\u0441\\u0435\\u043c\\u0438 `<ASSET_ID>/source-specs/*.json` (\\u043a\\u043e\\u0434 3 `prepare-generation` \\u043b\\u043e\\u0432\\u0438\\u0442 \\u0434\\u0443\\u0431\\u043b\\u044c\r\n   \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u0432\\u043d\\u0443\\u0442\\u0440\\u0438 run). CLI: `init` \\u0432 `generation-request/` \\u0441 `--primary-source tripo-pending`, \\u043f\\u043e\\u0442\\u043e\\u043c\r\n   `prepare-generation --dry-run`.\r\n2. \\u0421\\u043b\\u043e\\u0442\\u044b: FRONT = front, \\u0441\\u043b\\u043e\\u0442 `SIDE_VIEW` = side (\\u043f\\u043e \\u0443\\u043c\\u043e\\u043b\\u0447\\u0430\\u043d\\u0438\\u044e LEFT, HANDBOOK \\xa73.2 \\u043f.3), BACK = back, \\u0432\\u0442\\u043e\\u0440\\u043e\\u0439 \\u0431\\u043e\\u043a\\u043e\\u0432\\u043e\\u0439\r\n   \\u0441\\u043b\\u043e\\u0442 \\u043f\\u0443\\u0441\\u0442 (`references/tripo3d-stages.md` \\xa75.5). \\u041e\\u043f\\u0435\\u0440\\u0430\\u0446\\u0438\\u0438: H3.1 \\xab\\u043f\\u043e \\u0447\\u0430\\u0441\\u0442\\u044f\\u043c\\xbb 60 \\u2192 \\u0442\\u0435\\u043a\\u0441\\u0442\\u0443\\u0440\\u0430 8K \\xab\\u0423\\u0434\\u0430\\u043b\\u0438\\u0442\\u044c \\u043e\\u0441\\u0432\\u0435\\u0449\\u0435\\u043d\\u0438\\u0435\\xbb\r\n   30 \\u2192 PBR 5; \\u043f\\u0435\\u0440\\u0435\\u0434 \\u043a\\u0430\\u0436\\u0434\\u043e\\u0439 \\u2014 `ledger.py check --service tripo --next-cost <\\u0446\\u0435\\u043d\\u0430 \\u0441 \\u043a\\u043d\\u043e\\u043f\\u043a\\u0438> --balance <\\u0431\\u0430\\u043b\\u0430\\u043d\\u0441>` (\\u043a\\u043e\\u0434 0),\r\n   \\u043f\\u043e\\u0441\\u043b\\u0435 \\u2014 \\u0431\\u0430\\u043b\\u0430\\u043d\\u0441 \\u0438 \\u0441\\u0442\\u0440\\u043e\\u043a\\u0430 `ledger.py add --task <VISUAL_CARD_ID>`.\r\n3. \\u0412\\u044b\\u0445\\u043e\\u0434 \\u2014 \\u0447\\u0435\\u043a-\\u043b\\u0438\\u0441\\u0442 \\u044d\\u0442\\u0430\\u043f\\u0430 2: GLB \\u0432 `source/` \\u0441 \\u0434\\u043b\\u0438\\u043d\\u043e\\u0439 \\u043f\\u043e \\u0437\\u0430\\u0433\\u043e\\u043b\\u043e\\u0432\\u043a\\u0443, source-spec, `reports/tripo-run.json`,\r\n   `claims.art_accepted: false`.\r\n\r\n**\\u042d\\u0442\\u0430\\u043f 3 \\u2014 \\u0441\\u0431\\u043e\\u0440\\u043a\\u0430 \\u0432 Blender** (HANDBOOK \\xa74.1\\u20134.4, `references/acceptance-and-blender.md`).\r\n1. \\u0414\\u043e \\u043f\\u0435\\u0440\\u0432\\u043e\\u0433\\u043e \\u043f\\u0440\\u043e\\u0433\\u043e\\u043d\\u0430 \\u2014 \\u0440\\u0435\\u0433\\u0438\\u0441\\u0442\\u0440\\u0430\\u0446\\u0438\\u044f \\u044d\\u0442\\u0430\\u043f\\u0430 3 (`references/new-character-registration.md` \\xa73): `CHARACTER` \\u0432\r\n   `docs/art-pipeline/rig/rig-contract.json` \\u2192 `skeletons.UM_HUMANOID_17_v2.characters` \\u0441 \\u043f\\u043e\\u0434\\u044a\\u0451\\u043c\\u043e\\u043c `revision`;\r\n   \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043a\\u0430 `python -m unittest tools/tripo-pipeline/tests/test_rig_rules.py` \\u2192 OK. \\u0421\\u0442\\u043e\\u0440\\u043e\\u043d\\u0443 \\u043e\\u0440\\u0443\\u0436\\u0438\\u044f `h2_bake` \\u0431\\u0435\\u0440\\u0451\\u0442 \\u0438\\u0437\r\n   \\u043a\\u043e\\u043d\\u0442\\u0440\\u0430\\u043a\\u0442\\u0430 \\u043f\\u043e `rig.character`; \\u0447\\u0430\\u0441\\u0442\\u044c \\u0438 \\u043c\\u0435\\u0448 \\u043e\\u0440\\u0443\\u0436\\u0438\\u044f, \\u043a\\u043e\\u0441\\u0442\\u0438 `weapon.*` \\u0438 \\u0441\\u043e\\u043a\\u0435\\u0442 `Weapon` \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u044f \\u2014 \\u043f\\u043e `WEAPON_HAND`\r\n   (\\u0442\\u0430\\u0431\\u043b\\u0438\\u0446\\u0430 \\u0414-1, \\u0442\\u0430\\u043c \\u0436\\u0435 \\xa72; \\u043f\\u0440\\u0430\\u0432\\u0448\\u0430 \\u2014 \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043a\\u0430 `export_frame_bow_on_rotated_right`, \\u0431\\u0435\\u0437 \\u043e\\u0440\\u0443\\u0436\\u0438\\u044f \\u2014 \\u0431\\u0435\\u0437 \\u0447\\u0430\\u0441\\u0442\\u0438 `weapon`).\r\n2. \\u041d\\u043e\\u0432\\u044b\\u0439 \\u0444\\u0430\\u0439\\u043b \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u044f `<key>-h2-bake-h2.json` \\u043f\\u043e HANDBOOK \\xa74.2 (\\u043e\\u0431\\u0440\\u0430\\u0437\\u0435\\u0446 \\u2014 `medusa-h2-bake-h2.json`, \\u043d\\u0435 \\u0434\\u0440\\u0430\\u0439\\u0432\\u0435\\u0440\\u044b\r\n   `h2_bake_arthur/merlin/harpy`). \\u041a\\u0430\\u0436\\u0434\\u044b\\u0439 \\u043a\\u043b\\u044e\\u0447 \\u043f\\u0440\\u043e\\u0439\\u0442\\u0438, \\u043a\\u043e\\u043e\\u0440\\u0434\\u0438\\u043d\\u0430\\u0442\\u044b \\u043a\\u043e\\u0441\\u0442\\u0435\\u0439 \\u0437\\u0430\\u0434\\u0430\\u0442\\u044c \\u043f\\u043e \\u043d\\u043e\\u0432\\u043e\\u0439 \\u0433\\u0435\\u043e\\u043c\\u0435\\u0442\\u0440\\u0438\\u0438. \\u0411\\u043b\\u043e\\u043a `preview`\r\n   (h2-bake 0.6.1): `previous_candidate` \\u0438 `baseline` **\\u0443\\u0434\\u0430\\u043b\\u0438\\u0442\\u044c** \\u2014 \\u044d\\u0442\\u043e \\u043f\\u0440\\u0435\\u0436\\u043d\\u0438\\u0439 \\u043a\\u0430\\u043d\\u0434\\u0438\\u0434\\u0430\\u0442 W4-B \\u0438 \\u0442\\u0435\\u043a\\u0441\\u0442\\u0443\\u0440\\u044b H2 \\u0434\\u043e H2.1\r\n   Medusa; \\u0443 \\u043d\\u043e\\u0432\\u043e\\u0433\\u043e \\u043f\\u0435\\u0440\\u0441\\u043e\\u043d\\u0430\\u0436\\u0430 \\u0438\\u0445 \\u043d\\u0435\\u0442, \\u0431\\u0435\\u0437 \\u043a\\u043b\\u044e\\u0447\\u0435\\u0439 \\u0441\\u0442\\u0430\\u0434\\u0438\\u044f `preview` \\u0438 `compose` \\u043e\\u0431\\u0445\\u043e\\u0434\\u044f\\u0442\\u0441\\u044f \\u0431\\u0435\\u0437 \\u043d\\u0438\\u0445. `concepts` \\u2014 \\u0441\\u0432\\u043e\\u0438\r\n   \\u0432\\u0438\\u0434\\u044b; `closeups`, `pose_closeups`, `channel_views` \\u043f\\u0435\\u0440\\u0435\\u043f\\u0438\\u0441\\u0430\\u0442\\u044c \\u043f\\u043e\\u0434 \\u0441\\u0432\\u043e\\u044e \\u0444\\u0438\\u0433\\u0443\\u0440\\u0443 (\\u0446\\u0435\\u043b\\u0438 \\u0432 \\u043c\\u0435\\u0442\\u0440\\u0430\\u0445 \\u0444\\u0438\\u043d\\u0430\\u043b\\u044c\\u043d\\u043e\\u0439 \\u0440\\u0430\\u043c\\u043a\\u0438,\r\n   `pose_closeups` \\u2014 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043f\\u043e\\u0437\\u044b `st_seams.pose`, \\u043c\\u043e\\u0436\\u043d\\u043e `[]`); `frame` = `{\"checks_report\":\r\n   \"<\\u043f\\u0430\\u043f\\u043a\\u0430 \\u0432\\u0438\\u0434\\u043e\\u0432>/checks-report.json\", \"side\": \"<SIDE_VIEW>\"}` \\u2014 \\u043e\\u0440\\u0442\\u043e-\\u043a\\u0430\\u0434\\u0440\\u044b \\u043f\\u043e \\u043a\\u0430\\u0434\\u0440\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044e \\u0441\\u0432\\u043e\\u0435\\u0433\\u043e \\u043a\\u043e\\u043d\\u0446\\u0435\\u043f\\u0442\\u0430\r\n   (`h2_bake/framing.py`; \\u0431\\u0435\\u0437 \\u043a\\u043b\\u044e\\u0447\\u0430 \\u2014 \\u043a\\u0430\\u043d\\u043e\\u043d Medusa 1021 \\xd7 1540). \\u0422\\u043e\\u0442 \\u0436\\u0435 `frame` \\u2014 \\u0432 look-dev \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u0435\r\n   `<key>-h2-lookdev.json` (\\u0432\\u0435\\u0440\\u0445\\u043d\\u0438\\u0439 \\u0443\\u0440\\u043e\\u0432\\u0435\\u043d\\u044c): `ld_measure` \\u0441\\u0440\\u0430\\u0432\\u043d\\u0438\\u0432\\u0430\\u0435\\u0442 \\u043a\\u043e\\u043d\\u0446\\u0435\\u043f\\u0442 \\u0441 \\u043f\\u0440\\u043e\\u0445\\u043e\\u0434\\u043e\\u043c ID \\u043f\\u0438\\u043a\\u0441\\u0435\\u043b\\u044c \\u0432 \\u043f\\u0438\\u043a\\u0441\\u0435\\u043b\\u044c \\u0438\r\n   \\u043e\\u0442\\u043a\\u0430\\u0437\\u044b\\u0432\\u0430\\u0435\\u0442 \\u043a\\u043e\\u043d\\u0446\\u0435\\u043f\\u0442\\u0443 \\u0434\\u0440\\u0443\\u0433\\u043e\\u0433\\u043e \\u0430\\u0441\\u043f\\u0435\\u043a\\u0442\\u0430, \\u0430 `tone.json` (\\u043f\\u043e\\u0442\\u043e\\u043b\\u043e\\u043a T \\u044d\\u0442\\u0430\\u043f\\u0430 4) \\u0432\\u0435\\u0440\\u0435\\u043d \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043f\\u0440\\u0438 \\u0442\\u0430\\u043a\\u043e\\u0439 \\u0440\\u0430\\u043c\\u043a\\u0435.\r\n3. `python tools/tripo-pipeline/blender/h2_bake/run_h2_bake.py` \\u043f\\u043e \\u043e\\u0434\\u043d\\u043e\\u0439 \\u0441\\u0442\\u0430\\u0434\\u0438\\u0438 (HANDBOOK \\xa74.3), \\u0437\\u0430\\u0442\\u0435\\u043c\r\n   `--mode lookdev` \\u0438 `--mode teamaccent` (HANDBOOK \\xa74.4). TeamAccent (`team_accent` \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u044f, \\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u043e 5\\u201312 % \\u043f\\u043b\\u043e\\u0449\\u0430\\u0434\\u0438 \\u2014\r\n   `docs/art-pipeline/material-library/team-accent.md`): \\u043a\\u043e\\u043c\\u043f\\u043e\\u043d\\u0435\\u043d\\u0442\\u044b `hem` (\\u043f\\u043e\\u043b\\u043e\\u0441\\u0430 \\u0442\\u043a\\u0430\\u043d\\u0438 `cloth_class` \\u0432\\u0434\\u043e\\u043b\\u044c \\u043a\\u0440\\u043e\\u043c\\u043a\\u0438\r\n   \\u043a\\u043b\\u0430\\u0441\\u0441\\u0430 `band_class` \\u043d\\u0438\\u0436\\u0435 `band_z_max_m`) \\u0438 `ribbon` (\\u0440\\u0435\\u043c\\u0435\\u043d\\u044c/\\u043f\\u0435\\u0440\\u0435\\u0432\\u044f\\u0437\\u044c \\u043a\\u043b\\u0430\\u0441\\u0441\\u0430 `class` \\u0432\\u044b\\u0448\\u0435 `z_min_m`) \\u2014 \\u043a\\u0430\\u0436\\u0434\\u044b\\u0439\r\n   \\u043d\\u0435\\u043e\\u0431\\u044f\\u0437\\u0430\\u0442\\u0435\\u043b\\u0435\\u043d, \\u043d\\u0443\\u0436\\u0435\\u043d \\u0445\\u043e\\u0442\\u044f \\u0431\\u044b \\u043e\\u0434\\u0438\\u043d. \\u0422\\u043a\\u0430\\u043d\\u044c \\u0431\\u0435\\u0437 \\u043a\\u0440\\u043e\\u043c\\u043a\\u0438 (\\u043b\\u0430\\u0442\\u044b, \\u0442\\u0443\\u043d\\u0438\\u043a\\u0430 \\u0431\\u0435\\u0437 \\u043a\\u0430\\u0439\\u043c\\u044b) \\u2014 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e `ribbon` \\u043d\\u0430 \\u043f\\u043e\\u044f\\u0441\\u0435, \\u043f\\u0435\\u0440\\u0435\\u0432\\u044f\\u0437\\u0438,\r\n   \\u043a\\u043e\\u043b\\u0447\\u0430\\u043d\\u043d\\u043e\\u0439 \\u043b\\u044f\\u043c\\u043a\\u0435 \\u0438\\u043b\\u0438 \\u043f\\u043b\\u0430\\u0449\\u0435 (`class` \\u2014 \\u0438\\u0445 \\u043a\\u043b\\u0430\\u0441\\u0441 \\u0441 `teamDyeAllowed`; \\u0431\\u0435\\u0437 `hem` \\u043e\\u0431\\u044f\\u0437\\u0430\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e \\u0437\\u0430\\u0434\\u0430\\u0442\\u044c `cloth_class`/`trim_class`\r\n   \\u0432\\u0435\\u0440\\u0445\\u043d\\u0435\\u0433\\u043e \\u0443\\u0440\\u043e\\u0432\\u043d\\u044f \\u2014 \\u043e\\u0441\\u043d\\u043e\\u0432\\u043d\\u0430\\u044f \\u0442\\u043a\\u0430\\u043d\\u044c \\u0438 \\u043e\\u0442\\u0434\\u0435\\u043b\\u043a\\u0430 \\u0434\\u043b\\u044f \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043a\\u0438 `dress_parts` \\u0438 \\u043a\\u043e\\u043d\\u0442\\u0440\\u0430\\u0441\\u0442\\u0430 `ta_report`). \\u041f\\u0443\\u0441\\u0442\\u043e\\u0439 \\u043a\\u043e\\u043c\\u043f\\u043e\\u043d\\u0435\\u043d\\u0442 \\u043f\\u0440\\u043e\\u043f\\u0443\\u0441\\u043a\\u0430\\u0435\\u0442\\u0441\\u044f \\u0441 `skipped` \\u0432 \\u043e\\u0442\\u0447\\u0451\\u0442\\u0435; \\u0434\\u043e\\u043b\\u044e \\u0440\\u0435\\u0448\\u0430\\u0435\\u0442\r\n   `area_share_range` (5\\u201312 %). \\u041d\\u0438 \\u043e\\u0434\\u0438\\u043d \\u043a\\u043e\\u043c\\u043f\\u043e\\u043d\\u0435\\u043d\\u0442 \\u043d\\u0435 \\u0434\\u0430\\u043b \\u0430\\u043a\\u0446\\u0435\\u043d\\u0442\\u0430 \\u2014 `ta_maps` \\u043f\\u0430\\u0434\\u0430\\u0435\\u0442 \\u0441 \\u0441\\u043e\\u043e\\u0431\\u0449\\u0435\\u043d\\u0438\\u0435\\u043c: \\u0432\\u044b\\u0431\\u0440\\u0430\\u0442\\u044c \\u043a\\u043b\\u0430\\u0441\\u0441\\u044b\r\n   \\u0437\\u0430\\u043d\\u043e\\u0432\\u043e (\\u043d\\u0435 \\u0441\\u0442\\u043e\\u043f; \\u043d\\u043e\\u0432\\u044b\\u0439 \\u0440\\u0435\\u0436\\u0438\\u043c \\u0438\\u043b\\u0438 \\u043d\\u043e\\u0432\\u044b\\u0439 \\u043a\\u043b\\u0430\\u0441\\u0441 MatID \\u2014 \\u0441\\u0442\\u043e\\u043f \\xa75 \\u043f.5). \\u0422\\u043e\\u043d\\u043a\\u043e\\u0435 \\u043e\\u0440\\u0443\\u0436\\u0438\\u0435 (\\u0442\\u0435\\u0442\\u0438\\u0432\\u0430, \\u0441\\u0442\\u0440\\u0435\\u043b\\u044b) \\u2014 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u0441\\u0440\\u0435\\u0434\\u0441\\u0442\\u0432\\u0430\\u043c\\u0438\r\n   \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u044f: `retopo.target_tris` \\u0438 `retopo.dense_regions` \\u0434\\u043b\\u044f \\u0447\\u0430\\u0441\\u0442\\u0438 \\u043e\\u0440\\u0443\\u0436\\u0438\\u044f, `uv.texel_priority` (`st_retopo.py:217-227`,\r\n   `st_uv.py:417`). \\u0420\\u0435\\u0436\\u0438\\u043c\\u0430 \\u0443\\u0442\\u043e\\u043b\\u0449\\u0435\\u043d\\u0438\\u044f \\u0438 \\u043c\\u043e\\u0441\\u0442\\u0430 \\u0432 generic `h2_bake` \\u043d\\u0435\\u0442 (grep `solidify|thicken|bridge` \\u043f\\u0443\\u0441\\u0442). \\u041d\\u0435\r\n   \\u0447\\u0438\\u0442\\u0430\\u0435\\u0442\\u0441\\u044f \\u043d\\u0430 \\u044d\\u0442\\u0430\\u043f\\u0435 4 \\u2014 \\u043f\\u0443\\u043d\\u043a\\u0442 `rework_fix_list` (\\u044d\\u0442\\u0430\\u043f 5, \\u0442\\u043e\\u0442 \\u0436\\u0435 \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u044c\\u043d\\u044b\\u0439 \\u043f\\u0443\\u0442\\u044c), \\u0430 \\u0435\\u0441\\u043b\\u0438 \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u044c \\u043d\\u0435 \\u043f\\u043e\\u043c\\u043e\\u0433 \\u2014\r\n   \\u043f\\u043e\\u043c\\u0435\\u0442\\u043a\\u0430 \\xab\\u043d\\u0435 \\u0437\\u0430\\u043a\\u0440\\u044b\\u0442\\u043e\\xbb, \\u0431\\u0435\\u0437 \\u0441\\u0442\\u043e\\u043f\\u0430. \\u041e\\u0440\\u0443\\u0436\\u0438\\u0435 \\u0431\\u0435\\u0437 \\u0445\\u0432\\u0430\\u0442\\u0430 (\\u043d\\u0443\\u0436\\u0435\\u043d \\u043c\\u043e\\u0441\\u0442-\\u0446\\u0438\\u043b\\u0438\\u043d\\u0434\\u0440) \\u2014 \\u0441\\u0442\\u043e\\u043f \\xa75 \\u043f.5.\r\n4. \\u0412\\u044b\\u0445\\u043e\\u0434: \\u043c\\u0430\\u0440\\u043a\\u0435\\u0440\\u044b \\u0432\\u0441\\u0435\\u0445 \\u0441\\u0442\\u0430\\u0434\\u0438\\u0439, `probes-report.json` 7/7 \\u043d\\u0430 .blend \\u0438 FBX, `determinism-report.json`, `ld-*`, `ld-team-*`.\r\n\r\n**\\u042d\\u0442\\u0430\\u043f 3 \\u2014 \\u043f\\u0440\\u043e\\u043f** (\\u0432\\u0435\\u0442\\u043a\\u0430 `prop`; \\u0440\\u0435\\u0433\\u0438\\u0441\\u0442\\u0440\\u0430\\u0446\\u0438\\u044f \\u043f\\u0435\\u0440\\u0441\\u043e\\u043d\\u0430\\u0436\\u0430, h2_bake, look-dev \\u0438 TeamAccent \\u043d\\u0435 \\u0434\\u0435\\u043b\\u0430\\u044e\\u0442\\u0441\\u044f).\r\n1. Run-\\u043a\\u0430\\u0442\\u0430\\u043b\\u043e\\u0433 `R=art/pipeline-candidates/<ASSET_ID>/<YYYYMMDD>-prop-build` (\\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u0435 \\u0441\\u043a\\u0438\\u043b\\u043b\\u0430; \\u043d\\u043e\\u0432\\u044b\\u0439 \\u043d\\u0430 \\u043a\\u0430\\u0436\\u0434\\u044b\\u0439 \\u043f\\u0440\\u043e\\u0433\\u043e\\u043d,\r\n   \\u0434\\u043e\\u0440\\u0430\\u0431\\u043e\\u0442\\u043a\\u0430 \\u2014 `\\u2026-prop-build-r<N>`). \\u0412\\u0445\\u043e\\u0434 \\u2014 GLB \\u044d\\u0442\\u0430\\u043f\\u0430 2 \\u0438\\u0437 `<YYYYMMDD>-prop-tripo/source/`.\r\n2. HANDBOOK \\xa75 \\u043f.1\\u20135: `candidate-params.json` \\u043f\\u043e \\u043e\\u0431\\u0440\\u0430\\u0437\\u0446\\u0443 \\u043f\\u0440\\u043e\\u043f\\u0430 \\u0442\\u043e\\u0433\\u043e \\u0436\\u0435 \\u0432\\u0438\\u0434\\u0430\r\n   (`art/pipeline-candidates/ASSET-DECOR-KIT-001/20260928-{p15-barrel,lantern-tripo-h31}/reports/candidate-params.json`),\r\n   `target_height_m` = `FIGURE_HEIGHT_M` \\u0437\\u0430\\u044f\\u0432\\u043a\\u0438, `asset_name` `SM_<Name>`, `texture_prefix` `T_<Name>`; \\u0440\\u0435\\u043c\\u043e\\u043d\\u0442\r\n   \\u0433\\u0435\\u043e\\u043c\\u0435\\u0442\\u0440\\u0438\\u0438, \\u0444\\u0440\\u043e\\u043d\\u0442, \\u0441\\u0432\\u0435\\u0447\\u0435\\u043d\\u0438\\u0435; \\u0441\\u0431\\u043e\\u0440\\u043a\\u0430 `static_prop_candidate.py` \\u0438 read-back `check_static_prop_fbx.py`.\r\n3. \\u0412\\u044b\\u0445\\u043e\\u0434: `$R/export/SM_<Name>.fbx` + `T_<Name>_{BC,N,ORM}.png`, `$R/reports/candidate-report.json` \\u0441\r\n   `checks_passed: true` \\u0438 \\u043f\\u0443\\u0441\\u0442\\u044b\\u043c \\u0441\\u043f\\u0438\\u0441\\u043a\\u043e\\u043c \\u043d\\u0435\\u043f\\u0440\\u043e\\u0439\\u0434\\u0435\\u043d\\u043d\\u044b\\u0445 `checks`, `$R/reports/fbx-readback.json`. \\u0414\\u0430\\u043b\\u044c\\u0448\\u0435 \\u2014 \\u044d\\u0442\\u0430\\u043f 4 \\u0441\r\n   `--no-base` (`references/acceptance-and-blender.md` \\xa73).\r\n\r\n**\\u042d\\u0442\\u0430\\u043f 4 \\u2014 \\u043f\\u0440\\u0438\\u0451\\u043c\\u043a\\u0430 \\u043c\\u043e\\u0434\\u0435\\u043b\\u0438** (`references/acceptance-and-blender.md`). \\u041e\\u0431\\u044a\\u0435\\u043a\\u0442 \\u2014 \\u043e\\u0442\\u0433\\u0440\\u0443\\u0436\\u0430\\u0435\\u043c\\u044b\\u0439 H2LD-\\u043d\\u0430\\u0431\\u043e\\u0440.\r\n1. \\u041a\\u0430\\u0434\\u0440\\u044b: `python tools/art/acceptance/capture_acceptance_set.py --fbx <SK_<Key>_H2LD.fbx> --textures <dir> --out <evidence>/frames --key <Key> --side-view <SIDE_VIEW> --sheet art/imagegen/concept-<key>-codex/sheet-<key>.png`\r\n   \\u2192 8 `turn-*`, `close-{head,head-back,torso,torso-back,legs,legs-back,weapon,hands,base}`, `wire-{front,34,back}`,\r\n   `uv-layout.png`, `pose-01\\u202604` + `pose-03b`, `sheet.png`, `compare-{front,side,back}`, `tone.json` (\\u0438\\u0437\r\n   `measure-report.json` look-dev; \\u0443 \\u0433\\u0435\\u0440\\u043e\\u044f \\u0431\\u0435\\u0437 \\u043d\\u0435\\u0433\\u043e \\u2014 \\u043a\\u043e\\u0434 1), `frames.json` (`references/acceptance-and-blender.md` \\xa73).\r\n2. \\u0413\\u0435\\u0439\\u0442\\u044b PASS/FAIL \\u043f\\u043e \\u043e\\u0442\\u0447\\u0451\\u0442\\u0430\\u043c: G-TOPO (\\u043f\\u043e \\u0444\\u0438\\u043d\\u0430\\u043b\\u044c\\u043d\\u043e\\u043c\\u0443 FBX, `ld-fbx-report`), G-UV, G-TEX, G-RIG, G-NAMES. \\u0411\\u0430\\u043b\\u043b\\u044b S/F/T/D\r\n   0\\u20132, `score = round(sum / (2 \\xd7 n) \\xd7 10, 1)`; \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a \\u0432\\u043e\\u0437\\u0432\\u0440\\u0430\\u0449\\u0430\\u0435\\u0442 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e JSON, `card.json` \\u043f\\u0438\\u0448\\u0435\\u0442 \\u0437\\u0430\\u043f\\u0443\\u0441\\u043a\\u0430\\u044e\\u0449\\u0438\\u0439.\r\n   \\u041f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a \\xabSol 6.1 xhigh\\xbb \\u2014 `codex exec` \\u0441 `-c 'windows.sandbox=\"unelevated\"'` \\u0438 `--ignore-user-config`; \\u0441\\u0431\\u043e\\u0439\r\n   \\u043f\\u0435\\u0441\\u043e\\u0447\\u043d\\u0438\\u0446\\u044b (\\u043a\\u043e\\u0434 0, \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0430-\\u0437\\u0430\\u0433\\u043b\\u0443\\u0448\\u043a\\u0430) \\u2014 \\u0441\\u0431\\u043e\\u0439 \\u043e\\u043a\\u0440\\u0443\\u0436\\u0435\\u043d\\u0438\\u044f, \\u043d\\u0435 \\u043f\\u043e\\u043f\\u044b\\u0442\\u043a\\u0430 (`references/acceptance-and-blender.md` \\xa78.4).\r\n3. `python tools/art/acceptance/validate_card.py <card.json> --print-verdict --check-files`. \\u041a\\u043e\\u0434 0: `pass` \\u2192 \\u044d\\u0442\\u0430\\u043f 6;\r\n   `rework_blender` \\u2192 \\u044d\\u0442\\u0430\\u043f 5; `return_to_stage_1` \\u0438\\u043b\\u0438 `return_to_stage_2` (S < 1,5 \\u0438\\u043b\\u0438 \\u0434\\u0435\\u0444\\u0435\\u043a\\u0442 \\u0438\\u0441\\u0445\\u043e\\u0434\\u043d\\u0438\\u043a\\u0430) \\u2192 \\u043d\\u0430\\u0437\\u0430\\u0434;\r\n   \\u043f\\u043e\\u0441\\u043b\\u0435 r3 \\u0431\\u0435\\u0437 pass \\u2014 `escalate_user`. \\u041a\\u043e\\u0434 3 `needs_second_acceptor` (pass \\u0441 `score` 8,0\\u20138,4; \\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u043e \\u043e\\u0431\\u0449\\u0435\\u0435 \\u0434\\u043b\\u044f\r\n   \\u043c\\u043e\\u0434\\u0435\\u043b\\u0438, \\u043b\\u0438\\u0441\\u0442\\u0430 \\u043a\\u043e\\u043d\\u0446\\u0435\\u043f\\u0442\\u0430 \\u0438 \\u043a\\u043b\\u0438\\u043f\\u0430): \\u0432\\u0442\\u043e\\u0440\\u043e\\u0439 \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a \\u0434\\u0440\\u0443\\u0433\\u0438\\u043c \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u0435\\u043c \\u043d\\u0430 \\u0442\\u0435\\u0445 \\u0436\\u0435 \\u043a\\u0430\\u0434\\u0440\\u0430\\u0445 \\u2192 `card-2.json`, \\u0437\\u0430\\u0442\\u0435\\u043c\r\n   `validate_card.py card.json --second card-2.json --final-json final.json` \\u2014 \\u0438\\u0442\\u043e\\u0433 \\u043f\\u043e \\u043c\\u0438\\u043d\\u0438\\u043c\\u0443\\u043c\\u0443 \\u0438 \\u0431\\u043e\\u043b\\u0435\\u0435 \\u0441\\u0442\\u0440\\u043e\\u0433\\u043e\\u043c\\u0443\r\n   \\u043c\\u0430\\u0440\\u0448\\u0440\\u0443\\u0442\\u0443 (`references/acceptance-and-blender.md` \\xa76, \\xa78.5). \\u041a\\u043e\\u0434 1 \\u2014 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0430 \\u043d\\u0435\\u0432\\u0430\\u043b\\u0438\\u0434\\u043d\\u0430, \\u0431\\u0430\\u043b\\u043b\\u044b \\u043d\\u0435 \\u043f\\u0440\\u0430\\u0432\\u0438\\u0442\\u044c.\r\n   \\u0414\\u043e \\u0432\\u044b\\u0437\\u043e\\u0432\\u0430 \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a\\u0430 \\u2014 \\xab\\u0421\\u0432\\u0435\\u0440\\u043a\\u0430 \\u0432\\u0445\\u043e\\u0434\\u0430\\xbb (`references/acceptance-and-blender.md` \\xa73): \\u043b\\u0438\\u0441\\u0442 \\u0442\\u043e\\u0433\\u043e \\u0436\\u0435 \\u0430\\u0441\\u0441\\u0435\\u0442\\u0430\r\n   (`frames.json#sheet.key_match`), `accepted_object` = `frames.json#accepted_object`; S = 0 (\\u0434\\u0440\\u0443\\u0433\\u043e\\u0439 \\u043f\\u0435\\u0440\\u0441\\u043e\\u043d\\u0430\\u0436) \\u043f\\u043e\\u0441\\u043b\\u0435\r\n   \\u0432\\u0435\\u0440\\u043d\\u043e\\u0433\\u043e \\u0432\\u0445\\u043e\\u0434\\u0430 \\u2014 `return_to_stage_1`.\r\n\r\n**\\u042d\\u0442\\u0430\\u043f 5 \\u2014 \\u0434\\u043e\\u0440\\u0430\\u0431\\u043e\\u0442\\u043a\\u0430.** \\xabOpus xhigh\\xbb \\u043f\\u043e `rework_fix_list`. \\u041d\\u043e\\u0432\\u044b\\u0439 \\u0444\\u0430\\u0439\\u043b \\u043f\\u0440\\u043e\\u0444\\u0438\\u043b\\u044f \\u0438 \\u043d\\u043e\\u0432\\u044b\\u0439 run `\\u2026-r<N+1>`, \\u043f\\u0440\\u0435\\u0436\\u043d\\u0438\\u0439 \\u043d\\u0435\r\n\\u0442\\u0440\\u043e\\u0433\\u0430\\u0442\\u044c. \\u0421\\u0438\\u043b\\u0443\\u044d\\u0442, \\u043f\\u0440\\u043e\\u043f\\u043e\\u0440\\u0446\\u0438\\u0438 \\u0438 \\u043f\\u0430\\u043b\\u0438\\u0442\\u0440\\u0430 \\u0432 Blender \\u043d\\u0435 \\u043f\\u0440\\u0430\\u0432\\u044f\\u0442\\u0441\\u044f. \\u0416\\u0438\\u0432\\u043e\\u0439 Blender (`--backend mcp`) \\u2014 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043e\\u0441\\u043c\\u043e\\u0442\\u0440\r\n(HANDBOOK \\xa76). \\u0417\\u0430\\u0442\\u0435\\u043c \\u0441\\u043d\\u043e\\u0432\\u0430 \\u044d\\u0442\\u0430\\u043f 4 \\u043d\\u043e\\u0432\\u044b\\u043c \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a\\u043e\\u043c.\r\n\r\n**\\u042d\\u0442\\u0430\\u043f 6 \\u2014 \\u0430\\u043d\\u0438\\u043c\\u0430\\u0446\\u0438\\u044f, VFX, SFX** (`references/animation-vfx-sfx.md`, HANDBOOK \\xa72.6, \\xa72.8, \\xa74.5).\r\n1. \\u0420\\u0435\\u0433\\u0438\\u0441\\u0442\\u0440\\u0430\\u0446\\u0438\\u044f \\u044d\\u0442\\u0430\\u043f\\u0430 6 (`references/new-character-registration.md` \\xa74): `CHARS` \\u0438 `H2ANIM` \\u0432\r\n   `tools/tripo-pipeline/anim/clip_manifest.py`, `character.enum` \\u0432\r\n   `docs/art-pipeline/animation-library/clip-manifest.schema.json`; \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043a\\u0430 `clip_manifest.py build` \\u2192\r\n   `MANIFEST_CHECK PASS`. \\u0427\\u0435\\u0442\\u044b\\u0440\\u0435 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0438 \\u043a\\u043b\\u0438\\u043f\\u043e\\u0432 \\u0432 `06-tasks/anim.csv` (\\u043d\\u0443\\u0436\\u043d\\u044b \\u0434\\u043e \\u0442\\u0440\\u0430\\u0442 SYNTX \\u0438 \\u043b\\u0438\\u0441\\u0442\\u0443 AN-18) \\u0438 \\u0437\\u0430\\u043f\\u0438\\u0441\\u044c\r\n   `HEROES` \\u0432 `tools/art/anim/clip_review_sheet.py` (`Hero(...)` \\u0441 \\u044d\\u0442\\u0438\\u043c\\u0438 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0430\\u043c\\u0438, \\u04206-4) \\u2192\r\n   `clip_review_sheet.py --check` PASS. FX \\u0441\\u043f\\u043e\\u0441\\u043e\\u0431\\u043d\\u043e\\u0441\\u0442\\u0438 `tools/art/fx/fx_ability.py` \\u2014 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u0435\\u0441\\u043b\\u0438 \\u0443 \\u0433\\u0435\\u0440\\u043e\\u044f \\u0435\\u0441\\u0442\\u044c CUE-014\r\n   (\\u0442\\u0430\\u043c \\u0436\\u0435 \\xa76). `HIT_TYPE` \\u0432\\u044b\\u0431\\u0440\\u0430\\u0442\\u044c \\u0438 \\u0437\\u0430\\u043f\\u0438\\u0441\\u0430\\u0442\\u044c \\u0432 \\u0437\\u0430\\u044f\\u0432\\u043a\\u0443 (`references/animation-vfx-sfx.md` \\xa79).\r\n2. \\u041d\\u043e\\u0432\\u044b\\u0439 `<key>-h2anim.json` \\u0438 4 \\u043a\\u043b\\u0438\\u043f\\u0430 D-11: Idle, LungeAttack, HitReact, DeathSettle.\r\n   \\u0417\\u0430\\u0442\\u0435\\u043c `python tools/tripo-pipeline/anim/h2anim_run.py <spec>`.\r\n3. \\u041f\\u0440\\u0438\\u0451\\u043c\\u043a\\u0430 \\u043f\\u043e \\u043a\\u043b\\u0438\\u043f\\u0443: \\u0433\\u0435\\u0439\\u0442\\u044b `tools/tripo-pipeline/anim/validate_clip.py`,\r\n   `tools/tripo-pipeline/anim/clip_contact_check.py` \\u0438 \\u043c\\u0430\\u043d\\u0438\\u0444\\u0435\\u0441\\u0442; \\u0431\\u0430\\u043b\\u043b\\u044b R/C/D/L. \\u041a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0430 kind `anim` \\u0432\r\n   `evidence/acceptance-anim/<YYYYMMDD>-r<N>/<Clip>/card.json`. \\u0413\\u0435\\u0440\\u043e\\u0439 \\u043f\\u0440\\u043e\\u0445\\u043e\\u0434\\u0438\\u0442, \\u043a\\u043e\\u0433\\u0434\\u0430 \\u0432\\u0441\\u0435 4 \\u043a\\u043b\\u0438\\u043f\\u0430 `pass`.\r\n4. \\u0417\\u0432\\u0443\\u043a\\u0438 \\u0438 FX \\u2014 \\u043f\\u043e \\u0441\\u043b\\u043e\\u0442\\u0430\\u043c `docs/game-design/audio/02-audio-design.md` \\xa78.1 \\u0438 CUE-011/013/014 \\u0432\r\n   `docs/unreal/contracts/cue-dispatcher/cue-table.json`; \\u0446\\u0435\\u043f\\u043e\\u0447\\u043a\\u0430 \\u043a\\u043e\\u043c\\u0430\\u043d\\u0434 \\u2014 \\u0432 \\u0441\\u043f\\u0440\\u0430\\u0432\\u043e\\u0447\\u043d\\u0438\\u043a\\u0435. \\u041f\\u0440\\u043e\\u0441\\u043b\\u0443\\u0448\\u0438\\u0432\\u0430\\u043d\\u0438\\u0435\r\n   \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u0435\\u043c \\u043d\\u0435 \\u0441\\u0442\\u043e\\u043f: \\u0430\\u0433\\u0435\\u043d\\u0442 \\u043f\\u0440\\u0438\\u043d\\u0438\\u043c\\u0430\\u0435\\u0442 \\u043f\\u043e \\u0434\\u0435\\u043b\\u0435\\u0433\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044e \\u0441 \\u043f\\u043e\\u043c\\u0435\\u0442\\u043a\\u043e\\u0439.\r\n\r\n**\\u042d\\u0442\\u0430\\u043f 7 \\u2014 UE \\u0438 \\u0438\\u0433\\u0440\\u0430** (`references/ue-import-package.md`, HANDBOOK \\xa74.6\\u20134.7, `references/new-character-registration.md`\r\n\\xa75). \\u041f\\u043e\\u0434\\u043a\\u043b\\u044e\\u0447\\u0435\\u043d\\u0438\\u0435 S08 \\u0434\\u043b\\u044f \\u0433\\u0435\\u0440\\u043e\\u044f \\u0438 \\u043f\\u043e\\u043c\\u043e\\u0449\\u043d\\u0438\\u043a\\u0430 \\u043e\\u0431\\u044f\\u0437\\u0430\\u0442\\u0435\\u043b\\u044c\\u043d\\u043e. \\u0414\\u0432\\u0430 \\u0448\\u0430\\u0433\\u0430 \\u0441 \\u0440\\u0430\\u0437\\u043d\\u043e\\u0439 \\u0441\\u0440\\u0435\\u0434\\u043e\\u0439.\r\n\r\n**7a \\u2014 \\u0432 \\u043e\\u0442\\u043a\\u0440\\u044b\\u0442\\u043e\\u043c \\u0440\\u0435\\u0434\\u0430\\u043a\\u0442\\u043e\\u0440\\u0435 (MCP), \\u0440\\u0435\\u0434\\u0430\\u043a\\u0442\\u043e\\u0440 \\u043d\\u0435 \\u0437\\u0430\\u043a\\u0440\\u044b\\u0432\\u0430\\u0442\\u044c.**\r\n1. \\u0421\\u0440\\u0435\\u0434\\u0430: GUI-\\u0440\\u0435\\u0434\\u0430\\u043a\\u0442\\u043e\\u0440 \\u0441 MCP `127.0.0.1:8123` (`netstat -ano | grep ':8123 .*LISTEN'`). \\u041a\\u0430\\u0436\\u0434\\u0430\\u044f MCP-\\u043a\\u043e\\u043c\\u0430\\u043d\\u0434\\u0430 \\u2014 \\u043f\\u043e\\u0434\r\n   `python tools/art/material_library/ue_lock.py --step \"<\\u0448\\u0430\\u0433>\" -- <\\u043a\\u043e\\u043c\\u0430\\u043d\\u0434\\u0430>`; `ue_hero_lookdev.py review|verify`\r\n   \\u0431\\u0435\\u0440\\u0443\\u0442 \\u0431\\u043b\\u043e\\u043a\\u0438\\u0440\\u043e\\u0432\\u043a\\u0443 \\u0441\\u0430\\u043c\\u0438 \\u0438 \\u043d\\u0435 \\u043e\\u0431\\u043e\\u0440\\u0430\\u0447\\u0438\\u0432\\u0430\\u044e\\u0442\\u0441\\u044f.\r\n2. \\u0418\\u043c\\u043f\\u043e\\u0440\\u0442 `skeletal-adopt` (\\u043f\\u0440\\u043e\\u043f \\u2014 `static-candidate`), \\u043a\\u043b\\u0438\\u043f\\u044b \\u2014 `python tools/tripo-pipeline/anim/h2anim_ue.py import <spec.json>`,\r\n   look-dev \\u0441\\u044a\\u0451\\u043c\\u043a\\u0430 \\u2014 `python tools/art/material_library/ue_hero_lookdev.py review --config <json> --out <dir> --tag <tag>`.\r\n3. \\u041f\\u0440\\u0430\\u0432\\u043a\\u0438 \\u0431\\u0435\\u0437 \\u0441\\u0431\\u043e\\u0440\\u043a\\u0438 C++ (\\u0440\\u0435\\u0433\\u0438\\u0441\\u0442\\u0440\\u0430\\u0446\\u0438\\u044f \\xa75.4\\u20135.5): CUE-011/013 \\u0432 `cue-table.json` \\u2192\r\n   `python tools/s08/cue_contract/cue_contract.py validate-table`; `DirectoriesToAlwaysCook` \\u0432\r\n   `unreal/Unmatched/Config/DefaultGame.ini`; `S08FighterNames.json`; \\u0432\\u0430\\u0440\\u0438\\u0430\\u043d\\u0442\\u044b bench-\\u0444\\u0438\\u043a\\u0441\\u0442\\u0443\\u0440 \\u043e\\u0431\\u0435\\u0438\\u0445 \\u0434\\u043e\\u0441\\u043e\\u043a (\\u04207-11:\r\n   `env_bench_fixtures.cts --variant <Key> --hero-name \"<FIGHTER_NAME>\" --hero-slug <HERO_SLUG>`, \\u0437\\u0430\\u0442\\u0435\\u043c `--check`;\r\n   \\u043f\\u043e\\u043c\\u043e\\u0449\\u043d\\u0438\\u043a \\u0431\\u0435\\u0437 \\u043d\\u043e