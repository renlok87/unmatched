f\\u043e \\u0434\\u0435\\u043b\\u0435\\u0433\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044e \\u2014 \\u0441\\u043e\\u0434\\u0435\\u0440\\u0436\\u0438\\u0442 \\u00ab\\u043f\\u043e \\u0434\\u0435\\u043b\\u0435\\u0433\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u0438\\u044e\\u00bb (`docs/game-design/decisions/2026-10-06-visual-delegated-decisions.md`) |\n\n\\u041f\\u0443\\u0442\\u044c: `art/pipeline-candidates/<ASSET_ID>/evidence/acceptance-concept/<YYYYMMDD>-front-r<N>/card.json` (1a) \\u0438\n`\\u2026/<YYYYMMDD>-sheet-r<N>/card.json` (1c). \\u041f\\u0443\\u0441\\u0442\\u043e\\u0439 \\u043a\\u0430\\u0442\\u0430\\u043b\\u043e\\u0433 `frames/` \\u043d\\u0435 \\u043d\\u0443\\u0436\\u0435\\u043d: \\u043a\\u0430\\u0434\\u0440\\u044b \\u2014 \\u0444\\u0430\\u0439\\u043b\\u044b \\u043f\\u0430\\u043a\\u0435\\u0442\\u0430.\n\n```bash\npython tools/art/acceptance/validate_card.py \\\n    art/pipeline-candidates/<ASSET_ID>/evidence/acceptance-concept/<YYYYMMDD>-<front|sheet>-r<N>/card.json \\\n    --print-verdict --check-files\n# \\u043a\\u043e\\u0434 0 = \\u0441\\u0445\\u0435\\u043c\\u0430 \\u0432\\u0430\\u043b\\u0438\\u0434\\u043d\\u0430 \\u0438 \\u0432\\u0435\\u0440\\u0434\\u0438\\u043a\\u0442 \\u0441\\u043e\\u0433\\u043b\\u0430\\u0441\\u043e\\u0432\\u0430\\u043d \\u0441 \\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u0430\\u043c\\u0438; 1 = \\u043d\\u0435\\u0442. --check-files \\u0441\\u0432\\u0435\\u0440\\u044f\\u0435\\u0442 sha256 accepted_object\n# \\u0438 \\u043d\\u0430\\u043b\\u0438\\u0447\\u0438\\u0435 frames/reports/previous_card; \\u0437\\u0430\\u043f\\u0443\\u0441\\u043a \\u0438\\u0437 \\u043a\\u043e\\u0440\\u043d\\u044f \\u0440\\u0435\\u043f\\u043e\n```\n\n**\\u041f\\u0440\\u043e\\u043c\\u043f\\u0442 \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a\\u0430** (\\u043d\\u0430 \\u0432\\u0445\\u043e\\u0434 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u0444\\u0430\\u0439\\u043b\\u044b, \\u043e\\u0442\\u0447\\u0451\\u0442\\u044b, \\u0432\\u044b\\u0434\\u0435\