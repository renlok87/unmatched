3a\\u0446\\u0438\\u0438 1b.\n\\u0420\\u0443\\u0431\\u0440\\u0438\\u043a\\u0430: references/concept-sheet.md \\u0440\\u0430\\u0437\\u0434\\u0435\\u043b 11 (\\u0442\\u0430\\u0431\\u043b\\u0438\\u0446\\u0430 S, C, Q, P). \\u041d\\u0430 1a C = 1,5 \\u043f\\u043e \\u0444\\u0438\\u043a\\u0441\\u0438\\u0440\\u043e\\u0432\\u0430\\u043d\\u043d\\u043e\\u043c\\u0443 \\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u0443\n\\u0440\\u0430\\u0437\\u0434\\u0435\\u043b\\u0430 11, \\u0432 rework_fix_list C \\u043d\\u0430 1a \\u043d\\u0435 \\u0432\\u043a\\u043b\\u044e\\u0447\\u0430\\u0439. T- \\u0438\\u043b\\u0438 A-\\u043f\\u043e\\u0437\\u0430 = S 0. \\u0411\\u0430\\u043b\\u043b \\u2014 \\u043f\\u043e \\u044f\\u043a\\u043e\\u0440\\u044f\\u043c, \\u0448\\u0430\\u0433 0,5; \\u043e\\u0431\\u043e\\u0441\\u043d\\u043e\\u0432\\u0430\\u043d\\u0438\\u0435 \\u0441\n\\u0438\\u043c\\u0435\\u043d\\u0430\\u043c\\u0438 \\u0444\\u0430\\u0439\\u043b\\u043e\\u0432 \\u0438\\u0437 frames.files. \\u0413\\u0435\\u0439\\u0442 \\u043e\\u0434\\u0438\\u043d \\u2014 G-CHECKS \\u043f\\u043e checks-report.json (\\u043a\\u043e\\u0434 0 \\u2192 PASS); WARN \\u043d\\u0435 \\u0433\\u0435\\u0439\\u0442, \\u0443\\u0447\\u0438\\u0442\\u044b\\u0432\\u0430\\u0439 \\u0438\\u0445\n\\u0432 C. rework_fix_list \\u2014 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u0438\\u0437\\u043c\\u0435\\u0440\\u0435\\u043d\\u0438\\u044f < 2 \\u0438 G-CHECKS \\u043f\\u0440\\u0438 FAIL; \\u0443 \\u043f\\u0443\\u043d\\u043a\\u0442\\u0430: item, frame (\\u0432\\u0438\\u0434), fix (\\u043e\\u0434\\u043d\\u0430 \\u0430\\u043d\\u0433\\u043b\\u0438\\u0439\\u0441\\u043a\\u0430\\u044f\n\\u0441\\u0442\\u0440\\u043e\\u043a\\u0430 \\u0434\\u043b\\u044f CORRECTION), tool (Codex 1c CORRECTION | Tripo 1b \\u0447\\u0435\\u0440\\u043d\\u043e\\u0432\\u0438\\u043a | Codex 1a). \\u0412\\u0435\\u0440\\u0434\\u0438\\u043a\\u0442 \\u043f\\u043e\\u0441\\u0447\\u0438\\u0442\\u0430\\u0439 \\u043f\\u043e \\u043f\\u0440\\u0430\\u0432\\u0438\\u043b\\u0430\\u043c\n\\u0440\\