al_path\": \"C:\\\\Users\\\\ren\\\\.codex\\\\generated_images\\\\01a1347d-2299-70d1-8bee-38b305c412c4\\\\exec-83eea61b-c699-4b46-987e-b70ab48cf270.png\",\r\n      \"sha256\": \"8a61ab74d50ac73cb922a3dfaeaa4493c0af1cd379c472dbeebc738d97cd41da\",\r\n      \"original_exists\": true,\r\n      \"original_matches_saved\": true\r\n    },\r\n    {\r\n      \"view\": \"design-front\",\r\n      \"generation\": 2,\r\n      \"saved_path\": \"art/imagegen/concept-robert-muldoon-codex/concepts/robert-muldoon-design-front-g2.png\",\r\n      \"original_path\": \"C:\\\\Users\\\\ren\\\\.codex\\\\generated_images\\\\01a1347d-2299-70d1-8bee-38b305c412c4\\\\exec-6c32f31a-f0a7-4e45-b678-78df5802ca75.png\",\r\n      \"sha256\": \"ff87dd40c1400047cc5b5858c1d5d3dde20d4ee3d841612686b5c83200b9902a\",\r\n      \"original_exists\": true,\r\n      \"original_matches_saved\": true\r\n    },\r\n    {\r\n      \"view\": \"design-front\",\r\n      \"generation\": 3,\r\n      \"saved_path\": \"art/imagegen/concept-robert-muldoon-codex/concepts/robert-muldoon-design-front-g3.png\",\r\n      \"original_path\": \"C:\\\\Users\\\\ren\\\\.codex\\\\generated_images\\\\01a134b8-a6f1-75f2-bc45-d8fdac46d2ca\\\\exec-336451e6-dfb2-41a4-b5ff-e11ae16e9aed.png\",\r\n      \"sha256\": \"ae0646f5a94568acaa493b83a0a5d6477ba9e5a12ddcfdc57788416ed190cb5f\",\r\n      \"original_exists\": true,\r\n      \"original_matches_saved\": true\r\n    },\r\n    {\r\n      \"view\": \"design-front\",\r\n      \"generation\": 4,\r\n      \"saved_path\": \"art/imagegen/concept-robert-muldoon-codex/concepts/robert-muldoon-design-front-g4.png\",\r\n      \"original_path\": \"C:\\\\Users\\\\ren\\\\.codex\\\\generated_images\\\\01a134b8-a6f1-75f2-bc45-d8fdac46d2ca\\\\exec-9fa6837d-70ee-471c-b8d5-68ed7d2b6d23.png\",\r\n      \"sha256\": \"b3bed1b981227bac38fc0306d3a2c59b21c992511907d425587ce310fb09c6c5\",\r\n      \"original_exists\": true,\r\n      \"original_matches_saved\": true\r\n    }\r\n  ],\r\n  \"selected_copy\": {\r\n    \"path\