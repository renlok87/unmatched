a72.6, \\u00a70.3 \\u043f.4); `wing_tip.L/R` \\u2014 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043f\\u043e \\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u044e (\\u0441\\u0442\\u043e\\u043f \\u00a75 \\u043f.5); \\u0448\\u0438\\u0440\\u043e\\u043a\\u0438\\u0439 \\u043a\\u0430\\u0434\\u0440 \\u043a\\u043e\\u043d\\u0446\\u0435\\u043f\\u0442\\u0430 (HANDBOOK \\u00a73.1) |\\n| `prop` | 0, 1, 2, 3, 4, 6?, 7 | Tripo \\u2014 multi-view: front+side \\u0443 \\u043e\\u0441\\u0435\\u0441\\u0438\\u043c\\u043c\\u0435\\u0442\\u0440\\u0438\\u0447\\u043d\\u043e\\u0433\\u043e, front+back \\u0443 \\u0430\\u0441\\u0438\\u043c\\u043c\\u0435\\u0442\\u0440\\u0438\\u0447\\u043d\\u043e\\u0433\\u043e; \\u044d\\u0442\\u0430\\u043f 3 \\u2014 \\u043f\\u0443\\u0442\\u044c \\u0441\\u0442\\u0430\\u0442\\u0438\\u0447\\u0435\\u0441\\u043a\\u043e\\u0433\\u043e \\u043f\\u0440\\u043e\\u043f\\u0441\\u0430 (HANDBOOK \\u00a75, \\u00a76 \\u00ab\\u042d\\u0442\\u0430\\u043f 3 \\u2014 \\u043f\\u0440\\u043e\\u043f\\u00bb), \\u0440\\u0435\\u0433\\u0438\\u0441\\u0442\\u0440\\u0430\\u0446\\u0438\\u0438 \\u043f\\u0435\\u0440\\u0441\\u043e\\u043d\\u0430\\u0436\\u0430 \\u043d\\u0435\\u0442; \\u043d\\u0430 \\u044d\\u0442\\u0430\\u043f\\u0435 4 `D = null` \\u0438 `G-RIG = n/a`, \\u0441\\u044a\\u0451\\u043c\\u043a\\u0430 `capture_acceptance_set.py --no-base` \\u0440\\u0430\\u0431\\u043e\\u0442\\u0430\\u0435\\u0442 \\u0438 \\u043d\\u0430 \\u0448\\u0438\\u0440\\u043e\\u043a\\u043e\\u043c \\u043f\\u0440\\u043e\\u043f\\u0435 (`references/acceptance-and-blender.md` \\u00a714); \\u044d\\u0442\\u0430\\u043f 6 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043f\\u0440\\u0438 CUE \\u0438\\u043b\\u0438 \\u0437\\u0432\\u0443\\u043a\\u0435, \\u0438\\u043d\\u0430\\u0447\\u0435 \\u043f\\u0440\\u043e\\u043f\\u0443\\u0441\\u043a \\u0441 \\u0437\\u0430\\u043f\\u0438\\u0441\\u044c\\u044e \\u00ab\\u043d\\u0435\\u0442 \\u0441\\u043b\\u043e\\u0442\\u043e\\u0432\\u00bb \\u0432 `STAGE6_SLOTS`; \\u044d\\u0442\\u0430\\u043f 7 \\u2014 \\u0441\\u0442\\u0430\\u0442\\u0438\\u0447\\u0435\\u0441\\u043a\\u0438\\u0439 \\u0438\\u043c\\u043f\\u043e\\u0440\\u0442 (HANDBOOK \\u00a75 \\u043f.7); \\u043f\\u0440\\u043e\\u043f \\u0441 \\u043e\\u0441\\u0435\\u0432\\u043e\\u0439 \\u0441\\u0438\\u043c\\u043c\\u0435\\u0442\\u0440\\u0438\\u0435\\u0439 \\u043c\\u043e\\u0436\\u0435\\u0442 \\u043f\\u0440\\u043e\\u043f\\u0443\\u0441\\u0442\\u0438\\u0442\\u044c \\u0448\\u0430\\u0433 1b |\\n| `non-humanoid` (\\u0447\\u0435\\u0442\\u0432\\u0435\\u0440\\u043e\\u043d\\u043e\\u0433\\u043e\\u0435, \\u043c\\u043d\\u043e\\u0433\\u043e\\u0433\\u043e\\u043b\\u043e\\u0432\\u043e\\u0435, \\u0437\\u043c\\u0435\\u0435\\u0432\\u0438\\u0434\\u043d\\u043e\\u0435) | **\\u0441\\u0442\\u043e\\u043f \\u043d\\u0430 \\u044d\\u0442\\u0430\\u043f\\u0435 0** | \\u0433\\u0435\\u0439\\u0442 \\u00a75 \\u043f.1: \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044e \\u0443\\u0445\\u043e\\u0434\\u0438\\u0442 \\u0433\\u043e\\u0442\\u043e\\u0432\\u0430\\u044f \\u043f\\u043e\\u0441\\u0442\\u0430\\u043d\\u043e\\u0432\\u043a\\u0430 `<ASSET_DIR>/STOP-RIG-CONTRACT-3.md` \\u043f\\u043e \\u0448\\u0430\\u0431\\u043b\\u043e\\u043d\\u0443 `references/intake-and-evidence.md` \\u00a72. \\u0414\\u043e \\u0441\\u0442\\u043e\\u043f\\u0430 \\u043f\\u0438\\u0448\\u0435\\u0442\\u0441\\u044f \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e `asset-card.yaml` (`ANATOMY: non-humanoid`, \\u0430\\u043d\\u0430\\u0442\\u043e\\u043c\\u0438\\u044f \\u0432 `NOTES`); \\u0437\\u0430\\u043f\\u0438\\u0441\\u044c \\u0440\\u0435\\u0435\\u0441\\u0442\\u0440\\u0430, \\u0441\\u0442\\u0440\\u043e\\u043a\\u0430 `anim.csv` \\u0438 \\u0442\\u0440\\u0430\\u0442\\u044b \\u2014 \\u043d\\u0435\\u0442. \\u041f\\u0440\\u0430\\u0432\\u0438\\u043b\\u0430 \\u043f\\u043e\\u0437 \\u0447\\u0435\\u0442\\u0432\\u0435\\u0440\\u043e\\u043d\\u043e\\u0433\\u0438\\u0445 \\u0432 \\u0441\\u043f\\u0440\\u0430\\u0432\\u043e\\u0447\\u043d\\u0438\\u043a\\u0430\\u0445 \\u0434\\u0435\\u0439\\u0441\\u0442\\u0432\\u0443\\u044e\\u0442 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043f\\u043e\\u0441\\u043b\\u0435 \\u043f\\u0440\\u0438\\u043d\\u044f\\u0442\\u0438\\u044f rig-contract/3 |\\n\\n\\u0411\\u043b\\u043e\\u043a `optional_extensions` \\u0432 `docs/art-pipeline/rig/rig-contract.json:169-184` (`crown_snakes`, `cloak`, `harpy_wings`)\\n\\u0438\\u043c\\u0435\\u0435\\u0442 \\u0441\\u0442\\u0430\\u0442\\u0443\\u0441 \\u00ab\\u043f\\u0440\\u0435\\u0434\\u043b\\u043e\\u0436\\u0435\\u043d\\u043e, \\u043d\\u0435 \\u0440\\u0435\\u0430\\u043b\\u0438\\u0437\\u043e\\u0432\\u0430\\u043d\\u043e\\u00bb: h2_bake \\u0438 \\u0432\\u0430\\u043b\\u0438\\u0434\\u0430\\u0442\\u043e\\u0440\\u044b \\u044d\\u0442\\u0438\\u0445 \\u043a\\u043e\\u0441\\u0442\\u0435\\u0439 \\u043d\\u0435 \\u0441\\u043e\\u0437\\u0434\\u0430\\u044e\\u0442 (HANDBOOK \\u00a72.6 \\u00ab\\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043f\\u043e\\n\\u0440\\u0435\\u0448\\u0435\\u043d\\u0438\\u044e\\u00bb). \\u0418\\u0441\\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u044c \\u0440\\u0430\\u0441\\u0448\\u0438\\u0440\\u0435\\u043d\\u0438\\u0435 \\u2014 \\u0441\\u0442\\u043e\\u043f \\u00a75 \\u043f.5. \\u0411\\u0435\\u0437 \\u043d\\u043e\\u0432\\u044b\\u0445 \\u043a\\u043e\\u0441\\u0442\\u0435\\u0439 \\u0440\\u0430\\u0431\\u043e\\u0442\\u0430\\u0435\\u0442 \\u0431\\u0430\\u0437\\u0430: \\u0437\\u043c\\u0435\\u0438 100 % \\u043d\\u0430 `head`, \\u043f\\u043b\\u0430\\u0449, \\u043a\\u0430\\u043f\\u044e\\u0448\\u043e\\u043d\\n\\u0438 \\u044e\\u0431\\u043a\\u0430 \\u2014 \\u043f\\u043b\\u0430\\u0432\\u043d\\u044b\\u0435 \\u0432\\u0435\\u0441\\u0430 `hips`/`leg_upper.L/R`. \\u041d\\u043e\\u0432\\u044b\\u0439 MatID-\\u043a\\u043b\\u0430\\u0441\\u0441 \\u2014 \\u0442\\u043e\\u0436\\u0435 \\u0441\\u0442\\u043e\\u043f \\u00a75 \\u043f.5.\\n\\n## 4. \\u0418\\u0441\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u0438 \\u0438 \\u043a\\u0430\\u043a \\u0438\\u0445 \\u0432\\u044b\\u0437\\u044b\\u0432\\u0430\\u0442\\u044c\\n\\n| \\u0420\\u043e\\u043b\\u044c | \\u041a\\u0430\\u043a \\u0432\\u044b\\u0437\\u0432\\u0430\\u0442\\u044c | \\u041f\\u0440\\u0430\\u0432\\u0438\\u043b\\u0430 |\\n|---|---|---|\\n| Codex (\\u044d\\u0442\\u0430\\u043f 1) | \\u041e\\u0441\\u043d\\u043e\\u0432\\u043d\\u043e\\u0439 \\u043f\\u0443\\u0442\\u044c \\u2014 `codex.exe exec` \\u043f\\u043e\\u0441\\u043b\\u0435 \\u043f\\u0440\\u043e\\u0431\\u044b exec (`references/concept-sheet.md` \\u00a75.2): exe \\u0438\\u0437 `%LOCALAPPDATA%/OpenAI/Codex/bin/<hash>/` (\\u0435\\u0433\\u043e \\u0437\\u0430\\u043f\\u0443\\u0441\\u043a\\u0430\\u0435\\u0442 \\u0441\\u0430\\u043c\\u043e \\u043f\\u0440\\u0438\\u043b\\u043e\\u0436\\u0435\\u043d\\u0438\\u0435), \\u043f\\u0440\\u0438 \\u00abused by another process\\u00bb \\u2014 \\u043a\\u043e\\u043f\\u0438\\u044f \\u0432 `C:/tmp/codex-bin/`; \\u043f\\u0440\\u0438 \\u0437\\u0430\\u043a\\u0440\\u044b\\u0442\\u043e\\u043c \\u043f\\u0440\\u0438\\u043b\\u043e\\u0436\\u0435\\u043d\\u0438\\u0438 \\u0433\\u043e\\u0434\\u0438\\u0442\\u0441\\u044f \\u0438 exe \\u043f\\u0430\\u043a\\u0435\\u0442\\u0430 `C:/Program Files/WindowsApps/OpenAI.Codex_*/app/resources/`. \\u041f\\u0430\\u043a\\u0435\\u0442 \\u043d\\u0430 \\u043c\\u0430\\u0448\\u0438\\u043d\\u0435 \\u043e\\u0434\\u0438\\u043d, \\u00abexe \\u0441\\u043e\\u0441\\u0435\\u0434\\u043d\\u0435\\u0439 \\u0432\\u0435\\u0440\\u0441\\u0438\\u0438\\u00bb \\u043d\\u0435\\u0442. \\u0418\\u0437 PowerShell: `Get-Content <prompt> -Raw -Encoding UTF8 \\\\| & $exe exec -C <repo> -s workspace-write -c 'windows.sandbox=\\\"unelevated\\\"' --skip-git-repo-check -` (`$OutputEncoding` \\u0438 `[Console]::OutputEncoding` \\u2014 UTF-8). \\u0424\\u043b\\u0430\\u0433 `windows.sandbox=\\\"unelevated\\\"` \\u043e\\u0431\\u044f\\u0437\\u0430\\u0442\\u0435\\u043b\\u0435\\u043d: \\u0431\\u0435\\u0437 \\u043d\\u0435\\u0433\\u043e \\u043f\\u0440\\u0438 \\u043e\\u0442\\u043a\\u0440\\u044b\\u0442\\u043e\\u043c \\u043f\\u0440\\u0438\\u043b\\u043e\\u0436\\u0435\\u043d\\u0438\\u0438 \\u043f\\u0435\\u0441\\u043e\\u0447\\u043d\\u0438\\u0446\\u0430 \\u043d\\u0435 \\u0437\\u0430\\u043f\\u0443\\u0441\\u043a\\u0430\\u0435\\u0442 \\u043a\\u043e\\u043c\\u0430\\u043d\\u0434, \\u0430 \\u043a\\u043e\\u0434 \\u0432\\u044b\\u0445\\u043e\\u0434\\u0430 \\u0432\\u0441\\u0451 \\u0440\\u0430\\u0432\\u043d\\u043e 0 (concept-sheet \\u00a75.2). Exec \\u0437\\u0430\\u043d\\u044f\\u0442 \\u0438 \\u043a\\u043e\\u043f\\u0438\\u0435\\u0439 \\u2014 \\u043f\\u0440\\u0438\\u043b\\u043e\\u0436\\u0435\\u043d\\u0438\\u0435 ChatGPT \\u0447\\u0435\\u0440\\u0435\\u0437 \\u0443\\u043f\\u0440\\u0430\\u0432\\u043b\\u0435\\u043d\\u0438\\u0435 \\u0440\\u0430\\u0431\\u043e\\u0447\\u0438\\u043c \\u0441\\u0442\\u043e\\u043b\\u043e\\u043c (computer-use \\u0438\\u043b\\u0438 Windows-MCP): Ctrl+N \\u0432 \\u043f\\u0440\\u043e\\u0435\\u043a\\u0442\\u0435 `unmached`, \\u0441\\u043e\\u043e\\u0431\\u0449\\u0435\\u043d\\u0438\\u0435 \\u00ab\\u041f\\u0440\\u043e\\u0447\\u0438\\u0442\\u0430\\u0439 `<prompt file>` \\u0438 \\u0432\\u044b\\u043f\\u043e\\u043b\\u043d\\u0438 \\u0437\\u0430\\u0434\\u0430\\u0447\\u0443\\u00bb (`docs/game-design/visual/07-prompt-templates.md` \\u00a71.1; concept-sheet \\u00a75.3). \\u041f\\u0440\\u0438\\u043b\\u043e\\u0436\\u0435\\u043d\\u0438\\u0435 \\u043f\\u043e\\u043b\\u044c\\u0437\\u043e\\u0432\\u0430\\u0442\\u0435\\u043b\\u044f \\u043d\\u0435 \\u0437\\u0430\\u043a\\u0440\\u044b\\u0432\\u0430\\u0442\\u044c. npm-`codex` \\u043d\\u0435 \\u0440\\u0430\\u0431\\u043e\\u0442\\u0430\\u0435\\u0442 | \\u041f\\u0440\\u043e\\u043c\\u043f\\u0442-\\u0444\\u0430\\u0439\\u043b \\u043f\\u0438\\u0448\\u0435\\u0442 Claude: `docs/game-design/visual/06-tasks/prompts/<ASSET_ID>-concept.codex.md`. Codex \\u043f\\u0438\\u0448\\u0435\\u0442 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u0432 `art/imagegen/concept-<key>-codex/` \\u0438 \\u043d\\u0435 \\u043a\\u043e\\u043c\\u043c\\u0438\\u0442\\u0438\\u0442 |\\n| \\u041f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a \\u00abOpus xhigh\\u00bb (\\u043f\\u043e \\u0443\\u043c\\u043e\\u043b\\u0447\\u0430\\u043d\\u0438\\u044e) | \\u0410\\u0433\\u0435\\u043d\\u0442 Workflow `agent(prompt, {model: 'opus', effort: 'xhigh', schema: <\\u0441\\u0445\\u0435\\u043c\\u0430 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0438>, label})`, \\u0441\\u0432\\u0435\\u0436\\u0438\\u0439 \\u043a\\u043e\\u043d\\u0442\\u0435\\u043a\\u0441\\u0442 (\\u0441\\u043a\\u0440\\u0438\\u043f\\u0442 \\u0438 \\u043f\\u0440\\u043e\\u043c\\u043f\\u0442 \\u2014 `references/acceptance-and-blender.md` \\u00a78.2\\u20138.3). \\u041d\\u0430 \\u0432\\u0445\\u043e\\u0434 \\u2014 \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u043a\\u0430\\u0434\\u0440\\u044b, \\u043e\\u0442\\u0447\\u0451\\u0442\\u044b, \\u043a\\u043e\\u043d\\u0446\\u0435\\u043f\\u0442 \\u0438 \\u0440\\u0443\\u0431\\u0440\\u0438\\u043a\\u0430 | \\u041d\\u0435 \\u043f\\u0440\\u0430\\u0432\\u0438\\u0442. \\u0415\\u0433\\u043e \\u0441\\u0435\\u0441\\u0441\\u0438\\u044f \\u043e\\u0442\\u043b\\u0438\\u0447\\u043d\\u0430 \\u043e\\u0442 \\u0441\\u0435\\u0441\\u0441\\u0438\\u0438 \\u0438\\u0441\\u043f\\u043e\\u043b\\u043d\\u0438\\u0442\\u0435\\u043b\\u044f. `session_id` \\u043e\\u0431\\u043e\\u0438\\u0445 \\u043f\\u0438\\u0448\\u0443\\u0442\\u0441\\u044f \\u0432 \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0443 |\\n| \\u041f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a \\u00abSol 6.1 xhigh\\u00bb | \\u0422\\u043e\\u0442 \\u0436\\u0435 `$exe`, \\u043f\\u0440\\u043e\\u0448\\u0435\\u0434\\u0448\\u0438\\u0439 \\u043f\\u0440\\u043e\\u0431\\u0443 exec (\\u043d\\u0435 npm-`codex`; GUI-\\u043f\\u0443\\u0442\\u044c \\u043f\\u0440\\u0438\\u0451\\u043c\\u0449\\u0438\\u043a\\u0443 \\u043d\\u0435 \\u043f\\u043e\\u0434\\u0445\\u043e\\u0434\\u0438\\u0442 \\u2014 \\u043d\\u0443\\u0436\\u043d\\u044b `--output-schema` \\u0438 `-o`): `Get-Content <acceptor-prompt.md> -Raw -Encoding UTF8 \\\\| & $exe exec --ignore-user-config -m gpt-6.1-sol -c 'model_reasoning_effort=\\\"xhigh\\\"' -c 'windows.sandbox=\\\"unelevated\\\"' -s read-only -C <repo> --skip-git-repo-check --output-schema tools/art/acceptance/asset-acceptance-2.output-<kind>.schema.json -o <evidence>/card.json --json -i <\\u043a\\u0430\\u0434\\u04401> -i <\\u043a\\u0430\\u0434\\u04402> -- -` (\\u043f\\u043e\\u043b\\u043d\\u0430\\u044f \\u043a\\u043e\\u043c\\u0430\\u043d\\u0434\\u0430 \\u2014 `references/acceptance-and-blender.md` \\u00a78.4). \\u0421\\u0445\\u0435\\u043c\\u0430 \\u2014 \\u0441\\u0442\\u0440\\u043e\\u0433\\u0430\\u044f \\u043f\\u0440\\u043e\\u0438\\u0437\\u0432\\u043e\\u0434\\u043d\\u0430\\u044f \\u0441\\u0432\\u043e\\u0435\\u0433\\u043e \\u0432\\u0438\\u0434\\u0430 (`model`/`concept`/`anim`), \\u043d\\u0435 \\u043f\\u043e\\u043b\\u043d\\u0430\\u044f `asset-acceptance-2.schema.json`: \\u043f\\u043e\\u043b\\u043d\\u0443\\u044e \\u0441\\u0442\\u0440\\u043e\\u0433\\u0438\\u0439 \\u0440\\u0435\\u0436\\u0438\\u043c \\u043e\\u0442\\u0432\\u0435\\u0440\\u0433\\u0430\\u0435\\u0442. \\u041e\\u0442\\u043a\\u0430\\u0437 \\u0441\\u0445\\u0435\\u043c\\u044b \\u2014 \\u0442\\u043e\\u0442 \\u0436\\u0435 \\u0432\\u044b\\u0437\\u043e\\u0432 \\u0431\\u0435\\u0437 `--output-schema` (\\u00a78.4, \\u043f\\u043e\\u0434 \\u043a\\u043e\\u043c\\u0430\\u043d\\u0434\\u043e\\u0439). \\u041a\\u0430\\u0436\\u0434\\u044b\\u0439 \\u043a\\u0430\\u0434\\u0440 \\u2014 \\u043e\\u0442\\u0434\\u0435\\u043b\\u044c\\u043d\\u044b\\u0439 `-i`, \\u043f\\u0435\\u0440\\u0435\\u0434 `-` \\u0440\\u0430\\u0437\\u0434\\u0435\\u043b\\u0438\\u0442\\u0435\\u043b\\u044c `--` (`codex exec --help`, codex-cli 0.162.0-alpha.2); \\u0437\\u0430\\u0442\\u0435\\u043c `validate_card.py`. \\u041f\\u0440\\u043e\\u0432\\u0435\\u0440\\u0435\\u043d\\u043e \\u0436\\u0438\\u0432\\u044b\\u043c \\u0432\\u044b\\u0437\\u043e\\u0432\\u043e\\u043c 2026-10-09 (\\u043a\\u0430\\u043b\\u0438\\u0431\\u0440\\u043e\\u0432\\u043a\\u0430, 7\\u201312 \\u043c\\u0438\\u043d \\u043d\\u0430 \\u043f\\u0440\\u0438\\u0451\\u043c\\u043a\\u0443); \\u