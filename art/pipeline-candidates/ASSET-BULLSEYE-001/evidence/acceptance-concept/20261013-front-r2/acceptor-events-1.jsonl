d_palette`, `tools/art/concept/README.md` \\u00abpalette.json\\u00bb):\n  `{\"asset_id\": \"<ASSET_ID>\", \"main\": [{\"name\": \"midnight blue\", \"hex\": \"#1F2A5A\"}, {\"name\": \"\\u2026\", \"hex\": \"#\\u2026\"}], \"accent\": {\"name\": \"\\u2026\", \"hex\": \"#\\u2026\"}}`.\n  \\u042d\\u0442\\u043e \\u043a\\u043e\\u043f\\u0438\\u044f \\u043f\\u043e\\u043b\\u044f `PALETTE` \\u043a\\u0430\\u0440\\u0442\\u043e\\u0447\\u043a\\u0438 (\\u0448\\u0430\\u0431\\u043b\\u043e\\u043d SKILL.md \\u00a77.2 \\u0445\\u0440\\u0430\\u043d\\u0438\\u0442 \\u0442\\u0435 \\u0436\\u0435 `name` \\u0438 `hex`); \\u0430\\u043d\\u0433\\u043b\\u0438\\u0439\\u0441\\u043a\\u0438\\u0435 \\u0438\\u043c\\u0435\\u043d\\u0430 \\u2014 \\u0442\\u0435 \\u0436\\u0435, \\u0447\\u0442\\u043e \\u0432\n  `{{PALETTE_EN}}` (\\u0440\\u0430\\u0437\\u0434\\u0435\\u043b 9).\n- \\u0422\\u043e\\u043d\\u043a\\u0438\\u0435 \\u044d\\u043b\\u0435\\u043c\\u0435\\u043d\\u0442\\u044b (\\u0442\\u0435\\u0442\\u0438\\u0432\\u0430, \\u0434\\u0440\\u0435\\u0432\\u043a\\u043e, \\u0441\\u0442\\u0440\\u0435\\u043b\\u044b, \\u043f\\u043e\\u0441\\u043e\\u0445): \\u0432 \\u043f\\u0440\\u043e\\u043c\\u043f\\u0442\\u0435 \\u043f\\u043e\\u0436\\u0435\\u043b\\u0430\\u043d\\u0438\\u0435 \\u00abclearly readable, not hair-thin\\u00bb; \\u0432\n  \\u043f\\u0440\\u043e\\u0432\\u0435\\u0440\\u043a\\u0430\\u0445 \\u044d\\u0442\\u043e \\u043d\\u0435 FAIL \\u0438 \\u043d\\u0435 \\u043f\\u043e\\u0432\\u043e\\u0434 \\u0434\\u043b\\u044f \\u0440\\u0435\\u0442\\u0440\\u0430\\u044f. \\u0423\\u0442\\u043e\\u043b\\u0449\\u0430\\u044e\\u0449\\u0435\\u0433\\u043e \\u0440\\u0435\\u0436\\u0438\\u043c\\u0430 \\u0432 \\u0433\\u0435\\u043d\\u0435\\u0440\\u0438\\u0447\\u0435\\u0441\\u043a\\u043e\\u043c `h2_bake` \\u043d\\u0435\\u0442\n  (`tools/tripo-pipeline/blender/h2_bake/`; \\u043c\\u043e\\u0441\\u0442\\u044b \\u0435\\u0441\\u0442\\u044c \\u0442\\u043e\\u043b\\u044c\\u043a\\u043e \\u0432 \\u0440\\u0443\\u0447\\u043d\\u044b\\u0445 \\u0444\\u043e\\u0440\\