    },\n    \"Q\": {\n      \"value\": 2,\n      \"rationale\": \"raptors-front.png: уровень расписанной коллекционной миниатюры сопоставим с medusa-quality-reference.png. Внутри силуэта проработаны чешуя, складки кожи, зубы и ткани пасти; матовая кожа, блестящие когти и глаза различаются по материалу. Отсутствие костюмного орнамента соответствует персонажу и не снижает детализацию.\",\n      \"frames\": [\n        \"raptors-front.png\"\n      ]\n    },\n    \"P\": {\n      \"value\": 1,\n      \"rationale\": \"raptors-front.png: песочный тон кожи, тёмно-коричневые полосы, светлое брюхо и жёлтые глаза соответствуют PALETTE. Оба серповидных когтя читаются. Якорь длинного жёсткого хвоста потерян в перекрытии: отдельный полосатый конец над головой не показывает его длину и связь с тазом.\",\n      \"frames\": [\n        \"raptors-front.png\"\n      ]\n    }\n  },\n  \"score\": 6.9,\n  \"verdict\": \"return_to_stage_1\",\n  \"verdict_reason\": \"При PASS G-CHECKS сумма S=1, C=1.5, Q=2, P=1 даёт 6.9 < 8.0; длинный жёсткий хвост не читается, стройный силуэт Raptors требует доработки.\",\n  \"rework_fix_list\": [\n    {\n      \"item\": \"S\",\n      \"frame\": \"raptors-front.png\",\n      \"fix\": \"Give the Jurassic Park velociraptor a lean, forward-balanced torso, flexed hind legs and only slightly open jaws, preserving bent forearms separated from the body and a strictly frontal, level camera.\",\n      \"tool\": \"Codex 1a\"\n    },\n    {\n      \"item\": \"P\",\n      \"frame\": \"raptors-front.png\",\n      \"fix\": \"Show the long stiff striped tail extending behind the pelvis slightly to one side with a clearly readable continuous silhouette, replacing the isolated horn-like tip above the head while preserving the tan hide, brown stripes, pale belly and yellow eyes.\",\n      \"tool\": \"Codex 1a\"\n    }\n  ],\n  \"known_issues\": [\n    {\n      \"item\": \"G-CHECKS\",\n      \"frame\": \"checks-report.json\",\n      \"note\": \"view.frame_top = WARN: верхняя точка 2.831% при ориентире ≥ 4%; view.single_component = WARN: дополнительный компонент маски 1.755%. При визуальном осмотре обрезки и второй фигуры нет. WARN не меняют PASS гейта и фиксированное C.\"\n    }\n  ],\n  \"acceptor\": {\n    \"profile\": \"Sol 6.1 xhigh\",\n    \"session_id\": \"codex:pending\"\n  },\n  \"executor_session_id\": \"history:ASSET-RAPTORS-001-1a-design-front-g2\",\n  \"decided_by\": \"delegated (ВР-реестр 2026-10-06)\",\n  \"status_note\": \"Художественно не принято; требуется доработка силуэта Raptors и читаемости длинного жёсткого хвоста на этапе 1a.\"\n}"}}
