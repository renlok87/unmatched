# ============================================
# ENVIRONMENT VARIABLES EXAMPLE
# ============================================
# Скопируйте этот файл в .env и заполните реальные значения
# НЕ ИСПОЛЬЗУЙТЕ эти значения в production!

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ============================================
# DATABASE
# ============================================
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/unmached

# ============================================
# REDIS
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# JWT SECRETS (CRITICAL - CHANGE IN PRODUCTION!)
# ============================================
# Минимум 32 символа для безопасности
# Используйте: openssl rand -base64 32
JWT_SECRET=YOUR_SECRET_MIN_32_CHARS_HERE_CHANGE_IN_PRODUCTION
JWT_REFRESH_SECRET=YOUR_REFRESH_SECRET_MIN_32_CHARS_HERE_CHANGE_IN_PRODUCTION

# JWT TTL
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ============================================
# GAME CONFIGURATION
# ============================================
DEFAULT_BOARD_ID=cobble-city
MAX_PLAYERS_PER_GAME=4
TURN_TIME_LIMIT=300

# ============================================
# RATE LIMITING
# ============================================
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug
LOG_FORMAT=json

# ============================================
# CACHE
# ============================================
# Отключить Redis кэш для разработки (true/false)
DISABLE_CACHE=false

# ============================================
# MONITORING (OPTIONAL)
# ============================================
# SENTRY_DSN=
# PROMETHEUS_ENABLED=false
