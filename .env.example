# Environment
NODE_ENV=development

# Backend
PORT=3000

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/unmached?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets (CHANGE IN PRODUCTION!)
# Для production генерируйте случайные секреты длиной минимум 32 символа:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-secret-key-change-in-production-minimum-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production-minimum-32-chars
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=24h

# CORS
FRONTEND_URL=http://localhost:5173

# Vite
VITE_PORT=5173
